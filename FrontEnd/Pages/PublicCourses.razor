@page "/courses"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>دوره‌های آموزشی | آموزش‌یار</PageTitle>

<div class="public-courses-page" dir="rtl">

    <div class="public-courses-header">
        <span>آموزش‌یار</span>
        <h1>دوره‌های آموزشی</h1>
        <p>دوره موردنظر خود را انتخاب کنید و مسیر یادگیری را شروع کنید.</p>
    </div>

    @if (IsLoading)
    {
        <div class="public-courses-state">در حال دریافت دوره‌ها...</div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="public-courses-state error">@ErrorMessage</div>
    }
    else if (Courses.Count == 0)
    {
        <div class="public-courses-state">در حال حاضر دوره‌ای برای ثبت‌نام وجود ندارد.</div>
    }
    else
    {
        <div class="public-course-grid">

            @foreach (var course in Courses)
            {
                <article class="public-course-card">

                    <div class="public-course-top">
                        <div class="public-course-icon">آ</div>

                        <span class="public-course-delivery">
                            @GetDeliveryTypeText(course.DeliveryType)
                        </span>
                    </div>

                    <div class="public-course-body">

                        <h2>@course.Title</h2>

                        @if (!string.IsNullOrWhiteSpace(course.Description))
                        {
                            <p>@course.Description</p>
                        }

                        <div class="public-course-meta">

                            <div>
                                <small>مدرس</small>
                                <strong>
                                    @(string.IsNullOrWhiteSpace(course.InstructorName)
                                        ? "تعیین نشده"
                                        : course.InstructorName)
                                </strong>
                            </div>

                            <div>
                                <small>محتوا</small>
                                <strong>
                                    @course.ModuleCount ماژول · @course.LessonCount درس
                                </strong>
                            </div>

                            <div>
                                <small>شهریه</small>
                                <strong>@($"{course.Price:N0}") تومان</strong>
                            </div>

                        </div>

                        <div class="public-course-actions">

                            @if (IsStudentEnrolled(course.Id))
                            {
                                <button
                                    type="button"
                                    class="public-course-btn primary"
                                    @onclick="() => OpenCourse(course.Id)">
                                    ادامه دوره
                                    <span>←</span>
                                </button>
                            }
                            else if (Auth.IsStudent)

                            {
                                <button
                                    type="button"
                                    class="public-course-btn primary"
                                    disabled="@IsSubmitting"
                                    @onclick="() => Enroll(course)">
                                    @(IsSubmittingCourse(course.Id)
                                        ? "در حال ثبت‌نام..."
                                        : "ثبت‌نام در دوره")
                                </button>
                            }
                            else if (!Auth.IsLoggedIn)
                            {
                                <button
                                    type="button"
                                    class="public-course-btn primary"
                                    @onclick="Login">
                                    ورود و ثبت‌نام
                                </button>
                            }
                            else
                            {
                                <span class="public-course-note">
                                    این دوره برای دانشجو قابل ثبت‌نام است.
                                </span>
                            }

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>

@code {

    private List<PublicCourseDto> Courses { get; set; } = new();

    private HashSet<int> EnrolledCourseIds { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private int? SubmittingCourseId { get; set; }

    private bool IsSubmitting => SubmittingCourseId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Courses =
                await client.GetFromJsonAsync<List<PublicCourseDto>>(
                    "api/PublicCourses")
                ?? new();

            if (Auth.IsStudent)

            {
                var enrollments =
                    await client.GetFromJsonAsync<List<EnrollmentDto>>(
                        "api/Enrollments/my")
                    ?? new();

                EnrolledCourseIds = enrollments
                    .Where(x => x.Status != "Cancelled")
                    .Select(x => x.CourseId)
                    .ToHashSet();
            }
        }
        catch
        {
            ErrorMessage = "دریافت دوره‌ها با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private bool IsStudentEnrolled(int courseId)
    {
        return EnrolledCourseIds.Contains(courseId);
    }

    private bool IsSubmittingCourse(int courseId)
    {
        return SubmittingCourseId == courseId;
    }

    private void Login()
    {
        Navigation.NavigateTo("/register?returnUrl=/courses");
    }

    private void OpenCourse(int courseId)
    {
        Navigation.NavigateTo(
            $"/student/course-content/{courseId}");
    }

    private async Task Enroll(PublicCourseDto course)
    {
        if (!Auth.IsStudent)
        {
            Login();
            return;
        }

        ErrorMessage = null;
        SubmittingCourseId = course.Id;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var request = new
            {
                courseId = course.Id,
                startDate = DateTime.Now.Date,
                status = "Active",
                description = "ثبت‌نام دانشجو از سایت"
            };

            var response =
                await client.PostAsJsonAsync(
                    "api/Enrollments",
                    request);

            if (response.IsSuccessStatusCode)
            {
                EnrolledCourseIds.Add(course.Id);

                Navigation.NavigateTo(
                    $"/student/course-content/{course.Id}");
                return;
            }

            try
            {
                var error =
                    await response.Content
                        .ReadFromJsonAsync<ApiError>();

                ErrorMessage =
                    error?.Message ??
                    "ثبت‌نام در دوره انجام نشد.";
            }
            catch
            {
                ErrorMessage = "ثبت‌نام در دوره انجام نشد.";
            }
        }
        catch
        {
            ErrorMessage = "ارتباط با سرور هنگام ثبت‌نام برقرار نشد.";
        }
        finally
        {
            SubmittingCourseId = null;
        }
    }

    private string GetDeliveryTypeText(string? value)
    {
        return value switch
        {
            "Online" => "آنلاین",
            "InPerson" => "حضوری",
            "Hybrid" => "ترکیبی",
            _ => "نامشخص"
        };
    }

    private class PublicCourseDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal Price { get; set; }
        public string DeliveryType { get; set; } = "Online";
        public string? InstructorName { get; set; }
        public int ModuleCount { get; set; }
        public int LessonCount { get; set; }
    }

    private class EnrollmentDto
    {
        public int Id { get; set; }
        public int CourseId { get; set; }
        public string Status { get; set; } = string.Empty;
    }

    private class ApiError
    {
        public string? Message { get; set; }
    }
}

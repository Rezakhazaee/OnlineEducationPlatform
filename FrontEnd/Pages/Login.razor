@page "/login"
@using FrontEnd.Services
@using Microsoft.AspNetCore.WebUtilities
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>ورود | آموزش‌یار</PageTitle>

<div class="login-page">

    <div class="login-card">

        <div class="login-brand">

            <div class="login-brand-mark">
                آ
            </div>

            <div>
                <strong>آموزش‌یار</strong>
                <span>سامانه آموزش آنلاین</span>
            </div>

        </div>


        <div class="login-header">

            <span>خوش آمدید</span>

            <h1>
                ورود به حساب کاربری
            </h1>

            <p>
                برای ادامه، نام کاربری و رمز عبور خود را وارد کنید.
            </p>

        </div>


        <form class="login-form" @onsubmit="HandleLogin" @onsubmit:preventDefault="true">

            <div class="form-group">

                <label>
                    نام کاربری
                </label>

                <input
                    type="text"
                    @bind="Username" @bind:event="oninput"
                    placeholder="نام کاربری خود را وارد کنید"
                    disabled="@IsLoading" />

            </div>


            <div class="form-group">

                <label>
                    رمز عبور
                </label>

                <div class="login-password-field">
                    <input
                        type="@(ShowPassword ? "text" : "password")"
                        @bind="Password" @bind:event="oninput"
                        placeholder="رمز عبور خود را وارد کنید"
                        autocomplete="current-password"
                        disabled="@IsLoading" />
                    <button type="button" class="password-toggle"
                            @onclick="TogglePasswordVisibility"
                            aria-label="@(ShowPassword ? "مخفی کردن رمز عبور" : "نمایش رمز عبور")"
                            aria-pressed="@ShowPassword"
                            disabled="@IsLoading">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
                    </button>
                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="login-error">
                    @ErrorMessage
                </div>
            }


            <button
                class="login-submit"
                type="submit"
                disabled="@IsLoading">

                @if (IsLoading)
                {
                    <span>در حال ورود...</span>
                }
                else
                {
                    <span>ورود به سامانه</span>
                    <span>←</span>
                }

            </button>

        </form>


        <div class="login-footer">

            <span>
                حساب کاربری ندارید؟
            </span>

            <a href="/register">
                ثبت‌نام کنید
            </a>

        </div>


        <a href="/" class="back-home">
            ← بازگشت به صفحه اصلی
        </a>

    </div>

</div>


@code {

    private string Username { get; set; } = string.Empty;

    private string Password { get; set; } = string.Empty;

    private string? ErrorMessage { get; set; }

    private bool IsLoading { get; set; }

    private bool ShowPassword { get; set; }

    private void TogglePasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }


    private string GetReturnUrl()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            Navigation.ToAbsoluteUri(Navigation.Uri).Query);

        if (query.TryGetValue("returnUrl", out var value))
        {
            var url = value.ToString();
            if (url.StartsWith("/") && !url.StartsWith("//"))
                return url;
        }

        return "/student";
    }


    private async Task HandleLogin()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(Username) ||
            string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage =
                "لطفاً نام کاربری و رمز عبور را وارد کنید.";

            return;
        }

        IsLoading = true;

        try
        {
            var result = await Auth.Login(
                Username,
                Password
            );

            if (!result.Success)
            {
                ErrorMessage = result.Message;
                return;
            }


            // اگر مدیر است → پنل مدیریت
            if (Auth.IsAdmin)
            {
                Navigation.NavigateTo("/admin");
                return;
            }

            if (Auth.IsStudent)
            {
                Navigation.NavigateTo(GetReturnUrl());
                return;
            }

            if (Auth.Role == "Instructor")
            {
                Navigation.NavigateTo("/instructor");
                return;
            }

        if (Auth.Role == "Marketer")
        {
            Navigation.NavigateTo("/marketer");
            return;
        }

        if (Auth.Role == "Support")
        {
            Navigation.NavigateTo("/support");
            return;
        }


        if (Auth.Role == "EducationStaff")
        {
            Navigation.NavigateTo("/education");
            return;
        }

            Navigation.NavigateTo("/");
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
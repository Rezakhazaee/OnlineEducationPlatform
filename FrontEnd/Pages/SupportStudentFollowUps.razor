@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<section class="education-card" style="margin-top:24px;">

    <div class="education-card-header">
        <div>
            <h2>پیگیری‌های دانشجو</h2>
            <span>@FollowUps.Count پیگیری</span>
        </div>
    </div>

    <div class="education-form-grid">

        <div class="education-form-group">
            <label>تاریخ پیگیری</label>
            <input type="date" @bind="FollowUpDate" />
        </div>

        <div class="education-form-group">
            <label>وضعیت</label>
            <select @bind="NewStatus">
                <option value="Pending">در انتظار</option>
                <option value="InProgress">در حال پیگیری</option>
                <option value="Completed">تکمیل‌شده</option>
                <option value="Cancelled">لغوشده</option>
            </select>
        </div>

        <div class="education-form-group education-form-group-full">
            <label>توضیحات پیگیری</label>
            <textarea rows="4" @bind="NewDescription"></textarea>
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="education-alert error">
            @ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="education-alert success">
            @SuccessMessage
        </div>
    }

    <div class="education-form-actions">
        <button class="education-btn primary"
                @onclick="CreateFollowUp"
                disabled="@Saving">
            @(Saving ? "در حال ثبت..." : "ثبت پیگیری")
        </button>
    </div>

    <div style="margin-top:24px;">

    @if (EditingFollowUpId.HasValue)
    {
        <div class="education-card" style="margin-bottom:24px;">
            <h3>ویرایش پیگیری</h3>

            <div class="education-form-grid">
                <div class="education-form-group">
                    <label>تاریخ پیگیری</label>
                    <input type="date" @bind="EditFollowUpDate" />
                </div>

                <div class="education-form-group">
                    <label>وضعیت</label>
                    <select @bind="EditStatus">
                        <option value="Pending">در انتظار</option>
                        <option value="InProgress">در حال پیگیری</option>
                        <option value="Completed">تکمیل‌شده</option>
                        <option value="Cancelled">لغوشده</option>
                    </select>
                </div>

                <div class="education-form-group education-form-group-full">
                    <label>توضیحات</label>
                    <textarea rows="4" @bind="EditDescription"></textarea>
                </div>
            </div>

            <div class="education-form-actions">
                <button class="education-btn secondary" @onclick="CancelEdit">انصراف</button>
                <button class="education-btn primary" @onclick="UpdateFollowUp" disabled="@Saving">
                    @(Saving ? "در حال ذخیره..." : "ذخیره ویرایش")
                </button>
            </div>
        </div>
    }

        @if (Loading)
        {
            <div class="education-empty">
                در حال دریافت پیگیری‌ها...
            </div>
        }
        else if (FollowUps.Count == 0)
        {
            <div class="education-empty">
                هنوز پیگیری‌ای برای این دانشجو ثبت نشده است.
            </div>
        }
        else
        {
            <div class="education-table-wrapper">
                <table class="education-table">
                    <thead>
                        <tr>
                            <th>تاریخ</th>
                            <th>وضعیت</th>
                            <th>توضیحات</th>
                            <th>ثبت‌شده در</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in FollowUps)
                        {
                            <tr>
                                <td>@item.FollowUpDate.ToString("yyyy/MM/dd")</td>
                                <td>@GetStatusText(item.Status)</td>
                                <td>@item.Description</td>
                                <td>@item.CreatedDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    <button class="education-btn secondary" @onclick="() => BeginEdit(item)">ویرایش</button>
                                    <button class="education-btn primary" @onclick="() => DeleteFollowUp(item.Id)">حذف</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</section>

@code {
    [Parameter]
    public int StudentId { get; set; }

    private List<FollowUpDto> FollowUps { get; set; } = new();

    private bool Loading { get; set; } = true;
    private bool Saving { get; set; }

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    private DateTime FollowUpDate { get; set; } = DateTime.Today;
    private string NewStatus { get; set; } = "Pending";
    private int? EditingFollowUpId { get; set; }
    private DateTime EditFollowUpDate { get; set; }
    private string EditStatus { get; set; } = "Pending";
    private string? EditDescription { get; set; }

    private string? NewDescription { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await LoadFollowUps();
    }

    private async Task LoadFollowUps()
    {
        Loading = true;
        ErrorMessage = null;

        try
        {
            await Auth.RestoreAsync();

            if (!Auth.IsLoggedIn || Auth.Role != "Support")
            {
                ErrorMessage = "دسترسی غیرمجاز.";
                return;
            }

            var client = Auth.CreateAuthenticatedClient();

            FollowUps =
                await client.GetFromJsonAsync<List<FollowUpDto>>(
                    "api/StudentFollowUps/support/my")
                ?? new();

            FollowUps = FollowUps
                .Where(x => x.StudentId == StudentId)
                .OrderByDescending(x => x.FollowUpDate)
                .ThenByDescending(x => x.CreatedDate)
                .ToList();
        }
        catch
        {
            ErrorMessage = "دریافت پیگیری‌ها با خطا مواجه شد.";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task CreateFollowUp()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        Saving = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response = await client.PostAsJsonAsync(
                "api/StudentFollowUps",
                new
                {
                    studentId = StudentId,
                    followUpDate = FollowUpDate,
                    status = NewStatus,
                    description = NewDescription
                });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            NewDescription = null;
            NewStatus = "Pending";
            FollowUpDate = DateTime.Today;
            SuccessMessage = "پیگیری با موفقیت ثبت شد.";

            await LoadFollowUps();
        }
        catch
        {
            ErrorMessage = "ثبت پیگیری با خطا مواجه شد.";
        }
        finally
        {
            Saving = false;
        }
    }

    private void BeginEdit(FollowUpDto item)
    {
        EditingFollowUpId = item.Id;
        EditFollowUpDate = item.FollowUpDate;
        EditStatus = item.Status;
        EditDescription = item.Description;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private void CancelEdit()
    {
        EditingFollowUpId = null;
        EditDescription = null;
        EditStatus = "Pending";
        EditFollowUpDate = DateTime.Today;
    }

    private async Task UpdateFollowUp()
    {
        if (!EditingFollowUpId.HasValue)
            return;

        Saving = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response = await client.PutAsJsonAsync(
                $"api/StudentFollowUps/{EditingFollowUpId.Value}",
                new
                {
                    followUpDate = EditFollowUpDate,
                    status = EditStatus,
                    description = EditDescription
                });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            EditingFollowUpId = null;
            SuccessMessage = "پیگیری با موفقیت ویرایش شد.";
            await LoadFollowUps();
        }
        catch
        {
            ErrorMessage = "ویرایش پیگیری با خطا مواجه شد.";
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task DeleteFollowUp(int id)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();
            var response = await client.DeleteAsync($"api/StudentFollowUps/{id}");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            if (EditingFollowUpId == id)
                EditingFollowUpId = null;

            SuccessMessage = "پیگیری با موفقیت حذف شد.";
            await LoadFollowUps();
        }
        catch
        {
            ErrorMessage = "حذف پیگیری با خطا مواجه شد.";
        }
    }


    private string GetStatusText(string? status)
    {
        return status switch
        {
            "Pending" => "در انتظار",
            "InProgress" => "در حال پیگیری",
            "Completed" => "تکمیل‌شده",
            "Cancelled" => "لغوشده",
            _ => status ?? "نامشخص"
        };
    }

    private class FollowUpDto
    {
        public int Id { get; set; }
        public int StudentId { get; set; }
        public string StudentName { get; set; } = "";
        public int? SupportUserId { get; set; }
        public DateTime FollowUpDate { get; set; }
        public string Status { get; set; } = "";
        public string? Description { get; set; }
        public DateTime CreatedDate { get; set; }
    }
}

@page "/admin/partner-organizations"

@using System.Net.Http.Json
@using System.Net
@using FrontEnd.Services

@inject IHttpClientFactory HttpClientFactory
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>سازمان‌های طرف قرارداد | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-sidebar-header">
            <div class="admin-logo">آ</div>
            <div>
                <strong>آموزش‌یار</strong>
                <span>پنل مدیریت</span>
            </div>
        </div>

        <nav class="admin-nav">

            <NavLink href="/admin" Match="NavLinkMatch.All">
                <span>داشبورد</span>
            </NavLink>

            <NavLink href="/admin/users">
                <span>کاربران</span>
            </NavLink>

            <NavLink href="/admin/students">
                <span>دانشجویان</span>
            </NavLink>

            <NavLink href="/admin/courses">
                <span>دوره‌ها</span>
            </NavLink>

            <NavLink href="/admin/enrollments">
                <span>ثبت‌نام‌ها</span>
            </NavLink>

            <NavLink href="/admin/payments">
                <span>پرداخت‌ها</span>
            </NavLink>

            <NavLink href="/admin/partner-organizations">
                <span>سازمان‌های طرف قرارداد</span>
            </NavLink>

            <NavLink href="/admin/organizations">
                <span>تنظیمات سامانه</span>
            </NavLink>

            <NavLink href="/admin/reports">
                <span>گزارش‌ها</span>
            </NavLink>

        </nav>

    </aside>

    <main class="admin-main">

        <div class="admin-topbar">

            <div>
                <h1>سازمان‌های طرف قرارداد</h1>
                <p>
                    مدیریت سازمان‌هایی که برای ارائه دوره‌ها با آن‌ها قرارداد دارید.
                </p>
            </div>

            <button class="admin-primary-btn" @onclick="OpenCreateForm">
                + سازمان جدید
            </button>

        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-alert admin-alert-error">
                @ErrorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="admin-alert admin-alert-success">
                @SuccessMessage
            </div>
        }

        @if (IsLoading)
        {
            <div class="admin-empty-state">
                <p>در حال دریافت اطلاعات...</p>
            </div>
        }
        else if (ShowForm)
        {
            <section class="admin-form-card">

                <div class="admin-form-header">
                    <div>
                        <h2>@(EditingId.HasValue ? "ویرایش سازمان" : "ثبت سازمان طرف قرارداد")</h2>
                        <p>اطلاعات سازمان و قرارداد را وارد کنید.</p>
                    </div>
                </div>

                <div class="admin-form-grid">

                    <div class="admin-form-group">
                        <label>نام سازمان *</label>
                        <input class="admin-input"
                               @bind="Form.Name"
                               placeholder="مثلاً سازمان فنی و حرفه‌ای" />
                    </div>

                    <div class="admin-form-group">
                        <label>فرد رابط</label>
                        <input class="admin-input"
                               @bind="Form.ContactPerson"
                               placeholder="نام و نام خانوادگی" />
                    </div>

                    <div class="admin-form-group">
                        <label>موبایل فرد رابط</label>
                        <input class="admin-input"
                               @bind="Form.ContactMobile"
                               placeholder="مثلاً 09121234567" />
                    </div>

                    <div class="admin-form-group">
                        <label>شماره قرارداد</label>
                        <input class="admin-input"
                               @bind="Form.ContractNumber"
                               placeholder="شماره قرارداد" />
                    </div>

                    <div class="admin-form-group">
                        <label>تاریخ شروع قرارداد</label>
                        <input class="admin-input"
                               type="date"
                               @bind="Form.ContractStartDate" />
                    </div>

                    <div class="admin-form-group">
                        <label>تاریخ پایان قرارداد</label>
                        <input class="admin-input"
                               type="date"
                               @bind="Form.ContractEndDate" />
                    </div>

                    <div class="admin-form-group admin-form-full">
                        <label>توضیحات</label>
                        <textarea class="admin-input admin-textarea"
                                  @bind="Form.Description"
                                  placeholder="توضیحات مربوط به سازمان یا قرارداد"></textarea>
                    </div>

                    <div class="admin-form-group admin-form-full">

                        <label class="admin-checkbox-row">
                            <input type="checkbox" @bind="Form.IsActive" />
                            <span>قرارداد فعال است</span>
                        </label>

                    </div>

                </div>

                <div class="admin-form-actions">

                    <button class="admin-primary-btn"
                            @onclick="SaveOrganization"
                            disabled="@IsSaving">
                        @(IsSaving ? "در حال ذخیره..." : "ذخیره")
                    </button>

                    <button class="admin-secondary-btn"
                            @onclick="CancelForm"
                            disabled="@IsSaving">
                        انصراف
                    </button>

                </div>

            </section>
        }

        @if (CreatingAccountForId.HasValue)
        {
            <section class='partner-account-create'>
                <div class='partner-account-heading'><span class='partner-account-mark'>✦</span><div><h2>ایجاد حساب اختصاصی سازمان</h2><p>دسترسی امن و اختصاصی برای مشاهده گزارش‌های سازمان</p></div></div>
                <div class='partner-account-org'>سازمان انتخاب‌شده: <strong>@CreatingAccountName</strong></div>
                <div class='partner-account-grid'>
                    <div><label>نام و نام خانوادگی مسئول حساب *</label><input class='partner-account-input' @bind='AccountForm.FullName' placeholder='نام مسئول گزارش‌گیری' /></div>
                    <div><label>شماره موبایل *</label><input class='partner-account-input' @bind='AccountForm.Mobile' placeholder='09xxxxxxxxx' /></div>
                    <div><label>نام کاربری *</label><input class='partner-account-input' @bind='AccountForm.Username' placeholder='نام کاربری ورود' /></div>
                    <div><label>رمز عبور *</label><input class='partner-account-input' type='password' @bind='AccountForm.Password' placeholder='حداقل ۸ کاراکتر' /></div>
                </div>
                <div class='partner-account-note'>این حساب فقط به گزارش‌های همین سازمان دسترسی دارد و امکان ویرایش اطلاعات یا ثبت‌نام ندارد.</div>
                <div class='partner-account-actions'><button class='partner-account-submit' @onclick='CreatePartnerAccount' disabled='@IsCreatingAccount'>ایجاد حساب امن</button><button class='admin-secondary-btn' @onclick='CancelAccountForm' disabled='@IsCreatingAccount'>انصراف</button></div>
            </section>
        }
        <section class="admin-table-card">

            <div class="admin-table-header">

                <div>
                    <h2>فهرست سازمان‌ها</h2>
                    <span class="admin-count">
                        تعداد: @Organizations.Count
                    </span>
                </div>

            </div>

            @if (!IsLoading && Organizations.Count == 0)
            {
                <div class="admin-empty-state">
                    <div class="admin-empty-icon">🏢</div>
                    <h3>هنوز سازمانی ثبت نشده است</h3>
                    <p>
                        اولین سازمان طرف قرارداد را ثبت کنید.
                    </p>

                    <button class="admin-primary-btn"
                            @onclick="OpenCreateForm">
                        + ثبت سازمان
                    </button>
                </div>
            }
            else if (Organizations.Count > 0)
            {
                <div class="admin-table-wrapper">

                    <table class="admin-table">

                        <thead>
                            <tr>
                                <th>سازمان</th>
                                <th>فرد رابط</th>
                                <th>قرارداد</th>
                                <th>بازه قرارداد</th>
                                <th>وضعیت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var organization in Organizations)
                            {
                                <tr>

                                    <td>
                                        <div class="partner-org-name">
                                            <strong>@organization.Name</strong>

                                            @if (!string.IsNullOrWhiteSpace(organization.Description))
                                            {
                                                <small>@organization.Description</small>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(organization.ContactPerson))
                                            {
                                                <strong>@organization.ContactPerson</strong>
                                            }
                                            else
                                            {
                                                <span class="admin-muted">—</span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(organization.ContactMobile))
                                            {
                                                <small class="partner-org-mobile">
                                                    @organization.ContactMobile
                                                </small>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(organization.ContractNumber))
                                        {
                                            <span>@organization.ContractNumber</span>
                                        }
                                        else
                                        {
                                            <span class="admin-muted">بدون شماره</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="partner-org-dates">

                                            <span>
                                                شروع:
                                                @(organization.ContractStartDate?.ToString("yyyy/MM/dd") ?? "—")
                                            </span>

                                            <span>
                                                پایان:
                                                @(organization.ContractEndDate?.ToString("yyyy/MM/dd") ?? "—")
                                            </span>

                                        </div>
                                    </td>

                                    <td>
                                        @if (organization.IsActive)
                                        {
                                            <span class="admin-status active">
                                                فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-status inactive">
                                                غیرفعال
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        <div class="admin-row-actions">

                                            <button class="admin-action-btn"
                                                    @onclick="() => EditOrganization(organization)">
                                                ویرایش
                                            </button>

                                            @if (organization.IsActive && !organization.HasAccount)
                                            {
                                                <button class='partner-account-btn' @onclick='() => OpenAccountForm(organization)'>ساخت حساب گزارش‌گیری</button>
                                            }
                                            <button class="admin-action-btn danger"
                                                    @onclick="() => DeleteOrganization(organization)">
                                                حذف
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </section>

    </main>

</div>

<style>
.partner-account-create{position:relative;overflow:hidden;margin:0 0 24px;padding:28px;border:1px solid rgba(107,190,211,.38);border-radius:24px;background:radial-gradient(circle at 8% 0%,rgba(125,220,231,.23),transparent 35%),linear-gradient(135deg,#102b3b 0%,#1d5265 52%,#18394b 100%);box-shadow:0 18px 45px rgba(16,43,59,.20);color:#f4fbff}
.partner-account-heading{display:flex;align-items:center;gap:16px}.partner-account-heading h2{margin:0 0 7px;color:#fff;font-size:21px}.partner-account-heading p{margin:0;color:#c4e3eb}.partner-account-mark{display:grid;place-items:center;width:52px;height:52px;border:1px solid rgba(255,255,255,.4);border-radius:16px;background:linear-gradient(145deg,#d9f7f5,#7ac8d5);color:#164052;font-size:27px;box-shadow:inset 0 1px 2px #fff,0 8px 20px #071e2b66}
.partner-account-org{margin:22px 0;padding:12px 16px;border:1px solid #ffffff30;border-radius:12px;background:#ffffff12;color:#d9edf2}.partner-account-org strong{color:#fff}
.partner-account-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.partner-account-grid label{display:block;margin-bottom:8px;color:#d8edf2;font-size:13px}.partner-account-input{box-sizing:border-box;width:100%;padding:12px 14px;border:1px solid #a9d7df77;border-radius:11px;outline:none;background:#f5fbfc;color:#173747}.partner-account-input:focus{border-color:#8ee4e2;box-shadow:0 0 0 3px #8ee4e233}.partner-account-note{margin-top:18px;padding:12px 14px;border-right:3px solid #8edbd7;border-radius:8px;background:#ffffff12;color:#d6edf0;font-size:13px}.partner-account-actions{display:flex;gap:12px;margin-top:22px}.partner-account-submit,.partner-account-btn{border:0;border-radius:10px;padding:11px 18px;background:linear-gradient(135deg,#c9f3ec,#78c9cb);color:#153c4b;font-weight:700;cursor:pointer;box-shadow:0 7px 18px #061d2a40}.partner-account-submit:disabled{opacity:.6;cursor:not-allowed}.partner-account-btn{padding:8px 12px;font-size:12px}.partner-account-btn:hover,.partner-account-submit:hover{filter:brightness(1.06)}@@media(max-width:700px){.partner-account-create{padding:19px}.partner-account-grid{grid-template-columns:1fr}.partner-account-actions{flex-wrap:wrap}}
</style>
@code {

    private HttpClient Client => Auth.CreateAuthenticatedClient();

    private List<PartnerOrganizationDto> Organizations = new();

    private PartnerOrganizationForm Form = new();

    private bool IsLoading = true;
    private bool IsSaving = false;
    private bool ShowForm = false;

    private int? CreatingAccountForId;
    private bool IsCreatingAccount;
    private PartnerAccountForm AccountForm = new();
    private string CreatingAccountName => Organizations.FirstOrDefault(x => x.Id == CreatingAccountForId)?.Name ?? string.Empty;
    private int? EditingId;

    private string? ErrorMessage;
    private string? SuccessMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizations();
    }

    private async Task LoadOrganizations()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var response = await Client.GetAsync("api/PartnerOrganizations");

            if (response.StatusCode == HttpStatusCode.Unauthorized ||
                response.StatusCode == HttpStatusCode.Forbidden)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "دریافت فهرست سازمان‌ها با خطا مواجه شد.";
                return;
            }

            var result =
                await response.Content.ReadFromJsonAsync<List<PartnerOrganizationDto>>();

            Organizations = result ?? new List<PartnerOrganizationDto>();
        }
        catch
        {
            ErrorMessage = "\u062e\u0637\u0627 \u062f\u0631 \u062f\u0631\u06cc\u0627\u0641\u062a \u0641\u0647\u0631\u0633\u062a \u0633\u0627\u0632\u0645\u0627\u0646\u200c\u0647\u0627.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenCreateForm()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        EditingId = null;

        Form = new PartnerOrganizationForm
        {
            IsActive = true
        };

        ShowForm = true;
    }

    private void EditOrganization(PartnerOrganizationDto organization)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        EditingId = organization.Id;

        Form = new PartnerOrganizationForm
        {
            Name = organization.Name,
            ContactPerson = organization.ContactPerson,
            ContactMobile = organization.ContactMobile,
            ContractNumber = organization.ContractNumber,
            ContractStartDate = organization.ContractStartDate,
            ContractEndDate = organization.ContractEndDate,
            IsActive = organization.IsActive,
            Description = organization.Description
        };

        ShowForm = true;
    }

    private void CancelForm()
    {
        ShowForm = false;
        EditingId = null;
        Form = new PartnerOrganizationForm();
    }

    private async Task SaveOrganization()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (string.IsNullOrWhiteSpace(Form.Name))
        {
            ErrorMessage = "نام سازمان را وارد کنید.";
            return;
        }

        if (Form.ContractStartDate.HasValue &&
            Form.ContractEndDate.HasValue &&
            Form.ContractEndDate < Form.ContractStartDate)
        {
            ErrorMessage = "تاریخ پایان قرارداد نمی‌تواند قبل از تاریخ شروع باشد.";
            return;
        }

        IsSaving = true;

        try
        {
            HttpResponseMessage response;

            if (EditingId.HasValue)
            {
                response = await Client.PutAsJsonAsync(
                    $"api/PartnerOrganizations/{EditingId.Value}",
                    Form);
            }
            else
            {
                response = await Client.PostAsJsonAsync(
                    "api/PartnerOrganizations",
                    Form);
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized ||
                response.StatusCode == HttpStatusCode.Forbidden)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();

                ErrorMessage = string.IsNullOrWhiteSpace(message)
                    ? "ذخیره اطلاعات با خطا مواجه شد."
                    : message;

                return;
            }

            SuccessMessage = EditingId.HasValue
                ? "اطلاعات سازمان با موفقیت ویرایش شد."
                : "سازمان با موفقیت ثبت شد.";

            ShowForm = false;
            EditingId = null;

            await LoadOrganizations();
        }
        catch
        {
            ErrorMessage = "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task DeleteOrganization(PartnerOrganizationDto organization)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var response = await Client.DeleteAsync(
                $"api/PartnerOrganizations/{organization.Id}");

            if (response.StatusCode == HttpStatusCode.Unauthorized ||
                response.StatusCode == HttpStatusCode.Forbidden)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "حذف سازمان انجام نشد.";
                return;
            }

            SuccessMessage = "سازمان با موفقیت حذف شد.";

            await LoadOrganizations();
        }
        catch
        {
            ErrorMessage = "ارتباط با سرور برقرار نشد.";
        }
    }

    private void OpenAccountForm(PartnerOrganizationDto organization)
    {
        ErrorMessage = null;
        SuccessMessage = null;
        CreatingAccountForId = organization.Id;
        AccountForm = new PartnerAccountForm();
    }

    private void CancelAccountForm()
    {
        CreatingAccountForId = null;
        AccountForm = new PartnerAccountForm();
    }

    private async Task CreatePartnerAccount()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (!CreatingAccountForId.HasValue ||
            string.IsNullOrWhiteSpace(AccountForm.FullName) ||
            string.IsNullOrWhiteSpace(AccountForm.Mobile) ||
            string.IsNullOrWhiteSpace(AccountForm.Username) ||
            string.IsNullOrWhiteSpace(AccountForm.Password))
        {
            ErrorMessage = "همه فیلدهای حساب را تکمیل کنید.";
            return;
        }

        if (AccountForm.Password.Length < 8)
        {
            ErrorMessage = "رمز عبور باید حداقل ۸ کاراکتر باشد.";
            return;
        }

        IsCreatingAccount = true;
        try
        {
            var response = await Client.PostAsJsonAsync(
                $"api/PartnerOrganizations/{CreatingAccountForId.Value}/account",
                AccountForm);

            if (response.StatusCode == HttpStatusCode.Unauthorized ||
                response.StatusCode == HttpStatusCode.Forbidden)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                ErrorMessage = string.IsNullOrWhiteSpace(message)
                    ? "ایجاد حساب با خطا مواجه شد."
                    : message;
                return;
            }

            CreatingAccountForId = null;
            AccountForm = new PartnerAccountForm();
            SuccessMessage = "حساب گزارش‌گیری سازمان با موفقیت ایجاد شد.";
            await LoadOrganizations();
        }
        catch
        {
            ErrorMessage = "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsCreatingAccount = false;
        }
    }

    private class PartnerAccountForm
    {
        public string FullName { get; set; } = string.Empty;
        public string Mobile { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
    private class PartnerOrganizationDto
    {
        public int Id { get; set; }

        public string Name { get; set; } = string.Empty;

        public string? ContactPerson { get; set; }

        public string? ContactMobile { get; set; }

        public string? ContractNumber { get; set; }

        public DateTime? ContractStartDate { get; set; }

        public DateTime? ContractEndDate { get; set; }

        public bool IsActive { get; set; }

        public string? Description { get; set; }

        public DateTime CreatedDate { get; set; }
        public bool HasAccount { get; set; }
        public string? AccountUsername { get; set; }
        public bool? AccountIsActive { get; set; }
    }

    private class PartnerOrganizationForm
    {
        public string Name { get; set; } = string.Empty;

        public string? ContactPerson { get; set; }

        public string? ContactMobile { get; set; }

        public string? ContractNumber { get; set; }

        public DateTime? ContractStartDate { get; set; }

        public DateTime? ContractEndDate { get; set; }

        public bool IsActive { get; set; } = true;

        public string? Description { get; set; }
    }
}

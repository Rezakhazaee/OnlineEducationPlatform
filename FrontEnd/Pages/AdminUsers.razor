private async Task UpdateUserPassword()
{
    PasswordMessage = null;

    if (string.IsNullOrWhiteSpace(ChangePassword.NewPassword) || ChangePassword.NewPassword.Length < 6)
    {
        PasswordMessage = "رمز عبور باید حداقل ۶ کاراکتر باشد.";
        return;
    }

    try
    {
        var client = Auth.CreateAuthenticatedClient();
        var response = await client.PutAsJsonAsync($"api/Users/{EditingUserId}/password", ChangePassword);

        if (response.IsSuccessStatusCode)
        {
            ChangePassword.NewPassword = string.Empty;
            PasswordMessage = "رمز عبور با موفقیت تغییر کرد.";
        }
        else
        {
            PasswordMessage = "تغییر رمز عبور انجام نشد. " + await response.Content.ReadAsStringAsync();
        }
    }
    catch
    {
        PasswordMessage = "ارتباط با سرور برقرار نشد.";
    }
}

private async Task LoadStudentEditorData()
{
    IsLoadingStudentProfile = true;
    StudentProfileMessage = null;

    try
    {
        var client = Auth.CreateAuthenticatedClient();
        var students = await client.GetFromJsonAsync<List<StudentProfileModel>>("api/Students");
        StudentProfile = students?.FirstOrDefault(s => s.UserId == EditingUserId);

        if (StudentProfile is null)
        {
            StudentProfileMessage = "برای این حساب، پرونده دانشجویی پیدا نشد.";
            return;
        }

        var assignments = await client.GetFromJsonAsync<AssignmentUsersResponse>("api/Students/assignment-users");
        Marketers = assignments?.Marketers ?? new();
        Supports = assignments?.Supports ?? new();

        PartnerOrganizations =
            await client.GetFromJsonAsync<List<PartnerOrganizationModel>>("api/Students/active-partner-organizations")
            ?? new();
    }
    catch
    {
        StudentProfileMessage = "دریافت اطلاعات پرونده دانشجو انجام نشد.";
    }
    finally
    {
        IsLoadingStudentProfile = false;
    }
}

private async Task UpdateStudentProfile()
{
    StudentProfileMessage = null;
    StudentProfileSaved = false;

    if (StudentProfile is null)
        return;

    if (string.IsNullOrWhiteSpace(StudentProfile.FirstName) ||
        string.IsNullOrWhiteSpace(StudentProfile.LastName) ||
        string.IsNullOrWhiteSpace(StudentProfile.Mobile))
    {
        StudentProfileMessage = "نام، نام خانوادگی و موبایل دانشجو الزامی است.";
        return;
    }

    try
    {
        var client = Auth.CreateAuthenticatedClient();
        var request = new
        {
            StudentProfile.FirstName,
            StudentProfile.LastName,
            StudentProfile.NationalCode,
            StudentProfile.BirthDate,
            StudentProfile.Mobile,
            StudentProfile.Address,
            StudentProfile.GuardianName,
            StudentProfile.GuardianMobile,
            StudentProfile.PartnerOrganizationId,
            StudentProfile.MarketingUserId,
            StudentProfile.SupportUserId
        };

        var response = await client.PutAsJsonAsync(
            $"api/Students/{StudentProfile.Id}", request);

        if (response.IsSuccessStatusCode)
        {
            StudentProfileSaved = true;
            StudentProfileMessage = "پرونده دانشجو با موفقیت ذخیره شد.";
            await LoadUsers();
            EditingUser = Users.FirstOrDefault(u => u.Id == EditingUserId);
        }
        else
        {
            StudentProfileMessage = "ذخیره پرونده انجام نشد: " +
                await response.Content.ReadAsStringAsync();
        }
    }
    catch
    {
        StudentProfileMessage = "ارتباط با سرور برقرار نشد.";
    }
}


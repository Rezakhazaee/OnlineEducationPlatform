@page "/admin/users"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>مدیریت کاربران | آموزش‌یار</PageTitle>

<div class="admin-page admin-users-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

    <a href="/admin">
        <span>⌂</span>
        داشبورد
    </a>

    <a href="/admin/courses">
        <span>▣</span>
        دوره‌ها
    </a>

    <a href="/admin/users" class="active">
        <span>♙</span>
        کاربران
    </a>

    <a href="/admin/students">
        <span>♧</span>
        دانشجویان
    </a>

    <a href="/admin/enrollments">
        <span>✓</span>
        ثبت‌نام‌ها
    </a>

    <a href="/admin/payments">
        <span>₿</span>
        پرداخت‌ها
    </a>

    <a href="/admin/partner-organizations">
        <span>♧</span>
        سازمان‌های طرف قرارداد
    </a>

    <a href="/admin/organizations">
        <span>◈</span>
        تنظیمات سامانه
    </a>

    <a href="/admin/reports">
        <span>▤</span>
        گزارش‌ها
    </a>

    <a href="/admin/audit-logs">
        <span>◉</span>
        گزارش ممیزی
    </a>

</nav>

        <div class="admin-sidebar-bottom">
            <a href="/">
                ← بازگشت به سایت
            </a>
        </div>

    </aside>


    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    مدیریت سامانه
                </span>

                <h1>
                    کاربران
                </h1>
            </div>

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "مدیر سیستم")
                    </strong>

                    <small>
                        Administrator
                    </small>
                </div>

            </div>

        </header>
         
         @if (ShowCreateUserForm)
            {
                <section class="admin-content-card">

                    <div class="admin-card-header">
                        <div>
                            <span>کاربر جدید</span>
                            <h2>@(RoleFilter == "Student" ? "افزودن دانشجو" : "افزودن کاربر")</h2>
                        </div>

                        <button
                            class="admin-outline-btn"
                            @onclick="CloseCreateUserForm">

                            انصراف

                        </button>
                    </div>

                    <div class="admin-form">

                        <div class="admin-form-group">
                            <label>نام و نام خانوادگی</label>
                            <input
                                class="admin-input"
                                @bind="NewUser.FullName"
                                placeholder="مثلاً علی رضایی" />
                        </div>

                        <div class="admin-form-group">
                            <label>شماره موبایل</label>
                            <input
                                class="admin-input"
                                @bind="NewUser.Mobile"
                                placeholder="مثلاً 09120000001" />
                        </div>

                        <div class="admin-form-group">
                            <label>نام کاربری</label>
                            <input
                                class="admin-input"
                                @bind="NewUser.Username"
                                placeholder="نام کاربری" />
                        </div>

                        <div class="admin-form-group">
                            <label>رمز عبور</label>
                            <input
                                type="password"
                                class="admin-input"
                                @bind="NewUser.Password"
                                placeholder="رمز عبور" />
                        </div>

                        <div class="admin-form-group">
                            <label>نقش</label>

                            <select
                                class="admin-input"
                                @bind="NewUser.Role">

                                <option value="Student">دانشجو</option>
                                <option value="Instructor">مدرس</option>
                                <option value="Support">پشتیبان</option>
                                <option value="Admin">مدیر</option>

                            </select>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(CreateUserMessage))
                        {
                            <div class="admin-error">
                                @CreateUserMessage
                            </div>
                        }

                        <button
                            class="admin-primary-btn"
                            @onclick="CreateUser">

                            ایجاد کاربر

                        </button>

                    </div>

                </section>
            }

            @if (ShowEditUserForm)
            {
                <div class="users-modal-backdrop" @onclick="CloseEditUserForm">
                    <section class="users-edit-modal users-management-modal" role="dialog" aria-modal="true" aria-labelledby="edit-user-title" @onclick:stopPropagation="true">
                        <header class="users-modal-header">
                            <div>
                                <span>مرکز مدیریت حساب</span>
                                <h2 id="edit-user-title">مدیریت کاربر</h2>
                                <p>@EditingUser?.FullName — @EditingUser?.Username</p>
                            </div>
                            <button type="button" class="users-modal-close" aria-label="بستن" @onclick="CloseEditUserForm">×</button>
                        </header>

                        <nav class="users-modal-tabs">
                            <button type="button" class="@(ActiveEditTab == "profile" ? "active" : "")" @onclick='() => ActiveEditTab = "profile"'>اطلاعات حساب</button>
                            <button type="button" class="@(ActiveEditTab == "access" ? "active" : "")" @onclick='() => ActiveEditTab = "access"'>نقش و دسترسی</button>
                            <button type="button" class="@(ActiveEditTab == "security" ? "active" : "")" @onclick='() => ActiveEditTab = "security"'>امنیت حساب</button>
                            @if (EditingUser?.Role == "Student")
                            {
                                <button type="button" class="@(ActiveEditTab == "student" ? "active" : "")" @onclick='() => ActiveEditTab = "student"'>پرونده دانشجو</button>
                            }
                        </nav>

                        <div class="users-modal-body">
                            @if (ActiveEditTab == "profile")
                            {
                                <div class="users-tab-intro">
                                    <strong>اطلاعات هویتی و ورود</strong>
                                    <span>مشخصات عمومی حساب کاربر را ویرایش کنید.</span>
                                </div>
                                <div class="admin-form-group">
                                    <label>نام و نام خانوادگی</label>
                                    <input class="admin-input" @bind="EditUser.FullName" />
                                </div>
                                <div class="admin-form-group">
                                    <label>شماره موبایل</label>
                                    <input class="admin-input" @bind="EditUser.Mobile" />
                                </div>
                                <div class="admin-form-group">
                                    <label>نام کاربری</label>
                                    <input class="admin-input" @bind="EditUser.Username" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(EditUserMessage))
                                {
                                    <div class="admin-error">@EditUserMessage</div>
                                }
                                <button type="button" class="admin-primary-btn users-modal-action" @onclick="UpdateUser">ذخیره اطلاعات حساب</button>
                            }
                            else if (ActiveEditTab == "access")
                            {
                                <div class="users-tab-intro">
                                    <strong>سطح دسترسی کاربر</strong>
                                    <span>نقش تعیین می‌کند کاربر به کدام بخش‌های سامانه دسترسی داشته باشد.</span>
                                </div>
                                <div class="admin-form-group">
                                    <label>نقش کاربر</label>
                                    <select class="admin-input" @bind="ChangeRole.Role">
                                        <option value="Student">دانشجو</option>
                                        <option value="Instructor">مدرس</option>
                                        <option value="Support">پشتیبان</option>
                                        <option value="Marketer">بازاریاب</option>
                                        <option value="EducationStaff">کارشناس آموزش</option>
                                        <option value="Admin">مدیر</option>
                                    </select>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(RoleMessage))
                                {
                                    <div class="@(RoleMessage.StartsWith("نقش با موفقیت") ? "users-success-message" : "admin-error")">@RoleMessage</div>
                                }
                                @if (EditingUserId == 1)
                                {
                                    <div class="users-protected-note">نقش حساب مدیر اصلی قابل تغییر نیست.</div>
                                }
                                else
                                {
                                    <button type="button" class="admin-primary-btn users-modal-action" @onclick="UpdateUserRole">ذخیره نقش جدید</button>
                                }
                            }
                            else if (ActiveEditTab == "student" && EditingUser?.Role == "Student")
                            {
                                <div class="users-tab-intro">
                                    <strong>پرونده و اطلاعات تکمیلی دانشجو</strong>
                                    <span>مشخصات هویتی، اطلاعات سرپرست و مسئولان مرتبط با دانشجو را مدیریت کنید.</span>
                                </div>
                                @if (IsLoadingStudentProfile)
                                {
                                    <div class="admin-loading">در حال دریافت پرونده دانشجو...</div>
                                }
                                else if (StudentProfile is null)
                                {
                                    <div class="admin-error">@StudentProfileMessage</div>
                                }
                                else
                                {
                                    <div class="users-student-fields">
                                        <div class="admin-form-group">
                                            <label>نام</label>
                                            <input class="admin-input" @bind="StudentProfile.FirstName" />
                                        </div>
                                        <div class="admin-form-group">
                                            <label>نام خانوادگی</label>
                                            <input class="admin-input" @bind="StudentProfile.LastName" />
                                        </div>
                                        <div class="admin-form-group">
                                            <label>کد ملی</label>
                                            <input class="admin-input" @bind="StudentProfile.NationalCode" />
                                        </div>
                                        <div class="admin-form-group">
                                            <label>تاریخ تولد</label>
                                            <input type="date" class="admin-input" @bind="StudentProfile.BirthDate" />
                                        </div>
                                        <div class="admin-form-group">
                                            <label>موبایل دانشجو</label>
                                            <input class="admin-input" @bind="StudentProfile.Mobile" />
                                        </div>
                                        <div class="admin-form-group">
                                            <label>نام سرپرست</label>
                                            <input class="admin-input" @bind="StudentProfile.GuardianName" />
                                        </div>
                                        <div class="admin-form-group">
                                            <label>موبایل سرپرست</label>
                                            <input class="admin-input" @bind="StudentProfile.GuardianMobile" />
                                        </div>
                                        <div class="admin-form-group">
                                            <label>نشانی</label>
                                            <textarea class="admin-input" @bind="StudentProfile.Address"></textarea>
                                        </div>
                                        <div class="admin-form-group">
                                            <label>بازاریاب</label>
                                            <select class="admin-input" @bind="StudentProfile.MarketingUserId">
                                                <option value="">بدون انتساب</option>
                                                @foreach (var item in Marketers)
                                                {
                                                    <option value="@item.Id">@item.FullName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="admin-form-group">
                                            <label>پشتیبان</label>
                                            <select class="admin-input" @bind="StudentProfile.SupportUserId">
                                                <option value="">بدون انتساب</option>
                                                @foreach (var item in Supports)
                                                {
                                                    <option value="@item.Id">@item.FullName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="admin-form-group">
                                            <label>سازمان همکار</label>
                                            <select class="admin-input" @bind="StudentProfile.PartnerOrganizationId">
                                                <option value="">بدون انتساب</option>
                                                @foreach (var item in PartnerOrganizations)
                                                {
                                                    <option value="@item.Id">@item.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(StudentProfileMessage))
                                    {
                                        <div class="@(StudentProfileSaved ? "users-success-message" : "admin-error")">@StudentProfileMessage</div>
                                    }
                                    <button type="button" class="admin-primary-btn users-modal-action" @onclick="UpdateStudentProfile">
                                        ذخیره پرونده دانشجو
                                    </button>
                                }
                            }
                            else if (ActiveEditTab == "security")
                            {
                                <div class="users-tab-intro">
                                    <strong>امنیت و رمز عبور</strong>
                                    <span>برای حساب کاربر یک رمز عبور جدید تعیین کنید.</span>
                                </div>
                                <div class="admin-form-group">
                                    <label>رمز عبور جدید</label>
                                    <input type="password" class="admin-input" @bind="ChangePassword.NewPassword" placeholder="حداقل ۶ کاراکتر" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(PasswordMessage))
                                {
                                    <div class="@(PasswordMessage.StartsWith("رمز عبور با موفقیت") ? "users-success-message" : "admin-error")">@PasswordMessage</div>
                                }
                                <button type="button" class="admin-primary-btn users-modal-action" @onclick="UpdateUserPassword">ثبت رمز عبور جدید</button>
                            }

                            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="users-success-message" role="status">@StatusMessage</div>
            }
            <div class="users-account-status">
                                <div>
                                    <strong>وضعیت حساب</strong>
                                    <span>@(EditingUser?.IsActive == true ? "حساب فعال است" : "حساب غیرفعال است")</span>
                                </div>
                                @if (EditingUserId == 1)
                                {
                                    <span class="users-protected-note">مدیر اصلی — محافظت‌شده</span>
                                }
                                else if (EditingUser is not null)
                                {
                                    <button type="button" class="@(EditingUser.IsActive ? "users-danger-btn" : "users-enable-btn")" @onclick="() => ToggleUserStatus(EditingUser)">
                                        @(EditingUser.IsActive ? "غیرفعال‌کردن حساب" : "فعال‌کردن حساب")
                                    </button>
                                }
                            </div>
                        </div>

                        <footer class="users-modal-footer">
                            <button type="button" class="admin-outline-btn" @onclick="CloseEditUserForm">بستن پنجره</button>
                        </footer>
                    </section>
                </div>
            }
        @if (IsLoading)
        {
            <div class="admin-loading">

                <div class="admin-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت کاربران...
                </h3>

                <p>
                    اطلاعات کاربران از سرور دریافت می‌شود.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">

                <strong>
                    خطا در دریافت کاربران
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    class="admin-outline-btn"
                    @onclick="LoadUsers">

                    تلاش مجدد

                </button>

            </div>
        }
        else
        {
            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت کاربران
                        </span>

                        <h2>
                            فهرست کاربران
                        </h2>
                    </div>

                    <div class="users-header-actions">
                        <span class="users-count">@FilteredUsers.Count از @Users.Count کاربر</span>
                        <button type="button" class="admin-outline-btn users-tool-btn" @onclick="LoadUsers" disabled="@IsLoading">↻ تازه‌سازی</button>
                        <button type="button" class="admin-primary-btn users-tool-btn" @onclick="OpenCreateUserForm">@(RoleFilter == "Student" ? "＋ افزودن دانشجو" : "＋ افزودن کاربر")</button>
                    </div>

                </div>

                <div class="users-filter-panel">
                    <div class="users-search-box">
                        <span>⌕</span>
                        <input class="admin-input" @bind="SearchText" @bind:event="oninput" placeholder="جست‌وجو بر اساس نام، نام کاربری یا موبایل..." />
                    </div>

                    <div class="users-filter-control">
                        <label>نقش کاربر</label>
                        <select class="admin-input" @bind="RoleFilter">
                            <option value="All">همه نقش‌ها</option>
                            <option value="Admin">مدیر</option>
                            <option value="EducationStaff">کارشناس آموزش</option>
                            <option value="Marketer">بازاریاب</option>
                            <option value="Support">پشتیبان</option>
                            <option value="Instructor">مدرس</option>
                            <option value="Student">دانشجو</option>
                        </select>
                    </div>

                    <div class="users-filter-control">
                        <label>وضعیت حساب</label>
                        <select class="admin-input" @bind="StatusFilter">
                            <option value="All">همه وضعیت‌ها</option>
                            <option value="Active">فعال</option>
                            <option value="Inactive">غیرفعال</option>
                        </select>
                    </div>

                    <button type="button" class="admin-outline-btn users-clear-btn" @onclick="ResetUserFilters">پاک‌کردن فیلترها</button>
                </div>


                @if (Users.Count == 0)
                {
                    <div class="admin-empty-state">

                        <div>
                            ♙
                        </div>

                        <h3>
                            کاربری پیدا نشد
                        </h3>

                        <p>
                            هنوز کاربری در سیستم ثبت نشده است.
                        </p>

                    </div>
                }
                else if (FilteredUsers.Count == 0)
                {
                    <div class="admin-empty-state users-no-results">
                        <div>⌕</div>
                        <h3>نتیجه‌ای پیدا نشد</h3>
                        <p>عبارت جست‌وجو یا فیلترهای انتخاب‌شده را تغییر دهید.</p>
                    </div>
                }
                else
                {
                    <div class="users-table-wrapper">

                        <table class="users-table">

                            <thead>

                                <tr>

                                    <th>
                                        نام و نام خانوادگی
                                    </th>

                                    <th>
                                        نام کاربری
                                    </th>

                                    <th>
                                        موبایل
                                    </th>

                                    <th>
                                        نقش
                                    </th>

                                    <th>
                                        وضعیت
                                    </th>

                                    <th>
                                        تاریخ ثبت
                                    </th>

                                    <th>
                                      عملیات
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var user in FilteredUsers)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @(user.FullName ?? "-")
                                            </strong>
                                        </td>

                                        <td>
                                            @user.Username
                                        </td>

                                        <td>
                                            @user.Mobile
                                        </td>

                                        <td>

                                            @if (user.Role == "Admin")
                                            {
                                                <span class="user-role admin">
                                                    مدیر
                                                </span>
                                            }
                                            else if (user.Role == "Instructor")
                                            {
                                                <span class="user-role instructor">
                                                    مدرس
                                                </span>
                                            }
                                            else if (user.Role == "Support")
                                            {
                                                <span class="user-role support">
                                                    پشتیبان
                                                </span>
                                            }                                            else if (user.Role == "Marketer")
                                            {
                                                <span class="user-role support">بازاریاب</span>
                                            }
                                            else if (user.Role == "EducationStaff")
                                            {
                                                <span class="user-role instructor">کارشناس آموزش</span>
                                            }
                                            else if (user.Role == "Student")
                                            {
                                                <span class="user-role student">دانشجو</span>
                                            }
                                            else
                                            {
                                                <span class="user-role student">@user.Role</span>
                                            }

                                        </td>

                                        <td>

                                            @if (user.IsActive)
                                            {
                                                <span class="user-status active">
                                                    فعال
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="user-status inactive">
                                                    غیرفعال
                                                </span>
                                            }

                                        </td>

                                        <td>
                                            @user.CreatedAt.ToString("yyyy/MM/dd")
                                        </td>
                                        <td>

                                            @if (user.Id == 1)
                                            {
                                                <span class="user-status active">
                                                    Admin اصلی
                                                </span>
                                            }
                                            else
{
    <div class="admin-user-actions">

        <button
            class="admin-outline-btn"
            @onclick="() => OpenEditUserForm(user)">

            ویرایش

        </button>

        <button
            class="admin-outline-btn"
            @onclick="() => OpenRoleForm(user)">

            تغییر نقش

        </button>

        <button
            class="admin-outline-btn"
            @onclick="() => OpenPasswordForm(user)">

            تغییر رمز

        </button>

        <button
            class="admin-outline-btn"
            @onclick="() => ToggleUserStatus(user)">

            @(user.IsActive ? "غیرفعال کردن" : "فعال کردن")

        </button>

    </div>
}
               

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }

    </main>

</div>


@code {
     
     public class ChangeUserPasswordModel
     {
      public string NewPassword { get; set; } = string.Empty;
     }
     public class ChangeUserRoleModel
      {
       public string Role { get; set; } = "Student";
      }

    private StudentProfileModel? StudentProfile { get; set; }
    private bool IsLoadingStudentProfile { get; set; }
    private bool StudentProfileSaved { get; set; }
    private string? StudentProfileMessage { get; set; }
    private List<AssignmentUserModel> Marketers { get; set; } = new();
    private List<AssignmentUserModel> Supports { get; set; } = new();
    private List<PartnerOrganizationModel> PartnerOrganizations { get; set; } = new();

    public class StudentProfileModel
    {
        public int Id { get; set; }
        public int? UserId { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string NationalCode { get; set; } = "";
        public DateTime? BirthDate { get; set; }
        public string Mobile { get; set; } = "";
        public string? Address { get; set; }
        public string? GuardianName { get; set; }
        public string? GuardianMobile { get; set; }
        public int? MarketingUserId { get; set; }
        public int? SupportUserId { get; set; }
        public int? PartnerOrganizationId { get; set; }
        public string? PartnerOrganizationName { get; set; }
    }

    public class AssignmentUserModel
    {
        public int Id { get; set; }
        public string? FullName { get; set; }
    }

    public class PartnerOrganizationModel
    {
        public int Id { get; set; }
        public string? Name { get; set; }
    }

    public class AssignmentUsersResponse
    {
        public List<AssignmentUserModel> Marketers { get; set; } = new();
        public List<AssignmentUserModel> Supports { get; set; } = new();
    }

    private List<UserDto> Users { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private string SearchText { get; set; } = string.Empty;
    private string RoleFilter { get; set; } = "All";
    private string StatusFilter { get; set; } = "All";

    private List<UserDto> FilteredUsers => Users
        .Where(user =>
            string.IsNullOrWhiteSpace(SearchText) ||
            (user.FullName ?? string.Empty).Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (user.Username ?? string.Empty).Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (user.Mobile ?? string.Empty).Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase))
        .Where(user => RoleFilter == "All" || user.Role == RoleFilter)
        .Where(user =>
            StatusFilter == "All" ||
            (StatusFilter == "Active" && user.IsActive) ||
            (StatusFilter == "Inactive" && !user.IsActive))
        .ToList();

    private void ResetUserFilters()
    {
        SearchText = string.Empty;
        RoleFilter = "All";
        StatusFilter = "All";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }


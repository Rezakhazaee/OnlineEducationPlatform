@page "/admin/reports/enrollments"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>جزئیات ثبت‌نام‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            آموزش‌یار
        </div>

        <nav class="admin-nav">
            <a href="/admin">داشبورد</a>
            <a href="/admin/users">کاربران</a>
            <a href="/admin/courses">دوره‌ها</a>
            <a href="/admin/enrollments">ثبت‌نام‌ها</a>
            <a href="/admin/payments">پرداخت‌ها</a>
            <a href="/admin/organizations">سازمان‌ها و ظاهر</a>
            <a href="/admin/partner-organizations">سازمان‌های طرف قرارداد</a>
            <a href="/admin/reports" class="active">گزارش‌ها</a>
        </nav>

    </aside>

    <main class="admin-main">

        <header class="admin-header">
            <div>
                <h1>جزئیات ثبت‌نام‌ها</h1>
                <p>جستجو و فیلتر ثبت‌نام‌های انجام‌شده</p>
            </div>

            <a href="/admin/reports" class="back-button">
                بازگشت به گزارش‌ها
            </a>
        </header>

        <section class="admin-content-card filters-card">

            <div class="section-title">
                <div>
                    <span>فیلترها</span>
                    <h2>جستجو در ثبت‌نام‌ها</h2>
                </div>
            </div>

            <div class="filters-grid">

                <div class="filter-field">
                    <label>جستجو</label>
                    <input
                        type="text"
                        placeholder="نام دانشجو یا دوره..."
                        @bind="SearchText"
                        @bind:event="oninput" />
                </div>

                <div class="filter-field">
                    <label>وضعیت</label>
                    <select @bind="StatusFilter">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="Active">فعال</option>
                        <option value="Cancelled">لغوشده</option>
                        <option value="Suspended">تعلیق‌شده</option>
                    </select>
                </div>

                <div class="filter-field">
                    <label>پشتیبان</label>
                    <select @bind="SupportFilter">
                        <option value="">همه پشتیبان‌ها</option>

                        @foreach (var support in SupportUsers)
                        {
                            <option value="@support.Id">
                                @support.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label>استاد</label>
                    <select @bind="InstructorFilter">
                        <option value="">همه استادها</option>

                        @foreach (var instructor in Instructors)
                        {
                            <option value="@instructor.Id">
                                @instructor.Name
                            </option>
                        }
                    </select>
                </div>

            </div>

            <div class="filter-actions">

                <button
                    type="button"
                    class="admin-primary-button"
                    @onclick="ApplyFilters">
                    جستجو
                </button>

                <button
                    type="button"
                    class="admin-secondary-button"
                    @onclick="ClearFilters">
                    پاک کردن فیلترها
                </button>

            </div>

        </section>

        @if (Loading)
        {
            <section class="admin-content-card">
                <div class="admin-empty-state">
                    در حال دریافت اطلاعات...
                </div>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <section class="admin-content-card">
                <div class="admin-error">
                    @ErrorMessage
                </div>
            </section>
        }
        else
        {
            <section class="admin-content-card results-card">

                <div class="admin-card-header">
                    <div>
                        <span>نتایج جستجو</span>
                        <h2>ثبت‌نام‌ها</h2>
                    </div>

                    <div class="result-count">
                        @FilteredEnrollments.Count مورد
                    </div>
                </div>

                @if (FilteredEnrollments.Count == 0)
                {
                    <div class="admin-empty-state">
                        موردی با این فیلترها پیدا نشد.
                    </div>
                }
                else
                {
                    <div class="admin-table-wrapper">

                        <table class="admin-table enrollment-table">

                            <thead>
                                <tr>
                                    <th>دانشجو</th>
                                    <th>دوره</th>
                                    <th>پشتیبان</th>
                                    <th>استاد</th>
                                    <th>تاریخ ثبت‌نام</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in FilteredEnrollments)
                                {
                                    <tr>
                                        <td class="student-name">
                                            @item.StudentName
                                        </td>

                                        <td>
                                            @item.CourseTitle
                                        </td>

                                        <td>
                                            @(item.SupportUserName ?? "-")
                                        </td>

                                        <td>
                                            @(item.InstructorName ?? "-")
                                        </td>

                                        <td class="date-cell">
                                            @item.StartDate.ToString("yyyy/MM/dd")
                                        </td>

                                        <td>
                                            <span class="status-badge @StatusClass(item.Status)">
                                                @StatusLabel(item.Status)
                                            </span>
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }

    </main>

</div>

<style>

    .admin-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .admin-header h1 {
        margin: 0 0 8px;
        font-size: 28px;
    }

    .admin-header p {
        margin: 0;
        color: #71808a;
        font-size: 14px;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 10px;
        background: #eef3f5;
        color: #263d4a;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .back-button:hover {
        background: #e2eaee;
    }

    .filters-card {
        padding: 24px;
        margin-bottom: 24px;
    }

    .section-title {
        margin-bottom: 22px;
    }

    .section-title span {
        display: block;
        margin-bottom: 6px;
        color: #7a8992;
        font-size: 13px;
    }

    .section-title h2 {
        margin: 0;
        font-size: 20px;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 16px;
        align-items: end;
    }

    .filter-field {
        min-width: 0;
    }

    .filter-field label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #344650;
    }

    .filter-field input,
    .filter-field select {
        display: block;
        width: 100%;
        height: 44px;
        box-sizing: border-box;
        padding: 0 12px;
        border: 1px solid #d9e2e7;
        border-radius: 10px;
        background: #fff;
        color: #263d4a;
        font-family: inherit;
        font-size: 14px;
        outline: none;
    }

    .filter-field input:focus,
    .filter-field select:focus {
        border-color: #568fa8;
        box-shadow: 0 0 0 3px rgba(86, 143, 168, 0.10);
    }

    .filter-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 20px;
    }

    .admin-primary-button,
    .admin-secondary-button {
        height: 42px;
        padding: 0 20px;
        border: 0;
        border-radius: 9px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .admin-primary-button {
        background: #263d4a;
        color: #fff;
    }

    .admin-primary-button:hover {
        opacity: .92;
    }

    .admin-secondary-button {
        background: #eef3f5;
        color: #263d4a;
    }

    .admin-secondary-button:hover {
        background: #e2eaee;
    }

    .results-card {
        overflow: hidden;
    }

    .result-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        height: 34px;
        padding: 0 12px;
        border-radius: 8px;
        background: #eef3f5;
        color: #263d4a;
        font-size: 13px;
        font-weight: 700;
    }

    .enrollment-table {
        width: 100%;
        border-collapse: collapse;
    }

    .enrollment-table th,
    .enrollment-table td {
        padding: 14px 16px;
        text-align: right;
        white-space: nowrap;
        border-bottom: 1px solid #edf1f3;
    }

    .enrollment-table th {
        background: #f7f9fa;
        color: #566771;
        font-size: 13px;
        font-weight: 700;
    }

    .enrollment-table td {
        color: #354750;
        font-size: 14px;
    }

    .enrollment-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .enrollment-table tbody tr:hover {
        background: #fafcfd;
    }

    .student-name {
        font-weight: 700;
        color: #263d4a !important;
    }

    .date-cell {
        direction: ltr;
        text-align: right !important;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 64px;
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-active {
        background: #e7f5ed;
        color: #23734a;
    }

    .status-cancelled {
        background: #fceaea;
        color: #a33a3a;
    }

    .status-suspended {
        background: #fff4df;
        color: #94651c;
    }

    @@media (max-width: 1100px) {
        .filters-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 700px) {
        .admin-header {
            align-items: stretch;
            flex-direction: column;
        }

        .filters-grid {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .admin-primary-button,
        .admin-secondary-button {
            width: 100%;
        }

        .admin-table-wrapper {
            overflow-x: auto;
        }

        .enrollment-table {
            min-width: 850px;
        }
    }

</style>

@code {

    private List<EnrollmentDto> Enrollments { get; set; } = new();

    private List<EnrollmentDto> FilteredEnrollments { get; set; } = new();

    private string SearchText { get; set; } = "";
    private string StatusFilter { get; set; } = "";
    private string SupportFilter { get; set; } = "";
    private string InstructorFilter { get; set; } = "";

    private List<FilterUser> SupportUsers { get; set; } = new();
    private List<FilterUser> Instructors { get; set; } = new();

    private bool Loading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || Auth.Role != "Admin")
        {
            ErrorMessage = "دسترسی غیرمجاز.";
            Loading = false;
            return;
        }

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Enrollments =
                await client.GetFromJsonAsync<List<EnrollmentDto>>(
                    "api/Enrollments")
                ?? new();

            SupportUsers = Enrollments
                .Where(x => x.SupportUserId.HasValue)
                .GroupBy(x => new
                {
                    Id = x.SupportUserId!.Value,
                    Name = x.SupportUserName ?? "-"
                })
                .Select(x => new FilterUser
                {
                    Id = x.Key.Id,
                    Name = x.Key.Name
                })
                .OrderBy(x => x.Name)
                .ToList();

            Instructors = Enrollments
                .Where(x => x.InstructorId.HasValue)
                .GroupBy(x => new
                {
                    Id = x.InstructorId!.Value,
                    Name = x.InstructorName ?? "-"
                })
                .Select(x => new FilterUser
                {
                    Id = x.Key.Id,
                    Name = x.Key.Name
                })
                .OrderBy(x => x.Name)
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "دریافت اطلاعات ثبت‌نام‌ها با خطا مواجه شد: " + ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<EnrollmentDto> query = Enrollments;

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var search = SearchText.Trim();

            query = query.Where(x =>
                (x.StudentName ?? "")
                    .Contains(search, StringComparison.OrdinalIgnoreCase)
                ||
                (x.CourseTitle ?? "")
                    .Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            query = query.Where(x => x.Status == StatusFilter);
        }

        if (int.TryParse(SupportFilter, out var supportId))
        {
            query = query.Where(x => x.SupportUserId == supportId);
        }

        if (int.TryParse(InstructorFilter, out var instructorId))
        {
            query = query.Where(x => x.InstructorId == instructorId);
        }

        FilteredEnrollments = query
            .OrderByDescending(x => x.StartDate)
            .ToList();
    }

    private void ClearFilters()
    {
        SearchText = "";
        StatusFilter = "";
        SupportFilter = "";
        InstructorFilter = "";

        ApplyFilters();
    }

    private static string StatusLabel(string status)
    {
        return status switch
        {
            "Active" => "فعال",
            "Cancelled" => "لغوشده",
            "Suspended" => "تعلیق‌شده",
            _ => status
        };
    }

    private static string StatusClass(string status)
    {
        return status switch
        {
            "Active" => "status-active",
            "Cancelled" => "status-cancelled",
            "Suspended" => "status-suspended",
            _ => ""
        };
    }

    private class FilterUser
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    private class EnrollmentDto
    {
        public int Id { get; set; }
        public int StudentId { get; set; }
        public string? StudentName { get; set; }
        public int CourseId { get; set; }
        public string? CourseTitle { get; set; }
        public int? SupportUserId { get; set; }
        public string? SupportUserName { get; set; }
        public int? InstructorId { get; set; }
        public string? InstructorName { get; set; }
        public DateTime StartDate { get; set; }
        public string Status { get; set; } = "";
    }
}

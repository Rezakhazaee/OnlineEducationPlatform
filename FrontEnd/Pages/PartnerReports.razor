@page "/partner/reports"
@using System.Globalization
@using System.Net.Http.Json
@using FrontEnd.Services
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>گزارش‌های سازمان همکار | آموزش‌یار</PageTitle>

<div class="partner-portal" dir="rtl">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <header class="portal-header">
        <a class="brand" href="/">
            <span class="brand-mark">آ</span>
            <span>
                <strong>آموزش‌یار</strong>
                <small>درگاه اختصاصی سازمان همکار</small>
            </span>
        </a>
        <div class="header-actions">
            <span class="live-indicator"><i></i> گزارش‌های به‌روز</span>
            <div class="user-chip">
                <span class="user-avatar">س</span>
                <span>@(string.IsNullOrWhiteSpace(Auth.FullName) ? Auth.Username : Auth.FullName)</span>
                <button type="button" class="logout-button" @onclick="LogoutAsync">خروج</button>
            </div>
        </div>
    </header>

    <main class="portal-main">
        <section class="welcome">
            <div>
                <div class="eyebrow"><span></span> نمای کلی عملکرد همکاری</div>
                <h1>گزارش‌های سازمان <em>همکار</em></h1>
                <p>نمایی شفاف از ثبت‌نام‌ها، عملکرد دوره‌ها و وضعیت مالی همکاری شما</p>
            </div>
            <button class="refresh-button" type="button" @onclick="LoadDashboardAsync" disabled="@IsLoading">
                <span class="refresh-icon">↻</span>
                به‌روزرسانی گزارش
            </button>
        </section>

        @if (IsLoading)
        {
            <section class="state-panel">
                <span class="loader"></span>
                <strong>در حال دریافت گزارش‌ها...</strong>
                <small>اطلاعات اختصاصی سازمان شما در حال بارگذاری است.</small>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <section class="state-panel error-panel">
                <span class="state-symbol">!</span>
                <strong>دریافت گزارش با مشکل روبه‌رو شد</strong>
                <small>@ErrorMessage</small>
                <button type="button" class="retry-button" @onclick="LoadDashboardAsync">تلاش دوباره</button>
            </section>
        }
        else if (Dashboard is not null)
        {
            <section class="metrics-grid">
                <article class="metric-card metric-enrollments">
                    <div class="metric-top"><span>کل ثبت‌نام‌ها</span><span class="metric-icon">▤</span></div>
                    <strong class="metric-value">@Number(Dashboard.TotalEnrollments)</strong>
                    <small>تمام ثبت‌نام‌های منتسب به سازمان</small>
                    <div class="metric-line"></div>
                </article>
                <article class="metric-card metric-students">
                    <div class="metric-top"><span>تعداد فراگیران</span><span class="metric-icon">♙</span></div>
                    <strong class="metric-value">@Number(Dashboard.TotalStudents)</strong>
                    <small>فراگیران یکتای ثبت‌نام‌شده</small>
                    <div class="metric-line"></div>
                </article>
                <article class="metric-card metric-courses">
                    <div class="metric-top"><span>دوره‌های آموزشی</span><span class="metric-icon">◇</span></div>
                    <strong class="metric-value">@Number(Dashboard.TotalCourses)</strong>
                    <small>دوره‌های دارای ثبت‌نام</small>
                    <div class="metric-line"></div>
                </article>
                <article class="metric-card metric-remaining">
                    <div class="metric-top"><span>مانده قابل وصول</span><span class="metric-icon">◈</span></div>
                    <strong class="metric-value money">@Money(Dashboard.RemainingAmount)</strong>
                    <small>مابه‌التفاوت مبلغ مورد انتظار و پرداختی</small>
                    <div class="metric-line"></div>
                </article>
            </section>

            <section class="finance-section">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">گزارش مالی</span>
                        <h2>نمای شفاف مبالغ همکاری</h2>
                    </div>
                    <span class="read-only-label"><span>●</span> فقط مشاهده</span>
                </div>
                <div class="finance-grid">
                    <article class="finance-card expected">
                        <span class="finance-label">مبلغ مورد انتظار</span>
                        <strong>@Money(Dashboard.ExpectedAmount)</strong>
                        <small>مجموع مبلغ ثبت‌نام‌های سازمان</small>
                    </article>
                    <article class="finance-card paid">
                        <span class="finance-label">مبلغ پرداخت‌شده</span>
                        <strong>@Money(Dashboard.TotalPaid)</strong>
                        <small>مبالغ ثبت‌شده با وضعیت پرداخت‌شده</small>
                    </article>
                    <article class="finance-card balance">
                        <span class="finance-label">مانده</span>
                        <strong>@Money(Dashboard.RemainingAmount)</strong>
                        <small>مبلغ مورد انتظار منهای پرداختی</small>
                    </article>
                </div>
                <div class="finance-track" aria-label="نسبت مبلغ پرداخت‌شده به مبلغ مورد انتظار">
                    <div class="finance-track-fill" style="@($"width:{PaidPercent}%")"></div>
                </div>
                <div class="finance-foot">
                    <span>درصد وصول</span>
                    <strong>@Number(PaidPercent)%</strong>
                </div>
            </section>

            <section class="status-section">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">وضعیت آموزشی</span>
                        <h2>ترکیب وضعیت ثبت‌نام‌ها</h2>
                    </div>
                    <span class="total-pill">مجموع: @Number(Dashboard.TotalEnrollments)</span>
                </div>
                @if (Dashboard.Statuses.Count == 0)
                {
                    <div class="empty-status">هنوز اطلاعاتی برای نمایش وضعیت ثبت‌نام‌ها وجود ندارد.</div>
                }
                else
                {
                    <div class="status-list">
                        @foreach (var item in Dashboard.Statuses)
                        {
                            <div class="status-row" @key="item.Status">
                                <div class="status-name">
                                    <span class="@StatusDot(item.Status)"></span>
                                    <strong>@StatusTitle(item.Status)</strong>
                                </div>
                                <div class="status-bar"><span class="@StatusBar(item.Status)" style="@($"width:{StatusPercent(item.Count)}%")"></span></div>
                                <strong class="status-count">@Number(item.Count)</strong>
                            </div>
                        }
                    </div>
                }
            </section>
            <footer class="portal-footer">
                <span>آموزش‌یار <b>·</b> درگاه گزارش‌گیری سازمان همکار</span>
                <span>اطلاعات این صفحه فقط برای مشاهده است.</span>
            </footer>
        }
    </main>
</div>

<style>

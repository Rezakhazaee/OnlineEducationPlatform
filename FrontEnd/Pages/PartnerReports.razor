    .status-list{display:grid;gap:17px}.status-row{display:grid;grid-template-columns:145px minmax(80px,1fr) 42px;align-items:center;gap:15px}.status-name{display:flex;align-items:center;gap:9px;font-size:12px;color:#d8e6f1}.status-dot{width:8px;height:8px;border-radius:50%;background:#83dce0;box-shadow:0 0 9px currentColor}.dot-active{background:#70d9b9}.dot-completed{background:#80b9ed}.dot-cancelled{background:#e99aab}.dot-suspended{background:#e9c47e}
    .status-bar{height:7px;border-radius:20px;background:#e5f2fa12;overflow:hidden}.status-bar span{display:block;height:100%;border-radius:20px;background:linear-gradient(90deg,#4c9fc6,#83dce0)}.bar-active{background:linear-gradient(90deg,#319b83,#70d9b9)!important}.bar-completed{background:linear-gradient(90deg,#548ac1,#80b9ed)!important}.bar-cancelled{background:linear-gradient(90deg,#b86b83,#e99aab)!important}.bar-suspended{background:linear-gradient(90deg,#b58d4d,#e9c47e)!important}
    .status-count{text-align:left;font-size:12px;color:#e3f1fa;font-variant-numeric:tabular-nums}.empty-status{padding:22px;text-align:center;color:#9fb6c9;font-size:12px;background:#ffffff08;border-radius:12px}
    .portal-footer{display:flex;justify-content:space-between;gap:12px;padding:22px 4px 0;color:#829bb1;font-size:10px}.portal-footer b{color:#6fd5d9;margin:0 5px}
    .state-panel{min-height:250px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;border:1px solid #d7e9f021;border-radius:20px;background:#ffffff09;color:#eaf5ff;text-align:center;padding:25px}.state-panel strong{font-size:15px}.state-panel small{font-size:11px;color:#9eb5c9}.loader{width:32px;height:32px;border:3px solid #ffffff20;border-top-color:#78dce0;border-radius:50%;animation:spin .8s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}.state-symbol{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#e99aab22;color:#f1a6b4;font-size:20px}.error-panel small{max-width:600px}.retry-button{margin-top:4px}
    @@media(max-width:950px){.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.metric-value.money{font-size:25px}}

</style>

@code {
    private PartnerDashboardDto? Dashboard { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    private static readonly CultureInfo PersianCulture = CultureInfo.GetCultureInfo("fa-IR");

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || Auth.Role != "PartnerOrganization")
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            using var client = Auth.CreateAuthenticatedClient();
            using var response = await client.GetAsync("api/PartnerOrganizationReports/dashboard");

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                await Auth.LogoutAsync();
                Navigation.NavigateTo("/login", true);
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = $"سرویس گزارش‌گیری پاسخ مناسب نداد (کد {(int)response.StatusCode}).";
                return;
            }

            Dashboard = await response.Content.ReadFromJsonAsync<PartnerDashboardDto>();
            if (Dashboard is null)
                ErrorMessage = "اطلاعات گزارش از سرویس دریافت نشد.";
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "ارتباط با سرور برقرار نشد. از فعال بودن سرویس آموزش‌یار مطمئن شو.";
        }
        catch (TaskCanceledException)
        {
            ErrorMessage = "زمان انتظار برای دریافت گزارش به پایان رسید.";
        }
        catch (Exception)
        {
            ErrorMessage = "در پردازش اطلاعات گزارش خطایی رخ داد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    private static string Number(int value) => value.ToString("N0", PersianCulture);
    private static string Money(decimal value) => value.ToString("N0", PersianCulture) + " ریال";

    private int PaidPercent
    {
        get
        {
            if (Dashboard is null || Dashboard.ExpectedAmount <= 0) return 0;
            return (int)Math.Clamp(Math.Round(Dashboard.TotalPaid / Dashboard.ExpectedAmount * 100m), 0m, 100m);
        }
    }

    private int StatusPercent(int count)
    {
        if (Dashboard is null || Dashboard.TotalEnrollments <= 0) return 0;
        return (int)Math.Clamp(Math.Round((decimal)count / Dashboard.TotalEnrollments * 100m), 0m, 100m);
    }

    private static string StatusTitle(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "active" => "فعال",
        "completed" => "تکمیل‌شده",
        "cancelled" => "لغوشده",
        "suspended" => "متوقف",
        _ => string.IsNullOrWhiteSpace(status) ? "نامشخص" : status
    };

    private static string StatusDot(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "active" => "status-dot dot-active",
        "completed" => "status-dot dot-completed",
        "cancelled" => "status-dot dot-cancelled",
        "suspended" => "status-dot dot-suspended",
        _ => "status-dot"
    };

    private static string StatusBar(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "active" => "bar-active",
        "completed" => "bar-completed",
        "cancelled" => "bar-cancelled",
        "suspended" => "bar-suspended",
        _ => string.Empty
    };

    private sealed class PartnerDashboardDto
    {
        public int TotalEnrollments { get; set; }
        public int TotalStudents { get; set; }
        public int TotalCourses { get; set; }
        public decimal ExpectedAmount { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal RemainingAmount { get; set; }
        public List<PartnerStatusDto> Statuses { get; set; } = new();
    }

    private sealed class PartnerStatusDto
    {
        public string? Status { get; set; }
        public int Count { get; set; }
    }
}

        color: #a33a3a;
    }

    @@media (max-width: 1100px) {
        .filters-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 700px) {
        .admin-header {
            align-items: stretch;
            flex-direction: column;
        }

        .filters-grid {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .admin-primary-button,
        .admin-secondary-button {
            width: 100%;
        }

        .admin-table-wrapper {
            overflow-x: auto;
        }

        .financial-table {
            min-width: 900px;
        }
    }


    .installments-card {
        margin-top: 24px;
    }

    .installment-summary {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .installment-summary span {
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    .installment-paid {
        background: #e8f7ef;
        color: #18794e;
    }

    .installment-pending {
        background: #fff5df;
        color: #996600;
    }

    .installment-overdue {
        background: #fdeaea;
        color: #b42318;
    }

    .status-overdue {
        background: #fdeaea;
        color: #b42318;
    }

</style>

@code {

    private List<PaymentDto> Payments { get; set; } = new();

    private List<InstallmentDto> Installments { get; set; } = new();

    private List<PaymentDto> FilteredPayments { get; set; } = new();

    private string SearchText { get; set; } = "";
    private string StatusFilter { get; set; } = "";
    private string PaymentTypeFilter { get; set; } = "";
    private decimal? MinAmount { get; set; }

    private bool Loading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || Auth.Role != "Admin")
        {
            ErrorMessage = "دسترسی غیرمجاز.";
            Loading = false;
            return;
        }

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Payments =
                await client.GetFromJsonAsync<List<PaymentDto>>(
                    "api/Payments")
                ?? new();

            Installments =
                await client.GetFromJsonAsync<List<InstallmentDto>>(
                    "api/Installments")
                ?? new();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "دریافت اطلاعات پرداخت‌ها با خطا مواجه شد: " + ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<PaymentDto> query = Payments;

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var search = SearchText.Trim();

            query = query.Where(x =>
                (x.StudentName ?? "")
                    .Contains(search, StringComparison.OrdinalIgnoreCase)
                ||
                (x.CourseTitle ?? "")
                    .Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(StatusFilter))
        {
            query = query.Where(x => x.Status == StatusFilter);
        }

        if (!string.IsNullOrWhiteSpace(PaymentTypeFilter))
        {
            query = query.Where(x => x.PaymentType == PaymentTypeFilter);
        }

        if (MinAmount.HasValue)
        {
            query = query.Where(x => x.Amount >= MinAmount.Value);
        }

        FilteredPayments = query
            .OrderByDescending(x => x.PaymentDate)
            .ToList();
    }

    private void ClearFilters()
    {
        SearchText = "";
        StatusFilter = "";
        PaymentTypeFilter = "";
        MinAmount = null;

        ApplyFilters();
    }


    private static string InstallmentStatusLabel(string status)
    {
        return status switch
        {
            "Paid" => "پرداخت‌شده",
            "Pending" => "در انتظار پرداخت",
            "Overdue" => "معوق",
            "Cancelled" => "لغوشده",
            _ => status
        };
    }

    private static string InstallmentStatusClass(string status)
    {
        return status switch
        {
            "Paid" => "status-paid",
            "Pending" => "status-pending",
            "Overdue" => "status-overdue",
            "Cancelled" => "status-cancelled",
            _ => ""
        };
    }

    private static string StatusLabel(string status)
    {
        return status switch
        {
            "Paid" => "پرداخت‌شده",
            "Pending" => "در انتظار",
            "Cancelled" => "لغوشده",
            _ => status
        };
    }

    private static string StatusClass(string status)
    {
        return status switch
        {
            "Paid" => "status-paid",
            "Pending" => "status-pending",
            "Cancelled" => "status-cancelled",
            _ => ""
        };
    }

    private static string PaymentTypeLabel(string type)
    {
        return type switch
        {
            "FirstInstallment" => "قسط اول",
            "SecondInstallment" => "قسط دوم",
            "ThirdInstallment" => "قسط سوم",
            "FullPayment" => "پرداخت کامل",
            _ => type
        };
    }


    private class InstallmentDto
    {
        public int Id { get; set; }
        public int EnrollmentId { get; set; }
        public int InstallmentNumber { get; set; }
        public decimal Amount { get; set; }
        public DateTime DueDate { get; set; }
        public string Status { get; set; } = "";
        public string StudentName { get; set; } = "";
        public string CourseTitle { get; set; } = "";
        public decimal PaidAmount { get; set; }
        public string CalculatedStatus { get; set; } = "";
    }

    private class PaymentDto
    {
        public int Id { get; set; }
        public int EnrollmentId { get; set; }
        public string StudentName { get; set; } = "";
        public string CourseTitle { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime PaymentDate { get; set; }
        public string PaymentType { get; set; } = "";
        public string? Description { get; set; }
        public string Status { get; set; } = "";
    }
}

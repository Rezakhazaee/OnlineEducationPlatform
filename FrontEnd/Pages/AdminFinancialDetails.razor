@page "/admin/reports/financial"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>جزئیات وضعیت مالی | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            آموزش‌یار
        </div>

        <nav class="admin-nav">
            <a href="/admin">داشبورد</a>
            <a href="/admin/users">کاربران</a>
            <a href="/admin/courses">دوره‌ها</a>
            <a href="/admin/enrollments">ثبت‌نام‌ها</a>
            <a href="/admin/payments">پرداخت‌ها</a>
            <a href="/admin/organizations">سازمان‌ها و ظاهر</a>
            <a href="/admin/partner-organizations">سازمان‌های طرف قرارداد</a>
            <a href="/admin/reports" class="active">گزارش‌ها</a>
        </nav>

    </aside>

    <main class="admin-main">

        <header class="admin-header">
            <div>
                <h1>جزئیات وضعیت مالی</h1>
                <p>جستجو و فیلتر پرداخت‌های ثبت‌شده</p>
            </div>

            <a href="/admin/reports" class="back-button">
                بازگشت به گزارش‌ها
            </a>
        </header>

        <section class="admin-content-card filters-card">

            <div class="section-title">
                <div>
                    <span>فیلترها</span>
                    <h2>جستجو در پرداخت‌ها</h2>
                </div>
            </div>

            <div class="filters-grid">

                <div class="filter-field">
                    <label>جستجو</label>
                    <input
                        type="text"
                        placeholder="نام دانشجو یا دوره..."
                        @bind="SearchText"
                        @bind:event="oninput" />
                </div>

                <div class="filter-field">
                    <label>وضعیت پرداخت</label>
                    <select @bind="StatusFilter">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="Paid">پرداخت‌شده</option>
                        <option value="Pending">در انتظار</option>
                        <option value="Cancelled">لغوشده</option>
                    </select>
                </div>

                <div class="filter-field">
                    <label>نوع پرداخت</label>
                    <select @bind="PaymentTypeFilter">
                        <option value="">همه انواع</option>
                        <option value="FirstInstallment">قسط اول</option>
                        <option value="SecondInstallment">قسط دوم</option>
                        <option value="ThirdInstallment">قسط سوم</option>
                        <option value="FullPayment">پرداخت کامل</option>
                    </select>
                </div>

                <div class="filter-field">
                    <label>حداقل مبلغ</label>
                    <input
                        type="number"
                        placeholder="مثلاً 1000000"
                        @bind="MinAmount" />
                </div>

            </div>

            <div class="filter-actions">

                <button
                    type="button"
                    class="admin-primary-button"
                    @onclick="ApplyFilters">
                    جستجو
                </button>

                <button
                    type="button"
                    class="admin-secondary-button"
                    @onclick="ClearFilters">
                    پاک کردن فیلترها
                </button>

            </div>

        </section>

        @if (Loading)
        {
            <section class="admin-content-card">
                <div class="admin-empty-state">
                    در حال دریافت اطلاعات...
                </div>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <section class="admin-content-card">
                <div class="admin-error">
                    @ErrorMessage
                </div>
            </section>
        }
        else
        {
            <section class="admin-content-card results-card">

                <div class="admin-card-header">
                    <div>
                        <span>نتایج جستجو</span>
                        <h2>پرداخت‌ها</h2>
                    </div>

                    <div class="result-count">
                        @FilteredPayments.Count مورد
                    </div>
                </div>

                @if (FilteredPayments.Count == 0)
                {
                    <div class="admin-empty-state">
                        موردی با این فیلترها پیدا نشد.
                    </div>
                }
                else
                {
                    <div class="admin-table-wrapper">

                        <table class="admin-table financial-table">

                            <thead>
                                <tr>
                                    <th>دانشجو</th>
                                    <th>دوره</th>
                                    <th>مبلغ</th>
                                    <th>تاریخ</th>
                                    <th>نوع پرداخت</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in FilteredPayments)
                                {
                                    <tr>

                                        <td class="student-name">
                                            @item.StudentName
                                        </td>

                                        <td>
                                            @item.CourseTitle
                                        </td>

                                        <td class="amount-cell">
                                            @item.Amount.ToString("N0") تومان
                                        </td>

                                        <td class="date-cell">
                                            @item.PaymentDate.ToString("yyyy/MM/dd")
                                        </td>

                                        <td>
                                            @PaymentTypeLabel(item.PaymentType)
                                        </td>

                                        <td>
                                            <span class="status-badge @StatusClass(item.Status)">
                                                @StatusLabel(item.Status)
                                            </span>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }


            <section class="admin-content-card installments-card">

                <div class="admin-card-header">
                    <div>
                        <span>برنامه پرداخت</span>
                        <h2>وضعیت اقساط</h2>
                    </div>

                    <div class="installment-summary">
                        <span class="installment-paid">
                            پرداخت‌شده: @Installments.Count(x => x.CalculatedStatus == "Paid")
                        </span>
                        <span class="installment-pending">
                            در انتظار: @Installments.Count(x => x.CalculatedStatus == "Pending")
                        </span>
                        <span class="installment-overdue">
                            معوق: @Installments.Count(x => x.CalculatedStatus == "Overdue")
                        </span>
                    </div>
                </div>

                @if (Installments.Count == 0)
                {
                    <div class="admin-empty-state">
                        برنامه‌ای برای اقساط ثبت نشده است.
                    </div>
                }
                else
                {
                    <div class="admin-table-wrapper">

                        <table class="admin-table financial-table">

                            <thead>
                                <tr>
                                    <th>دانشجو</th>
                                    <th>دوره</th>
                                    <th>قسط</th>
                                    <th>مبلغ</th>
                                    <th>سررسید</th>
                                    <th>پرداخت‌شده</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Installments)
                                {
                                    <tr>

                                        <td class="student-name">
                                            @item.StudentName
                                        </td>

                                        <td>
                                            @item.CourseTitle
                                        </td>

                                        <td>
                                            قسط @item.InstallmentNumber
                                        </td>

                                        <td class="amount-cell">
                                            @item.Amount.ToString("N0") تومان
                                        </td>

                                        <td class="date-cell">
                                            @item.DueDate.ToString("yyyy/MM/dd")
                                        </td>

                                        <td class="amount-cell">
                                            @item.PaidAmount.ToString("N0") تومان
                                        </td>

                                        <td>
                                            <span class="status-badge @InstallmentStatusClass(item.CalculatedStatus)">
                                                @InstallmentStatusLabel(item.CalculatedStatus)
                                            </span>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
    </main>

</div>

<style>

    .admin-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .admin-header h1 {
        margin: 0 0 8px;
        font-size: 28px;
    }

    .admin-header p {
        margin: 0;
        color: #71808a;
        font-size: 14px;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 10px;
        background: #eef3f5;
        color: #263d4a;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .filters-card {
        padding: 24px;
        margin-bottom: 24px;
    }

    .section-title {
        margin-bottom: 22px;
    }

    .section-title span {
        display: block;
        margin-bottom: 6px;
        color: #7a8992;
        font-size: 13px;
    }

    .section-title h2 {
        margin: 0;
        font-size: 20px;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 16px;
        align-items: end;
    }

    .filter-field {
        min-width: 0;
    }

    .filter-field label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #344650;
    }

    .filter-field input,
    .filter-field select {
        display: block;
        width: 100%;
        height: 44px;
        box-sizing: border-box;
        padding: 0 12px;
        border: 1px solid #d9e2e7;
        border-radius: 10px;
        background: #fff;
        color: #263d4a;
        font-family: inherit;
        font-size: 14px;
        outline: none;
    }

    .filter-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 20px;
    }

    .admin-primary-button,
    .admin-secondary-button {
        height: 42px;
        padding: 0 20px;
        border: 0;
        border-radius: 9px;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
    }

    .admin-primary-button {
        background: #263d4a;
        color: #fff;
    }

    .admin-secondary-button {
        background: #eef3f5;
        color: #263d4a;
    }

    .results-card {
        overflow: hidden;
    }

    .result-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        height: 34px;
        padding: 0 12px;
        border-radius: 8px;
        background: #eef3f5;
        color: #263d4a;
        font-size: 13px;
        font-weight: 700;
    }

    .financial-table {
        width: 100%;
        border-collapse: collapse;
    }

    .financial-table th,
    .financial-table td {
        padding: 14px 16px;
        text-align: right;
        white-space: nowrap;
        border-bottom: 1px solid #edf1f3;
    }

    .financial-table th {
        background: #f7f9fa;
        color: #566771;
        font-size: 13px;
        font-weight: 700;
    }

    .financial-table td {
        color: #354750;
        font-size: 14px;
    }

    .financial-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .financial-table tbody tr:hover {
        background: #fafcfd;
    }

    .student-name {
        font-weight: 700;
        color: #263d4a !important;
    }

    .amount-cell {
        font-weight: 700;
        direction: ltr;
        text-align: right !important;
    }

    .date-cell {
        direction: ltr;
        text-align: right !important;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        padding: 6px 10px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-paid {
        background: #e7f5ed;
        color: #23734a;
    }

    .status-pending {
        background: #fff4df;
        color: #94651c;
    }

    .status-cancelled {

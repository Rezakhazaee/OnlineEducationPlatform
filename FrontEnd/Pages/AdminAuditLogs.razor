@page "/admin/audit-logs"
@using System.Net.Http.Json
@using System.Globalization
@using FrontEnd.Services
@inject AuthService Auth

<PageTitle>گزارش ممیزی | آموزش‌یار</PageTitle>

<div class="admin-page">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>
            <div><strong>آموزش‌یار</strong><small>پنل مدیریت</small></div>
        </div>
        <nav class="admin-menu">
            <a href="/admin">داشبورد</a>
            <a href="/admin/users">کاربران</a>
            <a href="/admin/courses">دوره‌ها</a>
            <a href="/admin/enrollments">ثبت‌نام‌ها</a>
            <a href="/admin/payments">پرداخت‌ها</a>
            <a href="/admin/reports">گزارش‌ها</a>
            <a href="/admin/audit-logs" class="active">گزارش ممیزی</a>
        </nav>
        <div class="admin-sidebar-bottom">
            <a href="/">بازگشت به سایت ←</a>
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-topbar">
            <div>
                <span class="admin-label">مدیریت سامانه</span>
                <h1>گزارش ممیزی فعالیت‌ها</h1>
                <p>بررسی عملیات کاربران و درخواست‌های غیرمجاز</p>
            </div>
            <div class="admin-user">
                <div class="admin-avatar">آ</div>
                <div>
                    <strong>@(Auth.FullName ?? "مدیر سیستم")</strong>
                    <small>مدیر سامانه</small>
                </div>
            </div>
        </header>

        <section style="margin:20px 0;padding:20px;background:white;border-radius:12px;">
            <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:end;">
                <label>شناسه کاربر
                    <input type="number" min="1" @bind="UserIdFilter"
                           placeholder="همه کاربران" />
                </label>
                <label>عملیات یا مسیر
                    <input @bind="ActionFilter"
                           placeholder="مثلاً POST یا /api/Users" />
                </label>
                <button class="refresh-btn" @onclick="ApplyFilters">اعمال فیلتر</button>
                <button class="refresh-btn" @onclick="ClearFilters">پاک‌کردن فیلتر</button>
                <button class="refresh-btn" @onclick="LoadLogs">بروزرسانی</button>
            </div>
            <p>تعداد کل رویدادها: <strong>@Total.ToString("N0")</strong></p>
        </section>

        @if (Loading)
        {
            <div class="report-state">در حال دریافت گزارش‌ها...</div>
        }
        else if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="report-error">@Error</div>
        }
        else
        {
            <section style="background:white;border-radius:12px;padding:16px;overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;min-width:1000px;">
                    <thead>
                        <tr style="background:#f2f6f8;text-align:right;">
                            <th>شناسه</th>
                            <th>کاربر</th>
                            <th>نقش</th>
                            <th>عملیات</th>
                            <th>مسیر</th>
                            <th>روش</th>
                            <th>کد پاسخ</th>
                            <th>IP</th>
                            <th>زمان</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Logs.Count == 0)
                        {
                            <tr><td colspan="9">رویدادی برای نمایش وجود ندارد.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Logs)
                            {
                                <tr style="border-bottom:1px solid #e5eaee;">
                                    <td>@item.Id</td>
                                    <td>@(item.Username ?? "ناشناس") (@(item.UserId?.ToString() ?? "-"))</td>
                                    <td>@(item.Role ?? "-")</td>
                                    <td dir="ltr">@item.Action</td>
                                    <td dir="ltr">@item.Path</td>
                                    <td>@item.HttpMethod</td>
                                    <td style="color:@(item.StatusCode >= 400 ? "#b42318" : "#16804a")">
                                        @item.StatusCode
                                    </td>
                                    <td dir="ltr">@(item.IpAddress ?? "-")</td>
                                    <td>@FormatDate(item.CreatedAt)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </section>

            <div style="display:flex;justify-content:space-between;gap:12px;margin-top:18px;">
                <span>صفحه @Page از @TotalPages</span>
                <div>
                    <button class="refresh-btn" disabled="@(Page <= 1)"
                            @onclick="PreviousPage">قبلی</button>
                    <button class="refresh-btn" disabled="@(Page >= TotalPages)"
                            @onclick="NextPage">بعدی</button>
                </div>
            </div>
        }
    </main>
</div>

@code {
    private List<AuditLogItem> Logs = new();
    private int Page = 1;
    private const int PageSize = 20;
    private int Total;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Total / (double)PageSize));
    private int? UserIdFilter;
    private string ActionFilter = "";
    private bool Loading;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        Loading = true;
        Error = null;
        try
        {
            var query = new List<string> {
                $"page={Page}", $"pageSize={PageSize}"
            };

            if (UserIdFilter.HasValue && UserIdFilter.Value > 0)
                query.Add($"userId={UserIdFilter.Value}");

            if (!string.IsNullOrWhiteSpace(ActionFilter))
                query.Add($"action={Uri.EscapeDataString(ActionFilter.Trim())}");

            using var client = Auth.CreateAuthenticatedClient();
            var result = await client.GetFromJsonAsync<AuditLogResponse>(
                "api/AuditLogs?" + string.Join("&", query));

            Logs = result?.Items ?? new();
            Total = result?.Total ?? 0;
        }
        catch
        {
            Logs = new();
            Total = 0;
            Error = "دریافت گزارش ناموفق بود. ورود مدیر و اجرای سرور را بررسی کنید.";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        Page = 1;
        await LoadLogs();
    }

    private async Task ClearFilters()
    {
        UserIdFilter = null;
        ActionFilter = "";
        Page = 1;
        await LoadLogs();
    }

    private async Task PreviousPage()
    {
        if (Page > 1) { Page--; await LoadLogs(); }
    }

    private async Task NextPage()
    {
        if (Page < TotalPages) { Page++; await LoadLogs(); }
    }

    private static string FormatDate(DateTime value)
    {
        var date = value.ToLocalTime();
        var calendar = new PersianCalendar();
        return $"{calendar.GetYear(date):0000}/{calendar.GetMonth(date):00}/{calendar.GetDayOfMonth(date):00} {date:HH:mm}";
    }

    private sealed class AuditLogResponse
    {
        public int Total { get; set; }
        public List<AuditLogItem> Items { get; set; } = new();
    }

    private sealed class AuditLogItem
    {
        public int Id { get; set; }
        public int? UserId { get; set; }
        public string? Username { get; set; }
        public string? Role { get; set; }
        public string Action { get; set; } = "";
        public string? Entity { get; set; }
        public string HttpMethod { get; set; } = "";
        public string Path { get; set; } = "";
        public int StatusCode { get; set; }
        public string? IpAddress { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
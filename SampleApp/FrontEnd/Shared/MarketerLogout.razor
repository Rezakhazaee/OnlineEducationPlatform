@using FrontEnd.Services

@inject AuthService Auth
@inject NavigationManager Navigation

<button
    type="button"
    class="support-logout-btn"
    @onclick="Logout">

    خروج

</button>

@code {

    private async Task Logout()
    {
        await Auth.LogoutAsync();

        Navigation.NavigateTo(
            "/login",
            replace: true,
            forceLoad: true);
    }

}

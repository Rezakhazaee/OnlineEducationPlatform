@inherits LayoutComponentBase
@using FrontEnd.Services
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="student-app">

    <aside class="student-sidebar">

        <div class="student-brand">
            <div class="student-brand-mark">آ</div>

            <div class="student-brand-text">
                <strong>آموزش‌یار</strong>
                <small>پنل دانشجو</small>
            </div>
        </div>

        <div class="student-user-card">
            <div class="student-user-avatar">
                @(string.IsNullOrWhiteSpace(Auth.FullName)
                    ? "د"
                    : Auth.FullName.Substring(0, 1))
            </div>

            <div class="student-user-info">
                <strong>@Auth.FullName</strong>
                <small>دانشجو</small>
            </div>
        </div>

        <nav class="student-nav">

            <NavLink href="/student" Match="NavLinkMatch.All">
                <span>⌂</span>
                داشبورد
            </NavLink>

            <NavLink href="/student/profile">
                <span>♙</span>
                پروفایل من
            </NavLink>

            <NavLink href="/student/courses">
                <span>▣</span>
                دوره‌های من
            </NavLink>

            <NavLink href="/student/payments">
                <span>₿</span>
                پرداخت‌های من
            </NavLink>

        </nav>

        <div class="student-sidebar-bottom">

            <a href="/">
                <span>←</span>
                بازگشت به سایت
            </a>

            <button type="button"
                    class="student-logout-btn"
                    @onclick="Logout">
                <span>↪</span>
                خروج
            </button>

        </div>

    </aside>

    <main class="student-main">
        <div class="student-main-inner">
            @Body
        </div>
    </main>

</div>

@code {
    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}

@page "/instructor/course-content/{CourseId:int}"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout InstructorLayout

@using Microsoft.JSInterop
@inject AuthService Auth
@inject AuthService Auth
@inject IJSRuntime JS

<PageTitle>محتوای دوره | آموزش‌یار</PageTitle>

<div class="support-content">

    @if (IsLoading)
    {
        <section class="support-content-card">

            <div class="support-loading">

                <div class="support-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت محتوای دوره...
                </h3>

            </div>

        </section>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="support-content-card">

            <div class="support-error">

                <strong>
                    خطا
                </strong>

                <p>
                    @ErrorMessage
                </p>

            </div>

        </section>
    }
    else
    {
        <section class="support-content-card">

            <div class="support-card-header">

                <div>

                    <span>
                        آموزش
                    </span>

                    <h2>
                        @CourseTitle
                    </h2>

                </div>

                <a
                    href="/instructor/courses"
                    class="support-outline-btn">

                    ← دوره‌های من

                </a>

            </div>


            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="support-success-message">

                    @SuccessMessage

                </div>
            }


            <!-- =========================
                 MODULE FORM
                 ========================= -->

            <div class="support-followup-form">

                <div class="support-form-grid">

                    <div class="support-form-group support-form-wide">

                        <label>
                            @(EditingModuleId.HasValue
                                ? "ویرایش سرفصل"
                                : "عنوان سرفصل جدید")
                        </label>

                        <input
                            class="support-form-input"
                            @bind="ModuleTitle"
                            placeholder="مثلاً فصل اول: آشنایی با Excel" />

                    </div>


                    <div class="support-form-group">

                        <label>
                            ترتیب
                        </label>

                        <input
                            class="support-form-input"
                            type="number"
                            min="0"
                            @bind="ModuleSortOrder" />

                    </div>

                </div>


                <div class="support-form-actions">

                    <button
                        type="button"
                        class="support-primary-btn"
                        disabled="@IsSaving"
                        @onclick="CreateModule">

                        @(IsSaving
                            ? "در حال ذخیره..."
                            : (EditingModuleId.HasValue
                                ? "ذخیره تغییرات"
                                : "افزودن سرفصل"))

                    </button>


                    @if (EditingModuleId.HasValue)
                    {
                        <button
                            type="button"
                            class="support-outline-btn"
                            @onclick="CancelModuleEdit">

                            انصراف

                        </button>
                    }

                </div>

            </div>

        </section>


        <!-- =========================
             MODULE LIST
             ========================= -->

        @if (Modules.Count == 0)
        {
            <section class="support-content-card">

                <div class="support-empty-state">

                    <h3>
                        هنوز سرفصلی برای این دوره ثبت نشده است.
                    </h3>

                    <p>
                        ابتدا یک سرفصل ایجاد کنید و سپس درس‌های آن را اضافه کنید.
                    </p>

                </div>

            </section>
        }
        else
        {
            @foreach (var module in Modules)
            {
                <section class="support-content-card">

                    <div class="support-card-header">

                        <div>

                            <span>
                                سرفصل @module.SortOrder
                            </span>

                            <h2>
                                @module.Title
                            </h2>

                            <small>
                                @module.LessonCount درس
                            </small>

                            <small>
                                وضعیت:
                                @(module.IsActive
                                    ? "فعال"
                                    : "غیرفعال")
                            </small>

                        </div>


                        <div class="instructor-course-actions">

                            <!-- Edit module -->

                            <button
                                type="button"
                                class="support-outline-btn"
                                @onclick="() => EditModule(module)">

                                ویرایش سرفصل

                            </button>


                            <!-- Toggle module -->

                            <button
                                type="button"
                                class="support-outline-btn"
                                @onclick="() => ToggleModuleStatus(module)">

                                @(module.IsActive
                                    ? "غیرفعال کردن"
                                    : "فعال کردن")

                            </button>


                            <!-- Add lesson -->

                            <button
                                type="button"
                                class="support-outline-btn"
                                @onclick="() => StartLesson(module)">

                                افزودن درس

                            </button>


                            <!-- Delete module -->

                            <button
                                type="button"
                                class="support-outline-btn"
                                @onclick="() => DeleteModule(module)">

                                حذف سرفصل

                            </button>

                        </div>

                    </div>


                    <!-- =========================
                         LESSON FORM
                         ========================= -->

                    @if (LessonModuleId == module.Id)
                    {
                        <div class="support-followup-form">

                            <div class="support-form-grid">

                                <div class="support-form-group support-form-wide">

                                    <label>
                                        @(EditingLessonId.HasValue
                                            ? "ویرایش درس"
                                            : "عنوان درس")
                                    </label>

                                    <input
                                        class="support-form-input"
                                        @bind="LessonTitle"
                                        placeholder="مثلاً آشنایی با محیط Excel" />

                                </div>


                                <div class="support-form-group">

                                    <label>
                                        نوع محتوا
                                    </label>

                                    <select
                                        class="support-form-input"
                                        @bind="LessonContentType">

                                        <option value="Video">
                                            ویدئو
                                        </option>

                                        <option value="Text">
                                            متن
                                        </option>

                                    </select>

                                </div>


                                <div class="support-form-group">

                                    <label>
                                        مدت زمان (دقیقه)
                                    </label>

                                    <input
                                        class="support-form-input"
                                        type="number"
                                        min="0"
                                        @bind="LessonDurationMinutes" />

                                </div>


                                <div class="support-form-group">

                                    <label>
                                        ترتیب درس
                                    </label>

                                    <input
                                        class="support-form-input"
                                        type="number"
                                        min="0"
                                        @bind="LessonSortOrder" />

                                </div>


                                <div class="support-form-group support-form-wide">

                                    <label>
                                        آدرس محتوا
                                    </label>

                                    <input
                                        class="support-form-input"
                                        @bind="LessonContentUrl"
                                        placeholder="آدرس ویدئو یا محتوای آنلاین" />

                                </div>


                                <div class="support-form-group support-form-wide">

                                    <label>
                                        توضیحات درس
                                    </label>

                                    <textarea
                                        class="support-form-input support-form-textarea"
                                        @bind="LessonDescription">
                                    </textarea>

                                </div>


                                <div class="support-form-group">

                                    <label>

                                        <input
                                            type="checkbox"
                                            @bind="LessonIsActive" />

                                        درس فعال باشد

                                    </label>

                                </div>


                                <div class="support-form-group">

                                    <label>

                                        <input
                                            type="checkbox"
                                            @bind="LessonIsFreePreview" />

                                        پیش‌نمایش رایگان

                                    </label>

                                </div>

                            </div>


                            <div class="support-form-actions">

                                <button
                                    type="button"
                                    class="support-primary-btn"
                                    disabled="@IsSaving"
                                    @onclick="CreateLesson">

                                    @(IsSaving
                                        ? "در حال ذخیره..."
                                        : (EditingLessonId.HasValue
                                            ? "ذخیره تغییرات"
                                            : "ثبت درس"))

                                </button>


                                <button
                                    type="button"
                                    class="support-outline-btn"
                                    @onclick="CancelLesson">

                                    انصراف

                                </button>

                            </div>

                        </div>
                    }


                    <!-- =========================
                         LESSON LIST
                         ========================= -->

                    @if (LessonsByModule.TryGetValue(module.Id, out var lessons)
                         && lessons.Count > 0)
                    {
                        <div class="support-enrollments-list">

                            @foreach (var lesson in lessons)
                            {
                                <div class="support-enrollment-row">

                                    <div class="support-enrollment-main">

                                        <strong>
                                            @lesson.SortOrder. @lesson.Title
                                        </strong>


                                        @if (!string.IsNullOrWhiteSpace(lesson.Description))
                                        {
                                            <span>
                                                @lesson.Description
                                            </span>
                                        }


                                        <span>
                                            نوع:
                                            @(lesson.ContentType == "Video"
                                                ? "ویدئو"
                                                : "متن")
                                        </span>


                                        @if (lesson.DurationMinutes > 0)
                                        {
                                            <span>
                                                مدت:
                                                @lesson.DurationMinutes دقیقه
                                            </span>
                                        }


                                        @if (!string.IsNullOrWhiteSpace(lesson.ContentUrl))
                                        {
                                            <span>
                                                آدرس محتوا:
                                                @lesson.ContentUrl
                                            </span>
                                        }

                                    </div>


                                    <div>

                                        <small>
                                            وضعیت
                                        </small>


                                        <span
                                            class="@(lesson.IsActive
                                                ? "status-active"
                                                : "status-cancelled")">

                                            @(lesson.IsActive
                                                ? "فعال"
                                                : "غیرفعال")

                                        </span>


                                        @if (lesson.IsFreePreview)
                                        {
                                            <small>
                                                پیش‌نمایش رایگان
                                            </small>
                                        }


                                        <div class="instructor-course-actions">

                                            <!-- Edit lesson -->

                                            <button
                                                type="button"
                                                class="support-outline-btn"
                                                @onclick="() => EditLesson(lesson)">

                                                ویرایش درس

                                            </button>


                                            <!-- Toggle lesson -->

                                            <button
                                                type="button"
                                                class="support-outline-btn"
                                                @onclick="() => ToggleLessonStatus(lesson)">

                                                @(lesson.IsActive
                                                    ? "غیرفعال کردن"
                                                    : "فعال کردن")

                                            </button>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="support-empty-state">

                            <p>
                                هنوز در این سرفصل درسی ثبت نشده است.
                            </p>

                        </div>
                    }

                </section>
            }
        }
    }

</div>


@code {

    // =====================================================
    // Course
    // =====================================================

    [Parameter]
    public int CourseId { get; set; }


    private string CourseTitle { get; set; } = string.Empty;


    // =====================================================
    // Data
    // =====================================================

    private List<CourseModuleDto> Modules { get; set; } = new();


    private Dictionary<int, List<CourseLessonDto>> LessonsByModule
        { get; set; } = new();


    // =====================================================
    // Page state
    // =====================================================

    private bool IsLoading { get; set; } = true;


    private bool IsSaving { get; set; }


    private string? ErrorMessage { get; set; }


    private string? SuccessMessage { get; set; }


    // =====================================================
    // Module form
    // =====================================================

    private int? EditingModuleId { get; set; }


    private string ModuleTitle { get; set; } = string.Empty;


    private int ModuleSortOrder { get; set; }


    // =====================================================
    // Lesson form
    // =====================================================

    private int? LessonModuleId { get; set; }


    private int? EditingLessonId { get; set; }


    private string LessonTitle { get; set; } = string.Empty;


    private string LessonDescription { get; set; } = string.Empty;


    private string LessonContentType { get; set; } = "Video";


    private string LessonContentUrl { get; set; } = string.Empty;


    private int LessonDurationMinutes { get; set; }


    private int LessonSortOrder { get; set; }


    private bool LessonIsActive { get; set; } = true;


    private bool LessonIsFreePreview { get; set; }


    // =====================================================
    // Initialization
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.IsInstructor)
        {
            return;
        }

        await LoadData();
    }


    // =====================================================
    // Load course + modules + lessons
    // =====================================================

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();


            var course =
                await client.GetFromJsonAsync<CourseDto>(
                    $"api/Courses/{CourseId}");


            if (course == null)
            {
                ErrorMessage = "دوره پیدا نشد.";
                return;
            }


            CourseTitle = course.Title;


            Modules =
                await client.GetFromJsonAsync<List<CourseModuleDto>>(
                    $"api/CourseModules/course/{CourseId}")
                ?? new List<CourseModuleDto>();


            LessonsByModule.Clear();


            foreach (var module in Modules)
            {
                var lessons =
                    await client.GetFromJsonAsync<List<CourseLessonDto>>(
                        $"api/CourseLessons/module/{module.Id}")
                    ?? new List<CourseLessonDto>();


                LessonsByModule[module.Id] = lessons;
            }
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =====================================================
    // Create / Update Module
    // =====================================================

    private async Task CreateModule()
    {
        ErrorMessage = null;
        SuccessMessage = null;


        if (string.IsNullOrWhiteSpace(ModuleTitle))
        {
            ErrorMessage =
                "عنوان سرفصل الزامی است.";

            return;
        }


        IsSaving = true;


        try
        {
            var client = Auth.CreateAuthenticatedClient();


            if (EditingModuleId.HasValue)
            {
                var module =
                    Modules.FirstOrDefault(
                        x => x.Id == EditingModuleId.Value);


                if (module == null)
                {
                    ErrorMessage =
                        "سرفصل پیدا نشد.";

                    return;
                }


                var response =
                    await client.PutAsJsonAsync(
                        $"api/CourseModules/{module.Id}",
                        new UpdateCourseModuleDto
                        {
                            Title = ModuleTitle.Trim(),
                            SortOrder = ModuleSortOrder,
                            IsActive = module.IsActive
                        });


                if (!response.IsSuccessStatusCode)
                {
                    ErrorMessage =
                        await GetErrorMessage(response);

                    return;
                }


                SuccessMessage =
                    "سرفصل با موفقیت ویرایش شد.";


                EditingModuleId = null;

                ModuleTitle = string.Empty;

                ModuleSortOrder = 0;


                await LoadData();

                return;
            }


            var createResponse =
                await client.PostAsJsonAsync(
                    "api/CourseModules",
                    new CreateCourseModuleDto
                    {
                        CourseId = CourseId,
                        Title = ModuleTitle.Trim(),
                        SortOrder = ModuleSortOrder,
                        IsActive = true
                    });


            if (!createResponse.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(createResponse);

                return;
            }


            SuccessMessage =
                "سرفصل با موفقیت اضافه شد.";


            ModuleTitle = string.Empty;

            ModuleSortOrder++;


            await LoadData();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =====================================================
    // Edit Module
    // =====================================================

    private void EditModule(CourseModuleDto module)
    {
        CancelLesson();


        EditingModuleId = module.Id;

        ModuleTitle = module.Title;

        ModuleSortOrder = module.SortOrder;


        ErrorMessage = null;

        SuccessMessage = null;
    }


    // =====================================================
    // Cancel Module edit
    // =====================================================

    private void CancelModuleEdit()
    {
        EditingModuleId = null;

        ModuleTitle = string.Empty;

        ModuleSortOrder = 0;
    }


    // =====================================================
    // Toggle Module active / inactive
    // =====================================================

    private async Task ToggleModuleStatus(
        CourseModuleDto module)
    {
        ErrorMessage = null;

        SuccessMessage = null;


        try
        {
            var client =
                Auth.CreateAuthenticatedClient();


            var response =
                await client.PutAsJsonAsync(
                    $"api/CourseModules/{module.Id}",
                    new UpdateCourseModuleDto
                    {
                        Title = module.Title,
                        SortOrder = module.SortOrder,
                        IsActive = !module.IsActive
                    });


            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }


            SuccessMessage =
                module.IsActive
                    ? "سرفصل غیرفعال شد."
                    : "سرفصل فعال شد.";


            await LoadData();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
    }


    // =====================================================
    // Start Add Lesson
    // =====================================================

    private void StartLesson(
        CourseModuleDto module)
    {
        CancelModuleEdit();


        ErrorMessage = null;

        SuccessMessage = null;


        LessonModuleId = module.Id;

        EditingLessonId = null;


        LessonTitle = string.Empty;

        LessonDescription = string.Empty;

        LessonContentType = "Video";

        LessonContentUrl = string.Empty;

        LessonDurationMinutes = 0;

        LessonSortOrder = module.LessonCount;

        LessonIsActive = true;

        LessonIsFreePreview = false;
    }


    // =====================================================
    // Edit Lesson
    // =====================================================

    private void EditLesson(
        CourseLessonDto lesson)
    {
        CancelModuleEdit();


        ErrorMessage = null;

        SuccessMessage = null;


        LessonModuleId =
            lesson.CourseModuleId;


        EditingLessonId =
            lesson.Id;


        LessonTitle =
            lesson.Title;


        LessonDescription =
            lesson.Description
            ?? string.Empty;


        LessonContentType =
            lesson.ContentType;


        LessonContentUrl =
            lesson.ContentUrl
            ?? string.Empty;


        LessonDurationMinutes =
            lesson.DurationMinutes;


        LessonSortOrder =
            lesson.SortOrder;


        LessonIsActive =
            lesson.IsActive;


        LessonIsFreePreview =
            lesson.IsFreePreview;
    }


    // =====================================================
    // Cancel Lesson form
    // =====================================================

    private void CancelLesson()
    {
        LessonModuleId = null;

        EditingLessonId = null;


        LessonTitle = string.Empty;

        LessonDescription = string.Empty;

        LessonContentType = "Video";

        LessonContentUrl = string.Empty;

        LessonDurationMinutes = 0;

        LessonSortOrder = 0;

        LessonIsActive = true;

        LessonIsFreePreview = false;
    }


    // =====================================================
    // Create / Update Lesson
    // =====================================================

    private async Task CreateLesson()
    {
        ErrorMessage = null;

        SuccessMessage = null;


        if (!LessonModuleId.HasValue)
        {
            return;
        }


        if (string.IsNullOrWhiteSpace(LessonTitle))
        {
            ErrorMessage =
                "عنوان درس الزامی است.";

            return;
        }


        if (LessonDurationMinutes < 0)
        {
            ErrorMessage =
                "مدت زمان نمی‌تواند منفی باشد.";

            return;
        }


        IsSaving = true;


        try
        {
            var client =
                Auth.CreateAuthenticatedClient();


            // ==============================
            // UPDATE
            // ==============================

            if (EditingLessonId.HasValue)
            {
                var response =
                    await client.PutAsJsonAsync(
                        $"api/CourseLessons/{EditingLessonId.Value}",
                        new UpdateCourseLessonDto
                        {
                            Title =
                                LessonTitle.Trim(),

                            Description =
                                string.IsNullOrWhiteSpace(
                                    LessonDescription)
                                    ? null
                                    : LessonDescription.Trim(),

                            ContentType =
                                LessonContentType,

                            ContentUrl =
                                string.IsNullOrWhiteSpace(
                                    LessonContentUrl)
                                    ? null
                                    : LessonContentUrl.Trim(),

                            DurationMinutes =
                                LessonDurationMinutes,

                            SortOrder =
                                LessonSortOrder,

                            IsActive =
                                LessonIsActive,

                            IsFreePreview =
                                LessonIsFreePreview
                        });


                if (!response.IsSuccessStatusCode)
                {
                    ErrorMessage =
                        await GetErrorMessage(response);

                    return;
                }


                SuccessMessage =
                    "درس با موفقیت ویرایش شد.";


                CancelLesson();


                await LoadData();

                return;
            }


            // ==============================
            // CREATE
            // ==============================

            var createResponse =
                await client.PostAsJsonAsync(
                    "api/CourseLessons",
                    new CreateCourseLessonDto
                    {
                        CourseModuleId =
                            LessonModuleId.Value,

                        Title =
                            LessonTitle.Trim(),

                        Description =
                            string.IsNullOrWhiteSpace(
                                LessonDescription)
                                ? null
                                : LessonDescription.Trim(),

                        ContentType =
                            LessonContentType,

                        ContentUrl =
                            string.IsNullOrWhiteSpace(
                                LessonContentUrl)
                                ? null
                                : LessonContentUrl.Trim(),

                        DurationMinutes =
                            LessonDurationMinutes,

                        SortOrder =
                            LessonSortOrder,

                        IsActive =
                            LessonIsActive,

                        IsFreePreview =
                            LessonIsFreePreview
                    });


            if (!createResponse.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(createResponse);

                return;
            }


            SuccessMessage =
                "درس با موفقیت اضافه شد.";


            CancelLesson();


            await LoadData();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    // =====================================================
    // =====================================================
    // Delete lesson
    // =====================================================

    private async Task DeleteLesson(CourseLessonDto lesson)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"آیا از حذف درس «{lesson.Title}» مطمئن هستید؟");

        if (!confirmed)
            return;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response = await client.DeleteAsync(
                $"api/CourseLessons/{lesson.Id}");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await GetErrorMessage(response);
                return;
            }

            SuccessMessage = "درس با موفقیت حذف شد.";

            if (EditingLessonId == lesson.Id)
                CancelLesson();

            await LoadData();
        }
        catch
        {
            ErrorMessage = "ارتباط با سرور برقرار نشد.";
        }
    }

    // Toggle Lesson active / inactive
    // =====================================================

    private async Task ToggleLessonStatus(
        CourseLessonDto lesson)
    {
        ErrorMessage = null;

        SuccessMessage = null;


        try
        {
            var client =
                Auth.CreateAuthenticatedClient();


            var response =
                await client.PutAsJsonAsync(
                    $"api/CourseLessons/{lesson.Id}",
                    new UpdateCourseLessonDto
                    {
                        Title =
                            lesson.Title,

                        Description =
                            lesson.Description,

                        ContentType =
                            lesson.ContentType,

                        ContentUrl =
                            lesson.ContentUrl,

                        DurationMinutes =
                            lesson.DurationMinutes,

                        SortOrder =
                            lesson.SortOrder,

                        IsActive =
                            !lesson.IsActive,

                        IsFreePreview =
                            lesson.IsFreePreview
                    });


            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }


            SuccessMessage =
                lesson.IsActive
                    ? "درس غیرفعال شد."
                    : "درس فعال شد.";


            await LoadData();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
    }


    // =====================================================
    // Delete Module
    // =====================================================

    private async Task DeleteModule(
        CourseModuleDto module)
    {
        ErrorMessage = null;

        SuccessMessage = null;


        try
        {
            var client =
                Auth.CreateAuthenticatedClient();


            var response =
                await client.DeleteAsync(
                    $"api/CourseModules/{module.Id}");


            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }


            SuccessMessage =
                "سرفصل و درس‌های آن حذف شدند.";


            await LoadData();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
    }


    // =====================================================
    // Error helper
    // =====================================================

    private async Task<string> GetErrorMessage(
        HttpResponseMessage response)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ApiError>();


            if (!string.IsNullOrWhiteSpace(
                error?.Message))
            {
                return error.Message;
            }
        }
        catch
        {
        }


        return "عملیات انجام نشد.";
    }



@page "/courses/{CourseId:int}"

@using System.Net.Http.Json
@using System.Text.Json
@using FrontEnd.Services

@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>ثبت‌نام در دوره</PageTitle>

<div class="public-course-page">

    @if (IsLoading)
    {
        <p>در حال بررسی دوره...</p>
    }
    else if (Course == null)
    {
        <div class="alert alert-danger">
            دوره پیدا نشد.
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">
            @ErrorMessage
        </div>

        <a href="@LoginUrl" class="btn btn-primary">
            ورود به حساب
        </a>
    }
    else if (!Auth.IsLoggedIn)
    {
        <div class="course-enrollment-card">

            <h1>@Course.Title</h1>

            <p>
                برای ثبت‌نام در این دوره ابتدا وارد حساب خود شوید یا حساب کاربری ایجاد کنید.
            </p>

            <div class="course-enrollment-actions">
                <a href="@LoginUrl" class="btn btn-primary">
                    ورود و ثبت‌نام در دوره
                </a>

                <a href="@RegisterUrl" class="btn btn-secondary">
                    ساخت حساب و ثبت‌نام در دوره
                </a>
            </div>

        </div>
    }
    else if (!Auth.IsStudent)
    {
        <div class="alert alert-warning">
            ثبت‌نام در دوره برای حساب دانشجویی انجام می‌شود.
        </div>
    }
    else if (IsEnrolling)
    {
        <div class="course-enrollment-card">
            <h1>@Course.Title</h1>
            <p>در حال ثبت‌نام شما در دوره...</p>
        </div>
    }

</div>

@code {

    [Parameter]
    public int CourseId { get; set; }

    private PublicCourseDto? Course;
    private bool IsLoading = true;
    private bool IsEnrolling;
    private string? ErrorMessage;

    private string EnrollReturnUrl => $"/courses/{CourseId}/enroll";

    private string LoginUrl =>
        $"/login?returnUrl={Uri.EscapeDataString(EnrollReturnUrl)}";

    private string RegisterUrl =>
        $"/register?returnUrl={Uri.EscapeDataString(EnrollReturnUrl)}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Course = await Http.GetFromJsonAsync<PublicCourseDto>(
                $"api/PublicCourses/{CourseId}");

            if (Course == null)
            {
                ErrorMessage = "دوره موردنظر پیدا نشد.";
                return;
            }

            if (Auth.IsLoggedIn && Auth.IsStudent)
            {
                await AutoEnrollAsync();
            }
        }
        catch
        {
            ErrorMessage = "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task AutoEnrollAsync()
    {
        IsEnrolling = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var studentResponse =
                await client.GetAsync("api/Students/me");

            if (!studentResponse.IsSuccessStatusCode)
            {
                ErrorMessage = "پروفایل دانشجویی شما ایجاد نشد. لطفاً دوباره وارد شوید.";
                return;
            }

            var response =
                await client.PostAsJsonAsync(
                    "api/Enrollments",
                    new CreateEnrollmentDto
                    {
                        CourseId = CourseId,
                        StartDate = DateTime.Today,
                        Status = "Active",
                        Description = "ثبت‌نام از صفحه عمومی دوره"
                    });

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/student/courses");
                return;
            }

            var body = await response.Content.ReadAsStringAsync();

            try
            {
                using var document = JsonDocument.Parse(body);

                if (document.RootElement.TryGetProperty("message", out var message))
                {
                    ErrorMessage = message.GetString() ?? "ثبت‌نام انجام نشد.";
                }
                else
                {
                    ErrorMessage = "ثبت‌نام در دوره انجام نشد.";
                }
            }
            catch
            {
                ErrorMessage = "ثبت‌نام در دوره انجام نشد.";
            }
        }
        catch
        {
            ErrorMessage = "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsEnrolling = false;
        }
    }

    private sealed class PublicCourseDto
    {
        public int Id { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public decimal Price { get; set; }
        public string? DeliveryType { get; set; }
        public string? InstructorName { get; set; }
    }

    private sealed class CreateEnrollmentDto
    {
        public int CourseId { get; set; }
        public DateTime StartDate { get; set; }
        public string Status { get; set; } = "Active";
        public string? Description { get; set; }
    }
}

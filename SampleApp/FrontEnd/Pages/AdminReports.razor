@page "/admin/reports"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>گزارش‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>
            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports" class="active">
                <span>▤</span>
                گزارش‌ها
            </a>

        </nav>

    </aside>

    <main class="admin-main">

        <div class="admin-page-header">

            <div>
                <span>مدیریت</span>
                <h1>گزارش‌های مدیریتی</h1>
                <p>تحلیل ثبت‌نام، درآمد، پرداخت و وضعیت دوره‌ها</p>
            </div>

            <div class="admin-page-header-actions">

                <button class="admin-primary-btn"
                        @onclick="LoadDashboard"
                        disabled="@Loading">

                    @(Loading ? "در حال دریافت..." : "به‌روزرسانی گزارش")

                </button>

                @if (LastUpdated.HasValue)
                {
                    <span class="admin-last-updated">
                        آخرین بروزرسانی:
                        @LastUpdated.Value.ToString("HH:mm:ss")
                    </span>
                }

            </div>

        </div>

        <!-- FILTERS -->

        <section class="admin-content-card">

            <div class="admin-card-header">

                <div>
                    <span>فیلتر گزارش</span>
                    <h2>پارامترهای جست‌وجو</h2>
                </div>

            </div>

            <div class="admin-form-grid">

                <div class="admin-form-group">

                    <label>از تاریخ</label>

                    <input type="date"
                           class="admin-input"
                           @bind="FromDate" />

                </div>

                <div class="admin-form-group">

                    <label>تا تاریخ</label>

                    <input type="date"
                           class="admin-input"
                           @bind="ToDate" />

                </div>

                <div class="admin-form-group">

                    <label>دوره</label>

                    <select class="admin-input"
                            @bind="SelectedCourseId">

                        <option value="">همه دوره‌ها</option>

                        @foreach (var course in Courses)
                        {
                            <option value="@course.Id">
                                @course.Title
                            </option>
                        }

                    </select>

                </div>

                <div class="admin-form-group">

                    <label>مدرس</label>

                    <select class="admin-input"
                            @bind="SelectedInstructorId">

                        <option value="">همه مدرس‌ها</option>

                        @foreach (var instructor in Instructors)
                        {
                            <option value="@instructor.Id">
                                @instructor.Name
                            </option>
                        }

                    </select>

                </div>

                <div class="admin-form-group">

                    <label>نوع برگزاری</label>

                    <select class="admin-input"
                            @bind="SelectedDeliveryType">

                        <option value="">همه</option>
                        <option value="Online">آنلاین</option>
                        <option value="InPerson">حضوری</option>

                    </select>

                </div>

                <div class="admin-form-group">

                    <label>وضعیت ثبت‌نام</label>

                    <select class="admin-input"
                            @bind="SelectedStatus">

                        <option value="">همه</option>
                        <option value="Active">فعال</option>
                        <option value="Cancelled">لغوشده</option>

                    </select>

                </div>

            </div>

            <div style="margin-top:18px; display:flex; gap:10px;">

                <button class="admin-primary-btn"
                        @onclick="LoadDashboard"
                        disabled="@Loading">

                    اعمال فیلتر

                </button>

                <button class="admin-secondary-btn"
                        @onclick="ClearFilters">

                    پاک کردن فیلترها

                </button>

            </div>

        </section>

        @if (Loading)
        {
            <section class="admin-content-card">

                <div class="admin-empty-state">
                    در حال دریافت گزارش...
                </div>

            </section>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <section class="admin-content-card">

                <div class="admin-error">
                    @ErrorMessage
                </div>

            </section>
        }
        else
        {
            <!-- KPI -->

            <div class="admin-stats-grid">

                <div class="admin-stat-card">
                    <div class="admin-stat-label">
                        دانشجویان
                    </div>
                    <div class="admin-stat-value">
                        @Dashboard.Summary.TotalStudents
                    </div>
                </div>

                <div class="admin-stat-card">
                    <div class="admin-stat-label">
                        دوره‌ها
                    </div>
                    <div class="admin-stat-value">
                        @Dashboard.Summary.TotalCourses
                    </div>
                </div>

                <div class="admin-stat-card">
                    <div class="admin-stat-label">
                        ثبت‌نام‌ها
                    </div>
                    <div class="admin-stat-value">
                        @Dashboard.Summary.TotalEnrollments
                    </div>
                </div>

                <div class="admin-stat-card">
                    <div class="admin-stat-label">
                        ثبت‌نام فعال
                    </div>
                    <div class="admin-stat-value">
                        @Dashboard.Summary.ActiveEnrollments
                    </div>
                </div>

                <div class="admin-stat-card">
                    <div class="admin-stat-label">
                        مبلغ مورد انتظار
                    </div>
                    <div class="admin-stat-value">
                        @Money(Dashboard.Summary.ExpectedAmount)
                        <small>تومان</small>
                    </div>
                </div>

                <div class="admin-stat-card">
                    <div class="admin-stat-label">
                        وصول‌شده
                    </div>
                    <div class="admin-stat-value">
                        @Money(Dashboard.Summary.PaidAmount)
                        <small>تومان</small>
                    </div>
                </div>

                <div class="admin-stat-card">
                    <div class="admin-stat-label">
                        مانده
                    </div>
                    <div class="admin-stat-value">
                        @Money(Dashboard.Summary.RemainingAmount)
                        <small>تومان</small>
                    </div>
                </div>

                <div class="admin-stat-card">
                    <div class="admin-stat-label">
                        درصد وصول
                    </div>
                    <div class="admin-stat-value">
                        @Dashboard.Summary.CollectionPercent.ToString("0.##")%
                    </div>
                </div>

            </div>

            <!-- FINANCIAL OVERVIEW -->

            <section class="admin-content-card" style="margin-top:24px;">

                <div class="admin-card-header">

                    <div>
                        <span>مالی</span>
                        <h2>وضعیت دریافت شهریه</h2>
                    </div>

                    <strong>
                        @Dashboard.Summary.CollectionPercent.ToString("0.##")%
                    </strong>

                </div>

                <div style="margin-top:20px;">

                    <div style="
                        height:18px;
                        background:#e5e7eb;
                        border-radius:20px;
                        overflow:hidden;">

                        <div style="
                            width:@Dashboard.Summary.CollectionPercent%;
                            height:100%;
                            background:#568fa8;
                            border-radius:20px;">
                        </div>

                    </div>

                </div>

                <div style="
                    display:grid;
                    grid-template-columns:repeat(3,1fr);
                    gap:16px;
                    margin-top:20px;">

                    <div>
                        <small>وصول‌شده</small>
                        <strong>
                            @Money(Dashboard.Summary.PaidAmount) تومان
                        </strong>
                    </div>

                    <div>
                        <small>در انتظار</small>
                        <strong>
                            @Money(Dashboard.Summary.PendingAmount) تومان
                        </strong>
                    </div>

                    <div>
                        <small>مانده</small>
                        <strong>
                            @Money(Dashboard.Summary.RemainingAmount) تومان
                        </strong>
                    </div>

                </div>

            </section>

            <!-- COURSE REPORT -->

            <section class="admin-content-card" style="margin-top:24px;">

                <div class="admin-card-header">

                    <div>
                        <span>تفکیک دوره‌ها</span>
                        <h2>عملکرد مالی دوره‌ها</h2>
                    </div>

                    <span>
                        @Dashboard.Courses.Count دوره
                    </span>

                </div>

                @if (Dashboard.Courses.Count == 0)
                {
                    <div class="admin-empty-state">
                        داده‌ای برای این فیلتر وجود ندارد.
                    </div>
                }
                else
                {
                    <div class="admin-table-wrapper">

                        <table class="admin-table">

                            <thead>

                                <tr>
                                    <th>دوره</th>
                                    <th>ثبت‌نام</th>
                                    <th>مبلغ مورد انتظار</th>
                                    <th>وصول‌شده</th>
                                    <th>مانده</th>
                                    <th>درصد وصول</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Dashboard.Courses)
                                {
                                    <tr>

                                        <td>
                                            @item.CourseTitle
                                        </td>

                                        <td>
                                            @item.EnrollmentCount
                                        </td>

                                        <td>
                                            @Money(item.ExpectedAmount) تومان
                                        </td>

                                        <td>
                                            @Money(item.PaidAmount) تومان
                                        </td>

                                        <td>
                                            @Money(item.RemainingAmount) تومان
                                        </td>

                                        <td>

                                            <strong>
                                                @item.CollectionPercent.ToString("0.##")%
                                            </strong>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>

            <!-- PROGRESS -->

            <AdminProgressReport />
        }

    </main>

</div>

@code {

    private bool Loading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private DateTime? LastUpdated { get; set; }

    private DashboardDto Dashboard { get; set; } = new();

    private string FromDate { get; set; } = "";

    private string ToDate { get; set; } = "";

    private string SelectedCourseId { get; set; } = "";

    private string SelectedInstructorId { get; set; } = "";

    private string SelectedDeliveryType { get; set; } = "";

    private string SelectedStatus { get; set; } = "";

    private List<CourseOption> Courses { get; set; } = new();

    private List<InstructorOption> Instructors { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || Auth.Role != "Admin")
        {
            ErrorMessage = "دسترسی غیرمجاز.";
            Loading = false;
            return;
        }

        await LoadOptions();
        await LoadDashboard();
    }

    private async Task LoadOptions()
    {
        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Courses =
                await client.GetFromJsonAsync<List<CourseOption>>(
                    "api/Courses")
                ?? new();

            Instructors =
                await client.GetFromJsonAsync<List<InstructorOption>>(
                    "api/Instructors")
                ?? new();
        }
        catch
        {
            // اگر endpointهای انتخاب مدرس/دوره در نسخه فعلی
            // ساختار متفاوت داشته باشند، گزارش اصلی همچنان قابل استفاده است.
        }
    }

    private async Task LoadDashboard()
    {
        Loading = true;
        ErrorMessage = null;

        try
        {
            var parameters = new List<string>();

            if (!string.IsNullOrWhiteSpace(FromDate))
                parameters.Add($"from={Uri.EscapeDataString(FromDate)}");

            if (!string.IsNullOrWhiteSpace(ToDate))
                parameters.Add($"to={Uri.EscapeDataString(ToDate)}");

            if (!string.IsNullOrWhiteSpace(SelectedCourseId))
                parameters.Add($"courseId={SelectedCourseId}");

            if (!string.IsNullOrWhiteSpace(SelectedInstructorId))
                parameters.Add($"instructorId={SelectedInstructorId}");

            if (!string.IsNullOrWhiteSpace(SelectedDeliveryType))
                parameters.Add($"deliveryType={SelectedDeliveryType}");

            if (!string.IsNullOrWhiteSpace(SelectedStatus))
                parameters.Add($"status={SelectedStatus}");

            var url = "api/Reports/dashboard";

            if (parameters.Count > 0)
                url += "?" + string.Join("&", parameters);

            var client = Auth.CreateAuthenticatedClient();

            var response =
                await client.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    $"دریافت گزارش با خطای {(int)response.StatusCode} ({response.StatusCode}) مواجه شد.";
                return;
            }

            Dashboard =
                await response.Content.ReadFromJsonAsync<DashboardDto>()
                ?? new();

            LastUpdated = DateTime.Now;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"خطا در دریافت گزارش: {ex.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ClearFilters()
    {
        FromDate = "";
        ToDate = "";
        SelectedCourseId = "";
        SelectedInstructorId = "";
        SelectedDeliveryType = "";
        SelectedStatus = "";

        await LoadDashboard();
    }

    private static string Money(decimal value)
    {
        return value.ToString("N0");
    }

    private class DashboardDto
    {
        public FilterDto Filters { get; set; } = new();

        public SummaryDto Summary { get; set; } = new();

        public List<CourseReportDto> Courses { get; set; } = new();
    }

    private class FilterDto
    {
        public DateTime? From { get; set; }

        public DateTime? To { get; set; }

        public int? CourseId { get; set; }

        public int? InstructorId { get; set; }

        public string? DeliveryType { get; set; }

        public string? Status { get; set; }
    }

    private class SummaryDto
    {
        public int TotalStudents { get; set; }

        public int TotalCourses { get; set; }

        public int TotalEnrollments { get; set; }

        public int ActiveEnrollments { get; set; }

        public int CancelledEnrollments { get; set; }

        public decimal ExpectedAmount { get; set; }

        public decimal PaidAmount { get; set; }

        public decimal PendingAmount { get; set; }

        public decimal CancelledPaymentAmount { get; set; }

        public decimal RemainingAmount { get; set; }

        public decimal CollectionPercent { get; set; }
    }

    private class CourseReportDto
    {
        public int CourseId { get; set; }

        public string CourseTitle { get; set; } = "";

        public int EnrollmentCount { get; set; }

        public decimal ExpectedAmount { get; set; }

        public decimal PaidAmount { get; set; }

        public decimal RemainingAmount { get; set; }

        public decimal CollectionPercent { get; set; }
    }

    private class CourseOption
    {
        public int Id { get; set; }

        public string Title { get; set; } = "";
    }

    private class InstructorOption
    {
        public int Id { get; set; }

        public string Name { get; set; } = "";
    }
}

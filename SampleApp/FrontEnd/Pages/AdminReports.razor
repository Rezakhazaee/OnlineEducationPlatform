@code {

    private DashboardReport? Report;
    private bool Loading = true;
    private List<InstructorReport> InstructorReports { get; set; } = new();
    private LearningProgressReport? LearningProgress { get; set; }
    private List<EnrollmentRow> EnrollmentRows { get; set; } = new();
    private string EnrollmentSearch { get; set; } = "";
    private string EnrollmentStatusFilter { get; set; } = "";
    private string EnrollmentDeliveryFilter { get; set; } = "";
    private int EnrollmentCourseFilter { get; set; }
    private int EnrollmentInstructorFilter { get; set; }
    private string? Error;

    private IEnumerable<EnrollmentRow> FilteredEnrollmentRows =>
        EnrollmentRows.Where(e =>
            (string.IsNullOrWhiteSpace(EnrollmentSearch) ||
             (e.StudentName ?? "").Contains(EnrollmentSearch, StringComparison.OrdinalIgnoreCase) ||
             (e.CourseTitle ?? "").Contains(EnrollmentSearch, StringComparison.OrdinalIgnoreCase) ||
             (e.InstructorName ?? "").Contains(EnrollmentSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(EnrollmentStatusFilter) || e.Status == EnrollmentStatusFilter) &&
            (EnrollmentCourseFilter == 0 || e.CourseId == EnrollmentCourseFilter) &&
            (EnrollmentInstructorFilter == 0 || e.InstructorId == EnrollmentInstructorFilter) &&
            (string.IsNullOrWhiteSpace(EnrollmentDeliveryFilter) ||
             Report?.Courses.FirstOrDefault(c => c.CourseId == e.CourseId)?.DeliveryType == EnrollmentDeliveryFilter));

    private double CollectionWidth =>
        Math.Clamp((double)(Report?.Summary.CollectionPercent ?? 0), 0, 100);

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || Auth.Role != "Admin")
        {
            Error = "دسترسی غیرمجاز. لطفاً با حساب مدیر وارد شوید.";
            Loading = false;
            return;
        }

        await LoadReport();
    }

    private async Task LoadReport()
    {
        Loading = true;
        Error = null;
        try
        {
            var client = Auth.CreateAuthenticatedClient();
            var json = await client.GetStringAsync("api/Reports/dashboard");
            using var document = System.Text.Json.JsonDocument.Parse(json);
            var root = document.RootElement;
            var summary = root.TryGetProperty("summary", out var summaryElement) ? summaryElement : root;
            int ReadInt(string key) => summary.TryGetProperty(key, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.Number ? v.GetInt32() : 0;
            decimal ReadDecimal(string key) => summary.TryGetProperty(key, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.Number ? v.GetDecimal() : 0m;
            Report = new DashboardReport
            {
                Summary = new DashboardSummary
                {
                    TotalStudents = ReadInt("totalStudents"),
                    TotalCourses = ReadInt("totalCourses"),
                    TotalEnrollments = ReadInt("totalEnrollments"),
                    ActiveEnrollments = ReadInt("activeEnrollments"),
                    CancelledEnrollments = ReadInt("cancelledEnrollments"),
                    TodayEnrollments = ReadInt("todayEnrollments"),
                    MonthEnrollments = ReadInt("monthEnrollments"),
                    OnlineEnrollments = ReadInt("onlineEnrollments"),
                    InPersonEnrollments = ReadInt("inPersonEnrollments"),
                    HybridEnrollments = ReadInt("hybridEnrollments"),
                    ExpectedAmount = ReadDecimal(summary.TryGetProperty("totalExpected", out _) ? "totalExpected" : "expectedAmount"),
                    TotalPaid = ReadDecimal("totalPaid"),
                    RemainingAmount = ReadDecimal(summary.TryGetProperty("totalRemaining", out _) ? "totalRemaining" : "remainingAmount"),
                    CollectionPercent = ReadDecimal("collectionPercent")
                },
                Courses = (root.TryGetProperty("courseReports", out var courses) || root.TryGetProperty("courses", out courses)) ? System.Text.Json.JsonSerializer.Deserialize<List<CourseReport>>(courses.GetRawText(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new() : new()
            };
            InstructorReports = await client.GetFromJsonAsync<List<InstructorReport>>("api/ManagementReports/instructors") ?? new();
            LearningProgress = await client.GetFromJsonAsync<LearningProgressReport>("api/ManagementReports/learning-progress");
            try { EnrollmentRows = await client.GetFromJsonAsync<List<EnrollmentRow>>("api/Enrollments") ?? new(); }
            catch { EnrollmentRows = new(); }
        }
        catch (Exception ex) { Error = "خطا در دریافت گزارش‌ها: " + ex.Message; }
        finally { Loading = false; }
    }

    private static string ActivityStatusLabel(string status)
    {
        return status switch
        {
            "NoActivity" => "بدون فعالیت",
            "HighProgress" => "پیشرفت بالا",
            "InProgress" => "در حال پیشرفت",
            _ => "-"
        };
    }

    private static string ActivityStatusClass(string status)
    {
        return status switch
        {
            "NoActivity" => "no-activity",
            "HighProgress" => "high-progress",
            "InProgress" => "in-progress",
            _ => ""
        };
    }

    private static string Money(decimal amount)
    {
        return amount.ToString("#,##0");
    }

    private static double CourseWidth(decimal percent)
    {
        return Math.Clamp((double)percent, 0, 100);
    }

    private void ClearEnrollmentFilters()
    {
        EnrollmentSearch = "";
        EnrollmentStatusFilter = "";
        EnrollmentDeliveryFilter = "";
        EnrollmentCourseFilter = 0;
        EnrollmentInstructorFilter = 0;
    }

    private static string EnrollmentStatusLabel(string? status) =>
        status switch
        {
            "Active" => "فعال",
            "Cancelled" => "لغوشده",
            "Completed" => "تکمیل‌شده",
            _ => status ?? "-"
        };

    private static string DeliveryLabel(string? deliveryType)
    {
        return deliveryType switch
        {
            "Online" => "آنلاین",
            "InPerson" => "حضوری",
            _ => deliveryType ?? "-"
        };
    }


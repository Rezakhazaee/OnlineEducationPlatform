@code {

    private DashboardReport? Report;
    private bool Loading = true;
    private List<InstructorReport> InstructorReports { get; set; } = new();
    private LearningProgressReport? LearningProgress { get; set; }
    private string? Error;

    private double CollectionWidth =>
        Math.Clamp((double)(Report?.Summary.CollectionPercent ?? 0), 0, 100);

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    private async Task LoadReport()
    {
        Loading = true;
        Error = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var json = await client.GetStringAsync("api/Reports/dashboard");
            using var document = System.Text.Json.JsonDocument.Parse(json);
            var root = document.RootElement;

            Report = new DashboardReport
            {
                Summary = new DashboardSummary
                {
                    TotalStudents = root.GetProperty("totalStudents").GetInt32(),
                    TotalCourses = root.GetProperty("totalCourses").GetInt32(),
                    TotalEnrollments = root.GetProperty("totalEnrollments").GetInt32(),
                    ActiveEnrollments = root.GetProperty("activeEnrollments").GetInt32(),
                    CancelledEnrollments = root.GetProperty("cancelledEnrollments").GetInt32(),
                    TodayEnrollments = root.GetProperty("todayEnrollments").GetInt32(),
                    MonthEnrollments = root.GetProperty("monthEnrollments").GetInt32(),
                    OnlineEnrollments = root.GetProperty("onlineEnrollments").GetInt32(),
                    InPersonEnrollments = root.GetProperty("inPersonEnrollments").GetInt32(),
                    ExpectedAmount = root.GetProperty("totalExpected").GetDecimal(),
                    TotalPaid = root.GetProperty("totalPaid").GetDecimal(),
                    RemainingAmount = root.GetProperty("totalRemaining").GetDecimal(),
                    CollectionPercent = root.GetProperty("collectionPercent").GetDecimal()
                },
                Courses = System.Text.Json.JsonSerializer.Deserialize<List<CourseReport>>(root.GetProperty("courseReports").GetRawText(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new()
            };

            InstructorReports = await client.GetFromJsonAsync<List<InstructorReport>>(
                "api/ManagementReports/instructors") ?? new();

            LearningProgress = await client.GetFromJsonAsync<LearningProgressReport>(
                "api/ManagementReports/learning-progress");
        }
        catch (Exception ex)
        {
            Error = "خطا در دریافت گزارش‌ها: " + ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private static string ActivityStatusLabel(string status)
    {
        return status switch
        {
            "NoActivity" => "بدون فعالیت",
            "HighProgress" => "پیشرفت بالا",
            "InProgress" => "در حال پیشرفت",
            _ => "-"
        };
    }

    private static string ActivityStatusClass(string status)
    {
        return status switch
        {
            "NoActivity" => "no-activity",
            "HighProgress" => "high-progress",
            "InProgress" => "in-progress",
            _ => ""
        };
    }

    private static string Money(decimal amount)
    {
        return amount.ToString("#,##0");
    }

    private static double CourseWidth(decimal percent)
    {
        return Math.Clamp((double)percent, 0, 100);
    }

    private static string DeliveryLabel(string? deliveryType)
    {
        return deliveryType switch
        {
            "Online" => "آنلاین",
            "InPerson" => "حضوری",
            _ => deliveryType ?? "-"
        };
    }

    public class LearningProgressReport
    {
        public LearningProgressSummary Summary { get; set; } = new();
        public List<LearningProgressStudent> Students { get; set; } = new();
    }

    public class LearningProgressSummary
    {
        public int ActiveStudents { get; set; }
        public int TotalCompletedLessons { get; set; }
        public decimal AverageProgress { get; set; }
        public int InactiveStudents { get; set; }
        public int HighProgressStudents { get; set; }
    }

    public class LearningProgressStudent
    {
        public int EnrollmentId { get; set; }
        public int StudentId { get; set; }
        public string StudentName { get; set; } = "";
        public int CourseId { get; set; }
        public string CourseTitle { get; set; } = "";
        public int TotalLessons { get; set; }
        public int CompletedLessons { get; set; }
        public decimal ProgressPercent { get; set; }
        public string ActivityStatus { get; set; } = "";
        public string EnrollmentStatus { get; set; } = "";
    }

    public class InstructorReport
    {
        public int InstructorId { get; set; }
        public string InstructorName { get; set; } = "";
        public int CourseCount { get; set; }
        public int StudentCount { get; set; }
        public int EnrollmentCount { get; set; }
        public int TotalLessons { get; set; }
        public int CompletedLessons { get; set; }
        public decimal AverageProgress { get; set; }
    }

    public class DashboardReport
    {
        public DashboardSummary Summary { get; set; } = new();
        public List<CourseReport> Courses { get; set; } = new();
    }

    public class DashboardSummary
    {
        public int TotalStudents { get; set; }
        public int TotalCourses { get; set; }
        public int TotalEnrollments { get; set; }
        public int ActiveEnrollments { get; set; }
        public int CancelledEnrollments { get; set; }
        public int TodayEnrollments { get; set; }
        public int MonthEnrollments { get; set; }
        public int OnlineEnrollments { get; set; }
        public int InPersonEnrollments { get; set; }

        public decimal ExpectedAmount { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal RemainingAmount { get; set; }
        public decimal CollectionPercent { get; set; }
    }

    public class CourseReport
    {
        public int CourseId { get; set; }
        public string CourseTitle { get; set; } = "";
        public string? DeliveryType { get; set; }
        public int EnrollmentCount { get; set; }
        public int Capacity { get; set; }
        public int ActiveStudentCount { get; set; }

        public decimal ExpectedAmount { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal RemainingAmount { get; set; }
        public decimal CollectionPercent { get; set; }
    }
    private decimal RegistrationWidth(int value)
    {
        if (Report.Summary.TotalEnrollments == 0)
            return 0;

        return Math.Round(
            value * 100m / Report.Summary.TotalEnrollments,
            2);
    }

}

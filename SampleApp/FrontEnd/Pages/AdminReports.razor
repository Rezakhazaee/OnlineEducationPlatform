@page "/admin/reports"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>گزارش‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/partner-organizations">
                <span>♧</span>
                سازمان‌های طرف قرارداد
            </a>

            <a href="/admin/reports" class="active">
                <span>▤</span>
                گزارش‌ها
            </a>
            <a href="/admin/organizations">
            <span>◈</span>
            سازمان‌ها و ظاهر  
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <a href="/">
                ← بازگشت به سایت
            </a>

        </div>

    </aside>

<main class="admin-main">

<div class="reports-page">

    <div class="reports-header">
        <div>
            <h1>گزارش‌ها</h1>
            <p>نمای کلی وضعیت ثبت‌نام و امور مالی</p>
        </div>

        <button class="refresh-btn" @onclick="LoadReport">
            ↻ بروزرسانی
        </button>
    </div>

    @if (Loading)
    {
        <div class="report-state">در حال دریافت اطلاعات...</div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="report-error">@Error</div>
    }
    else if (Report != null)
    {
        <!-- ثبت نام -->
        <section class="report-section">
            <div class="section-title">
                <div>
                    <h2>وضعیت ثبت‌نام</h2>
                    <span>خلاصه وضعیت ثبت‌نام‌های سامانه</span>
                </div>
            </div>

            <div class="stats-grid registration-grid">

                <div class="stat-card">
                    <div class="stat-icon">◎</div>
                    <div>
                        <span>کل ثبت‌نام‌ها</span>
                        <strong>@Report.Summary.TotalEnrollments</strong>
                    </div>
                </div>

                <div class="stat-card active">
                    <div class="stat-icon">✓</div>
                    <div>
                        <span>ثبت‌نام فعال</span>
                        <strong>@Report.Summary.ActiveEnrollments</strong>
                    </div>
                </div>

                <div class="stat-card cancelled">
                    <div class="stat-icon">×</div>
                    <div>
                        <span>لغوشده</span>
                        <strong>@Report.Summary.CancelledEnrollments</strong>
                    </div>
                </div>

                <div class="stat-card students">
                    <div class="stat-icon">♙</div>
                    <div>
                        <span>دانشجویان</span>
                        <strong>@Report.Summary.TotalStudents</strong>
                    </div>
                </div>

                <div class="stat-card courses">
                    <div class="stat-icon">▣</div>
                    <div>
                        <span>دوره‌های دارای ثبت‌نام</span>
                        <strong>@Report.Summary.TotalCourses</strong>
                    </div>
                </div>

            </div>
        </section>

        <section class="registration-breakdown">
            <div class="breakdown-header">
                <div>
                    <span>جزئیات ثبت‌نام</span>
                    <h3>روند و تفکیک ثبت‌نام‌ها</h3>
                </div>
            </div>

            <div class="registration-breakdown-grid">
                <div class="breakdown-card today">
                    <span class="breakdown-label">ثبت‌نام‌های امروز</span>
                    <strong>@Report.Summary.TodayEnrollments</strong>
                    <small>ثبت‌نام جدید امروز</small>
                </div>

                <div class="breakdown-card month">
                    <span class="breakdown-label">ثبت‌نام‌های این ماه</span>
                    <strong>@Report.Summary.MonthEnrollments</strong>
                    <small>از ابتدای ماه جاری</small>
                </div>

                <div class="breakdown-card online">
                    <span class="breakdown-label">ثبت‌نام آنلاین</span>
                    <strong>@Report.Summary.OnlineEnrollments</strong>
                    <small>دوره‌های آنلاین</small>
                </div>

                <div class="breakdown-card inperson">
                    <span class="breakdown-label">ثبت‌نام حضوری</span>
                    <strong>@Report.Summary.InPersonEnrollments</strong>
                    <small>دوره‌های حضوری</small>
                </div>
            </div>

            <div class="registration-status-panel">
                <div class="status-panel-title">
                    <strong>تفکیک وضعیت ثبت‌نام</strong>
                    <span>@Report.Summary.TotalEnrollments ثبت‌نام</span>
                </div>

                <div class="status-bars">
                    <div class="status-row">
                        <div class="status-row-label">
                            <span>فعال</span>
                            <strong>@Report.Summary.ActiveEnrollments</strong>
                        </div>
                        <div class="status-track">
                            <div class="status-fill active-fill"
                                 style="width:@RegistrationWidth(Report.Summary.ActiveEnrollments)%"></div>
                        </div>
                    </div>

                    <div class="status-row">
                        <div class="status-row-label">
                            <span>لغوشده</span>
                            <strong>@Report.Summary.CancelledEnrollments</strong>
                        </div>
                        <div class="status-track">
                            <div class="status-fill cancelled-fill"
                                 style="width:@RegistrationWidth(Report.Summary.CancelledEnrollments)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="report-section detail-links-section">
            <div class="section-title">
                <div>
                    <h2>گزارش‌های تفصیلی</h2>
                    <span>برای مشاهده و جستجوی جزئیات هر بخش وارد گزارش مربوطه شوید</span>
                </div>
            </div>

            <div class="detail-links-grid">
                <a href="/admin/reports/enrollments" class="detail-link enrollment-link">
                    <div class="detail-link-icon">✓</div>
                    <div class="detail-link-content">
                        <strong>جزئیات ثبت‌نام‌ها</strong>
                        <span>جستجو و فیلتر ثبت‌نام‌های انجام‌شده</span>
                    </div>
                    <div class="detail-link-arrow">←</div>
                </a>

                <a href="/admin/reports/financial" class="detail-link financial-link">
                    <div class="detail-link-icon">₮</div>
                    <div class="detail-link-content">
                        <strong>جزئیات وضعیت مالی</strong>
                        <span>جستجو و فیلتر پرداخت‌های ثبت‌شده</span>
                    </div>
                    <div class="detail-link-arrow">←</div>
                </a>
            </div>
        </section>

        <!-- مالی -->
        <section class="report-section financial-section">
            <div class="section-title">
                <div>
                    <h2>وضعیت مالی</h2>
                    <span>خلاصه مبالغ ثبت‌نام و میزان وصول</span>
                </div>

                <div class="collection-badge">
                    وصول
                    <strong>@Report.Summary.CollectionPercent.ToString("0.##")%</strong>
                </div>
            </div>

            <div class="stats-grid financial-grid">

                <div class="money-card expected">
                    <span>مبلغ مورد انتظار</span>
                    <strong>@Money(Report.Summary.ExpectedAmount)</strong>
                    <small>تومان</small>
                </div>

                <div class="money-card paid">
                    <span>پرداخت‌شده</span>
                    <strong>@Money(Report.Summary.TotalPaid)</strong>
                    <small>تومان</small>
                </div>

                <div class="money-card remaining">
                    <span>مانده</span>
                    <strong>@Money(Report.Summary.RemainingAmount)</strong>
                    <small>تومان</small>
                </div>

                <div class="money-card percentage">
                    <span>درصد وصول</span>
                    <strong>@Report.Summary.CollectionPercent.ToString("0.##")%</strong>
                    <small>از کل مبلغ</small>
                </div>

            </div>

            <div class="collection-box">
                <div class="collection-top">
                    <span>پیشرفت وصول مطالبات</span>
                    <strong>@Report.Summary.CollectionPercent.ToString("0.##")%</strong>
                </div>

                <div class="progress-track">
                    <div class="progress-value"
                         style="width:@CollectionWidth%">
                    </div>
                </div>

                <div class="collection-bottom">
                    <span>پرداخت‌شده: @Money(Report.Summary.TotalPaid) تومان</span>
                    <span>مانده: @Money(Report.Summary.RemainingAmount) تومان</span>
                </div>
            </div>
        </section>

        <!-- جدول دوره ها -->
        <section class="report-section course-section">
            <div class="section-title">
                <div>
                    <h2>وضعیت مالی دوره‌ها</h2>
                    <span>تفکیک مبلغ و وصول به تفکیک دوره</span>
                </div>
            </div>

            <div class="table-wrapper">
                <table class="reports-table">
                    <thead>
                        <tr>
                            <th>دوره</th>
                            <th>نوع برگزاری</th>
                            <th>ثبت‌نام</th>
                            <th>مبلغ مورد انتظار</th>
                            <th>پرداخت‌شده</th>
                            <th>مانده</th>
                            <th>وصول</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var course in Report.Courses)
                        {
                            <tr>
                                <td class="course-name">@course.CourseTitle</td>
                                <td>
                                    <span class="delivery-badge">
                                        @DeliveryLabel(course.DeliveryType)
                                    </span>
                                </td>
                                <td>@course.EnrollmentCount</td>
                                <td>@Money(course.ExpectedAmount) تومان</td>
                                <td class="paid-text">@Money(course.TotalPaid) تومان</td>
                                <td class="remaining-text">@Money(course.RemainingAmount) تومان</td>
                                <td>
                                    <div class="mini-progress">
                                        <div style="width:@CourseWidth(course.CollectionPercent)%"></div>
                                    </div>
                                    <span class="percent-text">
                                        @course.CollectionPercent.ToString("0.##")%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- گزارش عملکرد دوره‌ها -->
        <section class="report-section performance-section">
            <div class="section-title">
                <div>
                    <h2>گزارش عملکرد دوره‌ها</h2>
                    <span>نمایش ثبت‌نام، درآمد، وصول، ظرفیت و دانشجویان فعال</span>
                </div>
            </div>

            <div class="table-wrapper">
                <table class="reports-table performance-table">
                    <thead>
                        <tr>
                            <th>دوره</th>
                            <th>خلاصه عملکرد</th>
                            <th>درآمد مورد انتظار</th>
                            <th>وصول‌شده</th>
                            <th>مانده</th>
                            <th>ظرفیت</th>
                            <th>دانشجوی فعال</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var course in Report.Courses)
                        {
                            <tr>
                                <td class="course-name">@course.CourseTitle</td>

                                <td>
                                    <div class="performance-summary">
                                        <strong>@course.EnrollmentCount ثبت‌نام</strong>
                                        <span>@course.CollectionPercent.ToString("0.##")٪ وصول</span>
                                        <span>@course.ActiveStudentCount دانشجوی فعال</span>
                                    </div>
                                </td>

                                <td>@Money(course.ExpectedAmount) تومان</td>

                                <td class="paid-text">
                                    @Money(course.TotalPaid) تومان
                                </td>

                                <td class="remaining-text">
                                    @Money(course.RemainingAmount) تومان
                                </td>

                                <td>
                                    <span class="capacity-badge">
                                        @course.Capacity نفر
                                    </span>
                                </td>

                                <td>
                                    <strong>@course.ActiveStudentCount</strong>
                                    <span class="capacity-muted">
                                        از @course.Capacity
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
<!-- گزارش عملکرد مدرس -->
<section class="report-section instructor-performance-section">
    <div class="section-title">
        <div>
            <h2>گزارش عملکرد مدرس</h2>
            <span>نمایش دوره‌ها، دانشجویان، ثبت‌نام‌ها و میانگین پیشرفت دانشجویان</span>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="reports-table instructor-performance-table">
            <thead>
                <tr>
                    <th>مدرس</th>
                    <th>دوره‌ها</th>
                    <th>دانشجویان</th>
                    <th>ثبت‌نام‌ها</th>
                    <th>درس‌های تکمیل‌شده</th>
                    <th>میانگین پیشرفت</th>
                </tr>
            </thead>

            <tbody>
                @if (InstructorReports.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-report">
                            گزارشی برای مدرس‌ها وجود ندارد.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var instructor in InstructorReports)
                    {
                        <tr>
                            <td>
                                <div class="instructor-name">
                                    <strong>@instructor.InstructorName</strong>
                                </div>
                            </td>

                            <td>
                                <span class="instructor-stat-badge">
                                    @instructor.CourseCount دوره
                                </span>
                            </td>

                            <td>
                                <strong>@instructor.StudentCount</strong>
                                <span class="capacity-muted">دانشجو</span>
                            </td>

                            <td>
                                <strong>@instructor.EnrollmentCount</strong>
                                <span class="capacity-muted">ثبت‌نام</span>
                            </td>

                            <td>
                                <span class="lesson-progress-text">
                                    @instructor.CompletedLessons از @instructor.TotalLessons
                                </span>
                            </td>

                            <td>
                                <div class="instructor-progress">
                                    <div class="instructor-progress-header">
                                        <strong>@instructor.AverageProgress.ToString("0.##")٪</strong>
                                    </div>
                                    <div class="instructor-progress-track">
                                        <div class="instructor-progress-fill"
                                             style="width:@CourseWidth(instructor.AverageProgress)%"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

    <section class="report-section learning-progress-section">
        <div class="section-title">
            <div>
                <h2>گزارش پیشرفت آموزشی</h2>
                <span>وضعیت فعالیت و پیشرفت دانشجویان در دوره‌ها</span>
            </div>
        </div>

        @if (LearningProgress != null)
        {
            <div class="learning-summary-grid">
                <div class="learning-summary-card active">
                    <span>دانشجویان فعال</span>
                    <strong>@LearningProgress.Summary.ActiveStudents</strong>
                    <small>دانشجوی دارای ثبت‌نام فعال</small>
                </div>

                <div class="learning-summary-card completed">
                    <span>درس‌های تکمیل‌شده</span>
                    <strong>@LearningProgress.Summary.TotalCompletedLessons</strong>
                    <small>مجموع درس‌های تکمیل‌شده</small>
                </div>

                <div class="learning-summary-card average">
                    <span>میانگین پیشرفت</span>
                    <strong>@LearningProgress.Summary.AverageProgress.ToString("0.##")٪</strong>
                    <small>میانگین پیشرفت دانشجویان</small>
                </div>

                <div class="learning-summary-card inactive">
                    <span>بدون فعالیت</span>
                    <strong>@LearningProgress.Summary.InactiveStudents</strong>
                    <small>بدون تکمیل هیچ درس</small>
                </div>

                <div class="learning-summary-card high">
                    <span>پیشرفت بالا</span>
                    <strong>@LearningProgress.Summary.HighProgressStudents</strong>
                    <small>پیشرفت ۷۵٪ یا بیشتر</small>
                </div>
            </div>

            <div class="table-wrapper">
                <table class="reports-table learning-progress-table">
                    <thead>
                        <tr>
                            <th>دانشجو</th>
                            <th>دوره</th>
                            <th>درس‌های تکمیل‌شده</th>
                            <th>وضعیت فعالیت</th>
                            <th>پیشرفت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in LearningProgress.Students)
                        {
                            <tr>
                                <td class="learning-student-name">
                                    <strong>@student.StudentName</strong>
                                </td>
                                <td class="learning-course-name">
                                    @student.CourseTitle
                                </td>
                                <td>
                                    <span class="lesson-progress-text">
                                        @student.CompletedLessons از @student.TotalLessons
                                    </span>
                                </td>
                                <td>
                                    <span class="activity-badge @ActivityStatusClass(student.ActivityStatus)">
                                        @ActivityStatusLabel(student.ActivityStatus)
                                    </span>
                                </td>
                                <td>
                                    <div class="learning-progress">
                                        <div class="learning-progress-header">
                                            <strong>@student.ProgressPercent.ToString("0.##")٪</strong>
                                        </div>
                                        <div class="learning-progress-track">
                                            <div class="learning-progress-fill" style="width:@student.ProgressPercent%"></div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>
</main>
</div>
<style>

    .reports-page {
        direction: rtl;
        padding: 28px;
        max-width: 1500px;
        margin: 0 auto;
        color: #263d4a;
    }

    .reports-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 26px;
    }

    .reports-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
    }

    .reports-header p {
        margin: 7px 0 0;
        color: #71808a;
        font-size: 14px;
    }

    .refresh-btn {
        border: 0;
        background: #568fa8;
        color: white;
        padding: 11px 20px;
        border-radius: 10px;
        font-family: inherit;
        font-size: 14px;
        cursor: pointer;
        transition: .2s;
    }

    .refresh-btn:hover {
        transform: translateY(-1px);
        opacity: .92;
    }

    .report-section {
        background: white;
        border: 1px solid #e8eef1;
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 22px;
        box-shadow: 0 5px 20px rgba(38, 61, 74, .06);
    }

    .section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .section-title h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
    }

    .section-title span {
        display: block;
        margin-top: 5px;
        color: #7c8b94;
        font-size: 12px;
    }

    .stats-grid {
        display: grid;
        gap: 14px;
    }

    .registration-grid {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .financial-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .stat-card {
        min-height: 105px;
        border-radius: 14px;
        padding: 17px;
        background: #fafcfd;
        border: 1px solid #edf1f3;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .stat-icon {
        width: 43px;
        height: 43px;
        min-width: 43px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e6f0f4;
        color: #568fa8;
        font-size: 22px;
        font-weight: bold;
    }

    .stat-card span,
    .money-card span {
        display: block;
        color: #75838c;
        font-size: 12px;
        margin-bottom: 7px;
    }

    .stat-card strong {
        display: block;
        font-size: 24px;
        line-height: 1;
    }

    .stat-card.active .stat-icon {
        background: #e7f5ed;
        color: #27925d;
    }

    .stat-card.cancelled .stat-icon {
        background: #f9eaea;
        color: #c45a5a;
    }

    .stat-card.students .stat-icon {
        background: #eeeafb;
        color: #765fc4;
    }

    .stat-card.courses .stat-icon {
        background: #fff2df;
        color: #c88327;
    }

    .money-card {
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #edf1f3;
        background: #fafcfd;
    }

    .money-card strong {
        display: inline-block;
        font-size: 22px;
        font-weight: 800;
    }

    .money-card small {
        color: #84919a;
        margin-right: 5px;
        font-size: 11px;
    }

    .money-card.paid {
        background: #f2faf6;
    }

    .money-card.remaining {
        background: #fff8ed;
    }

    .money-card.percentage {
        background: #f3f7fb;
    }

    .collection-badge {
        background: #edf6f9;
        color: #568fa8;
        border-radius: 10px;
        padding: 8px 13px;
        font-size: 12px;
    }

    .collection-badge strong {
        margin-right: 6px;
        font-size: 15px;
    }

    .collection-box {
        margin-top: 18px;
        padding: 18px;
        border-radius: 14px;
        background: #f8fafb;
        border: 1px solid #edf1f3;
    }

    .collection-top,
    .collection-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
    }

    .collection-top strong {
        font-size: 15px;
    }

    .progress-track {
        height: 12px;
        background: #e7edef;
        border-radius: 20px;
        overflow: hidden;
        margin: 13px 0 10px;

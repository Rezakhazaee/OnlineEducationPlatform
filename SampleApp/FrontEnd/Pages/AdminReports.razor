@page "/admin/reports"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>گزارش‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports" class="active">
                <span>▤</span>
                گزارش‌ها
            </a>

        </nav>

    </aside>

    <main class="admin-main">

        <div class="admin-page-header">

            <div>
                <span>مدیریت</span>
                <h1>گزارش‌ها</h1>
                <p>
                    خلاصه وضعیت دانشجویان، دوره‌ها، ثبت‌نام‌ها و پرداخت‌ها
                </p>
            </div>

            <div class="admin-page-header-actions">

                <button
                    class="admin-primary-btn"
                    @onclick="LoadReport"
                    disabled="@IsLoading">

                    @if (IsLoading)
                    {
                        <span>
                            در حال بروزرسانی...
                        </span>
                    }
                    else
                    {
                        <span>
                            به‌روزرسانی گزارش
                        </span>
                    }

                </button>

                @if (LastUpdated.HasValue)
                {
                    <span class="admin-last-updated">
                        آخرین بروزرسانی:
                        @LastUpdated.Value.ToString("HH:mm:ss")
                    </span>
                }

            </div>

        </div>

        @if (IsLoading)
        {
            <section class="admin-content-card">

                <div class="admin-empty-state">
                    در حال دریافت گزارش‌ها...
                </div>

            </section>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <section class="admin-content-card">

                <div class="admin-error">
                    @ErrorMessage
                </div>

                <div style="margin-top: 16px; text-align: center;">

                    <button
                        class="admin-primary-btn"
                        @onclick="LoadReport">

                        تلاش مجدد

                    </button>

                </div>

            </section>
        }
        else
        {
            <div class="admin-stats-grid">

                <div class="admin-stat-card">

                    <div class="admin-stat-label">
                        دانشجویان
                    </div>

                    <div class="admin-stat-value">
                        @Report.TotalStudents
                    </div>

                </div>

                <div class="admin-stat-card">

                    <div class="admin-stat-label">
                        دوره‌ها
                    </div>

                    <div class="admin-stat-value">
                        @Report.TotalCourses
                    </div>

                </div>

                <div class="admin-stat-card">

                    <div class="admin-stat-label">
                        ثبت‌نام‌ها
                    </div>

                    <div class="admin-stat-value">
                        @Report.TotalEnrollments
                    </div>

                </div>

            </div>


            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            وضعیت مالی
                        </span>

                        <h2>
                            گزارش مالی
                        </h2>
                    </div>

                </div>


                <div class="admin-financial-grid">

                    <div class="admin-financial-card">

                        <small>
                            ارزش کل ثبت‌نام‌ها
                        </small>

                        <strong>
                            @Report.TotalEnrollmentValue.ToString("N0")
                        </strong>

                        <span>
                            تومان
                        </span>

                    </div>


                    <div class="admin-financial-card">

                        <small>
                            پرداخت‌شده
                        </small>

                        <strong>
                            @Report.TotalPaid.ToString("N0")
                        </strong>

                        <span>
                            تومان
                        </span>

                    </div>


                    <div class="admin-financial-card">

                        <small>
                            مانده قابل وصول
                        </small>

                        <strong>
                            @Report.TotalRemainingAmount.ToString("N0")
                        </strong>

                        <span>
                            تومان
                        </span>

                    </div>


                    <div class="admin-financial-card">

                        <small>
                            در انتظار پرداخت
                        </small>

                        <strong>
                            @Report.TotalPending.ToString("N0")
                        </strong>

                        <span>
                            تومان
                        </span>

                    </div>


                    <div class="admin-financial-card">

                        <small>
                            لغوشده
                        </small>

                        <strong>
                            @Report.TotalCancelled.ToString("N0")
                        </strong>

                        <span>
                            تومان
                        </span>

                    </div>

                </div>

            </section>
        }

    </main>

</div>


@code {

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private ReportsSummaryDto Report { get; set; } = new();

    private DateTime? LastUpdated { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }


    private async Task LoadReport()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response =
                await client.GetAsync("api/Reports/summary");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    $"دریافت گزارش‌ها با خطای {(int)response.StatusCode} ({response.StatusCode}) مواجه شد.";

                return;
            }

            var result =
                await response.Content
                    .ReadFromJsonAsync<ReportsSummaryDto>();

            Report =
                result ?? new ReportsSummaryDto();

            LastUpdated = DateTime.Now;
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"خطا در دریافت گزارش‌ها: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }


    public class ReportsSummaryDto
    {
        public int TotalStudents { get; set; }

        public int TotalCourses { get; set; }

        public int TotalEnrollments { get; set; }

        public decimal TotalPaid { get; set; }

        public decimal TotalPending { get; set; }

        public decimal TotalCancelled { get; set; }

        public decimal TotalEnrollmentValue { get; set; }

        public decimal TotalRemainingAmount { get; set; }
    }
}
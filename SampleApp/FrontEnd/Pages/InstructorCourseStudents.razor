@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<section class="instructor-courses-card">
    <div class="instructor-card-header">
        <div>
            <small>STUDENTS</small>
            <h3>دانشجویان دوره</h3>
        </div>

        <span>@Students.Count نفر</span>
    </div>

    @if (Loading)
    {
        <div class="instructor-mini-empty">
            در حال بارگذاری دانشجویان...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="instructor-error">
            @ErrorMessage
        </div>
    }
    else if (Students.Count == 0)
    {
        <div class="instructor-mini-empty">
            هنوز دانشجویی در این دوره ثبت‌نام نکرده است.
        </div>
    }
    else
    {
        <div class="instructor-course-list">

            @foreach (var student in Students)
            {
                <div class="instructor-course-item">

                    <div class="course-item-icon">
                        @(string.IsNullOrWhiteSpace(student.StudentName)
                            ? "د"
                            : student.StudentName.Substring(0, 1))
                    </div>

                    <div class="course-item-info">
                        <strong>@student.StudentName</strong>

                        <small>
                            @student.CompletedLessons از @student.TotalLessons درس
                            · @student.ProgressPercent٪
                        </small>

                        @if (!string.IsNullOrWhiteSpace(student.Mobile))
                        {
                            <small>@student.Mobile</small>
                        }
                    </div>

                    <strong>
                        @student.ProgressPercent%
                    </strong>

                </div>
            }

        </div>
    }
</section>

@code {
    [Parameter]
    public int CourseId { get; set; }

    private readonly List<StudentProgressDto> Students = new();

    private bool Loading { get; set; } = true;
    private string? ErrorMessage { get; set; }
    private int LastLoadedCourseId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (CourseId <= 0 || CourseId == LastLoadedCourseId)
            return;

        LastLoadedCourseId = CourseId;
        await LoadStudents();
    }

    private async Task LoadStudents()
    {
        Loading = true;
        ErrorMessage = null;
        Students.Clear();

        try
        {
            await Auth.RestoreAsync();

            if (!Auth.IsLoggedIn || Auth.Role != "Instructor")
            {
                ErrorMessage = "دسترسی غیرمجاز.";
                return;
            }

            var client = Auth.CreateAuthenticatedClient();

            var result =
                await client.GetFromJsonAsync<List<StudentProgressDto>>(
                    $"api/InstructorProgress/course/{CourseId}");

            Students.AddRange(result ?? new());
        }
        catch
        {
            ErrorMessage = "دریافت دانشجویان دوره با خطا مواجه شد.";
        }
        finally
        {
            Loading = false;
        }
    }

    private class StudentProgressDto
    {
        public int EnrollmentId { get; set; }
        public int StudentId { get; set; }
        public string StudentName { get; set; } = string.Empty;
        public string? Mobile { get; set; }
        public DateTime StartDate { get; set; }
        public string Status { get; set; } = string.Empty;
        public int TotalLessons { get; set; }
        public int CompletedLessons { get; set; }
        public decimal ProgressPercent { get; set; }
    }
}

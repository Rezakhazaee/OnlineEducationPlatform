@page "/admin/payments"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>پرداخت‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <AdminSidebar ActivePage="payments" />


<main class="admin-main">

    <header class="admin-header">

        <div>
            <h1>مدیریت پرداخت‌ها</h1>

            <p>
                ثبت، بررسی و مدیریت پرداخت‌های ثبت‌نام‌ها
            </p>
        </div>

    </header>


    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="admin-error">
            @ErrorMessage
        </div>
    }


    @if (!string.IsNullOrWhiteSpace(FormError))
    {
        <div class="admin-error">
            @FormError
        </div>
    }


    <section class="admin-card">

        <div class="admin-card-header">

            <div>
                <h3>ثبت پرداخت جدید</h3>

                <p>
                    پرداخت را برای یک ثبت‌نام موجود ثبت کنید.
                </p>
            </div>

        </div>


        <div class="admin-form-grid">

            <div class="admin-form-group">

                <label>
                    ثبت‌نام
                </label>

                <select
                    class="admin-input"
                    @bind="FormEnrollmentId">

                    <option value="">
                        انتخاب ثبت‌نام
                    </option>

                    @foreach (var enrollment in Enrollments)
                    {
                        <option value="@enrollment.Id">
                            @enrollment.StudentName -
                            @enrollment.CourseTitle
                            -
                            @GetEnrollmentStatusText(enrollment.Status)
                        </option>
                    }

                </select>

            </div>


            <div class="admin-form-group">

                <label>
                    مبلغ پرداخت
                </label>

                <input
                class="admin-input"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                value="@FormAmountText"
                @oninput="OnAmountInput" />

            </div>


            <div class="admin-form-group">

                <label>
                    نوع پرداخت
                </label>

                <select
                    class="admin-input"
                    @bind="FormPaymentType">

                    <option value="FirstInstallment">
                        قسط اول
                    </option>

                    <option value="SecondInstallment">
                        قسط دوم
                    </option>

                    <option value="ThirdInstallment">
                        قسط سوم
                    </option>

                    <option value="FullPayment">
                        پرداخت کامل
                    </option>

                </select>

            </div>


            <div class="admin-form-group">

                <label>
                    وضعیت پرداخت
                </label>

                <select
                    class="admin-input"
                    @bind="FormStatus">

                    <option value="Paid">
                        پرداخت‌شده
                    </option>

                    <option value="Pending">
                        در انتظار تأیید
                    </option>

                </select>

            </div>


            <div class="admin-form-group">

                <label>
                    تاریخ پرداخت
                </label>

                <input
                    class="admin-input"
                    type="datetime-local"
                    @bind="FormPaymentDate" />

            </div>


            <div class="admin-form-group">

                <label>
                    توضیحات
                </label>

                <input
                    class="admin-input"
                    @bind="FormDescription" />

            </div>

        </div>


        @if (SelectedEnrollment != null)
        {
            <div class="payment-enrollment-summary">

                <div class="payment-summary-title">
                    اطلاعات مالی ثبت‌نام
                </div>

                <div class="payment-summary-grid">

                    <div class="payment-summary-item">
                        <span>
                            دانشجو
                        </span>

                        <strong>
                            @SelectedEnrollment.StudentName
                        </strong>
                    </div>

                    <div class="payment-summary-item">
                        <span>
                            دوره
                        </span>

                        <strong>
                            @SelectedEnrollment.CourseTitle
                        </strong>
                    </div>

                    <div class="payment-summary-item">
                        <span>
                            قیمت نهایی
                        </span>

                        <strong>
                            @FormatMoney(
                                GetEnrollmentPrice(
                                    SelectedEnrollment))
                            تومان
                        </strong>
                    </div>

                    <div class="payment-summary-item">
                        <span>
                            پرداخت‌شده
                        </span>

                        <strong>
                            @FormatMoney(
                                SelectedEnrollment.TotalPaid)
                            تومان
                        </strong>
                    </div>

                    <div class="payment-summary-item">
                        <span>
                            مانده
                        </span>

                        <strong>
                            @FormatMoney(
                                SelectedEnrollment.RemainingAmount)
                            تومان
                        </strong>
                    </div>

                    <div class="payment-summary-item">
                        <span>
                            وضعیت مالی
                        </span>

                        @if (SelectedEnrollment.PaymentStatus == "Paid")
                        {
                            <span class="course-status active">
                                تسویه‌شده
                            </span>
                        }
                        else if (SelectedEnrollment.PaymentStatus == "PartiallyPaid")
                        {
                            <span class="course-status">
                                پرداخت ناقص
                            </span>
                        }
                        else if (SelectedEnrollment.PaymentStatus == "Unpaid")
                        {
                            <span class="course-status">
                                پرداخت‌نشده
                            </span>
                        }
                        else if (SelectedEnrollment.PaymentStatus == "Overpaid")
                        {
                            <span class="course-status">
                                اضافه‌پرداخت
                            </span>
                        }
                        else
                        {
                            <span class="course-status">
                                نامشخص
                            </span>
                        }

                    </div>

                    <div class="payment-summary-item">
                        <span>
                            وضعیت ثبت‌نام
                        </span>

                        <strong>
                            @GetEnrollmentStatusText(
                                SelectedEnrollment.Status)
                        </strong>
                    </div>

                </div>

            </div>
        }


        <div class="course-form-actions">

            <button
                class="admin-primary-btn"
                @onclick="CreatePayment"
                disabled="@IsSaving">

                @(IsSaving
                    ? "در حال ثبت..."
                    : "ثبت پرداخت")

            </button>

        </div>

    </section>


    <section class="admin-card">

        <div class="admin-card-header">

            <div>
                @if (OverduePaymentsCount > 0 || DueTodayPaymentsCount > 0)
                {
                    <div class="payment-due-summary">
                        @if (OverduePaymentsCount > 0)
                        {
                            <span class="payment-due-warning">
                                @OverduePaymentsCount قسط سررسید گذشته
                            </span>
                        }
                        @if (DueTodayPaymentsCount > 0)
                        {
                            <span class="payment-due-today">
                                @DueTodayPaymentsCount قسط سررسید امروز
                            </span>
                        }
                    </div>
                }
                <h3>لیست پرداخت‌ها</h3>

                <p>
                    @Payments.Count پرداخت ثبت شده
                </p>
            </div>

        </div>


        @if (IsLoading)
        {
            <div class="admin-loading">
                در حال دریافت اطلاعات...
            </div>
        }
        else if (Payments.Count == 0)
        {
            <div class="admin-empty-state">
                هنوز پرداختی ثبت نشده است.
            </div>
        }
        else
        {
            <div class="admin-table-wrapper">

                <table class="users-table">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                دانشجو
                            </th>

                            <th>
                                دوره
                            </th>

                            <th>
                                مبلغ
                            </th>

                            <th>
                                نوع پرداخت
                            </th>

                            <th>
                                تاریخ
                            </th>

                            <th>
                                وضعیت
                            </th>

                            <th>
                                عملیات
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var payment in Payments)
                        {
                            <tr>

                                <td>
                                    @payment.Id
                                </td>

                                <td>
                                    @payment.StudentName
                                </td>

                                <td>
                                    @payment.CourseTitle
                                </td>

                                <td>
                                    @FormatMoney(payment.Amount)
                                    تومان
                                </td>

                                <td>
                                    @GetPaymentTypeText(
                                        payment.PaymentType)
                                </td>

                                <td>
                                    @payment.PaymentDate
                                        .ToLocalTime()
                                        .ToString("yyyy/MM/dd HH:mm")
                                </td>

                                <td>

                                    @if (payment.Status == "Paid")
                                    {
                                        <span class="user-status active">
                                            پرداخت‌شده
                                        </span>
                                    }
                                    else if (payment.Status == "Pending")
                                    {
                                        <span class="user-status pending">
                                            در انتظار تأیید
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="user-status inactive">
                                            لغوشده
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (payment.Status == "Pending")
                                    {
                                        <button
                                            class="admin-primary-btn"
                                            @onclick="() => ApprovePayment(payment)"
                                            disabled="@IsProcessingPayment">

                                            تأیید

                                        </button>

                                        <button
                                            class="admin-secondary-btn"
                                            @onclick="() => CancelPayment(payment)"
                                            disabled="@IsProcessingPayment">

                                            لغو

                                        </button>
                                    }
                                    else
                                    {
                                        <span>
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</main>

</div>

@code {

private List<PaymentDetailDto> Payments { get; set; } = new();

private List<EnrollmentDto> Enrollments { get; set; } = new();

private int OverduePaymentsCount =>
    Payments.Count(x => x.Status != "Paid" && x.DueStatus == "Overdue");

private int DueTodayPaymentsCount =>
    Payments.Count(x => x.Status != "Paid" && x.DueStatus == "Due");
private bool IsLoading { get; set; } = true;

private bool IsSaving { get; set; }

private bool IsProcessingPayment { get; set; }

private string? ErrorMessage { get; set; }

private string? FormError { get; set; }


private string FormEnrollmentId { get; set; } = string.Empty;

private decimal FormAmount { get; set; }

private string FormAmountText { get; set; } = string.Empty;

private string FormPaymentType { get; set; } =
    "FirstInstallment";

private string FormStatus { get; set; } = "Paid";

private DateTime FormPaymentDate { get; set; } =
    DateTime.Now;

private string FormDescription { get; set; } =
    string.Empty;


private int? SelectedEnrollmentId =>
    int.TryParse(FormEnrollmentId, out var id)
        ? id
        : null;


private EnrollmentDto? SelectedEnrollment =>
    SelectedEnrollmentId.HasValue
        ? Enrollments.FirstOrDefault(
            x => x.Id == SelectedEnrollmentId.Value)
        : null;


protected override async Task OnInitializedAsync()
{
    if (!Auth.IsLoggedIn || !Auth.IsManagementPanelUser)
    {
        Navigation.NavigateTo(Auth.IsLoggedIn ? "/admin" : "/login");
        return;
    }

    await LoadData();
}


private async Task LoadData()
{
    IsLoading = true;
    ErrorMessage = null;

    try
    {
        var client =
            Auth.CreateAuthenticatedClient();


        var paymentsTask =
            client.GetFromJsonAsync<
                List<PaymentDetailDto>>(
                "api/Payments");


        var enrollmentsTask =
            client.GetFromJsonAsync<
                List<EnrollmentDto>>(
                "api/Enrollments");


        await Task.WhenAll(
            paymentsTask,
            enrollmentsTask);


        Payments =
            paymentsTask.Result
            ?? new List<PaymentDetailDto>();


        Enrollments =
            enrollmentsTask.Result
            ?? new List<EnrollmentDto>();
    }
    catch
    {
        ErrorMessage =
            "ارتباط با سرور برقرار نشد. لطفاً مطمئن شوید Backend در حال اجرا است.";
    }
    finally
    {
        IsLoading = false;
    }
}


private async Task CreatePayment()
{
    FormError = null;


    if (!SelectedEnrollmentId.HasValue)
    {
        FormError =
            "لطفاً ثبت‌نام را انتخاب کنید.";

        return;
    }


    if (FormAmount <= 0)
    {
        FormError =
            "مبلغ پرداخت باید بیشتر از صفر باشد.";

        return;
    }


    var enrollment =
        SelectedEnrollment;


    if (enrollment == null)
    {
        FormError =
            "ثبت‌نام انتخاب‌شده پیدا نشد.";

        return;
    }


    if (enrollment.Status == "Cancelled" ||
        enrollment.Status == "Suspended")
    {
        FormError =
            "برای ثبت‌نام لغوشده یا تعلیق‌شده امکان ثبت پرداخت وجود ندارد.";

        return;
    }


    IsSaving = true;


    try
    {
        var client =
            Auth.CreateAuthenticatedClient();


        var request = new CreatePaymentDto
        {
            EnrollmentId =
                SelectedEnrollmentId.Value,

            Amount =
                FormAmount,

            PaymentDate =
                FormPaymentDate,

            PaymentType =
                FormPaymentType,

            Description =
                string.IsNullOrWhiteSpace(
                    FormDescription)
                    ? null
                    : FormDescription.Trim(),

            Status =
                FormStatus
        };


        var response =
            await client.PostAsJsonAsync(
                "api/Payments",
                request);


        if (!response.IsSuccessStatusCode)
        {
            FormError =
                await GetErrorMessage(response);

            return;
        }


        ResetForm();

        await LoadData();
    }
    catch
    {
        FormError =
            "ارتباط با سرور برقرار نشد.";
    }
    finally
    {
        IsSaving = false;
    }
}

private void OnAmountInput(ChangeEventArgs e)
{
    var input = e.Value?.ToString() ?? string.Empty;

    // حذف جداکننده‌ها و هر چیزی غیر از رقم
    var digits = new string(
        input.Where(char.IsDigit).ToArray());

    if (string.IsNullOrEmpty(digits))
    {
        FormAmount = 0;
        FormAmountText = string.Empty;
        return;
    }

    if (decimal.TryParse(
        digits,
        System.Globalization.NumberStyles.None,
        System.Globalization.CultureInfo.InvariantCulture,
        out var amount))
    {
        FormAmount = amount;
        FormAmountText = amount.ToString(
            "#,##0",
            System.Globalization.CultureInfo.InvariantCulture);
    }
}
private async Task ApprovePayment(
    PaymentDetailDto payment)
{
    FormError = null;

    IsProcessingPayment = true;


    try
    {
        var client =
            Auth.CreateAuthenticatedClient();


        var response =
            await client.PutAsync(
                $"api/Payments/{payment.Id}/pay",
                null);


        if (!response.IsSuccessStatusCode)
        {
            FormError =
                await GetErrorMessage(response);

            return;
        }


        await LoadData();
    }
    catch
    {
        FormError =
            "ارتباط با سرور برقرار نشد.";
    }
    finally
    {
        IsProcessingPayment = false;
    }
}


private async Task CancelPayment(
    PaymentDetailDto payment)
{
    FormError = null;

    IsProcessingPayment = true;


    try
    {
        var client =
            Auth.CreateAuthenticatedClient();


        var response =
            await client.PutAsync(
                $"api/Payments/{payment.Id}/cancel",
                null);


        if (!response.IsSuccessStatusCode)
        {
            FormError =
                await GetErrorMessage(response);

            return;
        }


        await LoadData();
    }
    catch
    {
        FormError =
            "ارتباط با سرور برقرار نشد.";
    }
    finally
    {
        IsProcessingPayment = false;
    }
}


private void ResetForm()
{
    FormEnrollmentId = string.Empty;

    FormAmount = 0;

    FormPaymentType =
        "FirstInstallment";

    FormStatus =
        "Paid";

    FormPaymentDate =
        DateTime.Now;

    FormDescription =
        string.Empty;

    FormError = null;
}


private decimal GetEnrollmentPrice(
    EnrollmentDto enrollment)
{
    return enrollment.CoursePartnerOrganization?
        .AgreedPrice
        ?? enrollment.CoursePrice;
}


private string FormatMoney(decimal amount)
{
    return amount.ToString("N0");
}


private string GetEnrollmentStatusText(
    string status)
{
    return status switch
    {
        "Active" => "فعال",
        "Completed" => "تکمیل‌شده",
        "Suspended" => "تعلیق‌شده",
        "Cancelled" => "لغوشده",
        _ => status
    };
}


private string GetPaymentTypeText(
    string paymentType)
{
    return paymentType switch
    {
        "FirstInstallment" => "قسط اول",
        "SecondInstallment" => "قسط دوم",
        "ThirdInstallment" => "قسط سوم",
        "FullPayment" => "پرداخت کامل",
        _ => paymentType
    };
}


private async Task<string> GetErrorMessage(
    HttpResponseMessage response)
{
    try
    {
        var error =
            await response.Content
                .ReadFromJsonAsync<ApiError>();

        return error?.Message
            ?? "عملیات با خطا مواجه شد.";
    }
    catch
    {
        return "عملیات با خطا مواجه شد.";
    }
}


public class PaymentDetailDto
{
    public int Id { get; set; }

    public int EnrollmentId { get; set; }

    public string StudentName { get; set; } =
        string.Empty;

    public string CourseTitle { get; set; } =
        string.Empty;

    public decimal Amount { get; set; }

    public DateTime PaymentDate { get; set; }

    public DateTime? DueDate { get; set; }

    public string DueStatus { get; set; } =
        string.Empty;

    public string PaymentType { get; set; } =
        string.Empty;

    public string? Description { get; set; }

    public string Status { get; set; } =
        string.Empty;
}


public class EnrollmentDto
{
    public int Id { get; set; }

    public int StudentId { get; set; }

    public string StudentName { get; set; } = string.Empty;

    public int CourseId { get; set; }

    public string CourseTitle { get; set; } = string.Empty;

    public decimal CoursePrice { get; set; }

    public decimal TotalPaid { get; set; }

    public decimal RemainingAmount { get; set; }

    public string PaymentStatus { get; set; } = string.Empty;

    public DateTime StartDate { get; set; }

    public string Status { get; set; } = string.Empty;

    public string? Description { get; set; }

    public CoursePartnerOrganizationDto? CoursePartnerOrganization { get; set; }
}


public class CoursePartnerOrganizationDto
{
    public int Id { get; set; }

    public decimal? AgreedPrice { get; set; }
}


public class CreatePaymentDto
{
    public int EnrollmentId { get; set; }

    public decimal Amount { get; set; }

    public DateTime PaymentDate { get; set; }

    public DateTime? DueDate { get; set; }

    public string DueStatus { get; set; } =
        string.Empty;

    public string PaymentType { get; set; } =
        string.Empty;

    public string? Description { get; set; }

    public string Status { get; set; } =
        "Paid";
}


public class ApiError
{
    public string? Message { get; set; }
}

}

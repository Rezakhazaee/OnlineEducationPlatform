@page "/instructor/course-content/{CourseId:int}"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout InstructorLayout

@inject AuthService Auth

<PageTitle>محتوای دوره | آموزش‌یار</PageTitle>

<div class="support-content">

    @if (IsLoading)
    {
        <section class="support-content-card">

            <div class="support-loading">

                <div class="support-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت محتوای دوره...
                </h3>

            </div>

        </section>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="support-content-card">

            <div class="support-error">

                <strong>
                    خطا
                </strong>

                <p>
                    @ErrorMessage
                </p>

            </div>

        </section>
    }
    else
    {
        <section class="support-content-card">

            <div class="support-card-header">

                <div>

                    <span>
                        آموزش
                    </span>

                    <h2>
                        @CourseTitle
                    </h2>

                </div>

                <a
                    href="/instructor/courses"
                    class="support-outline-btn">

                    ← دوره‌های من

                </a>

            </div>


            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="support-success-message">
                    @SuccessMessage
                </div>
            }


            <div class="support-followup-form">

                <div class="support-form-grid">

                    <div class="support-form-group support-form-wide">

                        <label>
                            عنوان سرفصل جدید
                        </label>

                        <input
                            class="support-form-input"
                            @bind="ModuleTitle"
                            placeholder="مثلاً فصل اول: آشنایی با Excel" />

                    </div>


                    <div class="support-form-group">

                        <label>
                            ترتیب
                        </label>

                        <input
                            class="support-form-input"
                            type="number"
                            min="0"
                            @bind="ModuleSortOrder" />

                    </div>

                </div>


                <div class="support-form-actions">

                    <button
                        type="button"
                        class="support-primary-btn"
                        disabled="@IsSaving"
                        @onclick="CreateModule">

                        @(IsSaving
                            ? "در حال ذخیره..."
                            : "افزودن سرفصل")

                    </button>

                </div>

            </div>

        </section>


        @if (Modules.Count == 0)
        {
            <section class="support-content-card">

                <div class="support-empty-state">

                    <h3>
                        هنوز سرفصلی برای این دوره ثبت نشده است.
                    </h3>

                    <p>
                        ابتدا یک سرفصل ایجاد کنید و سپس درس‌های آن را اضافه کنید.
                    </p>

                </div>

            </section>
        }
        else
        {
            @foreach (var module in Modules)
            {
                <section class="support-content-card">

                    <div class="support-card-header">

                        <div>

                            <span>
                                سرفصل @module.SortOrder
                            </span>

                            <h2>
                                @module.Title
                            </h2>

                            <small>
                                @module.LessonCount درس
                            </small>

                        </div>

                        <div class="instructor-course-actions">

                            <button
                                type="button"
                                class="support-outline-btn"
                                @onclick="() => StartLesson(module)">

                                افزودن درس

                            </button>

                            <button
                                type="button"
                                class="support-outline-btn"
                                @onclick="() => DeleteModule(module)">

                                حذف سرفصل

                            </button>

                        </div>

                    </div>


                    @if (LessonModuleId == module.Id)
                    {
                        <div class="support-followup-form">

                            <div class="support-form-grid">

                                <div class="support-form-group support-form-wide">

                                    <label>
                                        عنوان درس
                                    </label>

                                    <input
                                        class="support-form-input"
                                        @bind="LessonTitle"
                                        placeholder="مثلاً آشنایی با محیط Excel" />

                                </div>


                                <div class="support-form-group">

                                    <label>
                                        نوع محتوا
                                    </label>

                                    <select
                                        class="support-form-input"
                                        @bind="LessonContentType">

                                        <option value="Video">
                                            ویدئو
                                        </option>

                                        <option value="Text">
                                            متن
                                        </option>

                                    </select>

                                </div>


                                <div class="support-form-group">

                                    <label>
                                        مدت زمان (دقیقه)
                                    </label>

                                    <input
                                        class="support-form-input"
                                        type="number"
                                        min="0"
                                        @bind="LessonDurationMinutes" />

                                </div>


                                <div class="support-form-group">

                                    <label>
                                        ترتیب درس
                                    </label>

                                    <input
                                        class="support-form-input"
                                        type="number"
                                        min="0"
                                        @bind="LessonSortOrder" />

                                </div>


                                <div class="support-form-group support-form-wide">

                                    <label>
                                        آدرس محتوا
                                    </label>

                                    <input
                                        class="support-form-input"
                                        @bind="LessonContentUrl"
                                        placeholder="آدرس ویدئو یا محتوای آنلاین" />

                                </div>


                                <div class="support-form-group support-form-wide">

                                    <label>
                                        توضیحات درس
                                    </label>

                                    <textarea
                                        class="support-form-input support-form-textarea"
                                        @bind="LessonDescription"></textarea>

                                </div>

                            </div>


                            <div class="support-form-actions">

                                <button
                                    type="button"
                                    class="support-primary-btn"
                                    disabled="@IsSaving"
                                    @onclick="CreateLesson">

                                    @(IsSaving
                                        ? "در حال ذخیره..."
                                        : "ثبت درس")

                                </button>

                                <button
                                    type="button"
                                    class="support-outline-btn"
                                    @onclick="CancelLesson">

                                    انصراف

                                </button>

                            </div>

                        </div>
                    }


                    @if (LessonsByModule.TryGetValue(module.Id, out var lessons) &&
                         lessons.Count > 0)
                    {
                        <div class="support-enrollments-list">

                            @foreach (var lesson in lessons)
                            {
                                <div class="support-enrollment-row">

                                    <div class="support-enrollment-main">

                                        <strong>
                                            @lesson.SortOrder. @lesson.Title
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(lesson.Description))
                                        {
                                            <span>
                                                @lesson.Description
                                            </span>
                                        }

                                        <span>
                                            نوع:
                                            @(lesson.ContentType == "Video"
                                                ? "ویدئو"
                                                : "متن")
                                        </span>

                                        @if (lesson.DurationMinutes > 0)
                                        {
                                            <span>
                                                مدت:
                                                @lesson.DurationMinutes دقیقه
                                            </span>
                                        }

                                    </div>


                                    <div>

                                        <small>
                                            وضعیت
                                        </small>

                                        <span class="@(lesson.IsActive
                                            ? "status-active"
                                            : "status-cancelled")">

                                            @(lesson.IsActive
                                                ? "فعال"
                                                : "غیرفعال")

                                        </span>

                                        @if (lesson.IsFreePreview)
                                        {
                                            <small>
                                                پیش‌نمایش رایگان
                                            </small>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="support-empty-state">

                            <p>
                                هنوز در این سرفصل درسی ثبت نشده است.
                            </p>

                        </div>
                    }

                </section>
            }
        }
    }

</div>


@code {

    [Parameter]
    public int CourseId { get; set; }

    private string CourseTitle { get; set; } = string.Empty;

    private List<CourseModuleDto> Modules { get; set; } = new();

    private Dictionary<int, List<CourseLessonDto>> LessonsByModule { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private bool IsSaving { get; set; }

    private string? ErrorMessage { get; set; }

    private string? SuccessMessage { get; set; }


    private string ModuleTitle { get; set; } = string.Empty;

    private int ModuleSortOrder { get; set; }


    private int? LessonModuleId { get; set; }

    private string LessonTitle { get; set; } = string.Empty;

    private string LessonDescription { get; set; } = string.Empty;

    private string LessonContentType { get; set; } = "Video";

    private string LessonContentUrl { get; set; } = string.Empty;

    private int LessonDurationMinutes { get; set; }

    private int LessonSortOrder { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.IsInstructor)
        {
            return;
        }

        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var course =
                await client.GetFromJsonAsync<CourseDto>(
                    $"api/Courses/{CourseId}");

            if (course == null)
            {
                ErrorMessage = "دوره پیدا نشد.";
                return;
            }

            CourseTitle = course.Title;

            Modules =
                await client.GetFromJsonAsync<List<CourseModuleDto>>(
                    $"api/CourseModules/course/{CourseId}")
                ?? new List<CourseModuleDto>();

            LessonsByModule.Clear();

            foreach (var module in Modules)
            {
                var lessons =
                    await client.GetFromJsonAsync<List<CourseLessonDto>>(
                        $"api/CourseLessons/module/{module.Id}")
                    ?? new List<CourseLessonDto>();

                LessonsByModule[module.Id] = lessons;
            }
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task CreateModule()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (string.IsNullOrWhiteSpace(ModuleTitle))
        {
            ErrorMessage = "عنوان سرفصل الزامی است.";
            return;
        }

        IsSaving = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response =
                await client.PostAsJsonAsync(
                    "api/CourseModules",
                    new CreateCourseModuleDto
                    {
                        CourseId = CourseId,
                        Title = ModuleTitle.Trim(),
                        SortOrder = ModuleSortOrder,
                        IsActive = true
                    });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }

            ModuleTitle = string.Empty;
            ModuleSortOrder++;

            SuccessMessage =
                "سرفصل با موفقیت اضافه شد.";

            await LoadData();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private void StartLesson(CourseModuleDto module)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        LessonModuleId = module.Id;
        LessonTitle = string.Empty;
        LessonDescription = string.Empty;
        LessonContentType = "Video";
        LessonContentUrl = string.Empty;
        LessonDurationMinutes = 0;
        LessonSortOrder = module.LessonCount;
    }


    private void CancelLesson()
    {
        LessonModuleId = null;

        LessonTitle = string.Empty;
        LessonDescription = string.Empty;
        LessonContentType = "Video";
        LessonContentUrl = string.Empty;
        LessonDurationMinutes = 0;
        LessonSortOrder = 0;
    }


    private async Task CreateLesson()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (!LessonModuleId.HasValue)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(LessonTitle))
        {
            ErrorMessage = "عنوان درس الزامی است.";
            return;
        }

        if (LessonDurationMinutes < 0)
        {
            ErrorMessage = "مدت زمان نمی‌تواند منفی باشد.";
            return;
        }

        IsSaving = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response =
                await client.PostAsJsonAsync(
                    "api/CourseLessons",
                    new CreateCourseLessonDto
                    {
                        CourseModuleId = LessonModuleId.Value,
                        Title = LessonTitle.Trim(),
                        Description =
                            string.IsNullOrWhiteSpace(LessonDescription)
                                ? null
                                : LessonDescription.Trim(),
                        ContentType = LessonContentType,
                        ContentUrl =
                            string.IsNullOrWhiteSpace(LessonContentUrl)
                                ? null
                                : LessonContentUrl.Trim(),
                        DurationMinutes = LessonDurationMinutes,
                        SortOrder = LessonSortOrder,
                        IsActive = true,
                        IsFreePreview = false
                    });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }

            SuccessMessage =
                "درس با موفقیت اضافه شد.";

            LessonModuleId = null;

            await LoadData();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private async Task DeleteModule(CourseModuleDto module)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response =
                await client.DeleteAsync(
                    $"api/CourseModules/{module.Id}");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }

            SuccessMessage =
                "سرفصل و درس‌های آن حذف شدند.";

            await LoadData();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
    }


    private async Task<string> GetErrorMessage(
        HttpResponseMessage response)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ApiError>();

            if (!string.IsNullOrWhiteSpace(error?.Message))
            {
                return error.Message;
            }
        }
        catch
        {
        }

        return "عملیات انجام نشد.";
    }


    public class CourseDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public decimal Price { get; set; }

        public string DeliveryType { get; set; } = "Online";

        public int? InstructorId { get; set; }

        public bool IsActive { get; set; }
    }


    public class CourseModuleDto
    {
        public int Id { get; set; }

        public int CourseId { get; set; }

        public string Title { get; set; } = string.Empty;

        public int SortOrder { get; set; }

        public bool IsActive { get; set; }

        public int LessonCount { get; set; }
    }


    public class CreateCourseModuleDto
    {
        public int CourseId { get; set; }

        public string Title { get; set; } = string.Empty;

        public int SortOrder { get; set; }

        public bool IsActive { get; set; } = true;
    }


    public class CourseLessonDto
    {
        public int Id { get; set; }

        public int CourseModuleId { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string ContentType { get; set; } = "Video";

        public string? ContentUrl { get; set; }

        public int DurationMinutes { get; set; }

        public int SortOrder { get; set; }

        public bool IsActive { get; set; }

        public bool IsFreePreview { get; set; }
    }


    public class CreateCourseLessonDto
    {
        public int CourseModuleId { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string ContentType { get; set; } = "Video";

        public string? ContentUrl { get; set; }

        public int DurationMinutes { get; set; }

        public int SortOrder { get; set; }

        public bool IsActive { get; set; } = true;

        public bool IsFreePreview { get; set; } = false;
    }


    public class ApiError
    {
        public string? Message { get; set; }
    }

}

@page "/support"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout SupportLayout

@inject AuthService Auth

<PageTitle>پنل پشتیبانی | آموزش‌یار</PageTitle>

<div class="support-content">

    @if (IsLoading)
    {
        <div class="support-loading">
            <div class="support-loading-icon">↻</div>

            <h3>
                در حال دریافت اطلاعات...
            </h3>

            <p>
                اطلاعات دانشجویان و امور پشتیبانی در حال بارگذاری است.
            </p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="support-error">

            <strong>
                خطا در دریافت اطلاعات
            </strong>

            <p>
                @ErrorMessage
            </p>

            <button
                type="button"
                class="support-outline-btn"
                @onclick="LoadDashboard">

                تلاش مجدد

            </button>

        </div>
    }
    else
    {
        <section class="support-welcome-card">

            <div>
                <span>
                    پشتیبانی آموزشی
                </span>

                <h2>
                    دانشجویان تحت پشتیبانی شما
                </h2>

                <p>
                    در این بخش فقط دانشجویان، ثبت‌نام‌ها و پرداخت‌های اختصاص‌یافته به شما نمایش داده می‌شود.
                </p>
            </div>

        </section>


        <section class="support-stats">

            <div class="support-stat-card">

                <span class="support-stat-icon">
                    ♙
                </span>

                <div>
                    <small>
                        دانشجویان من
                    </small>

                    <strong>
                        @Students.Count
                    </strong>
                </div>

            </div>


            <div class="support-stat-card">

                <span class="support-stat-icon">
                    ✓
                </span>

                <div>
                    <small>
                        ثبت‌نام‌ها
                    </small>

                    <strong>
                        @Enrollments.Count
                    </strong>
                </div>

            </div>


            <div class="support-stat-card">

                <span class="support-stat-icon">
                    ₿
                </span>

                <div>
                    <small>
                        پرداخت‌شده
                    </small>

                    <strong>
                        @TotalPaid.ToString("N0")
                    </strong>

                    <span>
                        تومان
                    </span>
                </div>

            </div>


            <div class="support-stat-card">

                <span class="support-stat-icon">
                    !
                </span>

                <div>
                    <small>
                        باقی‌مانده
                    </small>

                    <strong>
                        @TotalRemaining.ToString("N0")
                    </strong>

                    <span>
                        تومان
                    </span>
                </div>

            </div>

        </section>


        <section class="support-content-card">

            <div class="support-card-header">

                <div>
                    <span>
                        دانشجویان اختصاص‌یافته
                    </span>

                    <h2>
                        دانشجویان من
                    </h2>
                </div>

                <a
                    href="/admin/students"
                    class="support-outline-btn">

                    مشاهده همه

                </a>

            </div>


            @if (Students.Count == 0)
            {
                <div class="support-empty-state">

                    <div class="support-empty-icon">
                        ♙
                    </div>

                    <h3>
                        دانشجویی به شما اختصاص داده نشده است
                    </h3>

                    <p>
                        دانشجویان اختصاص‌یافته به شما در این بخش نمایش داده می‌شوند.
                    </p>

                </div>
            }
            else
            {
                <div class="support-students-list">

                    @foreach (var student in Students.Take(5))
                    {
                        <div class="support-student-row">

                            <div class="support-student-main">

                                <div class="support-student-avatar">
                                    @GetInitials(student)
                                </div>

                                <div>
                                    <strong>
                                        @student.FirstName @student.LastName
                                    </strong>

                                    <small>
                                        کد ملی: @student.NationalCode
                                    </small>

                                </div>

                            </div>

                            <div class="support-student-contact">

                                <small>
                                    موبایل
                                </small>

                                <strong>
                                    @student.Mobile
                                </strong>

                            </div>

                            <div class="support-student-date">

                                <small>
                                    تاریخ ثبت
                                </small>

                                <strong>
                                    @student.CreatedDate.ToString("yyyy/MM/dd")
                                </strong>

                            </div>

                        </div>
                    }

                </div>
            }

        </section>


        <section class="support-content-card">

            <div class="support-card-header">

                <div>
                    <span>
                        وضعیت ثبت‌نام
                    </span>

                    <h2>
                        آخرین ثبت‌نام‌ها
                    </h2>
                </div>

                <a
                    href="/admin/enrollments"
                    class="support-outline-btn">

                    مشاهده همه

                </a>

            </div>


            @if (Enrollments.Count == 0)
            {
                <div class="support-empty-state">

                    <h3>
                        هنوز ثبت‌نامی وجود ندارد
                    </h3>

                </div>
            }
            else
            {
                <div class="support-enrollments-list">

                    @foreach (var enrollment in Enrollments
                        .OrderByDescending(x => x.StartDate)
                        .Take(5))
                    {
                        <div class="support-enrollment-row">

                            <div class="support-enrollment-main">

                                <strong>
                                    @enrollment.StudentName
                                </strong>

                                <span>
                                    @enrollment.CourseTitle
                                </span>

                            </div>

                            <div class="support-enrollment-status">

                                <small>
                                    وضعیت
                                </small>

                                <span class="@GetEnrollmentStatusClass(enrollment.Status)">
                                    @GetEnrollmentStatusText(enrollment.Status)
                                </span>

                            </div>

                            <div class="support-enrollment-money">

                                <small>
                                    باقی‌مانده
                                </small>

                                <strong>
                                    @enrollment.RemainingAmount.ToString("N0")
                                    تومان
                                </strong>

                            </div>

                        </div>
                    }

                </div>
            }

        </section>


        <section class="support-content-card">

            <div class="support-card-header">

                <div>
                    <span>
                        امور مالی
                    </span>

                    <h2>
                        آخرین پرداخت‌ها
                    </h2>
                </div>

                <a
                    href="/admin/payments"
                    class="support-outline-btn">

                    مشاهده همه

                </a>

            </div>


            @if (Payments.Count == 0)
            {
                <div class="support-empty-state">

                    <h3>
                        هنوز پرداختی ثبت نشده است
                    </h3>

                </div>
            }
            else
            {
                <div class="support-payments-list">

                    @foreach (var payment in Payments
                        .OrderByDescending(x => x.PaymentDate)
                        .Take(5))
                    {
                        <div class="support-payment-row">

                            <div class="support-payment-item">

                                <small>
                                    دوره:
                                </small>

                                <strong>
                                    @payment.CourseTitle
                                </strong>

                            </div>

                            <div class="support-payment-item">

                                <small>
                                    تاریخ پرداخت:
                                </small>

                                <strong>
                                    @payment.PaymentDate.ToString("yyyy/MM/dd")
                                </strong>

                            </div>

                            <div class="support-payment-item">

                                <small>
                                    نوع پرداخت:
                                </small>

                                <strong>
                                    @GetPaymentTypeText(payment.PaymentType)
                                </strong>

                            </div>

                            <div class="support-payment-item">

                                <small>
                                    وضعیت:
                                </small>

                                <span class="@GetPaymentStatusClass(payment.Status)">
                                    @GetPaymentStatusText(payment.Status)
                                </span>

                            </div>

                            <div class="support-payment-item support-payment-amount">

                                <small>
                                    مبلغ:
                                </small>

                                <strong>
                                    @payment.Amount.ToString("N0") تومان
                                </strong>

                            </div>

                        </div>
                    }

                </div>
            }

        </section>

    }

</div>


@code {

    private List<SupportStudentDto> Students { get; set; } = new();

    private List<SupportEnrollmentDto> Enrollments { get; set; } = new();

    private List<SupportPaymentDto> Payments { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }


    private decimal TotalPaid =>
        Enrollments.Sum(x => x.TotalPaid);


    private decimal TotalRemaining =>
        Enrollments.Sum(x => x.RemainingAmount);


    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.IsSupport)
        {
            return;
        }

        await LoadDashboard();
    }


    private async Task LoadDashboard()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Students =
                await client.GetFromJsonAsync<List<SupportStudentDto>>(
                    "api/Students")
                ?? new List<SupportStudentDto>();

            Enrollments =
                await client.GetFromJsonAsync<List<SupportEnrollmentDto>>(
                    "api/Enrollments")
                ?? new List<SupportEnrollmentDto>();

            Payments =
                await client.GetFromJsonAsync<List<SupportPaymentDto>>(
                    "api/Payments")
                ?? new List<SupportPaymentDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private string GetInitials(SupportStudentDto student)
    {
        var first =
            string.IsNullOrWhiteSpace(student.FirstName)
                ? "د"
                : student.FirstName.Trim()[0].ToString();

        var last =
            string.IsNullOrWhiteSpace(student.LastName)
                ? ""
                : student.LastName.Trim()[0].ToString();

        return first + last;
    }


    private string GetEnrollmentStatusText(string status)
    {
        return status switch
        {
            "Active" => "فعال",
            "Completed" => "تکمیل‌شده",
            "Suspended" => "معلق",
            "Cancelled" => "لغوشده",
            _ => status
        };
    }


    private string GetEnrollmentStatusClass(string status)
    {
        return status switch
        {
            "Active" => "status-active",
            "Completed" => "status-completed",
            "Suspended" => "status-suspended",
            "Cancelled" => "status-cancelled",
            _ => "status-default"
        };
    }


    private string GetPaymentTypeText(string type)
    {
        return type switch
        {
            "FullPayment" => "پرداخت کامل",
            "FirstInstallment" => "قسط اول",
            "SecondInstallment" => "قسط دوم",
            "ThirdInstallment" => "قسط سوم",
            _ => type
        };
    }


    private string GetPaymentStatusText(string status)
    {
        return status switch
        {
            "Paid" => "پرداخت‌شده",
            "Pending" => "در انتظار پرداخت",
            "Cancelled" => "لغوشده",
            "Unpaid" => "پرداخت‌نشده",
            _ => status
        };
    }


    private string GetPaymentStatusClass(string status)
    {
        return status switch
        {
            "Paid" => "payment-paid",
            "Pending" => "payment-pending",
            "Cancelled" => "payment-cancelled",
            _ => "payment-default"
        };
    }


    public class SupportStudentDto
    {
        public int Id { get; set; }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        public string NationalCode { get; set; } = string.Empty;

        public DateTime? BirthDate { get; set; }

        public string Mobile { get; set; } = string.Empty;

        public string? Address { get; set; }

        public string? GuardianName { get; set; }

        public string? GuardianMobile { get; set; }

        public int? MarketingUserId { get; set; }

        public int? SupportUserId { get; set; }

        public DateTime CreatedDate { get; set; }
    }


    public class SupportEnrollmentDto
    {
        public int Id { get; set; }

        public string StudentName { get; set; } = string.Empty;

        public string CourseTitle { get; set; } = string.Empty;

        public decimal CoursePrice { get; set; }

        public decimal TotalPaid { get; set; }

        public decimal RemainingAmount { get; set; }

        public string PaymentStatus { get; set; } = string.Empty;

        public DateTime StartDate { get; set; }

        public string Status { get; set; } = string.Empty;
    }


    public class SupportPaymentDto
    {
        public int Id { get; set; }

        public string CourseTitle { get; set; } = string.Empty;

        public decimal Amount { get; set; }

        public DateTime PaymentDate { get; set; }

        public string PaymentType { get; set; } = string.Empty;

        public string Status { get; set; } = string.Empty;

        public int EnrollmentId { get; set; }
    }

}

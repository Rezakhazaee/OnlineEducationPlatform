@page "/education"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>پنل آموزش | آموزش‌یار</PageTitle>

<div class="education-page">

    <aside class="education-sidebar">

        <div class="education-brand">
            <div class="education-logo">آ</div>
            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل آموزش</small>
            </div>
        </div>

        <nav class="education-nav">

            <button class="education-nav-btn @(ActiveTab == "students" ? "active" : "")"
                    @onclick='() => ActiveTab = "students"'>
                دانشجویان
            </button>

            <button class="education-nav-btn @(ActiveTab == "enrollments" ? "active" : "")"
                    @onclick='() => ActiveTab = "enrollments"'>
                ثبت‌نام‌ها
            </button>

            <button class="education-nav-btn @(ActiveTab == "courses" ? "active" : "")"
                    @onclick='() => ActiveTab = "courses"'>
                محتوای دوره‌ها
            </button>

        </nav>

        <button class="education-logout" @onclick="Logout">
            خروج
        </button>

    </aside>

    <main class="education-main">

        <header class="education-topbar">
            <div>
                <h1>پنل آموزش</h1>
                <p>مدیریت فرآیندهای آموزشی</p>
            </div>

            <div class="education-user">
                <strong>@Auth.FullName</strong>
                <span>کارشناس آموزش</span>
            </div>
        </header>

        @if (IsLoading)
        {
            <div class="education-card">
                در حال دریافت اطلاعات...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="education-error">
                @ErrorMessage
            </div>
        }
        else
        {
            @if (ActiveTab == "students")
            {
                <section class="education-card">
                    <div class="education-card-header">
                        <div>
                            <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                            <h2>دانشجویان</h2>
                            <a href="/education/students/new" class="education-primary-btn">دانشجوی جدید</a>
                        </div>
                            <span>@Students.Count دانشجو</span>
                        </div>
                    </div>

                    @if (Students.Count == 0)
                    {
                        <div class="education-empty">
                            دانشجویی ثبت نشده است.
                        </div>
                    }
                    else
                    {
                        <div class="education-table-wrapper">
                            <table class="education-table">
                                <thead>
                                    <tr>
                                        <th>نام</th>
                                        <th>موبایل</th>
                                        <th>کد ملی</th>
                                        <th>پشتیبان</th>
                                        <th>تاریخ ایجاد</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Students)
                                    {
                                        <tr>
                                            <td>@student.FirstName @student.LastName</td>
                                            <td>@student.Mobile</td>
                                            <td>@student.NationalCode</td>
                                            <td>@student.SupportUserId</td>
                                            <td><a class="education-btn secondary" href="/education/students/@student.Id/edit">ویرایش</a></td>
                                            <td>@student.CreatedDate.ToString("yyyy/MM/dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            @if (ActiveTab == "enrollments")
            {
                <section class="education-card">
                    <div class="education-card-header">
                        <div>
                            <h2>ثبت‌نام‌ها</h2>
                            <a class="education-btn primary" href="/education/enrollments/new">ثبت‌نام جدید</a>
                            <span>@Enrollments.Count ثبت‌نام</span>
                        </div>
                    </div>

                    @if (Enrollments.Count == 0)
                    {
                        <div class="education-empty">
                            ثبت‌نامی ثبت نشده است.
                        </div>
                    }
                    else
                    {
                        <div class="education-table-wrapper">
                            <table class="education-table">
                                <thead>
                                    <tr>
                                        <th>دانشجو</th>
                                        <th>دوره</th>
                                        <th>پشتیبان</th>
                                        <th>استاد</th>
                                        <th>شروع</th>
                                        <th>وضعیت</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Enrollments)
                                    {
                                        <tr>
                                            <td>@item.StudentName</td>
                                            <td>@item.CourseTitle</td>
                                            <td>@item.SupportUserName</td>
                                            <td>@item.InstructorName</td>
                                            <td>@item.StartDate.ToString("yyyy/MM/dd")</td>
                                            <td><a class="education-btn secondary" href="/education/enrollments/@item.Id/edit">ویرایش</a></td>
                                            <td>@item.Status</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            @if (ActiveTab == "courses")
            {
                <section class="education-card">

                    <div class="education-card-header">
                        <div>
                            <h2>محتوای دوره‌ها</h2>
                            <span>مشاهده سرفصل‌ها و درس‌ها</span>
                        </div>
                    </div>

                    <div class="education-course-select">
                        <label>دوره</label>

                        <select @bind="SelectedCourseId" @bind:after="LoadCourseContent">
                            <option value="0">انتخاب دوره</option>

                            @foreach (var course in Courses)
                            {
                                <option value="@course.Id">@course.Title</option>
                            }
                        </select>
                    </div>

                    @if (SelectedCourseId > 0)
                    {
                        @if (Modules.Count == 0)
                        {
                            <div class="education-empty">
                                برای این دوره هنوز سرفصلی ثبت نشده است.
                            </div>
                        }
                        else
                        {
                            @foreach (var module in Modules)
                            {
                                <div class="education-module">
                                    <div class="education-module-title">
                                        @module.Title
                                    </div>

                                    @if (module.Lessons.Count == 0)
                                    {
                                        <div class="education-lesson-empty">
                                            درسی ثبت نشده است.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var lesson in module.Lessons)
                                        {
                                            <div class="education-lesson">
                                                <div>
                                                    <strong>@lesson.Title</strong>
                                                    <small>
                                                        @lesson.ContentType
                                                        @if (lesson.DurationMinutes > 0)
                                                        {
                                                            <span> | @lesson.DurationMinutes دقیقه</span>
                                                        }
                                                    </small>
                                                </div>

                                                @if (lesson.IsFreePreview)
                                                {
                                                    <span class="education-badge">
                                                        پیش‌نمایش رایگان
                                                    </span>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="education-empty">
                            یک دوره را انتخاب کنید.
                        </div>
                    }

                </section>
            }
        }

    </main>
</div>

@code {

    private string ActiveTab { get; set; } = "students";
    [SupplyParameterFromQuery(Name = "tab")]
    private string? Tab { get; set; }


    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private List<StudentDto> Students { get; set; } = new();

    private List<EnrollmentDto> Enrollments { get; set; } = new();

    private List<CourseDto> Courses { get; set; } = new();

    private List<CourseModuleDto> Modules { get; set; } = new();

    private int _selectedCourseId;

    private int SelectedCourseId
    {
        get => _selectedCourseId;
        set => _selectedCourseId = value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Auth.RestoreAsync();

        if (Tab == "enrollments" || Tab == "courses" || Tab == "students")
            ActiveTab = Tab;


        if (!Auth.IsLoggedIn || Auth.Role != "EducationStaff")
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Students =
                await client.GetFromJsonAsync<List<StudentDto>>(
                    "api/Students"
                ) ?? new();

            Enrollments =
                await client.GetFromJsonAsync<List<EnrollmentDto>>(
                    "api/Enrollments"
                ) ?? new();

            Courses =
                await client.GetFromJsonAsync<List<CourseDto>>(
                    "api/PublicCourses"
                ) ?? new();
        }
        catch
        {
            ErrorMessage = "دریافت اطلاعات از سرور با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadCourseContent()
    {
        Modules = new();

        if (SelectedCourseId <= 0)
            return;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var moduleResult =
                await client.GetFromJsonAsync<List<CourseModuleDto>>(
                    $"api/CourseModules/course/{SelectedCourseId}"
                ) ?? new();

            Modules = moduleResult;

            foreach (var module in Modules)
            {
                module.Lessons =
                    await client.GetFromJsonAsync<List<CourseLessonDto>>(
                        $"api/CourseLessons/module/{module.Id}"
                    ) ?? new();
            }
        }
        catch
        {
            ErrorMessage = "دریافت محتوای دوره با خطا مواجه شد.";
        }
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public class StudentDto
    {
        public int Id { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? NationalCode { get; set; }
        public DateTime? BirthDate { get; set; }
        public string? Mobile { get; set; }
        public string? Address { get; set; }
        public string? GuardianName { get; set; }
        public string? GuardianMobile { get; set; }
        public int? MarketingUserId { get; set; }
        public int? SupportUserId { get; set; }
        public DateTime CreatedDate { get; set; }
    }

    public class EnrollmentDto
    {
        public int Id { get; set; }
        public int StudentId { get; set; }
        public string StudentName { get; set; } = "";
        public int CourseId { get; set; }
        public string CourseTitle { get; set; } = "";
        public int? SupportUserId { get; set; }
        public string? SupportUserName { get; set; }
        public int? InstructorId { get; set; }
        public string? InstructorName { get; set; }
        public DateTime StartDate { get; set; }
        public string Status { get; set; } = "";
    }

    public class CourseDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
    }

    public class CourseModuleDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public List<CourseLessonDto> Lessons { get; set; } = new();
    }

    public class CourseLessonDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string ContentType { get; set; } = "";
        public int DurationMinutes { get; set; }
        public bool IsFreePreview { get; set; }
    }
}

@page "/student/lesson/{CourseId:int}/{LessonId:int}"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout StudentLayout

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>مشاهده درس | آموزش‌یار</PageTitle>

<div class="student-page">

    @if (IsLoading)
    {
        <section class="student-content-card">
            <div class="student-loading">
                در حال بارگذاری درس...
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="student-content-card">

            <div class="student-error">

                <strong>
                    دسترسی به درس
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <a
                    href="/student/courses"
                    class="student-course-details-btn">

                    ← بازگشت به دوره‌ها

                </a>

            </div>

        </section>
    }
    else if (Lesson != null)
    {
        <section class="student-content-card">

            <div class="student-content-header">

                <div>

                    <small>
                        درس @Lesson.SortOrder
                    </small>

                    <h1>
                        @Lesson.Title
                    </h1>

                    <p>
                        دوره:
                        @CourseTitle
                    </p>

                </div>

                <a
                    href="/student/course-content/@CourseId"
                    class="student-course-details-btn">

                    ← محتوای دوره

                </a>

            </div>


            <div style="margin-top:20px;">

                <small>
                    نوع محتوا:
                    @(Lesson.ContentType == "Video" ? "ویدئو" : "متن")
                </small>

                @if (Lesson.DurationMinutes > 0)
                {
                    <small style="margin-right:15px;">
                        مدت:
                        @Lesson.DurationMinutes دقیقه
                    </small>
                }

            </div>


            @if (!string.IsNullOrWhiteSpace(Lesson.Description))
            {
                <div style="margin-top:20px;">

                    <h3>
                        توضیحات درس
                    </h3>

                    <p>
                        @Lesson.Description
                    </p>

                </div>
            }


            @if (Lesson.ContentType == "Video" &&
                 !string.IsNullOrWhiteSpace(Lesson.ContentUrl))
            {
                <div style="margin-top:25px;">

                    <iframe
                        src="@Lesson.ContentUrl"
                        title="@Lesson.Title"
                        width="100%"
                        height="500"
                        style="border:0; border-radius:12px;"
                        allowfullscreen>
                    </iframe>

                    <div style="margin-top:12px;">

                        <a
                            href="@Lesson.ContentUrl"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="student-course-details-btn">

                            باز کردن ویدئو در صفحه جدید

                        </a>

                    </div>

                </div>
            }
            else if (Lesson.ContentType == "Text" &&
                     !string.IsNullOrWhiteSpace(Lesson.ContentUrl))
            {
                <div style="margin-top:25px;">

                    <div class="student-content-card">

                        <h3>
                            محتوای متنی
                        </h3>

                        <p>
                            محتوای این درس در لینک زیر قرار دارد.
                        </p>

                        <a
                            href="@Lesson.ContentUrl"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="student-course-details-btn">

                            مشاهده محتوای متنی

                        </a>

                    </div>

                </div>
            }
            else
            {
                <div class="student-empty-state" style="margin-top:25px;">

                    <h3>
                        محتوای این درس هنوز منتشر نشده است.
                    </h3>

                </div>
            }


            <div style="margin-top:25px;">

                <button
                    type="button"
                    class="student-course-details-btn"
                    disabled="@IsSavingProgress"
                    @onclick="ToggleProgress">

                    @(IsCompleted
                        ? "✓ تکمیل‌شده"
                        : "علامت‌گذاری به‌عنوان تکمیل‌شده")

                </button>

            </div>


            @if (HasPreviousLesson || HasNextLesson)
            {
                <div style="
                    display:flex;
                    justify-content:space-between;
                    gap:12px;
                    margin-top:30px;
                    flex-wrap:wrap;">

                    @if (HasPreviousLesson)
                    {
                        <a
                            href="/student/lesson/@CourseId/@PreviousLesson!.Id"
                            class="student-course-details-btn">

                            ← درس قبلی

                        </a>
                    }
                    else
                    {
                        <span></span>
                    }

                    @if (HasNextLesson)
                    {
                        <a
                            href="/student/lesson/@CourseId/@NextLesson!.Id"
                            class="student-course-details-btn">

                            درس بعدی →

                        </a>
                    }

                </div>
            }

        </section>
    }

</div>


@code {

    [Parameter]
    public int CourseId { get; set; }

    [Parameter]
    public int LessonId { get; set; }


    private StudentCourseContentDto? Content { get; set; }

    private StudentCourseLessonDto? Lesson { get; set; }

    private StudentCourseLessonDto? PreviousLesson { get; set; }

    private StudentCourseLessonDto? NextLesson { get; set; }

    private int EnrollmentId { get; set; }

    private string CourseTitle =>
        Content?.CourseTitle ?? string.Empty;

    private bool IsLoading { get; set; } = true;

    private bool IsSavingProgress { get; set; }

    private bool IsCompleted { get; set; }

    private string? ErrorMessage { get; set; }


    private bool HasPreviousLesson =>
        PreviousLesson != null;

    private bool HasNextLesson =>
        NextLesson != null;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || !Auth.IsStudent)
        {
            Navigation.NavigateTo(
                $"/login?returnUrl=/student/lesson/{CourseId}/{LessonId}",
                true);

            return;
        }

        await LoadData();

        StateHasChanged();
    }


    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var enrollments =
                await client.GetFromJsonAsync<List<EnrollmentDto>>(
                    "api/Enrollments/my")
                ?? new List<EnrollmentDto>();

            var enrollment =
                enrollments.FirstOrDefault(x =>
                    x.CourseId == CourseId &&
                    x.Status == "Active");

            if (enrollment == null)
            {
                ErrorMessage =
                    "شما در این دوره ثبت‌نام فعال ندارید.";

                return;
            }

            EnrollmentId = enrollment.Id;


            Content =
                await client.GetFromJsonAsync<StudentCourseContentDto>(
                    $"api/StudentCourseContent/{CourseId}");


            if (Content == null)
            {
                ErrorMessage =
                    "محتوای دوره پیدا نشد.";

                return;
            }


            var allLessons =
                Content.Modules
                    .OrderBy(x => x.SortOrder)
                    .SelectMany(x =>
                        x.Lessons
                            .OrderBy(l => l.SortOrder)
                            .ThenBy(l => l.Id))
                    .ToList();


            Lesson =
                allLessons.FirstOrDefault(x =>
                    x.Id == LessonId);


            if (Lesson == null)
            {
                ErrorMessage =
                    "درس مورد نظر پیدا نشد.";

                return;
            }


            var lessonIndex =
                allLessons.FindIndex(x =>
                    x.Id == LessonId);


            if (lessonIndex > 0)
            {
                PreviousLesson =
                    allLessons[lessonIndex - 1];
            }


            if (lessonIndex >= 0 &&
                lessonIndex < allLessons.Count - 1)
            {
                NextLesson =
                    allLessons[lessonIndex + 1];
            }


            var progress =
                await client.GetFromJsonAsync<List<LessonProgressDto>>(
                    $"api/LessonProgress/enrollment/{EnrollmentId}")
                ?? new List<LessonProgressDto>();


            var currentProgress =
                progress.FirstOrDefault(x =>
                    x.CourseLessonId == LessonId);


            IsCompleted =
                currentProgress?.IsCompleted ?? false;
        }
        catch
        {
            ErrorMessage =
                "دریافت اطلاعات درس با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task ToggleProgress()
    {
        if (Lesson == null ||
            EnrollmentId <= 0)
        {
            return;
        }

        ErrorMessage = null;
        IsSavingProgress = true;

        try
        {
            var client =
                Auth.CreateAuthenticatedClient();

            var response =
                await client.PutAsJsonAsync(
                    "api/LessonProgress",
                    new UpdateLessonProgressDto
                    {
                        EnrollmentId = EnrollmentId,
                        CourseLessonId = Lesson.Id,
                        IsCompleted = !IsCompleted
                    });


            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }


            var result =
                await response.Content
                    .ReadFromJsonAsync<LessonProgressDto>();


            if (result != null)
            {
                IsCompleted =
                    result.IsCompleted;
            }
        }
        catch
        {
            ErrorMessage =
                "ذخیره وضعیت درس با خطا مواجه شد.";
        }
        finally
        {
            IsSavingProgress = false;
        }
    }


    private async Task<string> GetErrorMessage(
        HttpResponseMessage response)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ErrorResponse>();

            return error?.Message
                ?? "عملیات انجام نشد.";
        }
        catch
        {
            return "عملیات انجام نشد.";
        }
    }


    public class EnrollmentDto
    {
        public int Id { get; set; }

        public int CourseId { get; set; }

        public string CourseTitle { get; set; } = string.Empty;

        public string Status { get; set; } = string.Empty;
    }


    public class StudentCourseContentDto
    {
        public int CourseId { get; set; }

        public string CourseTitle { get; set; } = string.Empty;

        public string DeliveryType { get; set; } = string.Empty;

        public List<StudentCourseModuleDto> Modules { get; set; } = new();
    }


    public class StudentCourseModuleDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public int SortOrder { get; set; }

        public List<StudentCourseLessonDto> Lessons { get; set; } = new();
    }


    public class StudentCourseLessonDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string ContentType { get; set; } = "Video";

        public string? ContentUrl { get; set; }

        public int DurationMinutes { get; set; }

        public int SortOrder { get; set; }

        public bool IsFreePreview { get; set; }
    }


    public class LessonProgressDto
    {
        public int CourseLessonId { get; set; }

        public bool IsCompleted { get; set; }

        public DateTime? CompletedAt { get; set; }
    }


    public class UpdateLessonProgressDto
    {
        public int EnrollmentId { get; set; }

        public int CourseLessonId { get; set; }

        public bool IsCompleted { get; set; }
    }


    public class ErrorResponse
    {
        public string? Message { get; set; }
    }
}

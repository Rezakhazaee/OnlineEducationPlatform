@page "/student/lesson/{CourseId:int}/{LessonId:int}"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout StudentLayout

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>مشاهده درس | آموزش‌یار</PageTitle>

<div class="student-page">

    @if (IsLoading)
    {
        <section class="student-content-card">
            <div class="student-loading">
                در حال بارگذاری درس...
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="student-content-card">

            <div class="student-error">

                <strong>
                    دسترسی به درس
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <a
                    href="/student/courses"
                    class="student-course-details-btn">

                    ← بازگشت به دوره‌ها

                </a>

            </div>

        </section>
    }
    else if (Lesson != null)
    {
        <section class="student-content-card">

            <div class="student-content-header">

                <div>

                    <small>
                        درس @Lesson.SortOrder
                    </small>

                    <h1>
                        @Lesson.Title
                    </h1>

                    <p>
                        دوره:
                        @CourseTitle
                    </p>

                </div>

                <a
                    href="/student/course-content/@CourseId"
                    class="student-course-details-btn">

                    ← محتوای دوره

                </a>

            </div>


            <div style="margin-top:20px;">

                <small>
                    نوع محتوا:
                    @(Lesson.ContentType == "Video" ? "ویدئو" : "متن")
                </small>

                @if (Lesson.DurationMinutes > 0)
                {
                    <small style="margin-right:15px;">
                        مدت:
                        @Lesson.DurationMinutes دقیقه
                    </small>
                }

            </div>


            @if (!string.IsNullOrWhiteSpace(Lesson.Description))
            {
                <div style="margin-top:20px;">

                    <h3>
                        توضیحات درس
                    </h3>

                    <p>
                        @Lesson.Description
                    </p>

                </div>
            }


            @if (Lesson.ContentType == "Video" &&
                 !string.IsNullOrWhiteSpace(Lesson.ContentUrl))
            {
                <div style="margin-top:25px;">

                    <iframe
                        src="@Lesson.ContentUrl"
                        title="@Lesson.Title"
                        width="100%"
                        height="500"
                        style="border:0; border-radius:12px;"
                        allowfullscreen>
                    </iframe>

                    <div style="margin-top:12px;">

                        <a
                            href="@Lesson.ContentUrl"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="student-course-details-btn">

                            باز کردن ویدئو در صفحه جدید

                        </a>

                    </div>

                </div>
            }
            else if (Lesson.ContentType == "Text" &&
                     !string.IsNullOrWhiteSpace(Lesson.Content))
            {
                <div style="margin-top:25px;">
                    <div class="student-content-card">
                        <h3>
                            محتوای درس
                        </h3>
                        <div style="white-space:pre-wrap; line-height:2;">
                            @Lesson.Content
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="student-empty-state" style="margin-top:25px;">

                    <h3>
                        محتوای این درس هنوز منتشر نشده است.
                    </h3>

                </div>
            }




            <LessonProgressPanel CourseId="@CourseId" LessonId="@LessonId" />

            @if (HasPreviousLesson || HasNextLesson)
            {
                <div style="
                    display:flex;
                    justify-content:space-between;
                    gap:12px;
                    margin-top:30px;
                    flex-wrap:wrap;">

                    @if (HasPreviousLesson)
                    {
                        <a
                            href="/student/lesson/@CourseId/@PreviousLesson!.Id"
                            class="student-course-details-btn">

                            ← درس قبلی

                        </a>
                    }
                    else
                    {
                        <span></span>
                    }

                    @if (HasNextLesson)
                    {
                        <a
                            href="/student/lesson/@CourseId/@NextLesson!.Id"
                            class="student-course-details-btn">

                            درس بعدی →

                        </a>
                    }

                </div>
            }

        </section>
    }

</div>




@code {

    [Parameter]
    public int CourseId { get; set; }

    [Parameter]
    public int LessonId { get; set; }

    private StudentCourseContentDto? Content { get; set; }

    private StudentCourseLessonDto? Lesson { get; set; }

    private StudentCourseLessonDto? PreviousLesson { get; set; }

    private StudentCourseLessonDto? NextLesson { get; set; }

    private string CourseTitle =>
        Content?.CourseTitle ?? string.Empty;

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    private bool HasPreviousLesson =>
        PreviousLesson != null;

    private bool HasNextLesson =>
        NextLesson != null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || !Auth.IsStudent)
        {
            Navigation.NavigateTo(
                $"/login?returnUrl=/student/lesson/{CourseId}/{LessonId}",
                false);

            return;
        }

        await LoadData();

        StateHasChanged();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var enrollments =
                await client.GetFromJsonAsync<List<EnrollmentDto>>(
                    "api/Enrollments/my")
                ?? new List<EnrollmentDto>();

            var enrollment =
                enrollments.FirstOrDefault(x =>
                    x.CourseId == CourseId &&
                    x.Status == "Active");

            if (enrollment == null)
            {
                ErrorMessage =
                    "شما در این دوره ثبت‌نام فعال ندارید.";

                return;
            }

            Content =
                await client.GetFromJsonAsync<StudentCourseContentDto>(
                    $"api/StudentCourseContent/{CourseId}");

            if (Content == null)
            {
                ErrorMessage =
                    "محتوای دوره پیدا نشد.";

                return;
            }

            var allLessons =
                Content.Modules
                    .OrderBy(x => x.SortOrder)
                    .SelectMany(x =>
                        x.Lessons
                            .OrderBy(l => l.SortOrder)
                            .ThenBy(l => l.Id))
                    .ToList();

            Lesson =
                allLessons.FirstOrDefault(x =>
                    x.Id == LessonId);

            if (Lesson == null)
            {
                ErrorMessage =
                    "درس مورد نظر پیدا نشد.";

                return;
            }

            var lessonIndex =
                allLessons.FindIndex(x =>
                    x.Id == LessonId);

            if (lessonIndex > 0)
            {
                PreviousLesson =
                    allLessons[lessonIndex - 1];
            }

            if (lessonIndex >= 0 &&
                lessonIndex < allLessons.Count - 1)
            {
                NextLesson =
                    allLessons[lessonIndex + 1];
            }
        }
        catch
        {
            ErrorMessage =
                "دریافت اطلاعات درس با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    public class StudentCourseContentDto
    {
        public int CourseId { get; set; }

        public string CourseTitle { get; set; } = string.Empty;

        public string DeliveryType { get; set; } = "Online";

        public List<StudentCourseModuleDto> Modules { get; set; } = new();
    }

    public class StudentCourseModuleDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public int SortOrder { get; set; }

        public List<StudentCourseLessonDto> Lessons { get; set; } = new();
    }

    public class StudentCourseLessonDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string ContentType { get; set; } = "Video";

        public string? ContentUrl { get; set; }

        public string? Content { get; set; }

        public int DurationMinutes { get; set; }

        public int SortOrder { get; set; }

        public bool IsFreePreview { get; set; }
    }

    public class EnrollmentDto
    {
        public int Id { get; set; }

        public int CourseId { get; set; }

        public string? CourseTitle { get; set; }

        public string Status { get; set; } = string.Empty;
    }
}

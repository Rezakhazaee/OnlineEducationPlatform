@page "/admin/student-report"

@using System.Net.Http.Json
@using System.Globalization
@using FrontEnd.Services
@using Microsoft.JSInterop

@inject AuthService Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>گزارش دانشجویان | آموزش‌یار</PageTitle>

<div class="admin-page">

    <AdminSidebar ActivePage="reports" />

    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    گزارش‌ها
                </span>

                <h1>
                    گزارش دانشجویان
                </h1>
            </div>

            <AdminLogout />

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "کاربر سامانه")
                    </strong>

                    <small>
                        گزارش دانشجویان
                    </small>
                </div>

            </div>

        </header>

        @if (IsLoading)
        {
            <div class="admin-loading">

                <div class="admin-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت گزارش...
                </h3>

                <p>
                    اطلاعات دانشجویان از سرور دریافت می‌شود.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">

                <strong>
                    خطا در دریافت گزارش
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    type="button"
                    class="admin-outline-btn"
                    @onclick="LoadReport">

                    تلاش مجدد

                </button>

            </div>
        }
        else
        {
            <section class="students-summary">

                <div class="student-summary-card">

                    <span>
                        تعداد نتایج
                    </span>

                    <strong>
                        @TotalCount
                    </strong>

                </div>

                <div class="student-summary-card">

                    <span>
                        صفحه
                    </span>

                    <strong>
                        @(TotalPages == 0 ? 0 : CurrentPage)
                    </strong>

                </div>

                <div class="student-summary-card">

                    <span>
                        تعداد در صفحه
                    </span>

                    <strong>
                        @Students.Count
                    </strong>

                </div>

            </section>

            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            فیلتر و جستجو
                        </span>

                        <h2>
                            گزارش دانشجویان
                        </h2>
                    </div>

                </div>

                <div class="course-form-grid">

                    <div class="form-group student-address-field">

                        <label>
                            جستجو
                        </label>

                        <input
                            type="text"
                            placeholder="نام، نام خانوادگی، کد ملی، موبایل..."
                            @bind="Search" />

                    </div>

                    @if (CanManageReportFilters)
                    {
                        <div class="form-group">

                            <label>
                                پشتیبان
                            </label>

                            <select @bind="SupportUserId">

                                <option value="">
                                    همه
                                </option>

                                @foreach (var item in SupportUsers)
                                {
                                    <option value="@item.Id">
                                        @item.FullName
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="form-group">

                            <label>
                                بازاریاب
                            </label>

                            <select @bind="MarketingUserId">

                                <option value="">
                                    همه
                                </option>

                                @foreach (var item in MarketerUsers)
                                {
                                    <option value="@item.Id">
                                        @item.FullName
                                    </option>
                                }

                            </select>

                        </div>

                        @if (PackageLevel >= 4)
                        {
                            <div class="form-group">

                                <label>
                                    سازمان طرف قرارداد
                                </label>

                                <select @bind="PartnerOrganizationId">

                                    <option value="">
                                        همه
                                    </option>

                                    @foreach (var item in PartnerOrganizations)
                                    {
                                        <option value="@item.Id">
                                            @item.Name
                                        </option>
                                    }

                                </select>

                            </div>
                        }
                    }

                    <div class="form-group">

                        <label>
                            از تاریخ ایجاد
                        </label>

                        <input
                            type="date"
                            @bind="CreatedFrom" />

                    </div>

                    <div class="form-group">

                        <label>
                            تا تاریخ ایجاد
                        </label>

                        <input
                            type="date"
                            @bind="CreatedTo" />

                    </div>

                    <div class="form-group">

                        <label>
                            مرتب‌سازی
                        </label>

                        <select @bind="SortBy">

                            <option value="createdDate">
                                تاریخ ایجاد
                            </option>

                            <option value="firstName">
                                نام
                            </option>

                            <option value="lastName">
                                نام خانوادگی
                            </option>

                            <option value="mobile">
                                موبایل
                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>
                            جهت مرتب‌سازی
                        </label>

                        <select @bind="SortDescending">

                            <option value="true">
                                نزولی
                            </option>

                            <option value="false">
                                صعودی
                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>
                            تعداد در صفحه
                        </label>

                        <select @bind="PageSize">

                            <option value="10">
                                10
                            </option>

                            <option value="20">
                                20
                            </option>

                            <option value="50">
                                50
                            </option>

                            <option value="100">
                                100
                            </option>

                        </select>

                    </div>

                </div>

                <div class="student-form-actions">

                    <button
                        type="button"
                        class="admin-primary-btn"
                        @onclick="ApplyFilters">

                        اعمال فیلتر

                    </button>

                    <button
                        type="button"
                        class="admin-outline-btn"
                        @onclick="ResetFilters">

                        پاک کردن فیلترها

                    </button>

                </div>


              <div class="student-form-actions">

                  <button
                      type="button"
                      class="admin-primary-btn"
                      disabled="@IsExporting"
                      @onclick='() => DownloadExport("excel")'>

                      @(IsExporting ? "در حال آماده‌سازی..." : "خروجی Excel")

                  </button>

                  <button
                      type="button"
                      class="admin-outline-btn"
                      disabled="@IsExporting"
                      @onclick='() => DownloadExport("pdf")'>

                      @(IsExporting ? "در حال آماده‌سازی..." : "خروجی PDF")

                  </button>

              </div>
            </section>

            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            نتایج
                        </span>

                        <h2>
                            @(
                                TotalCount == 0
                                    ? "نتیجه‌ای وجود ندارد"
                                    : $"نمایش {(CurrentPage - 1) * PageSize + 1} تا {Math.Min(CurrentPage * PageSize, TotalCount)} از {TotalCount}"
                             )
                        </h2>
                    </div>

                </div>

                @if (Students.Count == 0)
                {
                    <div class="admin-empty-state">
                        دانشجویی مطابق فیلترهای انتخاب‌شده پیدا نشد.
                    </div>
                }
                else
                {
                    <div class="students-table-wrap">

                        <table class="students-table">

                            <thead>

                                <tr>

                                    <th>
                                        دانشجو
                                    </th>

                                    <th>
                                        کد ملی
                                    </th>

                                    <th>
                                        موبایل
                                    </th>

                                    <th>
                                        بازاریاب
                                    </th>

                                    <th>
                                        پشتیبان
                                    </th>

                                    @if (PackageLevel >= 4)
                                    {
                                        <th>
                                            سازمان طرف قرارداد
                                        </th>
                                    }

                                    <th>
                                        تاریخ ایجاد
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var student in Students)
                                {
                                    <tr>

                                        <td>

                                            <div class="student-name-cell">

                                                <strong>
                                                    @student.FirstName @student.LastName
                                                </strong>

                                                <small>
                                                    شناسه: @student.Id
                                                </small>

                                            </div>

                                        </td>

                                        <td>
                                            @student.NationalCode
                                        </td>

                                        <td>
                                            @student.Mobile
                                        </td>

                                        <td>
                                            @GetUserName(student.MarketingUserId)
                                        </td>

                                        <td>
                                            @GetUserName(student.SupportUserId)
                                        </td>

                                        @if (PackageLevel >= 4)
                                        {
                                            <td>
                                                @GetPartnerOrganizationName(student.PartnerOrganizationId)
                                            </td>
                                        }

                                        <td>
                                            @student.CreatedDate.ToString(
                                                "yyyy/MM/dd",
                                                CultureInfo.InvariantCulture)
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <div class="student-form-actions">

                        <button
                            type="button"
                            class="admin-outline-btn"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="PreviousPage">

                            صفحه قبل

                        </button>

                        <span>
                            صفحه @CurrentPage از @(TotalPages == 0 ? 0 : TotalPages)
                        </span>

                        <button
                            type="button"
                            class="admin-outline-btn"
                            disabled="@(CurrentPage >= TotalPages || TotalPages == 0)"
                            @onclick="NextPage">

                            صفحه بعد

                        </button>

                    </div>
                }

            </section>
        }

    </main>

</div>

@code {

    private bool IsLoading { get; set; } = true;
    private bool IsExporting { get; set; }

    private string? ErrorMessage { get; set; }

    private List<StudentDto> Students { get; set; } = new();

    private List<StudentManagementOptionDto> ManagementOptions { get; set; } = new();

    private List<PartnerOrganizationDto> PartnerOrganizations { get; set; } = new();

    private int PackageLevel { get; set; } = 1;

    private string Search { get; set; } = string.Empty;

    private string SupportUserId { get; set; } = string.Empty;

    private string MarketingUserId { get; set; } = string.Empty;

    private string PartnerOrganizationId { get; set; } = string.Empty;

    private DateTime? CreatedFrom { get; set; }

    private DateTime? CreatedTo { get; set; }

    private string SortBy { get; set; } = "createdDate";

    private bool SortDescending { get; set; } = true;

    private int PageSize { get; set; } = 20;

    private int CurrentPage { get; set; } = 1;

    private int TotalCount { get; set; }

    private int TotalPages { get; set; }

    private IEnumerable<StudentManagementOptionDto> MarketerUsers =>
        ManagementOptions.Where(x => x.Role == "Marketer");

    private IEnumerable<StudentManagementOptionDto> SupportUsers =>
        ManagementOptions.Where(x => x.Role == "Support");

    private bool CanManageReportFilters =>
        Auth.IsAdmin || Auth.IsEducationStaff;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (!firstRender)
            return;

        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || !Auth.IsManagementPanelUser)
        {
            Navigation.NavigateTo(
                Auth.IsLoggedIn ? "/" : "/login",
                true);

            return;
        }

        await LoadData();

        StateHasChanged();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var settings =
                await client.GetFromJsonAsync<OrganizationSettingsDto>(
                    "api/OrganizationSettings");

            PackageLevel =
                settings?.PackageLevel ?? 1;

            if (CanManageReportFilters)
            {
                ManagementOptions =
                    await client.GetFromJsonAsync<
                        List<StudentManagementOptionDto>>(
                        "api/Students/management-options")
                    ?? new List<StudentManagementOptionDto>();

                if (PackageLevel >= 4)
                {
                    PartnerOrganizations =
                        await client.GetFromJsonAsync<
                            List<PartnerOrganizationDto>>(
                            "api/PartnerOrganizations")
                        ?? new List<PartnerOrganizationDto>();
                }
            }

            await LoadReport();
        }
        catch
        {
            ErrorMessage =
                "دریافت اطلاعات گزارش با خطا مواجه شد.";
            IsLoading = false;
        }
    }

    private async Task LoadReport()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client =
                Auth.CreateAuthenticatedClient();

            var parameters =
                new List<string>();

            if (!string.IsNullOrWhiteSpace(Search))
            {
                parameters.Add(
                    $"Search={Uri.EscapeDataString(Search.Trim())}");
            }

            if (int.TryParse(
                SupportUserId,
                out var supportId))
            {
                parameters.Add(
                    $"SupportUserId={supportId}");
            }

            if (int.TryParse(
                MarketingUserId,
                out var marketerId))
            {
                parameters.Add(
                    $"MarketingUserId={marketerId}");
            }

            if (int.TryParse(
                PartnerOrganizationId,
                out var organizationId))
            {
                parameters.Add(
                    $"PartnerOrganizationId={organizationId}");
            }

            if (CreatedFrom.HasValue)
            {
                parameters.Add(
                    $"CreatedFrom={CreatedFrom.Value:yyyy-MM-dd}");
            }

            if (CreatedTo.HasValue)
            {
                parameters.Add(
                    $"CreatedTo={CreatedTo.Value:yyyy-MM-dd}");
            }

            parameters.Add(
                $"SortBy={Uri.EscapeDataString(SortBy)}");

            parameters.Add(
                $"SortDescending={SortDescending.ToString().ToLowerInvariant()}");

            parameters.Add(
                $"Page={CurrentPage}");

            parameters.Add(
                $"PageSize={PageSize}");

            var url =
                "api/StudentReports?" +
                string.Join("&", parameters);

            var result =
                await client.GetFromJsonAsync<StudentReportResultDto>(
                    url);

            Students =
                result?.Items ?? new List<StudentDto>();

            TotalCount =
                result?.TotalCount ?? 0;

            CurrentPage =
                result?.Page ?? 1;

            PageSize =
                result?.PageSize ?? PageSize;

            TotalPages =
                result?.TotalPages ?? 0;
        }
        catch
        {
            ErrorMessage =
                "دریافت گزارش دانشجویان با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        CurrentPage = 1;
        await LoadReport();
    }

    private string BuildExportQuery()
    {
        var parameters = new List<string>();

        if (!string.IsNullOrWhiteSpace(Search))
            parameters.Add($"Search={Uri.EscapeDataString(Search.Trim())}");

        if (int.TryParse(SupportUserId, out var supportId))
            parameters.Add($"SupportUserId={supportId}");

        if (int.TryParse(MarketingUserId, out var marketerId))
            parameters.Add($"MarketingUserId={marketerId}");

        if (int.TryParse(PartnerOrganizationId, out var organizationId))
            parameters.Add($"PartnerOrganizationId={organizationId}");

        if (CreatedFrom.HasValue)
            parameters.Add($"CreatedFrom={CreatedFrom.Value:yyyy-MM-dd}");

        if (CreatedTo.HasValue)
            parameters.Add($"CreatedTo={CreatedTo.Value:yyyy-MM-dd}");

        parameters.Add($"SortBy={Uri.EscapeDataString(SortBy)}");
        parameters.Add($"SortDescending={SortDescending.ToString().ToLowerInvariant()}");

        return string.Join("&", parameters);
    }

    private async Task DownloadExport(string format)
    {
        IsExporting = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();
            var query = BuildExportQuery();

            var response = await client.GetAsync(
                $"api/StudentReportExports/{format}?{query}");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "تهیه فایل خروجی با خطا مواجه شد.";
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();

            var contentType =
                response.Content.Headers.ContentType?.ToString()
                ?? "application/octet-stream";

            var fileName =
                format == "pdf"
                    ? "student-report.pdf"
                    : "student-report.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName,
                contentType,
                Convert.ToBase64String(bytes));
        }
        catch
        {
            ErrorMessage = "دانلود فایل خروجی با خطا مواجه شد.";
        }
        finally
        {
            IsExporting = false;
        }
    }

    private async Task ResetFilters()
    {
        Search = string.Empty;
        SupportUserId = string.Empty;
        MarketingUserId = string.Empty;
        PartnerOrganizationId = string.Empty;
        CreatedFrom = null;
        CreatedTo = null;
        SortBy = "createdDate";
        SortDescending = true;
        PageSize = 20;
        CurrentPage = 1;

        await LoadReport();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage <= 1)
            return;

        CurrentPage--;

        await LoadReport();
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages)
            return;

        CurrentPage++;

        await LoadReport();
    }

    private string GetUserName(int? userId)
    {
        if (!userId.HasValue)
            return "بدون تخصیص";

        return ManagementOptions
            .FirstOrDefault(x => x.Id == userId.Value)
            ?.FullName
            ?? $"شناسه {userId.Value}";
    }

    private string GetPartnerOrganizationName(int? id)
    {
        if (!id.HasValue)
            return "بدون سازمان";

        return PartnerOrganizations
            .FirstOrDefault(x => x.Id == id.Value)
            ?.Name
            ?? $"شناسه {id.Value}";
    }

    public class StudentDto
    {
        public int Id { get; set; }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        public string NationalCode { get; set; } = string.Empty;

        public string Mobile { get; set; } = string.Empty;

        public int? MarketingUserId { get; set; }

        public int? SupportUserId { get; set; }

        public int? PartnerOrganizationId { get; set; }

        public DateTime CreatedDate { get; set; }
    }

    public class StudentReportResultDto
    {
        public List<StudentDto> Items { get; set; } = new();

        public int TotalCount { get; set; }

        public int Page { get; set; }

        public int PageSize { get; set; }

        public int TotalPages { get; set; }
    }

    public class StudentManagementOptionDto
    {
        public int Id { get; set; }

        public string FullName { get; set; } = string.Empty;

        public string Role { get; set; } = string.Empty;
    }

    public class PartnerOrganizationDto
    {
        public int Id { get; set; }

        public string Name { get; set; } = string.Empty;

        public bool IsActive { get; set; }
    }

    public class OrganizationSettingsDto
    {
        public int PackageLevel { get; set; }
    }
}

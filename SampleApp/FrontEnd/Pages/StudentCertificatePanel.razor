@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<section class="student-content-card">
    <div class="student-section-header">
        <h2>گواهی پایان دوره</h2>
        <span>پس از تکمیل ۱۰۰٪ درس‌های دوره</span>
    </div>

    @if (IsLoading)
    {
        <div class="student-empty-state">
            <p>در حال بررسی وضعیت گواهی...</p>
        </div>
    }
    else if (Certificate != null)
    {
        <div class="student-profile-grid">
            <div class="student-profile-field">
                <small>شماره گواهی</small>
                <strong>@Certificate.CertificateNumber</strong>
            </div>

            <div class="student-profile-field">
                <small>نام دانشجو</small>
                <strong>@Certificate.StudentName</strong>
            </div>

            <div class="student-profile-field">
                <small>دوره</small>
                <strong>@Certificate.CourseTitle</strong>
            </div>

            <div class="student-profile-field">
                <small>تاریخ صدور</small>
                <strong>@Certificate.IssuedAtUtc.ToLocalTime().ToString("yyyy/MM/dd")</strong>
            </div>
        </div>

        <div class="student-form-actions">
            <a href="@($"/certificate-pdf/{Certificate.CertificateNumber}")"
               class="student-primary-link">
                دانلود گواهی PDF
            </a>
        </div>
    }
    else if (Progress != null &&
             Progress.TotalLessons > 0 &&
             Progress.ProgressPercent >= 100)
    {
        <div class="student-form-actions">
            <button type="button"
                    class="student-primary-link"
                    @onclick="IssueCertificate"
                    disabled="@IsIssuing">
                @(IsIssuing ? "در حال صدور..." : "صدور گواهی پایان دوره")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="student-error">
                <p>@ErrorMessage</p>
            </div>
        }
    }
    else
    {
        <div class="student-empty-state">
            <p>پس از تکمیل تمام درس‌های دوره، گواهی پایان دوره برای شما قابل صدور خواهد بود.</p>
        </div>
    }
</section>

@code {
    [Parameter]
    public int CourseId { get; set; }

    private int EnrollmentId { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsIssuing { get; set; }
    private string? ErrorMessage { get; set; }

    private ProgressSummary? Progress { get; set; }
    private CertificateDto? Certificate { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || !Auth.IsStudent)
        {
            IsLoading = false;
            return;
        }

        await LoadAsync();

        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var enrollments =
                await client.GetFromJsonAsync<List<EnrollmentInfo>>(
                    "api/Enrollments/my")
                ?? new();

            var enrollment = enrollments.FirstOrDefault(x =>
                x.CourseId == CourseId &&
                x.Status != "Cancelled");

            if (enrollment == null)
            {
                return;
            }

            EnrollmentId = enrollment.Id;

            Progress =
                await client.GetFromJsonAsync<ProgressSummary>(
                    $"api/LessonProgress/enrollment/{EnrollmentId}");

            try
            {
                Certificate =
                    await client.GetFromJsonAsync<CertificateDto>(
                        $"api/Certificates/enrollment/{EnrollmentId}");
            }
            catch
            {
                Certificate = null;
            }
        }
        catch
        {
            ErrorMessage = "دریافت وضعیت گواهی با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task IssueCertificate()
    {
        if (EnrollmentId <= 0 || IsIssuing)
        {
            return;
        }

        IsIssuing = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response = await client.PostAsync(
                $"api/Certificates/enrollment/{EnrollmentId}/issue",
                null);

            if (response.IsSuccessStatusCode)
            {
                Certificate =
                    await response.Content.ReadFromJsonAsync<CertificateDto>();
            }
            else
            {
                var error =
                    await response.Content.ReadFromJsonAsync<ErrorDto>();

                ErrorMessage =
                    error?.Message ?? "صدور گواهی با خطا مواجه شد.";
            }
        }
        catch
        {
            ErrorMessage = "صدور گواهی با خطا مواجه شد.";
        }
        finally
        {
            IsIssuing = false;
        }
    }

    private class EnrollmentInfo
    {
        public int Id { get; set; }
        public int CourseId { get; set; }
        public string Status { get; set; } = string.Empty;
    }

    private class ProgressSummary
    {
        public int TotalLessons { get; set; }
        public int CompletedLessons { get; set; }
        public decimal ProgressPercent { get; set; }
    }

    private class CertificateDto
    {
        public int Id { get; set; }
        public int EnrollmentId { get; set; }
        public string CertificateNumber { get; set; } = string.Empty;
        public string StudentName { get; set; } = string.Empty;
        public string CourseTitle { get; set; } = string.Empty;
        public DateTime IssuedAtUtc { get; set; }
    }

    private class ErrorDto
    {
        public string? Message { get; set; }
    }
}

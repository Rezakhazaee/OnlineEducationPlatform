@page "/register"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>ثبت‌نام | آموزش‌یار</PageTitle>

<div class="login-page">

    <div class="login-card">

        <div class="login-brand">

            <div class="login-brand-mark">
                آ
            </div>

            <div>
                <strong>آموزش‌یار</strong>
                <span>سامانه آموزش آنلاین</span>
            </div>

        </div>


        <div class="login-header">

            <span>
                خوش آمدید
            </span>

            <h1>
                ایجاد حساب کاربری
            </h1>

            <p>
                برای شروع یادگیری، اطلاعات خود را وارد کنید.
            </p>

        </div>


        <div class="login-form">

            <div class="form-group">

                <label>
                    نام و نام خانوادگی
                </label>

                <input
                    type="text"
                    @bind="FullName"
                    @bind:event="oninput"
                    placeholder="نام و نام خانوادگی"
                    disabled="@IsLoading" />

            </div>


            <div class="form-group">

                <label>
                    شماره موبایل
                </label>

                <input
                    type="text"
                    @bind="Mobile"
                    @bind:event="oninput"
                    placeholder="مثلاً 09120000000"
                    disabled="@IsLoading" />

            </div>


            <div class="form-group">

                <label>
                    نام کاربری
                </label>

                <input
                    type="text"
                    @bind="Username"
                    @bind:event="oninput"
                    placeholder="نام کاربری"
                    disabled="@IsLoading" />

            </div>


            <div class="form-group">

                <label>
                    رمز عبور
                </label>

                <input
                    type="password"
                    @bind="Password"
                    @bind:event="oninput"
                    placeholder="رمز عبور"
                    disabled="@IsLoading" />

            </div>


            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="login-error">
                    @ErrorMessage
                </div>
            }


            <button
                class="login-submit"
                @onclick="HandleRegister"
                disabled="@IsLoading">

                @if (IsLoading)
                {
                    <span>
                        در حال ثبت‌نام...
                    </span>
                }
                else
                {
                    <span>
                        ایجاد حساب
                    </span>

                    <span>
                        ←
                    </span>
                }

            </button>

        </div>


        <div class="login-footer">

            <span>
                قبلاً حساب دارید؟
            </span>

            <a href="@GetLoginUrl()">
                وارد شوید
            </a>

        </div>


        <a href="/" class="back-home">
            ← بازگشت به صفحه اصلی
        </a>

    </div>

</div>


@code {

    private string FullName { get; set; } = string.Empty;

    private string Mobile { get; set; } = string.Empty;

    private string Username { get; set; } = string.Empty;

    private string Password { get; set; } = string.Empty;

    private string? ErrorMessage { get; set; }

    private bool IsLoading { get; set; }


    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }


    private async Task HandleRegister()
    {
        ErrorMessage = null;


        if (string.IsNullOrWhiteSpace(FullName) ||
            string.IsNullOrWhiteSpace(Mobile) ||
            string.IsNullOrWhiteSpace(Username) ||
            string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage =
                "لطفاً همه اطلاعات را تکمیل کنید.";

            return;
        }


        if (Password.Length < 6)
        {
            ErrorMessage =
                "رمز عبور باید حداقل ۶ کاراکتر باشد.";

            return;
        }


        IsLoading = true;


        try
        {
            var client =
                Auth.CreateAuthenticatedClient();


            var response =
                await client.PostAsJsonAsync(
                    "api/Auth/register",
                    new RegisterRequest
                    {
                        FullName = FullName.Trim(),
                        Mobile = Mobile.Trim(),
                        Username = Username.Trim(),
                        Password = Password
                    });


            if (!response.IsSuccessStatusCode)
            {
                try
                {
                    var error =
                        await response.Content
                            .ReadFromJsonAsync<ApiError>();

                    ErrorMessage =
                        error?.Message
                        ?? "ثبت‌نام انجام نشد.";
                }
                catch
                {
                    ErrorMessage =
                        "ثبت‌نام انجام نشد.";
                }

                return;
            }


            var loginUrl = GetLoginUrl();

            Navigation.NavigateTo(loginUrl);
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private string GetLoginUrl()
    {
        if (IsSafeLocalUrl(ReturnUrl))
        {
            return
                $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl!)}";
        }

        return "/login";
    }


    private static bool IsSafeLocalUrl(
        string? url)
    {
        return !string.IsNullOrWhiteSpace(url)
               && url.StartsWith("/")
               && !url.StartsWith("//");
    }


    public class RegisterRequest
    {
        public string FullName { get; set; } =
            string.Empty;

        public string Mobile { get; set; } =
            string.Empty;

        public string Username { get; set; } =
            string.Empty;

        public string Password { get; set; } =
            string.Empty;
    }


    public class ApiError
    {
        public string? Message { get; set; }
    }

    private string? GetSafeReturnUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query;
        const string key = "returnUrl=";
        var index = query.IndexOf(key, StringComparison.OrdinalIgnoreCase);

        if (index < 0)
            return null;

        var value = query[(index + key.Length)..];
        var ampIndex = value.IndexOf('&');

        if (ampIndex >= 0)
            value = value[..ampIndex];

        value = Uri.UnescapeDataString(value);

        if (string.IsNullOrWhiteSpace(value) ||
            !value.StartsWith("/") ||
            value.StartsWith("//"))
            return null;

        return value;
    }
}

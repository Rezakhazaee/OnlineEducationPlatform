@page "/register"

@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Http
@using FrontEnd.Services

@inject IHttpClientFactory HttpClientFactory
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>ثبت‌نام | آموزش‌یار</PageTitle>

<div class="login-page">

    <div class="login-card">

        <div class="login-brand">
            <div class="login-brand-mark">آ</div>
            <div>
                <strong>آموزش‌یار</strong>
                <span>سامانه آموزش آنلاین</span>
            </div>
        </div>

        <div class="login-header">
            <span>شروع یادگیری</span>
            <h1>ایجاد حساب دانشجو</h1>
            <p>اطلاعات خود را وارد کنید تا حساب دانشجویی ساخته شود.</p>
        </div>

        <div class="login-form">

            <div class="form-group">
                <label>نام و نام خانوادگی</label>
                <input @bind="FullName" type="text" disabled="@IsLoading" />
            </div>

            <div class="form-group">
                <label>شماره موبایل</label>
                <input @bind="Mobile" type="text" disabled="@IsLoading" />
            </div>

            <div class="form-group">
                <label>نام کاربری</label>
                <input @bind="Username" type="text" disabled="@IsLoading" />
            </div>

            <div class="form-group">
                <label>رمز عبور</label>
                <input @bind="Password" type="password" disabled="@IsLoading" />
            </div>

            <div class="form-group">
                <label>تکرار رمز عبور</label>
                <input @bind="ConfirmPassword" type="password" disabled="@IsLoading" />
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="login-error">@ErrorMessage</div>
            }

            <button class="login-submit"
                    @onclick="HandleRegister"
                    disabled="@IsLoading">
                @(IsLoading ? "در حال ثبت‌نام..." : "ایجاد حساب")
                @if (!IsLoading)
                {
                    <span>←</span>
                }
            </button>

        </div>

        <div class="login-footer">
            <span>قبلاً حساب دارید؟</span>
            <a href="@($"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}")">
                ورود
            </a>
        </div>

        <a href="/courses" class="back-home">← بازگشت به دوره‌ها</a>

    </div>

</div>

@code {
    private string FullName { get; set; } = string.Empty;
    private string Mobile { get; set; } = string.Empty;
    private string Username { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; }

    private string ReturnUrl
    {
        get
        {
            var query = QueryHelpers.ParseQuery(
                Navigation.ToAbsoluteUri(Navigation.Uri).Query);

            if (query.TryGetValue("returnUrl", out var value) &&
                !string.IsNullOrWhiteSpace(value))
            {
                var url = value.ToString();

                if (url.StartsWith("/") && !url.StartsWith("//"))
                    return url;
            }

            return "/courses";
        }
    }

    private async Task HandleRegister()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(FullName) ||
            string.IsNullOrWhiteSpace(Mobile) ||
            string.IsNullOrWhiteSpace(Username) ||
            string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = "لطفاً همه اطلاعات را وارد کنید.";
            return;
        }

        if (Password != ConfirmPassword)
        {
            ErrorMessage = "تکرار رمز عبور صحیح نیست.";
            return;
        }

        IsLoading = true;

        try
        {
            var client = HttpClientFactory.CreateClient("Backend");

            var response = await client.PostAsJsonAsync(
                "api/Auth/register",
                new
                {
                    FullName,
                    Mobile,
                    Username,
                    Password
                });

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ApiError>();
                ErrorMessage = error?.Message ?? "ثبت‌نام انجام نشد.";
                return;
            }

            var login = await Auth.Login(Username, Password);

            if (!login.Success)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var studentClient = Auth.CreateAuthenticatedClient();
            var studentProfileResponse = await studentClient.GetAsync("api/Students/me");
            if (!studentProfileResponse.IsSuccessStatusCode)
            {
                ErrorMessage = "حساب ساخته شد، اما پروفایل دانشجویی ایجاد نشد.";
                return;
            }

            Navigation.NavigateTo(ReturnUrl);
        }
        catch
        {
            ErrorMessage = "ثبت‌نام با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private class ApiError
    {
        public string? Message { get; set; }
    }
}

@page "/admin"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>پنل مدیریت | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin" class="active">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports">
                <span>▤</span>
                گزارش‌ها
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <a href="/">
                ← بازگشت به سایت
            </a>

        </div>

    </aside>


    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    مدیریت سامانه
                </span>

                <h1>
                    داشبورد
                </h1>
            </div>

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "مدیر سیستم")
                    </strong>

                    <small>
                        Administrator
                    </small>
                </div>

            </div>

        </header>


        @if (IsLoading)
        {
            <div class="admin-loading">
                <div class="admin-loading-icon">↻</div>

                <h3>
                    در حال دریافت اطلاعات...
                </h3>

                <p>
                    اطلاعات واقعی سامانه در حال بارگذاری است.
                </p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">
                <strong>
                    خطا در دریافت اطلاعات
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    class="admin-outline-btn"
                    @onclick="LoadDashboard">

                    تلاش مجدد
                </button>
            </div>
        }
        else if (Summary != null)
        {
            <section class="admin-stats">

                <div class="admin-stat-card">

                    <span class="stat-icon">
                        ▣
                    </span>

                    <div>
                        <small>
                            دوره‌ها
                        </small>

                        <strong>
                            @Summary.TotalCourses
                        </strong>
                    </div>

                </div>


                <div class="admin-stat-card">

                    <span class="stat-icon">
                        ♙
                    </span>

                    <div>
                        <small>
                            دانشجویان
                        </small>

                        <strong>
                            @Summary.TotalStudents
                        </strong>
                    </div>

                </div>


                <div class="admin-stat-card">

                    <span class="stat-icon">
                        ✓
                    </span>

                    <div>
                        <small>
                            ثبت‌نام‌ها
                        </small>

                        <strong>
                            @Summary.TotalEnrollments
                        </strong>
                    </div>

                </div>

            </section>


            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            وضعیت مالی
                        </span>

                        <h2>
                            گزارش پرداخت‌ها
                        </h2>
                    </div>

                    <a
                        href="/admin/courses"
                        class="admin-primary-btn">

                        + افزودن دوره

                    </a>

                </div>


                <div class="admin-financial-grid">

                    <div class="admin-financial-card">

                        <small>
                            پرداخت‌شده
                        </small>

                        <strong>
                            @Summary.TotalPaid.ToString("N0")
                        </strong>

                        <span>
                            تومان
                        </span>

                    </div>


                    <div class="admin-financial-card">

                        <small>
                            در انتظار پرداخت
                        </small>

                        <strong>
                            @Summary.TotalPending.ToString("N0")
                        </strong>

                        <span>
                            تومان
                        </span>

                    </div>


                    <div class="admin-financial-card">

                        <small>
                            لغوشده
                        </small>

                        <strong>
                            @Summary.TotalCancelled.ToString("N0")
                        </strong>

                        <span>
                            تومان
                        </span>

                    </div>

                </div>

            </section>
        }

    </main>

</div>


@code {

    private ReportsSummaryDto? Summary { get; set; }

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }


    private async Task LoadDashboard()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Summary = await client.GetFromJsonAsync<ReportsSummaryDto>(
                "api/Reports/summary"
            );

            if (Summary == null)
            {
                ErrorMessage =
                    "اطلاعات گزارش از سرور دریافت نشد.";
            }
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    public class ReportsSummaryDto
    {
        public int TotalStudents { get; set; }

        public int TotalCourses { get; set; }

        public int TotalEnrollments { get; set; }

        public decimal TotalPaid { get; set; }

        public decimal TotalPending { get; set; }

        public decimal TotalCancelled { get; set; }
    }
}

@page "/admin"

<PageTitle>پنل مدیریت | آموزش‌یار</PageTitle>

<div class="admin-page">

```
<aside class="admin-sidebar">

    <div class="admin-brand">
        <div class="admin-brand-mark">آ</div>

        <div>
            <strong>آموزش‌یار</strong>
            <small>پنل مدیریت</small>
        </div>
    </div>


    <nav class="admin-menu">

        <a href="/admin" class="active">
            <span>⌂</span>
            داشبورد
        </a>

        <a href="/admin/courses">
            <span>▣</span>
            دوره‌ها
        </a>

        <a href="/admin/users">
            <span>♙</span>
            کاربران
        </a>

        <a href="/admin/enrollments">
            <span>✓</span>
            ثبت‌نام‌ها
        </a>

        <a href="/admin/payments">
            <span>₿</span>
            پرداخت‌ها
        </a>

        <a href="/admin/reports">
            <span>▤</span>
            گزارش‌ها
        </a>

    </nav>


    <div class="admin-sidebar-bottom">

        <a href="/">
            ← بازگشت به سایت
        </a>

    </div>

</aside>


<main class="admin-main">

    <header class="admin-topbar">

        <div>
            <span class="admin-label">
                مدیریت سامانه
            </span>

            <h1>
                داشبورد
            </h1>
        </div>

        <div class="admin-user">
            <div class="admin-avatar">
                ا
            </div>

            <div>
                <strong>مدیر سیستم</strong>
                <small>Administrator</small>
            </div>
        </div>

    </header>


    <section class="admin-stats">

        <div class="admin-stat-card">
            <span class="stat-icon">▣</span>

            <div>
                <small>دوره‌ها</small>
                <strong>24</strong>
            </div>
        </div>


        <div class="admin-stat-card">
            <span class="stat-icon">♙</span>

            <div>
                <small>دانشجویان</small>
                <strong>186</strong>
            </div>
        </div>


        <div class="admin-stat-card">
            <span class="stat-icon">◎</span>

            <div>
                <small>کاربران</small>
                <strong>205</strong>
            </div>
        </div>


        <div class="admin-stat-card">
            <span class="stat-icon">₿</span>

            <div>
                <small>پرداخت‌ها</small>
                <strong>132</strong>
            </div>
        </div>

    </section>


    <section class="admin-content-card">

        <div class="admin-card-header">

            <div>
                <span>مدیریت آموزش</span>

                <h2>
                    دوره‌های اخیر
                </h2>
            </div>

            <a href="/admin/courses" class="admin-primary-btn">
                + افزودن دوره
            </a>

        </div>


        <div class="admin-empty-state">

            <div class="empty-icon">
                ▣
            </div>

            <h3>
                هنوز دوره‌ای ثبت نشده است
            </h3>

            <p>
                اولین دوره آموزشی خود را ایجاد کنید.
            </p>

            <a href="/admin/courses" class="admin-outline-btn">
                مدیریت دوره‌ها
            </a>

        </div>

    </section>

</main>
```

</div>

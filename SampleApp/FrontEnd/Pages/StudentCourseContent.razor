@page "/student/course-content/{CourseId:int}"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout StudentLayout

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>محتوای دوره | آموزش‌یار</PageTitle>

<div class="student-page">

    @if (IsLoading)
    {
        <section class="student-content-card">
            <div class="student-loading">
                در حال بارگذاری محتوای دوره...
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="student-content-card">
            <div class="student-error">

                <strong>
                    خطا
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <a
                    href="/student/courses"
                    class="student-course-details-btn">

                    ← بازگشت به دوره‌ها

                </a>

            </div>
        </section>
    }
    else if (Content != null)
    {
        <section class="student-content-card">

            <div class="student-content-header">

                <div>

                    <small>
                        محتوای آموزشی
                    </small>

                    <h1>
                        @Content.CourseTitle
                    </h1>

                    <p>
                        نوع دوره:
                        @GetDeliveryTypeText(Content.DeliveryType)
                    </p>

                </div>

                <a
                    href="/student/courses"
                    class="student-course-details-btn">

                    ← دوره‌های من

                </a>

            </div>


            <div style="margin-top:20px;">

                <strong>
                    پیشرفت دوره:
                </strong>

                @CompletedLessonCount از @TotalLessonCount درس تکمیل شده

            </div>

        </section>


        @if (Content.Modules.Count == 0)
        {
            <section class="student-content-card">

                <div class="student-empty-state">

                    <h3>
                        هنوز محتوایی برای این دوره منتشر نشده است.
                    </h3>

                </div>

            </section>
        }
        else
        {
            @foreach (var module in Content.Modules)
            {
                <section class="student-content-card">

                    <div class="student-module-header">

                        <div>

                            <small>
                                سرفصل @module.SortOrder
                            </small>

                            <h2>
                                @module.Title
                            </h2>

                        </div>

                        <span>
                            @module.Lessons.Count درس
                        </span>

                    </div>


                    @if (module.Lessons.Count == 0)
                    {
                        <div class="student-empty-state">

                            <p>
                                درسی در این سرفصل منتشر نشده است.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="student-lessons-list">

                            @foreach (var lesson in module.Lessons)
                            {
                                var completed =
                                    Progress.TryGetValue(
                                        lesson.Id,
                                        out var isCompleted)
                                    && isCompleted;

                                <article
                                    class="student-lesson-row">

                                    <div class="student-lesson-main">

                                        <strong>
                                            @lesson.SortOrder.
                                            @lesson.Title
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(lesson.Description))
                                        {
                                            <p>
                                                @lesson.Description
                                            </p>
                                        }

                                        <small>

                                            نوع محتوا:
                                            @(lesson.ContentType == "Video"
                                                ? "ویدئو"
                                                : "متن")

                                            @if (lesson.DurationMinutes > 0)
                                            {
                                                <text>
                                                    | مدت:
                                                    @lesson.DurationMinutes دقیقه
                                                </text>
                                            }

                                            @if (lesson.IsFreePreview)
                                            {
                                                <text>
                                                    | پیش‌نمایش رایگان
                                                </text>
                                            }

                                        </small>

                                    </div>


                                    <div>

                                          <a
                                              href="/student/lesson/@CourseId/@lesson.Id"
                                              class="student-course-details-btn">

                                              مشاهده درس

                                          </a>


                                        <button
                                            type="button"
                                            class="student-course-details-btn"
                                            disabled="@IsSavingProgress"
                                            @onclick="() => ToggleLessonProgress(
                                                lesson.Id,
                                                completed)">

                                            @(completed
                                                ? "✓ تکمیل‌شده"
                                                : "علامت‌گذاری به‌عنوان تکمیل‌شده")

                                        </button>

                                    </div>

                                </article>
                            }

                        </div>
                    }

                </section>
            }
        }
    }

</div>


@code {

    [Parameter]
    public int CourseId { get; set; }


    private StudentCourseContentDto? Content { get; set; }

    private int EnrollmentId { get; set; }

    private bool IsLoading { get; set; } = true;

    private bool IsSavingProgress { get; set; }

    private string? ErrorMessage { get; set; }

    private Dictionary<int, bool> Progress { get; set; } = new();


    private int TotalLessonCount =>
        Content?.Modules.Sum(x => x.Lessons.Count) ?? 0;


    private int CompletedLessonCount =>
        Progress.Count(x => x.Value);


      protected override async Task OnAfterRenderAsync(bool firstRender)
      {
          if (!firstRender)
          {
              return;
          }

          await Auth.RestoreAsync();

          if (!Auth.IsLoggedIn || !Auth.IsStudent)
          {
              Navigation.NavigateTo(
                  $"/login?returnUrl=/student/course-content/{CourseId}",
                  true);
              return;
          }

          await LoadData();

          StateHasChanged();
      }


    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();


            var enrollments =
                await client.GetFromJsonAsync<List<EnrollmentDto>>(
                    "api/Enrollments/my")
                ?? new List<EnrollmentDto>();


            var enrollment =
                enrollments.FirstOrDefault(x =>
                    x.CourseId == CourseId &&
                    x.Status != "Cancelled");


            if (enrollment == null)
            {
                ErrorMessage =
                    "شما در این دوره ثبت‌نام فعال ندارید.";

                return;
            }


            EnrollmentId = enrollment.Id;


            Content =
                await client.GetFromJsonAsync<StudentCourseContentDto>(
                    $"api/StudentCourseContent/{CourseId}");


            if (Content == null)
            {
                ErrorMessage =
                    "محتوای دوره پیدا نشد.";

                return;
            }


            var progress =
                await client.GetFromJsonAsync<List<LessonProgressDto>>(
                    $"api/LessonProgress/enrollment/{EnrollmentId}")
                ?? new List<LessonProgressDto>();


            Progress = progress.ToDictionary(
                x => x.CourseLessonId,
                x => x.IsCompleted);
        }
        catch
        {
            ErrorMessage =
                "دریافت محتوای دوره با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task ToggleLessonProgress(
        int lessonId,
        bool currentlyCompleted)
    {
        if (EnrollmentId <= 0)
        {
            return;
        }

        ErrorMessage = null;
        IsSavingProgress = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response =
                await client.PutAsJsonAsync(
                    "api/LessonProgress",
                    new UpdateLessonProgressDto
                    {
                        EnrollmentId = EnrollmentId,
                        CourseLessonId = lessonId,
                        IsCompleted = !currentlyCompleted
                    });


            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }


            var result =
                await response.Content
                    .ReadFromJsonAsync<LessonProgressDto>();


            if (result != null)
            {
                Progress[result.CourseLessonId] =
                    result.IsCompleted;
            }
        }
        catch
        {
            ErrorMessage =
                "ذخیره پیشرفت درس با خطا مواجه شد.";
        }
        finally
        {
            IsSavingProgress = false;
        }
    }


    private string GetDeliveryTypeText(string? value)
    {
        return value switch
        {
            "Online" => "آنلاین",
            "InPerson" => "حضوری",
            "Hybrid" => "ترکیبی",
            _ => "نامشخص"
        };
    }


    private async Task<string> GetErrorMessage(
        HttpResponseMessage response)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ApiError>();

            if (!string.IsNullOrWhiteSpace(error?.Message))
            {
                return error.Message;
            }
        }
        catch
        {
        }

        return "عملیات انجام نشد.";
    }


    public class StudentCourseContentDto
    {
        public int CourseId { get; set; }

        public string CourseTitle { get; set; } = string.Empty;

        public string DeliveryType { get; set; } = "Online";

        public List<StudentCourseModuleDto> Modules { get; set; } = new();
    }


    public class StudentCourseModuleDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public int SortOrder { get; set; }

        public List<StudentCourseLessonDto> Lessons { get; set; } = new();
    }


    public class StudentCourseLessonDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string ContentType { get; set; } = "Video";

        public string? ContentUrl { get; set; }

        public int DurationMinutes { get; set; }

        public int SortOrder { get; set; }

        public bool IsFreePreview { get; set; }
    }


    public class EnrollmentDto
    {
        public int Id { get; set; }

        public int CourseId { get; set; }

        public string? CourseTitle { get; set; }

        public string Status { get; set; } = string.Empty;
    }


    public class LessonProgressDto
    {
        public int CourseLessonId { get; set; }

        public bool IsCompleted { get; set; }

        public DateTime? CompletedAt { get; set; }
    }


    public class UpdateLessonProgressDto
    {
        public int EnrollmentId { get; set; }

        public int CourseLessonId { get; set; }

        public bool IsCompleted { get; set; }
    }


    public class ApiError
    {
        public string? Message { get; set; }
    }

}

@page "/support/follow-ups"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout SupportLayout

@inject AuthService Auth

<PageTitle>پیگیری‌ها | آموزش‌یار</PageTitle>

<div class="support-content">

    <section class="support-content-card">

        <div class="support-card-header">

            <div>
                <span>پشتیبانی آموزشی</span>
                <h2>پیگیری‌های دانشجویان من</h2>
            </div>

            <a href="/support" class="support-outline-btn">
                ← داشبورد
            </a>

        </div>


        <div class="support-followup-form">

            <div class="support-followup-form-header">
                <h3>ثبت پیگیری جدید</h3>
                <p>
                    پیگیری فقط برای دانشجویانی که به شما اختصاص داده شده‌اند ثبت می‌شود.
                </p>
            </div>


            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="support-success-message">
                    @SuccessMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="support-error-message">
                    @ErrorMessage
                </div>
            }


            <div class="support-form-grid">

                <div class="support-form-group">

                    <label>
                        دانشجو
                    </label>

                    <select
                        class="support-form-input"
                        @bind="FormStudentId">

                        <option value="0">
                            انتخاب دانشجو
                        </option>

                        @foreach (var student in Students)
                        {
                            <option value="@student.Id">
                                @student.FirstName @student.LastName
                            </option>
                        }

                    </select>

                </div>


                <div class="support-form-group">

                    <label>
                        تاریخ پیگیری
                    </label>

                    <input
                        type="datetime-local"
                        class="support-form-input"
                        @bind="FormFollowUpDate" />

                </div>


                <div class="support-form-group">

                    <label>
                        وضعیت
                    </label>

                    <select
                        class="support-form-input"
                        @bind="FormStatus">

                        <option value="Pending">
                            در انتظار پیگیری
                        </option>

                        <option value="InProgress">
                            در حال پیگیری
                        </option>

                        <option value="Completed">
                            تکمیل‌شده
                        </option>

                        <option value="Cancelled">
                            لغوشده
                        </option>

                    </select>

                </div>


                <div class="support-form-group support-form-wide">

                    <label>
                        توضیحات
                    </label>

                    <textarea
                        class="support-form-input support-form-textarea"
                        @bind="FormDescription"
                        placeholder="توضیحات پیگیری را وارد کنید...">
                    </textarea>

                </div>

            </div>


            <div class="support-form-actions">

                <button
                    type="button"
                    class="support-primary-btn"
                    disabled="@IsSaving"
                    @onclick="CreateFollowUp">

                    @(IsSaving ? "در حال ثبت..." : "ثبت پیگیری")

                </button>

            </div>

        </div>

    </section>


    <section class="support-content-card">

        <div class="support-card-header">

            <div>
                <span>سوابق</span>
                <h2>آخرین پیگیری‌ها</h2>
            </div>

        </div>


        @if (IsLoading)
        {
            <div class="support-loading">
                در حال دریافت اطلاعات...
            </div>
        }
        else if (FollowUps.Count == 0)
        {
            <div class="support-empty-state">

                <h3>
                    هنوز پیگیری‌ای ثبت نشده است.
                </h3>

                <p>
                    پیگیری‌های ثبت‌شده برای دانشجویان شما در این بخش نمایش داده می‌شود.
                </p>

            </div>
        }
        else
        {
            <div class="support-followups-list">

                @foreach (var item in FollowUps)
                {
                    <div class="support-followup-row">

                        <div class="support-followup-main">

                            <strong>
                                @item.StudentName
                            </strong>

                            <small>
                                تاریخ پیگیری:
                                @item.FollowUpDate.ToString("yyyy/MM/dd HH:mm")
                            </small>

                        </div>


                        <div class="support-followup-status">

                            <small>
                                وضعیت
                            </small>

                            <span class="@GetStatusClass(item.Status)">
                                @GetStatusText(item.Status)
                            </span>

                        </div>


                        <div class="support-followup-description">

                            <small>
                                توضیحات
                            </small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "بدون توضیح"
                                    : item.Description)
                            </strong>

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</div>


@code {

    private List<StudentDto> Students { get; set; } = new();

    private List<FollowUpDto> FollowUps { get; set; } = new();

    private int FormStudentId { get; set; }

    private DateTime FormFollowUpDate { get; set; } = DateTime.Now;

    private string FormStatus { get; set; } = "Pending";

    private string FormDescription { get; set; } = string.Empty;

    private bool IsLoading { get; set; } = true;

    private bool IsSaving { get; set; }

    private string? ErrorMessage { get; set; }

    private string? SuccessMessage { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.IsSupport)
        {
            return;
        }

        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Students =
                await client.GetFromJsonAsync<List<StudentDto>>(
                    "api/Students")
                ?? new List<StudentDto>();

            FollowUps =
                await client.GetFromJsonAsync<List<FollowUpDto>>(
                    "api/StudentFollowUps")
                ?? new List<FollowUpDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task CreateFollowUp()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (FormStudentId <= 0)
        {
            ErrorMessage = "لطفاً دانشجو را انتخاب کنید.";
            return;
        }

        IsSaving = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var request = new CreateFollowUpDto
            {
                StudentId = FormStudentId,
                FollowUpDate = FormFollowUpDate,
                Status = FormStatus,
                Description =
                    string.IsNullOrWhiteSpace(FormDescription)
                        ? null
                        : FormDescription.Trim()
            };

            var response =
                await client.PostAsJsonAsync(
                    "api/StudentFollowUps",
                    request);

            if (!response.IsSuccessStatusCode)
            {
                var message =
                    await response.Content.ReadAsStringAsync();

                ErrorMessage =
                    string.IsNullOrWhiteSpace(message)
                        ? "ثبت پیگیری انجام نشد."
                        : "ثبت پیگیری انجام نشد.";

                return;
            }

            SuccessMessage =
                "پیگیری با موفقیت ثبت شد.";

            FormStudentId = 0;
            FormFollowUpDate = DateTime.Now;
            FormStatus = "Pending";
            FormDescription = string.Empty;

            FollowUps =
                await client.GetFromJsonAsync<List<FollowUpDto>>(
                    "api/StudentFollowUps")
                ?? new List<FollowUpDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "در انتظار پیگیری",
            "InProgress" => "در حال پیگیری",
            "Completed" => "تکمیل‌شده",
            "Cancelled" => "لغوشده",
            _ => status
        };
    }


    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "payment-pending",
            "InProgress" => "status-completed",
            "Completed" => "payment-paid",
            "Cancelled" => "payment-cancelled",
            _ => "status-default"
        };
    }


    public class StudentDto
    {
        public int Id { get; set; }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;
    }


    public class FollowUpDto
    {
        public int Id { get; set; }

        public int StudentId { get; set; }

        public string StudentName { get; set; } = string.Empty;

        public int? SupportUserId { get; set; }

        public DateTime FollowUpDate { get; set; }

        public string Status { get; set; } = string.Empty;

        public string? Description { get; set; }

        public DateTime CreatedDate { get; set; }
    }


    public class CreateFollowUpDto
    {
        public int StudentId { get; set; }

        public DateTime FollowUpDate { get; set; }

        public string Status { get; set; } = "Pending";

        public string? Description { get; set; }
    }

}

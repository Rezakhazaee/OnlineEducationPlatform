}


private async Task DeletePartnerOrganization(
    CoursePartnerOrganizationDto contract)
{
    PartnerOrganizationError = null;
    PartnerOrganizationSuccess = null;

    try
    {
        var client = Auth.CreateAuthenticatedClient();

        var response = await client.DeleteAsync(
            $"api/CoursePartnerOrganizations/{contract.Id}");

        if (!response.IsSuccessStatusCode)

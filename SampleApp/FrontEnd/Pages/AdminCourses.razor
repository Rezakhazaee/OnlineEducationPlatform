@page "/admin/courses"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>مدیریت دوره‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses" class="active">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports">
                <span>▤</span>
                گزارش‌ها
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <a href="/">
                ← بازگشت به سایت
            </a>

        </div>

    </aside>


    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    مدیریت سامانه
                </span>

                <h1>
                    دوره‌ها
                </h1>
            </div>

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "مدیر سیستم")
                    </strong>

                    <small>
                        Administrator
                    </small>
                </div>

            </div>

        </header>


        @if (IsLoading)
        {
            <div class="admin-loading">

                <div class="admin-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت دوره‌ها...
                </h3>

                <p>
                    اطلاعات دوره‌ها از سرور دریافت می‌شود.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">

                <strong>
                    خطا در دریافت دوره‌ها
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    class="admin-outline-btn"
                    @onclick="LoadCourses">

                    تلاش مجدد

                </button>

            </div>
        }
        else
        {
            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت آموزشی
                        </span>

                        <h2>
                            فهرست دوره‌ها
                        </h2>
                    </div>

                    <button
                        class="admin-primary-btn"
                        @onclick="OpenCreateForm">

                        + افزودن دوره

                    </button>

                </div>


                @if (ShowForm)
                {
                    <div class="course-form-card">

                        <div class="course-form-header">

                            <div>
                                <span>
                                    @(EditingCourseId == null
                                        ? "دوره جدید"
                                        : "ویرایش دوره")
                                </span>

                                <h3>
                                    @(EditingCourseId == null
                                        ? "افزودن دوره جدید"
                                        : "ویرایش اطلاعات دوره")
                                </h3>
                            </div>

                            <button
                                class="course-close-btn"
                                @onclick="CloseForm">

                                ×

                            </button>

                        </div>


                        <div class="course-form-grid">

                            <div class="form-group">

                                <label>
                                    عنوان دوره
                                </label>

                                <input
                                    type="text"
                                    @bind="FormTitle"
                                    placeholder="مثلاً آموزش Excel مقدماتی" />

                            </div>


                            <div class="form-group">

                                <label>
                                    قیمت دوره
                                </label>

                                <input
                                    type="number"
                                    @bind="FormPrice"
                                    placeholder="مثلاً 2500000" />

                                <small class="form-hint">
                                    مبلغ به تومان
                                </small>

                            </div>


                            <div class="form-group course-description-group">

                                <label>
                                    توضیحات دوره
                                </label>

                                <textarea
                                    @bind="FormDescription"
                                    placeholder="توضیح کوتاهی درباره دوره وارد کنید...">
                                </textarea>

                            </div>


                            <div class="form-group">

                                <label>
                                    مدرس دوره
                                </label>

                                <select @bind="FormInstructorId">

                                    <option value="">
                                        بدون مدرس
                                    </option>

                                    @foreach (var instructor in Instructors)
                                    {
                                        <option value="@instructor.Id">
                                            @instructor.FullName
                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="course-active-option">

                                <label class="course-checkbox">

                                    <input
                                        type="checkbox"
                                        @bind="FormIsActive" />

                                    <span>
                                        دوره فعال باشد
                                    </span>

                                </label>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(FormError))
                        {
                            <div class="course-form-error">
                                @FormError
                            </div>
                        }


                        <div class="course-form-actions">

                            <button
                                class="admin-primary-btn"
                                @onclick="SaveCourse"
                                disabled="@IsSaving">

                                @(IsSaving
                                    ? "در حال ذخیره..."
                                    : "ذخیره دوره")

                            </button>

                            <button
                                class="admin-outline-btn"
                                @onclick="CloseForm"
                                disabled="@IsSaving">

                                انصراف

                            </button>

                        </div>

                    </div>
                }


                @if (Courses.Count == 0)
                {
                    <div class="admin-empty-state">

                        <div>
                            ▣
                        </div>

                        <h3>
                            هنوز دوره‌ای ثبت نشده است
                        </h3>

                        <p>
                            برای شروع، اولین دوره آموزشی را اضافه کنید.
                        </p>

                        <button
                            class="admin-primary-btn"
                            @onclick="OpenCreateForm">

                            + افزودن اولین دوره

                        </button>

                    </div>
                }
                else
                {
                    <div class="courses-table-wrapper">

                        <table class="courses-table">

                            <thead>

                                <tr>

                                    <th>
                                        عنوان دوره
                                    </th>

                                    <th>
                                        مدرس
                                    </th>

                                    <th>
                                        قیمت
                                    </th>

                                    <th>
                                        وضعیت
                                    </th>

                                    <th>
                                        عملیات
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var course in Courses)
                                {
                                    <tr>

                                        <td>

                                            <div class="course-title-cell">

                                                <strong>
                                                    @course.Title
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(course.Description))
                                                {
                                                    <small>
                                                        @course.Description
                                                    </small>
                                                }

                                            </div>

                                        </td>


                                        <td>

                                            @GetInstructorName(course.InstructorId)

                                        </td>


                                        <td>

                                            <strong>
                                                @course.Price.ToString("N0")
                                            </strong>

                                            <span class="price-unit">
                                                تومان
                                            </span>

                                        </td>


                                        <td>

                                            @if (course.IsActive)
                                            {
                                                <span class="course-status active">
                                                    فعال
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="course-status inactive">
                                                    غیرفعال
                                                </span>
                                            }

                                        </td>


                                        <td>

                                            <button
                                                class="course-edit-btn"
                                                @onclick="() => OpenEditForm(course)">

                                                ویرایش

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }

    </main>

</div>


@code {

    private List<CourseDto> Courses { get; set; } = new();

    private List<InstructorDto> Instructors { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private bool ShowForm { get; set; }

    private bool IsSaving { get; set; }

    private string? ErrorMessage { get; set; }

    private string? FormError { get; set; }

    private int? EditingCourseId { get; set; }

    private string FormTitle { get; set; } = string.Empty;

    private string FormDescription { get; set; } = string.Empty;

    private decimal FormPrice { get; set; }

    private string FormInstructorId { get; set; } = string.Empty;

    private bool FormIsActive { get; set; } = true;


    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
        await LoadInstructors();
    }


    private async Task LoadCourses()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var result = await client.GetFromJsonAsync<List<CourseDto>>(
                "api/Courses"
            );

            Courses = result ?? new List<CourseDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً مطمئن شوید Backend در حال اجرا است.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task LoadInstructors()
    {
        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var result =
                await client.GetFromJsonAsync<List<InstructorDto>>(
                    "api/Courses/instructors"
                );

            Instructors = result ?? new List<InstructorDto>();
        }
        catch
        {
            Instructors = new List<InstructorDto>();
        }
    }


    private void OpenCreateForm()
    {
        EditingCourseId = null;

        FormTitle = string.Empty;
        FormDescription = string.Empty;
        FormPrice = 0;
        FormInstructorId = string.Empty;
        FormIsActive = true;

        FormError = null;
        ShowForm = true;
    }


    private void OpenEditForm(CourseDto course)
    {
        EditingCourseId = course.Id;

        FormTitle = course.Title;
        FormDescription = course.Description ?? string.Empty;
        FormPrice = course.Price;

        FormInstructorId =
            course.InstructorId?.ToString()
            ?? string.Empty;

        FormIsActive = course.IsActive;

        FormError = null;
        ShowForm = true;
    }


    private void CloseForm()
    {
        if (IsSaving)
        {
            return;
        }

        ShowForm = false;
        FormError = null;
    }


    private async Task SaveCourse()
    {
        FormError = null;

        if (string.IsNullOrWhiteSpace(FormTitle))
        {
            FormError =
                "لطفاً عنوان دوره را وارد کنید.";

            return;
        }

        if (FormPrice < 0)
        {
            FormError =
                "قیمت دوره نمی‌تواند منفی باشد.";

            return;
        }

        IsSaving = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            int? instructorId = null;

            if (int.TryParse(
                FormInstructorId,
                out var parsedInstructorId))
            {
                instructorId = parsedInstructorId;
            }


            if (EditingCourseId == null)
            {
                var request = new CreateCourseDto
                {
                    Title = FormTitle,
                    Description = FormDescription,
                    Price = FormPrice,
                    InstructorId = instructorId,
                    IsActive = FormIsActive
                };

                var response =
                    await client.PostAsJsonAsync(
                        "api/Courses",
                        request
                    );

                if (!response.IsSuccessStatusCode)
                {
                    FormError =
                        await GetErrorMessage(response);

                    return;
                }
            }
            else
            {
                var request = new UpdateCourseDto
                {
                    Title = FormTitle,
                    Description = FormDescription,
                    Price = FormPrice,
                    IsActive = FormIsActive
                };

                var response =
                    await client.PutAsJsonAsync(
                        $"api/Courses/{EditingCourseId}",
                        request
                    );

                if (!response.IsSuccessStatusCode)
                {
                    FormError =
                        await GetErrorMessage(response);

                    return;
                }
            }


            ShowForm = false;

            await LoadCourses();
        }
        catch
        {
            FormError =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private string GetInstructorName(int? instructorId)
    {
        if (!instructorId.HasValue)
        {
            return "بدون مدرس";
        }

        var instructor =
            Instructors.FirstOrDefault(
                x => x.Id == instructorId.Value
            );

        return instructor?.FullName
            ?? "مدرس نامشخص";
    }


    private async Task<string> GetErrorMessage(
        HttpResponseMessage response)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ApiError>();

            return error?.Message
                ?? "عملیات با خطا مواجه شد.";
        }
        catch
        {
            return "عملیات با خطا مواجه شد.";
        }
    }


    public class CourseDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public decimal Price { get; set; }

        public int? InstructorId { get; set; }

        public bool IsActive { get; set; }
    }


    public class InstructorDto
    {
        public int Id { get; set; }

        public string? FullName { get; set; }

        public string? Mobile { get; set; }

        public string? Username { get; set; }

        public bool IsActive { get; set; }

        public int CourseCount { get; set; }
    }


    public class CreateCourseDto
    {
        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public decimal Price { get; set; }

        public int? InstructorId { get; set; }

        public bool IsActive { get; set; } = true;
    }


    public class UpdateCourseDto
    {
        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public decimal Price { get; set; }

        public bool IsActive { get; set; }
    }


    public class ApiError
    {
        public string? Message { get; set; }
    }
}
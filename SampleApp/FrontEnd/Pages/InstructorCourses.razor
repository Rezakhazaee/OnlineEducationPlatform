@page "/instructor/courses"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout InstructorLayout

@inject AuthService Auth

<PageTitle>دوره‌های من | آموزش‌یار</PageTitle>

<div class="support-content">

    <section class="support-content-card">

        <div class="support-card-header">

            <div>
                <span>آموزش</span>
                <h2>دوره‌های من</h2>
            </div>

            <a href="/instructor" class="support-outline-btn">
                ← داشبورد
            </a>

        </div>


        @if (IsLoading)
        {
            <div class="support-loading">
                در حال دریافت اطلاعات...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="support-error">
                <strong>@ErrorMessage</strong>
            </div>
        }
        else if (Courses.Count == 0)
        {
            <div class="support-empty-state">
                <h3>هنوز دوره‌ای به شما اختصاص داده نشده است.</h3>
            </div>
        }
        else
        {
            <div class="support-enrollments-list">

                @foreach (var course in Courses)
                {
                    <div class="support-enrollment-row">

                        <div class="support-enrollment-main">

                            <strong>
                                @course.Title
                            </strong>

                            <span>
                                @course.Price.ToString("N0") تومان
                            </span>

                            @if (!string.IsNullOrWhiteSpace(course.Description))
                            {
                                <span>
                                    @course.Description
                                </span>
                            }

                        </div>


                        <div>

                            <small>
                                وضعیت
                            </small>

                            <span class="@(course.IsActive ? "status-active" : "status-cancelled")">
                                @(course.IsActive ? "فعال" : "غیرفعال")
                            </span>

                        </div>


                        <div>

                            <small>
                                عملیات
                            </small>

                            <button
                                type="button"
                                class="support-outline-btn"
                                @onclick="() => ToggleCourseStatus(course)">

                                @(course.IsActive ? "غیرفعال کردن" : "فعال کردن")

                            </button>

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</div>


@code {

    private List<CourseDto> Courses { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.IsInstructor)
        {
            return;
        }

        await LoadCourses();
    }


    private async Task LoadCourses()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Courses =
                await client.GetFromJsonAsync<List<CourseDto>>(
                    "api/Courses")
                ?? new List<CourseDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task ToggleCourseStatus(CourseDto course)
    {
        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var response =
                await client.PutAsJsonAsync(
                    $"api/Courses/{course.Id}/status",
                    new UpdateCourseStatusDto
                    {
                        IsActive = !course.IsActive
                    });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "تغییر وضعیت دوره انجام نشد.";
                return;
            }

            course.IsActive = !course.IsActive;
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
    }


    public class CourseDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public decimal Price { get; set; }

        public int? InstructorId { get; set; }

        public bool IsActive { get; set; }
    }


    public class UpdateCourseStatusDto
    {
        public bool IsActive { get; set; }
    }

}

@page "/instructor/courses"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout InstructorLayout

@inject AuthService Auth

<PageTitle>دوره‌های من | آموزش‌یار</PageTitle>

<div class="support-content">

    @if (IsLoading)
    {
        <section class="support-content-card">

            <div class="support-loading">

                <div class="support-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت دوره‌ها...
                </h3>

                <p>
                    اطلاعات دوره‌های شما در حال بارگذاری است.
                </p>

            </div>

        </section>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="support-content-card">

            <div class="support-error">

                <strong>
                    خطا
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    type="button"
                    class="support-outline-btn"
                    @onclick="LoadCourses">

                    تلاش مجدد

                </button>

            </div>

        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="support-success-message">
                @SuccessMessage
            </div>
        }


        <section class="support-content-card">

            <div class="support-card-header">

                <div>

                    <span>
                        آموزش
                    </span>

                    <h2>
                        دوره‌های من
                    </h2>

                </div>

                <a
                    href="/instructor"
                    class="support-outline-btn">

                    ← داشبورد

                </a>

            </div>


            @if (Courses.Count == 0)
            {
                <div class="support-empty-state">

                    <h3>
                        هنوز دوره‌ای به شما اختصاص داده نشده است.
                    </h3>

                    <p>
                        دوره‌های اختصاص‌یافته به شما در این بخش نمایش داده می‌شوند.
                    </p>

                </div>
            }
            else
            {
                <div class="support-enrollments-list">

                    @foreach (var course in Courses)
                    {
                        <div class="support-enrollment-row">

                            <div class="support-enrollment-main">

                                <strong>
                                    @course.Title
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(course.Description))
                                {
                                    <span>
                                        @course.Description
                                    </span>
                                }

                                <span>
                                    قیمت:
                                    @course.Price.ToString("N0")
                                    تومان
                                </span>

                            </div>


                            <div>

                                <small>
                                    وضعیت
                                </small>

                                <span class="@(course.IsActive
                                    ? "status-active"
                                    : "status-cancelled")">

                                    @(course.IsActive
                                        ? "فعال"
                                        : "غیرفعال")

                                </span>

                            </div>


                            <div>

                                <small>
                                    عملیات
                                </small>

                                <div class="instructor-course-actions">

                                    <a href="/instructor/course-content/@course.Id" class="support-outline-btn">

                                        محتوای دوره

                                    </a>


                                    <button
                                        type="button"
                                        class="support-outline-btn"
                                        @onclick="() => OpenEditForm(course)">

                                        ویرایش

                                    </button>


                                    <button
                                        type="button"
                                        class="instructor-status-btn @(course.IsActive
                                            ? "is-active"
                                            : "is-inactive")"
                                        @onclick="() => ToggleCourseStatus(course)">

                                        @(course.IsActive
                                            ? "غیرفعال کردن"
                                            : "فعال کردن")

                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </section>


        @if (ShowEditForm)
        {
            <section class="support-content-card">

                <div class="support-card-header">

                    <div>

                        <span>
                            مدیریت دوره
                        </span>

                        <h2>
                            ویرایش دوره
                        </h2>

                    </div>


                    <button
                        type="button"
                        class="support-outline-btn"
                        @onclick="CloseEditForm">

                        بستن

                    </button>

                </div>


                <div class="support-followup-form">

                    <div class="support-form-grid">

                        <div class="support-form-group support-form-wide">

                            <label>
                                عنوان دوره
                            </label>

                            <input
                                class="support-form-input"
                                @bind="FormTitle" />

                        </div>


                        <div class="support-form-group support-form-wide">

                            <label>
                                توضیحات
                            </label>

                            <textarea
                                class="support-form-input support-form-textarea"
                                @bind="FormDescription"></textarea>

                        </div>


                        <div class="support-form-group">

                            <label>
                                قیمت دوره
                            </label>

                            <input
                                class="support-form-input"
                                type="number"
                                min="0"
                                step="1"
                                @bind="FormPrice" />

                        </div>

                    </div>


                    <div class="support-form-actions">

                        <button
                            type="button"
                            class="support-primary-btn"
                            disabled="@IsSaving"
                            @onclick="SaveCourse">

                            @(IsSaving
                                ? "در حال ذخیره..."
                                : "ذخیره تغییرات")

                        </button>

                    </div>

                </div>

            </section>
        }

    }

</div>


@code {

    private List<CourseDto> Courses { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private bool IsSaving { get; set; }

    private bool ShowEditForm { get; set; }

    private int? EditingCourseId { get; set; }

    private string? ErrorMessage { get; set; }

    private string? SuccessMessage { get; set; }

    private string FormTitle { get; set; } = string.Empty;

    private string? FormDescription { get; set; }

    private decimal FormPrice { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.IsInstructor)
        {
            return;
        }

        await LoadCourses();
    }


    private async Task LoadCourses()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Courses =
                await client.GetFromJsonAsync<List<CourseDto>>(
                    "api/Courses")
                ?? new List<CourseDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private void OpenEditForm(CourseDto course)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        EditingCourseId = course.Id;

        FormTitle = course.Title;
        FormDescription = course.Description;
        FormPrice = course.Price;

        ShowEditForm = true;
    }


    private void CloseEditForm()
    {
        ShowEditForm = false;
        EditingCourseId = null;

        ErrorMessage = null;
        SuccessMessage = null;
    }


    private async Task SaveCourse()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (!EditingCourseId.HasValue)
        {
            ErrorMessage =
                "دوره‌ای برای ویرایش انتخاب نشده است.";

            return;
        }

        if (string.IsNullOrWhiteSpace(FormTitle))
        {
            ErrorMessage =
                "عنوان دوره الزامی است.";

            return;
        }

        if (FormTitle.Trim().Length < 3)
        {
            ErrorMessage =
                "عنوان دوره باید حداقل ۳ کاراکتر باشد.";

            return;
        }

        if (FormPrice < 0)
        {
            ErrorMessage =
                "قیمت نمی‌تواند منفی باشد.";

            return;
        }


        var course =
            Courses.FirstOrDefault(
                x => x.Id == EditingCourseId.Value);

        if (course == null)
        {
            ErrorMessage =
                "دوره پیدا نشد.";

            return;
        }


        IsSaving = true;

        try
        {
            var client =
                Auth.CreateAuthenticatedClient();


            var request = new UpdateCourseDto
            {
                Title =
                    FormTitle.Trim(),

                Description =
                    string.IsNullOrWhiteSpace(FormDescription)
                        ? null
                        : FormDescription.Trim(),

                Price =
                    FormPrice,

                // وضعیت در فرم ویرایش تغییر نمی‌کند
                IsActive =
                    course.IsActive
            };


            var response =
                await client.PutAsJsonAsync(
                    $"api/Courses/{course.Id}",
                    request);


            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }


            var updatedCourse =
                await response.Content
                    .ReadFromJsonAsync<CourseDto>();


            if (updatedCourse != null)
            {
                course.Title =
                    updatedCourse.Title;

                course.Description =
                    updatedCourse.Description;

                course.Price =
                    updatedCourse.Price;

                course.IsActive =
                    updatedCourse.IsActive;
            }
            else
            {
                course.Title =
                    FormTitle.Trim();

                course.Description =
                    string.IsNullOrWhiteSpace(FormDescription)
                        ? null
                        : FormDescription.Trim();

                course.Price =
                    FormPrice;
            }


            SuccessMessage =
                "اطلاعات دوره با موفقیت ذخیره شد.";

            ShowEditForm = false;
            EditingCourseId = null;
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private async Task ToggleCourseStatus(CourseDto course)
    {
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var client =
                Auth.CreateAuthenticatedClient();


            var response =
                await client.PutAsJsonAsync(
                    $"api/Courses/{course.Id}/status",
                    new UpdateCourseStatusDto
                    {
                        IsActive = !course.IsActive
                    });


            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    await GetErrorMessage(response);

                return;
            }


            var updatedCourse =
                await response.Content
                    .ReadFromJsonAsync<CourseDto>();


            if (updatedCourse != null)
            {
                course.IsActive =
                    updatedCourse.IsActive;
            }
            else
            {
                course.IsActive =
                    !course.IsActive;
            }


            SuccessMessage =
                course.IsActive
                    ? "دوره فعال شد."
                    : "دوره غیرفعال شد.";
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد.";
        }
    }


    private async Task<string> GetErrorMessage(
        HttpResponseMessage response)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ApiError>();

            if (!string.IsNullOrWhiteSpace(
                error?.Message))
            {
                return error.Message;
            }
        }
        catch
        {
        }

        return "عملیات انجام نشد.";
    }


    public class CourseDto
    {
        public int Id { get; set; }

        public string Title { get; set; } =
            string.Empty;

        public string? Description { get; set; }

        public decimal Price { get; set; }

        public int? InstructorId { get; set; }

        public bool IsActive { get; set; }
    }


    public class UpdateCourseDto
    {
        public string Title { get; set; } =
            string.Empty;

        public string? Description { get; set; }

        public decimal Price { get; set; }

        public bool IsActive { get; set; }
    }


    public class UpdateCourseStatusDto
    {
        public bool IsActive { get; set; }
    }


    public class ApiError
    {
        public string? Message { get; set; }
    }

}

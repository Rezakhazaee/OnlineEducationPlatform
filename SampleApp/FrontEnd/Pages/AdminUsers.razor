@page "/admin/users"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>مدیریت کاربران | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users" class="active">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports">
                <span>▤</span>
                گزارش‌ها
            </a>

        </nav>

        <div class="admin-sidebar-bottom">
            <a href="/">
                ← بازگشت به سایت
            </a>
        </div>

    </aside>


    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    مدیریت سامانه
                </span>

                <h1>
                    کاربران
                </h1>
            </div>

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "مدیر سیستم")
                    </strong>

                    <small>
                        Administrator
                    </small>
                </div>

            </div>

        </header>
         
         @if (ShowCreateUserForm)
            {
                <section class="admin-content-card">

                    <div class="admin-card-header">
                        <div>
                            <span>کاربر جدید</span>
                            <h2>افزودن کاربر</h2>
                        </div>

                        <button
                            class="admin-outline-btn"
                            @onclick="CloseCreateUserForm">

                            انصراف

                        </button>
                    </div>

                    <div class="admin-form">

                        <div class="admin-form-group">
                            <label>نام و نام خانوادگی</label>
                            <input
                                class="admin-input"
                                @bind="NewUser.FullName"
                                placeholder="مثلاً علی رضایی" />
                        </div>

                        <div class="admin-form-group">
                            <label>شماره موبایل</label>
                            <input
                                class="admin-input"
                                @bind="NewUser.Mobile"
                                placeholder="مثلاً 09120000001" />
                        </div>

                        <div class="admin-form-group">
                            <label>نام کاربری</label>
                            <input
                                class="admin-input"
                                @bind="NewUser.Username"
                                placeholder="نام کاربری" />
                        </div>

                        <div class="admin-form-group">
                            <label>رمز عبور</label>
                            <input
                                type="password"
                                class="admin-input"
                                @bind="NewUser.Password"
                                placeholder="رمز عبور" />
                        </div>

                        <div class="admin-form-group">
                            <label>نقش</label>

                            <select
                                class="admin-input"
                                @bind="NewUser.Role">

                                <option value="Student">دانشجو</option>
                                <option value="Instructor">مدرس</option>
                                <option value="Support">پشتیبان</option>
                                <option value="Admin">مدیر</option>

                            </select>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(CreateUserMessage))
                        {
                            <div class="admin-error">
                                @CreateUserMessage
                            </div>
                        }

                        <button
                            class="admin-primary-btn"
                            @onclick="CreateUser">

                            ایجاد کاربر

                        </button>

                    </div>

                </section>
            }

            @if (ShowEditUserForm)
            {
                <section class="admin-content-card">
                    <div class="admin-card-header">
                        <div>
                            <span>ویرایش کاربر</span>
                            <h2>ویرایش اطلاعات کاربر</h2>
                        </div>

                        <button class="admin-outline-btn" @onclick="CloseEditUserForm">
                            انصراف
                        </button>
                    </div>

                    <div class="admin-form">

                        <div class="admin-form-group">
                            <label>نام و نام خانوادگی</label>

                            <input
                                class="admin-input"
                                @bind="EditUser.FullName"
                                placeholder="نام و نام خانوادگی" />
                        </div>

                        <div class="admin-form-group">
                            <label>شماره موبایل</label>

                            <input
                                class="admin-input"
                                @bind="EditUser.Mobile"
                                placeholder="شماره موبایل" />
                        </div>

                        <div class="admin-form-group">
                            <label>نام کاربری</label>

                            <input
                                class="admin-input"
                                @bind="EditUser.Username"
                                placeholder="نام کاربری" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(EditUserMessage))
                        {
                            <div class="admin-error">
                                @EditUserMessage
                            </div>
                        }

                        <button
                            class="admin-primary-btn"
                            @onclick="UpdateUser">

                            ذخیره تغییرات

                        </button>

                    </div>
                </section>
            }
      
             @if (ShowRoleForm)
{
    <section class="admin-content-card">
        <div class="admin-card-header">
            <div>
                <span>تغییر نقش</span>
                <h2>تغییر نقش کاربر</h2>
            </div>

            <button class="admin-outline-btn" @onclick="CloseRoleForm">
                انصراف
            </button>
        </div>

        <div class="admin-form">

            <div class="admin-form-group">
                <label>نقش جدید</label>

                <select
                    class="admin-input"
                    @bind="ChangeRole.Role">

                    <option value="Student">دانشجو</option>
                    <option value="Instructor">مدرس</option>
                    <option value="Support">پشتیبان</option>
                    <option value="Admin">مدیر</option>

                </select>
            </div>

            @if (!string.IsNullOrWhiteSpace(RoleMessage))
            {
                <div class="admin-error">
                    @RoleMessage
                </div>
            }

            <button
                class="admin-primary-btn"
                @onclick="UpdateUserRole">

                ذخیره نقش

            </button>

        </div>
    </section>
}
        @if (IsLoading)
        {
            <div class="admin-loading">

                <div class="admin-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت کاربران...
                </h3>

                <p>
                    اطلاعات کاربران از سرور دریافت می‌شود.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">

                <strong>
                    خطا در دریافت کاربران
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    class="admin-outline-btn"
                    @onclick="LoadUsers">

                    تلاش مجدد

                </button>

            </div>
        }
        else
        {
            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت کاربران
                        </span>

                        <h2>
                            فهرست کاربران
                        </h2>
                    </div>

                    <div class="users-count">
                        @Users.Count کاربر
                    </div>
                    <button
                        class="admin-primary-btn"
                        @onclick="OpenCreateUserForm">

                        + افزودن کاربر

                    </button>

                </div>


                @if (Users.Count == 0)
                {
                    <div class="admin-empty-state">

                        <div>
                            ♙
                        </div>

                        <h3>
                            کاربری پیدا نشد
                        </h3>

                        <p>
                            هنوز کاربری در سیستم ثبت نشده است.
                        </p>

                    </div>
                }
                else
                {
                    <div class="users-table-wrapper">

                        <table class="users-table">

                            <thead>

                                <tr>

                                    <th>
                                        نام و نام خانوادگی
                                    </th>

                                    <th>
                                        نام کاربری
                                    </th>

                                    <th>
                                        موبایل
                                    </th>

                                    <th>
                                        نقش
                                    </th>

                                    <th>
                                        وضعیت
                                    </th>

                                    <th>
                                        تاریخ ثبت
                                    </th>

                                    <th>
                                      عملیات
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var user in Users)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @(user.FullName ?? "-")
                                            </strong>
                                        </td>

                                        <td>
                                            @user.Username
                                        </td>

                                        <td>
                                            @user.Mobile
                                        </td>

                                        <td>

                                            @if (user.Role == "Admin")
                                            {
                                                <span class="user-role admin">
                                                    مدیر
                                                </span>
                                            }
                                            else if (user.Role == "Instructor")
                                            {
                                                <span class="user-role instructor">
                                                    مدرس
                                                </span>
                                            }
                                            else if (user.Role == "Support")
                                            {
                                                <span class="user-role support">
                                                    پشتیبان
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="user-role student">
                                                    دانشجو
                                                </span>
                                            }

                                        </td>

                                        <td>

                                            @if (user.IsActive)
                                            {
                                                <span class="user-status active">
                                                    فعال
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="user-status inactive">
                                                    غیرفعال
                                                </span>
                                            }

                                        </td>

                                        <td>
                                            @user.CreatedAt.ToString("yyyy/MM/dd")
                                        </td>
                                        <td>

                                            @if (user.Id == 1)
                                            {
                                                <span class="user-status active">
                                                    Admin اصلی
                                                </span>
                                            }
                                            else
                                            {
                                                <div class="admin-user-actions">

                                                    <button
                                                        class="admin-outline-btn"
                                                        @onclick="() => OpenEditUserForm(user)">

                                                        ویرایش

                                                    </button>

                                                    <button
                                                        class="admin-outline-btn"
                                                        @onclick="() => OpenRoleForm(user)">

                                                        تغییر نقش

                                                    </button>

                                                    <button
                                                        class="admin-outline-btn"
                                                        @onclick="() => ToggleUserStatus(user)">

                                                        @(user.IsActive ? "غیرفعال کردن" : "فعال کردن")

                                                    </button>

                                                </div>
                                            }
               

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }

    </main>

</div>


@code {
     
     public class ChangeUserRoleModel
      {
       public string Role { get; set; } = "Student";
      }

    private List<UserDto> Users { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

     private bool ShowRoleForm { get; set; }
private string? RoleMessage { get; set; }
private int ChangingRoleUserId { get; set; }

private ChangeUserRoleModel ChangeRole { get; set; } = new();

private void OpenRoleForm(UserDto user)
{
    ChangingRoleUserId = user.Id;

    ChangeRole = new ChangeUserRoleModel
    {
        Role = user.Role
    };

    RoleMessage = null;
    ShowRoleForm = true;
}

private void CloseRoleForm()
{
    RoleMessage = null;
    ShowRoleForm = false;
}

private async Task UpdateUserRole()
{
    RoleMessage = null;

    try
    {
        var client = Auth.CreateAuthenticatedClient();

        var response = await client.PutAsJsonAsync(
            $"api/Users/{ChangingRoleUserId}/role",
            ChangeRole
        );

        if (response.IsSuccessStatusCode)
        {
            ShowRoleForm = false;
            await LoadUsers();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            RoleMessage =
                "تغییر نقش کاربر انجام نشد. " + error;
        }
    }
    catch
    {
        RoleMessage = "ارتباط با سرور برقرار نشد.";
    }
}
    private async Task LoadUsers()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var result =
                await client.GetFromJsonAsync<List<UserDto>>(
                    "api/Users"
                );

            Users = result ?? new List<UserDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً مطمئن شوید Backend در حال اجرا است و با حساب Admin وارد شده‌اید.";
        }
        finally
        {
            IsLoading = false;
        }
    }

private async Task ToggleUserStatus(UserDto user)
{
    try
    {
        var client = Auth.CreateAuthenticatedClient();

        var newStatus = !user.IsActive;

        var response = await client.PutAsJsonAsync(
            $"api/Users/{user.Id}/status",
            new
            {
                IsActive = newStatus
            }
        );

        if (response.IsSuccessStatusCode)
        {
            user.IsActive = newStatus;
        }
        else
        {
            ErrorMessage = "تغییر وضعیت کاربر انجام نشد.";
        }
    }
    catch
    {
        ErrorMessage = "ارتباط با سرور برقرار نشد.";
    }
}
      private bool ShowCreateUserForm { get; set; }

private string? CreateUserMessage { get; set; }

private CreateUserModel NewUser { get; set; } = new();

private void OpenCreateUserForm()
{
    CreateUserMessage = null;
    NewUser = new CreateUserModel();
    ShowCreateUserForm = true;
}

private void CloseCreateUserForm()
{
    CreateUserMessage = null;
    ShowCreateUserForm = false;
}
private async Task UpdateUser()
{
    EditUserMessage = null;

    if (string.IsNullOrWhiteSpace(EditUser.FullName) ||
        string.IsNullOrWhiteSpace(EditUser.Mobile) ||
        string.IsNullOrWhiteSpace(EditUser.Username))
    {
        EditUserMessage = "لطفاً همه اطلاعات کاربر را وارد کنید.";
        return;
    }

    try
    {
        var client = Auth.CreateAuthenticatedClient();

        var response = await client.PutAsJsonAsync(
            $"api/Users/{EditingUserId}",
            EditUser
        );

        if (response.IsSuccessStatusCode)
        {
            ShowEditUserForm = false;
            await LoadUsers();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            EditUserMessage =
                "ویرایش کاربر انجام نشد. " + error;
        }
    }
    catch
    {
        EditUserMessage =
            "ارتباط با سرور برقرار نشد.";
    }
}
private async Task CreateUser()
{
    CreateUserMessage = null;

    if (string.IsNullOrWhiteSpace(NewUser.FullName) ||
        string.IsNullOrWhiteSpace(NewUser.Mobile) ||
        string.IsNullOrWhiteSpace(NewUser.Username) ||
        string.IsNullOrWhiteSpace(NewUser.Password))
    {
        CreateUserMessage = "لطفاً همه اطلاعات کاربر را وارد کنید.";
        return;
    }

    try
    {
        var client = Auth.CreateAuthenticatedClient();

        var response = await client.PostAsJsonAsync(
            "api/Users",
            NewUser
        );

        if (response.IsSuccessStatusCode)
        {
            ShowCreateUserForm = false;

            await LoadUsers();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            CreateUserMessage =
                "ایجاد کاربر انجام نشد. " + error;
        }
    }
    catch
    {
        CreateUserMessage =
            "ارتباط با سرور برقرار نشد.";
    }
}

public class CreateUserModel
{
    public string FullName { get; set; } = string.Empty;

    public string Mobile { get; set; } = string.Empty;

    public string Username { get; set; } = string.Empty;

    public string Password { get; set; } = string.Empty;

    public string Role { get; set; } = "Student";
}
    public class UserDto
    {
        public int Id { get; set; }

        public string? FullName { get; set; }

        public string? Mobile { get; set; }

        public string Username { get; set; } = string.Empty;

        public string Role { get; set; } = string.Empty;

        public bool IsActive { get; set; }

        public DateTime CreatedAt { get; set; }
    }
    private bool ShowEditUserForm { get; set; }

private string? EditUserMessage { get; set; }

private EditUserModel EditUser { get; set; } = new();

private int EditingUserId { get; set; }

private void OpenEditUserForm(UserDto user)
{
    EditingUserId = user.Id;

    EditUser = new EditUserModel
    {
        FullName = user.FullName ?? string.Empty,
        Mobile = user.Mobile ?? string.Empty,
        Username = user.Username
    };

    EditUserMessage = null;
    ShowEditUserForm = true;
}

private void CloseEditUserForm()
{
    EditUserMessage = null;
    ShowEditUserForm = false;
}
public class EditUserModel
{
    public string FullName { get; set; } = string.Empty;

    public string Mobile { get; set; } = string.Empty;

    public string Username { get; set; } = string.Empty;
}
}

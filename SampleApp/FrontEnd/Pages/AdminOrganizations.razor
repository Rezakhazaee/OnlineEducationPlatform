@page "/admin/organizations"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>تنظیمات سامانه | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports">
                <span>▤</span>
                گزارش‌ها
            </a>

            <a href="/admin/organizations" class="active">
                <span>⚙</span>
                تنظیمات سامانه
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <a href="/">
                ← بازگشت به سایت
            </a>

        </div>

    </aside>

    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    تنظیمات سامانه
                </span>

                <h1>
                    تنظیمات سامانه
                </h1>
            </div>

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "مدیر سیستم")
                    </strong>

                    <small>
                        Administrator
                    </small>
                </div>

            </div>

        </header>

        @if (IsLoading)
        {
            <div class="admin-loading">

                <div class="admin-loading-icon">↻</div>

                <h3>
                    در حال دریافت تنظیمات...
                </h3>

                <p>
                    اطلاعات سامانه در حال بارگذاری است.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">

                <strong>
                    خطا
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    class="admin-outline-btn"
                    @onclick="LoadSettings">

                    تلاش مجدد

                </button>

            </div>
        }
        else
        {
            <!-- =========================
                 Organization Information
            ========================== -->

            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            اطلاعات سامانه
                        </span>

                        <h2>
                            اطلاعات سازمان
                        </h2>
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(OrganizationMessage))
                {
                    <div class="admin-success organization-message">
                        @OrganizationMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(OrganizationError))
                {
                    <div class="admin-error organization-message">
                        @OrganizationError
                    </div>
                }

                <div class="organization-management-form">

                    <div class="organization-form-grid">

                        <div class="admin-form">

                            <label>
                                نام سازمان
                            </label>

                            <input
                                class="admin-input"
                                @bind="OrganizationName"
                                placeholder="نام سازمان" />

                        </div>

                        <div class="admin-form">

                            <label>
                                وضعیت سامانه
                            </label>

                            <select
                                class="admin-input"
                                @bind="OrganizationIsActive">

                                <option value="true">
                                    فعال
                                </option>

                                <option value="false">
                                    غیرفعال
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="admin-form organization-description-field">

                        <label>
                            توضیحات
                        </label>

                        <textarea
                            class="admin-input organization-textarea"
                            @bind="OrganizationDescription"
                            placeholder="توضیح کوتاهی درباره سازمان یا سامانه...">
                        </textarea>

                    </div>

                </div>

            </section>

            <!-- =========================
                 Appearance Settings
            ========================== -->

            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت ظاهر
                        </span>

                        <h2>
                            رنگ‌بندی سایت
                        </h2>
                    </div>

                </div>

                <div class="organization-theme-layout">

                    <div class="organization-theme-form">

                        <div class="theme-color-field">

                            <label>
                                رنگ اصلی
                            </label>

                            <div class="theme-color-description">
                                دکمه‌ها، لینک‌های مهم، منوی فعال، لوگو و عناصر تأکیدی سایت
                            </div>

                            <div class="theme-color-control">

                                <input
                                    type="color"
                                    value="@PrimaryColor"
                                    @onchange="OnPrimaryColorChanged" />

                                <span class="theme-color-value">
                                    @PrimaryColor
                                </span>

                            </div>

                        </div>

                        <div class="theme-color-field">

                            <label>
                                رنگ ثانویه
                            </label>

                            <div class="theme-color-description">
                                عنوان‌ها، متن‌های اصلی و عناصر ثانویه سایت
                            </div>

                            <div class="theme-color-control">

                                <input
                                    type="color"
                                    value="@SecondaryColor"
                                    @onchange="OnSecondaryColorChanged" />

                                <span class="theme-color-value">
                                    @SecondaryColor
                                </span>

                            </div>

                        </div>

                        <div class="theme-active-field">

                            <label>

                                <input
                                    type="checkbox"
                                    @bind="IsThemeActive" />

                                فعال بودن رنگ‌بندی اختصاصی

                            </label>

                        </div>

                    </div>

                    <div class="organization-theme-preview">

                        <span>
                            پیش‌نمایش
                        </span>

                        <div
                            class="organization-preview-card"
                            style="@PreviewStyle">

                            <div class="organization-preview-header">

                                <strong>
                                    آموزش‌یار
                                </strong>

                                <small>
                                    سامانه آموزش آنلاین
                                </small>

                            </div>

                            <div class="organization-preview-body">

                                <h3>
                                    یادگیری، ساده‌تر از همیشه
                                </h3>

                                <p>
                                    این بخش نمونه‌ای از ظاهر سایت
                                    با رنگ‌های انتخاب‌شده است.
                                </p>

                                <button>
                                    شروع یادگیری
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

            <!-- =========================
                 Save Settings
            ========================== -->

            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            ذخیره تنظیمات
                        </span>

                        <h2>
                            اعمال تغییرات
                        </h2>
                    </div>

                </div>

                <div class="organization-form-actions">

                    <button
                        class="admin-primary-btn"
                        @onclick="SaveSettings"
                        disabled="@IsSaving">

                        @(IsSaving
                            ? "در حال ذخیره..."
                            : "ذخیره تنظیمات")

                    </button>

                </div>

                @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                {
                    <div class="admin-success">
                        @SuccessMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(SaveErrorMessage))
                {
                    <div class="admin-error">
                        @SaveErrorMessage
                    </div>
                }

            </section>
        }

    </main>

</div>

@code {

    private string OrganizationName { get; set; } = string.Empty;

    private string? OrganizationDescription { get; set; }

    private bool OrganizationIsActive { get; set; } = true;

    private string PrimaryColor { get; set; } = "#568fa8";

    private string SecondaryColor { get; set; } = "#263d4a";

    private bool IsThemeActive { get; set; } = true;

    private bool IsLoading { get; set; } = true;

    private bool IsSaving { get; set; }

    private string? ErrorMessage { get; set; }

    private string? SuccessMessage { get; set; }

    private string? SaveErrorMessage { get; set; }

    private string? OrganizationMessage { get; set; }

    private string? OrganizationError { get; set; }

    private string PreviewStyle =>
        $"--preview-primary: {PrimaryColor}; " +
        $"--preview-secondary: {SecondaryColor};";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        IsLoading = true;

        ErrorMessage = null;
        SuccessMessage = null;
        SaveErrorMessage = null;
        OrganizationMessage = null;
        OrganizationError = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var settings =
                await client.GetFromJsonAsync<OrganizationSettingsDto>(
                    "api/OrganizationSettings");

            if (settings == null)
            {
                ErrorMessage =
                    "تنظیمات سامانه دریافت نشد.";

                return;
            }

            OrganizationName =
                settings.Name ?? string.Empty;

            OrganizationDescription =
                settings.Description;

            OrganizationIsActive =
                settings.IsActive;

            PrimaryColor =
                NormalizeColor(
                    settings.PrimaryColor,
                    "#568fa8");

            SecondaryColor =
                NormalizeColor(
                    settings.SecondaryColor,
                    "#263d4a");

            IsThemeActive =
                settings.ThemeIsActive;
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnPrimaryColorChanged(
        ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(value))
        {
            PrimaryColor =
                NormalizeColor(
                    value,
                    PrimaryColor);
        }
    }

    private void OnSecondaryColorChanged(
        ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(value))
        {
            SecondaryColor =
                NormalizeColor(
                    value,
                    SecondaryColor);
        }
    }

    private async Task SaveSettings()
    {
        SuccessMessage = null;
        SaveErrorMessage = null;
        OrganizationMessage = null;
        OrganizationError = null;

        if (string.IsNullOrWhiteSpace(OrganizationName))
        {
            SaveErrorMessage =
                "نام سازمان الزامی است.";

            return;
        }

        PrimaryColor =
            NormalizeColor(
                PrimaryColor,
                "#568fa8");

        SecondaryColor =
            NormalizeColor(
                SecondaryColor,
                "#263d4a");

        IsSaving = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var request =
                new UpdateOrganizationSettingsDto
                {
                    Name =
                        OrganizationName.Trim(),

                    Description =
                        string.IsNullOrWhiteSpace(
                            OrganizationDescription)
                            ? null
                            : OrganizationDescription.Trim(),

                    IsActive =
                        OrganizationIsActive,

                    PrimaryColor =
                        PrimaryColor,

                    SecondaryColor =
                        SecondaryColor,

                    ThemeIsActive =
                        IsThemeActive
                };

            var response =
                await client.PutAsJsonAsync(
                    "api/OrganizationSettings",
                    request);

            if (response.IsSuccessStatusCode)
            {
                var updated =
                    await response.Content
                        .ReadFromJsonAsync<OrganizationSettingsDto>();

                if (updated != null)
                {
                    OrganizationName =
                        updated.Name ?? OrganizationName;

                    OrganizationDescription =
                        updated.Description;

                    OrganizationIsActive =
                        updated.IsActive;

                    PrimaryColor =
                        NormalizeColor(
                            updated.PrimaryColor,
                            "#568fa8");

                    SecondaryColor =
                        NormalizeColor(
                            updated.SecondaryColor,
                            "#263d4a");

                    IsThemeActive =
                        updated.ThemeIsActive;
                }

                SuccessMessage =
                    "تنظیمات سامانه با موفقیت ذخیره شد.";
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.Unauthorized)
            {
                SaveErrorMessage =
                    "دسترسی مدیر تأیید نشد. لطفاً دوباره وارد حساب مدیر شوید.";
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.Forbidden)
            {
                SaveErrorMessage =
                    "شما دسترسی لازم برای تغییر تنظیمات را ندارید.";
            }
            else
            {
                SaveErrorMessage =
                    "ذخیره تنظیمات با خطا مواجه شد.";
            }
        }
        catch
        {
            SaveErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string NormalizeColor(
        string? color,
        string fallback)
    {
        if (string.IsNullOrWhiteSpace(color))
            return fallback;

        color = color.Trim();

        if (color.Length != 7 ||
            color[0] != '#' ||
            !color.Skip(1).All(
                c => Uri.IsHexDigit(c)))
        {
            return fallback;
        }

        return color;
    }

    private class OrganizationSettingsDto
    {
        public int Id { get; set; }

        public string? Name { get; set; }

        public string? Description { get; set; }

        public bool IsActive { get; set; }

        public string? PrimaryColor { get; set; }

        public string? SecondaryColor { get; set; }

        public bool ThemeIsActive { get; set; }
    }

    private class UpdateOrganizationSettingsDto
    {
        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public bool IsActive { get; set; } = true;

        public string PrimaryColor { get; set; } = "#568fa8";

        public string SecondaryColor { get; set; } = "#263d4a";

        public bool ThemeIsActive { get; set; } = true;
    }
}
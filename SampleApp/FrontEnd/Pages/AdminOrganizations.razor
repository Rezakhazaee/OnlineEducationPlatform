@page "/admin/organizations"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>سازمان‌ها و ظاهر | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports">
                <span>▤</span>
                گزارش‌ها
            </a>

            <a href="/admin/organizations" class="active">
                <span>◈</span>
                سازمان‌ها و ظاهر
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <a href="/">
                ← بازگشت به سایت
            </a>

        </div>

    </aside>

    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    مدیریت سازمان‌ها
                </span>

                <h1>
                    سازمان‌ها و ظاهر
                </h1>
            </div>

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "مدیر سیستم")
                    </strong>

                    <small>
                        Administrator
                    </small>
                </div>

            </div>

        </header>

        @if (IsLoading)
        {
            <div class="admin-loading">

                <div class="admin-loading-icon">↻</div>

                <h3>
                    در حال دریافت اطلاعات...
                </h3>

                <p>
                    اطلاعات سازمان‌ها در حال بارگذاری است.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">

                <strong>
                    خطا
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    class="admin-outline-btn"
                    @onclick="LoadOrganizations">

                    تلاش مجدد

                </button>

            </div>
        }
        else
        {
            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت سازمان
                        </span>

                        <h2>
                            انتخاب سازمان
                        </h2>
                    </div>

                </div>

                <div class="admin-form">

                    <label>
                        سازمان
                    </label>

                    <select
                        class="admin-input"
                        value="@SelectedOrganizationId"
                        @onchange="OnOrganizationChanged">

                        <option value="0">
                            انتخاب سازمان
                        </option>

                        @foreach (var organization in Organizations)
                        {
                            <option value="@organization.Id">
                                @organization.Name
                            </option>
                        }

                    </select>

                </div>

            </section>

            @if (SelectedOrganizationId > 0)
            {
                <section class="admin-content-card">

                    <div class="admin-card-header">

                        <div>
                            <span>
                                تنظیمات ظاهری
                            </span>

                            <h2>
                                رنگ‌بندی سایت سازمان
                            </h2>
                        </div>

                    </div>

                    @if (ThemeLoading)
                    {
                        <div class="admin-loading">

                            <div class="admin-loading-icon">↻</div>

                            <p>
                                در حال دریافت تنظیمات ظاهر...
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="organization-theme-layout">

                            <div class="organization-theme-form">
                              
                              <div class="theme-color-field">

                                <label>
                                    رنگ اصلی
                                </label>

                                <div class="theme-color-description">
                                    دکمه‌ها، لینک‌های مهم، منوی فعال، لوگو و عناصر تأکیدی سایت
                                </div>

                                <div class="theme-color-control">

                                    <input
                                        type="color"
                                        value="@PrimaryColor"
                                        @onchange="OnPrimaryColorChanged" />

                                    <span class="theme-color-value">
                                        @PrimaryColor
                                    </span>

                                </div>

                            </div>

                                <div class="theme-color-field">

                                <label>
                                    رنگ ثانویه
                                </label>

                                <div class="theme-color-description">
                                    عنوان‌ها، متن‌های اصلی، متن‌های توضیحی و عناصر ثانویه سایت
                                </div>

                                <div class="theme-color-control">

                                    <input
                                        type="color"
                                        value="@SecondaryColor"
                                        @onchange="OnSecondaryColorChanged" />

                                    <span class="theme-color-value">
                                        @SecondaryColor
                                    </span>

                                </div>

                            </div>

                                <div class="theme-active-field">

                                    <label>

                                        <input
                                            type="checkbox"
                                            @bind="IsThemeActive" />

                                        فعال بودن این تم

                                    </label>

                                </div>

                                <div class="theme-save-area">

                                    <button
                                        class="admin-primary-btn"
                                        @onclick="SaveTheme"
                                        disabled="@IsSaving">

                                        @(IsSaving
                                            ? "در حال ذخیره..."
                                            : "ذخیره تنظیمات")

                                    </button>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                                {
                                    <div class="admin-success">
                                        @SuccessMessage
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(SaveErrorMessage))
                                {
                                    <div class="admin-error">
                                        @SaveErrorMessage
                                    </div>
                                }

                            </div>

                            <div class="organization-theme-preview">

                                <span>
                                    پیش‌نمایش
                                </span>

                                <div
                                    class="organization-preview-card"
                                    style="@PreviewStyle">

                                    <div class="organization-preview-header">

                                        <strong>
                                            آموزش‌یار
                                        </strong>

                                        <small>
                                            سامانه آموزش آنلاین
                                        </small>

                                    </div>

                                    <div class="organization-preview-body">

                                        <h3>
                                            یادگیری، ساده‌تر از همیشه
                                        </h3>

                                        <p>
                                            این بخش نمونه‌ای از ظاهر سایت
                                            با رنگ‌های انتخاب‌شده است.
                                        </p>

                                        <button>
                                            شروع یادگیری
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </section>
            }

        }

    </main>

</div>

@code {

    private List<OrganizationDto> Organizations { get; set; } = new();

    private int SelectedOrganizationId { get; set; }

    private string PrimaryColor { get; set; } = "#568fa8";

    private string SecondaryColor { get; set; } = "#263d4a";

    private bool IsThemeActive { get; set; } = true;

    private bool IsLoading { get; set; } = true;

    private bool ThemeLoading { get; set; }

    private bool IsSaving { get; set; }

    private string? ErrorMessage { get; set; }

    private string? SuccessMessage { get; set; }

    private string? SaveErrorMessage { get; set; }

    private string PreviewStyle =>
        $"--preview-primary: {PrimaryColor}; " +
        $"--preview-secondary: {SecondaryColor};";

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizations();
    }

    private async Task LoadOrganizations()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var result =
                await client.GetFromJsonAsync<List<OrganizationDto>>(
                    "api/Organizations"
                );

            Organizations = result ?? new List<OrganizationDto>();

            if (Organizations.Count == 0)
            {
                ErrorMessage =
                    "هنوز هیچ سازمانی در سامانه ثبت نشده است.";
            }
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnOrganizationChanged(
        ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id))
        {
            SelectedOrganizationId = 0;
            return;
        }

        SelectedOrganizationId = id;

        SuccessMessage = null;
        SaveErrorMessage = null;

        if (SelectedOrganizationId > 0)
        {
            await LoadTheme();
        }
    }

    private async Task LoadTheme()
    {
        ThemeLoading = true;
        SuccessMessage = null;
        SaveErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var theme =
                await client.GetFromJsonAsync<OrganizationThemeDto>(
                    $"api/OrganizationThemes/{SelectedOrganizationId}"
                );

            if (theme != null)
            {
                PrimaryColor =
                    NormalizeColor(theme.PrimaryColor, "#568fa8");

                SecondaryColor =
                    NormalizeColor(theme.SecondaryColor, "#263d4a");

                IsThemeActive = theme.IsActive;
            }
        }
        catch
        {
            SaveErrorMessage =
                "تنظیمات ظاهر سازمان دریافت نشد.";
        }
        finally
        {
            ThemeLoading = false;
        }
    }

    private void OnPrimaryColorChanged(
        ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(value))
        {
            PrimaryColor = value;
        }
    }

    private void OnSecondaryColorChanged(
        ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(value))
        {
            SecondaryColor = value;
        }
    }

    private async Task SaveTheme()
    {
        if (SelectedOrganizationId <= 0)
            return;

        IsSaving = true;
        SuccessMessage = null;
        SaveErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var request = new UpdateOrganizationThemeDto
            {
                PrimaryColor = PrimaryColor,
                SecondaryColor = SecondaryColor,
                IsActive = IsThemeActive
            };

            var response =
                await client.PutAsJsonAsync(
                    $"api/OrganizationThemes/{SelectedOrganizationId}",
                    request
                );

            if (response.IsSuccessStatusCode)
            {
                SuccessMessage =
                    "تنظیمات ظاهر سازمان با موفقیت ذخیره شد.";
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.Unauthorized)
            {
                SaveErrorMessage =
                    "دسترسی مدیر تأیید نشد. لطفاً دوباره وارد حساب مدیر شوید.";
            }
            else if (response.StatusCode ==
                     System.Net.HttpStatusCode.Forbidden)
            {
                SaveErrorMessage =
                    "شما دسترسی لازم برای تغییر ظاهر سازمان را ندارید.";
            }
            else
            {
                SaveErrorMessage =
                    "ذخیره تنظیمات با خطا مواجه شد.";
            }
        }
        catch
        {
            SaveErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string NormalizeColor(
        string? color,
        string fallback)
    {
        if (string.IsNullOrWhiteSpace(color))
            return fallback;

        if (color.Length != 7 ||
            color[0] != '#' ||
            !color.Skip(1).All(
                c => Uri.IsHexDigit(c)))
        {
            return fallback;
        }

        return color;
    }

    public class OrganizationDto
    {
        public int Id { get; set; }

        public string? Name { get; set; }

        public string? Description { get; set; }

        public bool IsActive { get; set; }
    }

    public class OrganizationThemeDto
    {
        public int Id { get; set; }

        public int OrganizationId { get; set; }

        public string? PrimaryColor { get; set; }

        public string? SecondaryColor { get; set; }

        public bool IsActive { get; set; }
    }

    public class UpdateOrganizationThemeDto
    {
        public string PrimaryColor { get; set; } = "#568fa8";

        public string SecondaryColor { get; set; } = "#263d4a";

        public bool IsActive { get; set; } = true;
    }
}

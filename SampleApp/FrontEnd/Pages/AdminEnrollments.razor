@page "/admin/enrollments"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>مدیریت ثبت‌نام‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments" class="active">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports">
                <span>▤</span>
                گزارش‌ها
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <a href="/">
                ← بازگشت به سایت
            </a>

        </div>

    </aside>


    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    مدیریت سامانه
                </span>

                <h1>
                    ثبت‌نام‌ها
                </h1>
            </div>

            <AdminLogout />

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "مدیر سیستم")
                    </strong>

                    <small>
                        Administrator
                    </small>
                </div>

            </div>

        </header>


        @if (IsLoading)
        {
            <div class="admin-loading">

                <div class="admin-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت اطلاعات...
                </h3>

                <p>
                    اطلاعات ثبت‌نام‌ها از سرور دریافت می‌شود.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">

                <strong>
                    خطا در دریافت اطلاعات
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    class="admin-outline-btn"
                    @onclick="LoadData">

                    تلاش مجدد

                </button>

            </div>
        }
        else
        {
            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت آموزشی
                        </span>

                        <h2>
                            ثبت‌نام جدید
                        </h2>
                    </div>

                </div>


                <div class="course-form-card">

                    <div class="course-form-header">

                        <div>
                            <span>
                                ثبت‌نام دانشجو
                            </span>

                            <h3>
                                @(IsEditMode
                                 ? "ویرایش ثبت‌نام"
                                 : "ایجاد ثبت‌نام جدید")
                            </h3>
                        </div>

                    </div>


                    <div class="course-form-grid">

                        <div class="form-group">

                            <label>
                                دانشجو
                            </label>

                            <select @bind="FormStudentId">

                                <option value="">
                                    انتخاب دانشجو
                                </option>

                                @foreach (var student in Students)
                                {
                                    <option value="@student.Id">
                                        @student.FirstName @student.LastName
                                        — @student.Mobile
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                دوره
                            </label>

                            <select value="@FormCourseId" @onchange="OnCourseChanged">

                                <option value="">
                                    انتخاب دوره
                                </option>

                                @foreach (var course in Courses)
                                {
                                    <option value="@course.Id">
                                        @course.Title
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                سازمان طرف قرارداد
                            </label>

                            <select @bind="FormCoursePartnerOrganizationId"
                                    disabled="@(!SelectedCourseId.HasValue || IsLoadingContracts)">

                                <option value="">
                                    بدون قرارداد سازمانی
                                </option>

                                @foreach (var contract in CoursePartnerOrganizations)
                                {
                                    <option value="@contract.Id">
                                        @contract.PartnerOrganization?.Name
                                        @if (!string.IsNullOrWhiteSpace(contract.ContractNumber))
                                        {
                                            <text> — @contract.ContractNumber</text>
                                        }
                                    </option>
                                }

                            </select>

                            @if (IsLoadingContracts)
                            {
                                <small class="form-hint">
                                    در حال دریافت قراردادهای این دوره...
                                </small>
                            }
                            else if (SelectedCourseId.HasValue && CoursePartnerOrganizations.Count == 0)
                            {
                                <small class="form-hint">
                                    برای این دوره قرارداد سازمانی فعالی ثبت نشده است.
                                </small>
                            }
                            else
                            {
                                <small class="form-hint">
                                    در صورت انتخاب قرارداد، قیمت توافقی اعمال می‌شود.
                                </small>
                            }

                        </div>


                        @if (SelectedCourse != null)
                        {
                            <div class="form-group">

                                <label>
                                    قیمت دوره
                                </label>

                                <div class="enrollment-price-box">

                                    <strong>
                                        @SelectedCourse.Price.ToString("N0")
                                    </strong>

                                    <span>
                                        تومان
                                    </span>

                                </div>

                            </div>
                        }


                        @if (SelectedContract != null)
                        {
                            <div class="form-group">

                                <label>
                                    قیمت توافقی سازمان
                                </label>

                                <div class="enrollment-price-box enrollment-agreed-price">

                                    @if (SelectedContract.AgreedPrice.HasValue)
                                    {
                                        <strong>
                                            @SelectedContract.AgreedPrice.Value.ToString("N0")
                                        </strong>

                                        <span>
                                            تومان
                                        </span>
                                    }
                                    else
                                    {
                                        <strong>
                                            قیمت توافقی تعیین نشده
                                        </strong>
                                    }

                                </div>

                            </div>
                        }


                        @if (SelectedCourse != null)
                        {
                            <div class="form-group">

                                <label>
                                    قیمت نهایی ثبت‌نام
                                </label>

                                <div class="enrollment-price-box enrollment-final-price">

                                    <strong>
                                        @FinalPrice.ToString("N0")
                                    </strong>

                                    <span>
                                        تومان
                                    </span>

                                </div>

                            </div>
                        }


                        <div class="form-group">

                            <label>
                                پشتیبان آموزشی
                            </label>

                            <select @bind="FormSupportUserId">

                                <option value="">
                                    بدون پشتیبان
                                </option>

                                @foreach (var support in SupportUsers)
                                {
                                    <option value="@support.Id">
                                        @support.FullName
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                مدرس
                            </label>

                            <select @bind="FormInstructorId">

                                <option value="">
                                    بدون مدرس
                                </option>

                                @foreach (var instructor in ActiveInstructors)
                                {
                                    <option value="@instructor.Id">
                                        @instructor.FullName
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                تاریخ شروع
                            </label>

                            <input
                                type="date"
                                @bind="FormStartDate" />

                        </div>


                        <div class="form-group">

                            <label>
                                وضعیت ثبت‌نام
                            </label>

                            <select @bind="FormStatus">

                                <option value="Active">
                                    فعال
                                </option>

                                <option value="Completed">
                                    تکمیل‌شده
                                </option>

                                <option value="Suspended">
                                    تعلیق‌شده
                                </option>

                                <option value="Cancelled">
                                    لغوشده
                                </option>

                            </select>

                        </div>


                        <div class="form-group course-description-group">

                            <label>
                                توضیحات
                            </label>

                            <textarea
                                @bind="FormDescription"
                                placeholder="توضیحات مربوط به این ثبت‌نام...">
                            </textarea>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(FormError))
                    {
                        <div class="course-form-error">
                            @FormError
                        </div>
                    }


                     <div class="course-form-actions">

    <button
        class="admin-primary-btn"
        @onclick="SaveEnrollment"
        disabled="@IsSaving">

        @(IsSaving
            ? "در حال ذخیره..."
            : IsEditMode
                ? "ذخیره تغییرات"
                : "ثبت‌نام دانشجو")

    </button>


    @if (IsEditMode)
    {
        <button
            type="button"
            class="admin-secondary-btn"
            @onclick="CancelEdit"
            disabled="@IsSaving">

            انصراف

        </button>
    }

</div>

                </div>

            </section>


            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت آموزشی
                        </span>

                        <h2>
                            فهرست ثبت‌نام‌ها
                        </h2>
                    </div>

                    <span class="users-count">
                        @Enrollments.Count ثبت‌نام
                    </span>

                </div>


                @if (Enrollments.Count == 0)
                {
                    <div class="admin-empty-state">

                        <div>
                            ✓
                        </div>

                        <h3>
                            هنوز ثبت‌نامی ثبت نشده است
                        </h3>

                        <p>
                            از فرم بالا اولین ثبت‌نام را ایجاد کنید.
                        </p>

                    </div>
                }
                else
                {
                    <div class="courses-table-wrapper">

                        <table class="courses-table">

                            <thead>

                                <tr>

                                    <th>
                                        دانشجو
                                    </th>

                                    <th>
                                        دوره
                                    </th>

                                    <th>
                                        سازمان طرف قرارداد
                                    </th>

                                    <th>
                                        مدرس
                                    </th>

                                    <th>
                                        پشتیبان
                                    </th>

                                    <th>
                                        قیمت
                                    </th>

                                    <th>
                                        پرداخت‌شده
                                    </th>

                                    <th>
                                        مانده
                                    </th>

                                    <th>
                                        وضعیت مالی
                                    </th>

                                    <th>
                                        تاریخ شروع
                                    </th>

                                    <th>
                                        وضعیت
                                    </th>
                                    <th>
                                        عملیات
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var enrollment in Enrollments)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @enrollment.StudentName
                                            </strong>
                                        </td>

                                        <td>
                                            @enrollment.CourseTitle
                                        </td>

                                        <td>
                                            @(enrollment.CoursePartnerOrganization?.PartnerOrganization?.Name
                                                ?? "بدون قرارداد سازمانی")
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(enrollment.InstructorName)
                                                ? "بدون مدرس"
                                                : enrollment.InstructorName)
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(enrollment.SupportUserName)
                                                ? "بدون پشتیبان"
                                                : enrollment.SupportUserName)
                                        </td>

                                         <td>
                                            <strong>
                                                @enrollment.CoursePrice.ToString("N0")
                                            </strong>

                                            <span class="price-unit">
                                                تومان
                                            </span>
                                        </td>

                                        <td>
                                            <strong>
                                                @enrollment.TotalPaid.ToString("N0")
                                            </strong>

                                            <span class="price-unit">
                                                تومان
                                            </span>
                                        </td>

                                        <td>
                                            <strong>
                                                @enrollment.RemainingAmount.ToString("N0")
                                            </strong>

                                            <span class="price-unit">
                                                تومان
                                            </span>
                                        </td>

                                        <td>
                                            @if (enrollment.PaymentStatus == "Paid")
                                            {
                                                <span class="course-status active">
                                                    تسویه‌شده
                                                </span>
                                            }
                                            else if (enrollment.PaymentStatus == "PartiallyPaid")
                                            {
                                                <span class="course-status">
                                                    پرداخت ناقص
                                                </span>
                                            }
                                            else if (enrollment.PaymentStatus == "Unpaid")
                                            {
                                                <span class="course-status">
                                                    پرداخت‌نشده
                                                </span>
                                            }
                                            else if (enrollment.PaymentStatus == "Overpaid")
                                            {
                                                <span class="course-status">
                                                    اضافه‌پرداخت
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="course-status">
                                                    نامشخص
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @enrollment.StartDate.ToString("yyyy/MM/dd")
                                        </td>

                                     <td>
    @if (enrollment.Status == "Active")
    {
        <span class="course-status active">
            فعال
        </span>
    }
    else if (enrollment.Status == "Completed")
    {
        <span class="course-status">
            تکمیل‌شده
        </span>
    }
    else if (enrollment.Status == "Suspended")
    {
        <span class="course-status">
            تعلیق‌شده
        </span>
    }
    else if (enrollment.Status == "Cancelled")
    {
        <span class="course-status inactive">
            لغوشده
        </span>
    }
    else
    {
        <span class="course-status">
            @enrollment.Status
        </span>
    }
</td>

                              <td>
    <div class="admin-actions">

<button
    type="button"
    class="admin-secondary-btn"
    @onclick="() => ShowFinancialDetails(enrollment)">

    جزئیات مالی

</button>

        <button
            type="button"
            class="admin-secondary-btn"
            @onclick="() => BeginEditEnrollment(enrollment)">

            ویرایش

        </button>

    </div>
</td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }

    </main>

</div>

@if (IsFinancialDetailsOpen)
{
    <div class="admin-modal-overlay">

        <div class="admin-modal">

            <div class="admin-modal-header">

                <h3>
                    جزئیات مالی ثبت‌نام
                </h3>

                <button
                    type="button"
                    class="admin-modal-close"
                    @onclick="CloseFinancialDetails">

                    ×

                </button>

            </div>

            <div class="admin-modal-body">

                @if (IsLoadingFinancialDetails)
                {
                    <div class="admin-empty-state">
                        در حال دریافت اطلاعات مالی...
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(FinancialDetailsError))
                {
                    <div class="admin-error">
                        @FinancialDetailsError
                    </div>
                }
                else if (SelectedFinancialDetails != null)
                {
                    <div class="financial-summary">

                        <div class="financial-summary-item">
                            <span>
                                دانشجو
                            </span>

                            <strong>
                                @SelectedFinancialDetails.StudentName
                            </strong>
                        </div>

                        <div class="financial-summary-item">
                            <span>
                                دوره
                            </span>

                            <strong>
                                @SelectedFinancialDetails.CourseTitle
                            </strong>
                        </div>

                        <div class="financial-summary-item">
                            <span>
                                قیمت دوره
                            </span>

                            <strong>
                                @SelectedFinancialDetails.CoursePrice.ToString("N0")
                                تومان
                            </strong>
                        </div>

                        <div class="financial-summary-item">
                            <span>
                                مجموع پرداخت‌شده
                            </span>

                            <strong>
                                @SelectedFinancialDetails.TotalPaid.ToString("N0")
                                تومان
                            </strong>
                        </div>

                        <div class="financial-summary-item">
                            <span>
                                مبلغ باقی‌مانده
                            </span>

                            <strong>
                                @SelectedFinancialDetails.RemainingAmount.ToString("N0")
                                تومان
                            </strong>
                        </div>

                        <div class="financial-summary-item">
                            <span>
                                وضعیت مالی
                            </span>

                            @if (SelectedFinancialDetails.PaymentStatus == "Paid")
                            {
                                <span class="course-status active">
                                    تسویه‌شده
                                </span>
                            }
                            else if (SelectedFinancialDetails.PaymentStatus == "PartiallyPaid")
                            {
                                <span class="course-status">
                                    پرداخت ناقص
                                </span>
                            }
                            else if (SelectedFinancialDetails.PaymentStatus == "Unpaid")
                            {
                                <span class="course-status">
                                    پرداخت‌نشده
                                </span>
                            }
                            else if (SelectedFinancialDetails.PaymentStatus == "Overpaid")
                            {
                                <span class="course-status">
                                    اضافه‌پرداخت
                                </span>
                            }
                            else
                            {
                                <span class="course-status">
                                    نامشخص
                                </span>
                            }

                        </div>

                    </div>

                    <div class="financial-payments">

                        <h4>
                            سوابق پرداخت
                        </h4>

                        @if (SelectedFinancialDetails.Payments == null ||
                             SelectedFinancialDetails.Payments.Count == 0)
                        {
                            <div class="admin-empty-state">
                                تاکنون پرداختی برای این ثبت‌نام ثبت نشده است.
                            </div>
                        }
                        else
                        {
                            <div class="courses-table-wrapper">

                                <table class="courses-table">

                                    <thead>

                                        <tr>

                                            <th>
                                                مبلغ
                                            </th>

                                            <th>
                                                تاریخ
                                            </th>

                                            <th>
                                                نوع پرداخت
                                            </th>

                                            <th>
                                                وضعیت
                                            </th>

                                            <th>
                                                توضیحات
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var payment in SelectedFinancialDetails.Payments)
                                        {
                                            <tr>

                                                <td>
                                                    <strong>
                                                        @payment.Amount.ToString("N0")
                                                    </strong>

                                                    <span class="price-unit">
                                                        تومان
                                                    </span>
                                                </td>

                                                <td>
                                                    @payment.PaymentDate.ToString("yyyy/MM/dd HH:mm")
                                                </td>

                                                <td>
                                                         @GetPaymentTypeText(payment.PaymentType)                                                </td>

                                                <td>

                                                    @if (payment.Status == "Paid")
                                                    {
                                                        <span class="course-status active">
                                                            پرداخت‌شده
                                                        </span>
                                                    }
                                                    else if (payment.Status == "Pending")
                                                    {
                                                        <span class="course-status">
                                                            در انتظار
                                                        </span>
                                                    }
                                                    else if (payment.Status == "Cancelled")
                                                    {
                                                        <span class="course-status inactive">
                                                            لغوشده
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="course-status">
                                                            @payment.Status
                                                        </span>
                                                    }

                                                </td>

                                                <td>
                                                    @(string.IsNullOrWhiteSpace(payment.Description)
                                                        ? "-"
                                                        : payment.Description)
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>
                }

            </div>

            <div class="admin-modal-footer">

                <button
                    type="button"
                    class="admin-secondary-btn"
                    @onclick="CloseFinancialDetails">

                    بستن

                </button>

            </div>

        </div>

    </div>
}

@code {

    private List<StudentDto> Students { get; set; } = new();

    private List<CourseDto> Courses { get; set; } = new();

    private List<CoursePartnerOrganizationDto> CoursePartnerOrganizations { get; set; } = new();

    private List<EnrollmentDto> Enrollments { get; set; } = new();

    private List<StudentManagementOptionDto> ManagementOptions { get; set; } = new();

    private List<InstructorDto> Instructors { get; set; } = new();

    private EnrollmentFinancialDetailDto? SelectedFinancialDetails { get; set; }

    private bool IsFinancialDetailsOpen { get; set; }

    private bool IsLoadingFinancialDetails { get; set; }

    private string? FinancialDetailsError { get; set; }

    private bool IsLoading { get; set; } = true;

    private bool IsLoadingContracts { get; set; }

    private bool IsSaving { get; set; }
    private bool IsEditMode { get; set; }

    private int EditingEnrollmentId { get; set; }

    private string? ErrorMessage { get; set; }

    private string? FormError { get; set; }

    private string FormStudentId { get; set; } = string.Empty;

    private string FormCourseId { get; set; } = string.Empty;

    private string FormCoursePartnerOrganizationId { get; set; } = string.Empty;

    private string FormSupportUserId { get; set; } = string.Empty;

    private string FormInstructorId { get; set; } = string.Empty;

    private DateTime FormStartDate { get; set; } = DateTime.Today;

    private string FormStatus { get; set; } = "Active";

    private string FormDescription { get; set; } = string.Empty;


    private int? SelectedCourseId =>
        int.TryParse(FormCourseId, out var id)
            ? id
            : null;


    private CourseDto? SelectedCourse =>
        SelectedCourseId.HasValue
            ? Courses.FirstOrDefault(x => x.Id == SelectedCourseId.Value)
            : null;


    private int? SelectedContractId =>
        int.TryParse(FormCoursePartnerOrganizationId, out var id)
            ? id
            : null;


    private CoursePartnerOrganizationDto? SelectedContract =>
        SelectedContractId.HasValue
            ? CoursePartnerOrganizations.FirstOrDefault(x => x.Id == SelectedContractId.Value)
            : null;


    private IEnumerable<StudentManagementOptionDto> SupportUsers =>
        ManagementOptions
            .Where(x => x.Role == "Support")
            .OrderBy(x => x.FullName);


    private IEnumerable<InstructorDto> ActiveInstructors =>
        Instructors
            .Where(x => x.IsActive)
            .OrderBy(x => x.FullName);


    private decimal FinalPrice =>
        SelectedContract?.AgreedPrice
        ?? SelectedCourse?.Price
        ?? 0;


    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.IsManagementPanelUser)
        {
            Navigation.NavigateTo(Auth.IsLoggedIn ? "/admin" : "/login");
            return;
        }

        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var studentsTask =
                client.GetFromJsonAsync<List<StudentDto>>(
                    "api/Students");

            var coursesTask =
                client.GetFromJsonAsync<List<CourseDto>>(
                    "api/Courses");

            var enrollmentsTask =
                client.GetFromJsonAsync<List<EnrollmentDto>>(
                    "api/Enrollments");

            var managementOptionsTask =
                client.GetFromJsonAsync<List<StudentManagementOptionDto>>(
                    "api/Students/management-options");

            var instructorsTask =
                client.GetFromJsonAsync<List<InstructorDto>>(
                    "api/Courses/instructors");

            await Task.WhenAll(
                studentsTask,
                coursesTask,
                enrollmentsTask,
                managementOptionsTask,
                instructorsTask);

            Students =
                studentsTask.Result ?? new List<StudentDto>();

            Courses =
                coursesTask.Result ?? new List<CourseDto>();

            Enrollments =
                enrollmentsTask.Result ?? new List<EnrollmentDto>();

            ManagementOptions =
                managementOptionsTask.Result ?? new List<StudentManagementOptionDto>();

            Instructors =
                instructorsTask.Result ?? new List<InstructorDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً مطمئن شوید Backend در حال اجرا است.";
        }
        finally
        {
            IsLoading = false;
        }
    }
    

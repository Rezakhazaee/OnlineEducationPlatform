   private async Task BeginEditEnrollment(EnrollmentDto enrollment)
{
    FormError = null;

    IsEditMode = true;
    EditingEnrollmentId = enrollment.Id;

    FormStudentId = enrollment.StudentId.ToString();
    FormCourseId = enrollment.CourseId.ToString();

    FormStartDate = enrollment.StartDate;
    FormStatus = enrollment.Status;
    FormDescription = enrollment.Description ?? string.Empty;

    CoursePartnerOrganizations.Clear();

    await LoadCoursePartnerOrganizations();

    FormCoursePartnerOrganizationId =
        enrollment.CoursePartnerOrganization?.Id.ToString()
        ?? string.Empty;
}

    private async Task OnCourseChanged(ChangeEventArgs e)
    {
        FormCourseId = e.Value?.ToString() ?? string.Empty;

        FormCoursePartnerOrganizationId = string.Empty;
        CoursePartnerOrganizations.Clear();

        if (!SelectedCourseId.HasValue)
        {
            return;
        }

        await LoadCoursePartnerOrganizations();
    }
    
    private void CancelEdit()
{
    IsEditMode = false;
    EditingEnrollmentId = 0;

    ResetForm();
}

    private async Task LoadCoursePartnerOrganizations()
    {
        if (!SelectedCourseId.HasValue)
        {
            return;
        }

        IsLoadingContracts = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var result =
                await client.GetFromJsonAsync<List<CoursePartnerOrganizationDto>>(
                    $"api/CoursePartnerOrganizations/course/{SelectedCourseId.Value}");

            CoursePartnerOrganizations =
                result ?? new List<CoursePartnerOrganizationDto>();
        }
        catch
        {
            CoursePartnerOrganizations =
                new List<CoursePartnerOrganizationDto>();

            FormError =
                "دریافت قراردادهای سازمانی این دوره با خطا مواجه شد.";
        }
        finally
        {
            IsLoadingContracts = false;
        }
    }


private async Task SaveEnrollment()
{
    FormError = null;

    if (!int.TryParse(FormStudentId, out var studentId))
    {
        FormError = "لطفاً دانشجو را انتخاب کنید.";
        return;
    }

    if (!int.TryParse(FormCourseId, out var courseId))
    {
        FormError = "لطفاً دوره را انتخاب کنید.";
        return;
    }

    if (SelectedContract != null &&
        !SelectedContract.AgreedPrice.HasValue)
    {
        FormError =
            "برای قرارداد انتخاب‌شده قیمت توافقی تعیین نشده است.";
        return;
    }

    IsSaving = true;

    try
    {
        var client = Auth.CreateAuthenticatedClient();

        int? coursePartnerOrganizationId = null;

        if (int.TryParse(
            FormCoursePartnerOrganizationId,
            out var parsedContractId))
        {
            coursePartnerOrganizationId = parsedContractId;
        }

        if (IsEditMode)
        {
            var updateRequest = new UpdateEnrollmentDto
            {
                CoursePartnerOrganizationId =
                    coursePartnerOrganizationId,

                StartDate = FormStartDate,

                Status = FormStatus,

                Description =
                    string.IsNullOrWhiteSpace(FormDescription)
                        ? null
                        : FormDescription.Trim()
            };

            var response =
                await client.PutAsJsonAsync(
                    $"api/Enrollments/{EditingEnrollmentId}",
                    updateRequest);

            if (!response.IsSuccessStatusCode)
            {
                FormError =
                    await GetErrorMessage(response);

                return;
            }
        }
        else
        {
            var request = new CreateEnrollmentDto
            {
                StudentId = studentId,

                CourseId = courseId,

                CoursePartnerOrganizationId =
                    coursePartnerOrganizationId,

                StartDate = FormStartDate,

                Status = FormStatus,

                Description =
                    string.IsNullOrWhiteSpace(FormDescription)
                        ? null
                        : FormDescription.Trim()
            };

            var response =
                await client.PostAsJsonAsync(
                    "api/Enrollments",
                    request);

            if (!response.IsSuccessStatusCode)
            {
                FormError =
                    await GetErrorMessage(response);

                return;
            }
        }

        ResetForm();

        IsEditMode = false;
        EditingEnrollmentId = 0;

        await LoadData();
    }
    catch
    {
        FormError =
            "ارتباط با سرور برقرار نشد.";
    }
    finally
    {
        IsSaving = false;
    }
}


    private void ResetForm()
    {
        FormStudentId = string.Empty;
        FormCourseId = string.Empty;
        FormCoursePartnerOrganizationId = string.Empty;
        FormStartDate = DateTime.Today;
        FormStatus = "Active";
        FormDescription = string.Empty;
        CoursePartnerOrganizations.Clear();
        FormError = null;
    }

     private string GetPaymentTypeText(string paymentType)
{
    return paymentType switch
    {
        "FirstInstallment" => "قسط اول",
        "SecondInstallment" => "قسط دوم",
        "ThirdInstallment" => "قسط سوم",
        "FullPayment" => "پرداخت کامل",
        _ => paymentType
    };
}

    private async Task<string> GetErrorMessage(
        HttpResponseMessage response)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ApiError>();

            return error?.Message
                ?? "عملیات با خطا مواجه شد.";
        }
        catch
        {
            return "عملیات با خطا مواجه شد.";
        }
    }



@page "/admin/enrollments"

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<PageTitle>مدیریت ثبت‌نام‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-mark">آ</div>

            <div>
                <strong>آموزش‌یار</strong>
                <small>پنل مدیریت</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a href="/admin">
                <span>⌂</span>
                داشبورد
            </a>

            <a href="/admin/courses">
                <span>▣</span>
                دوره‌ها
            </a>

            <a href="/admin/users">
                <span>♙</span>
                کاربران
            </a>

            <a href="/admin/enrollments" class="active">
                <span>✓</span>
                ثبت‌نام‌ها
            </a>

            <a href="/admin/payments">
                <span>₿</span>
                پرداخت‌ها
            </a>

            <a href="/admin/reports">
                <span>▤</span>
                گزارش‌ها
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <a href="/">
                ← بازگشت به سایت
            </a>

        </div>

    </aside>


    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="admin-label">
                    مدیریت سامانه
                </span>

                <h1>
                    ثبت‌نام‌ها
                </h1>
            </div>

            <div class="admin-user">

                <div class="admin-avatar">
                    ا
                </div>

                <div>
                    <strong>
                        @(Auth.FullName ?? "مدیر سیستم")
                    </strong>

                    <small>
                        Administrator
                    </small>
                </div>

            </div>

        </header>


        @if (IsLoading)
        {
            <div class="admin-loading">

                <div class="admin-loading-icon">
                    ↻
                </div>

                <h3>
                    در حال دریافت اطلاعات...
                </h3>

                <p>
                    اطلاعات ثبت‌نام‌ها از سرور دریافت می‌شود.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">

                <strong>
                    خطا در دریافت اطلاعات
                </strong>

                <p>
                    @ErrorMessage
                </p>

                <button
                    class="admin-outline-btn"
                    @onclick="LoadData">

                    تلاش مجدد

                </button>

            </div>
        }
        else
        {
            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت آموزشی
                        </span>

                        <h2>
                            ثبت‌نام جدید
                        </h2>
                    </div>

                </div>


                <div class="course-form-card">

                    <div class="course-form-header">

                        <div>
                            <span>
                                ثبت‌نام دانشجو
                            </span>

                            <h3>
                                ایجاد ثبت‌نام جدید
                            </h3>
                        </div>

                    </div>


                    <div class="course-form-grid">

                        <div class="form-group">

                            <label>
                                دانشجو
                            </label>

                            <select @bind="FormStudentId">

                                <option value="">
                                    انتخاب دانشجو
                                </option>

                                @foreach (var student in Students)
                                {
                                    <option value="@student.Id">
                                        @student.FirstName @student.LastName
                                        — @student.Mobile
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                دوره
                            </label>

                            <select value="@FormCourseId" @onchange="OnCourseChanged">

                                <option value="">
                                    انتخاب دوره
                                </option>

                                @foreach (var course in Courses)
                                {
                                    <option value="@course.Id">
                                        @course.Title
                                    </option>
                                }

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                سازمان طرف قرارداد
                            </label>

                            <select @bind="FormCoursePartnerOrganizationId"
                                    disabled="@(!SelectedCourseId.HasValue || IsLoadingContracts)">

                                <option value="">
                                    بدون قرارداد سازمانی
                                </option>

                                @foreach (var contract in CoursePartnerOrganizations)
                                {
                                    <option value="@contract.Id">
                                        @contract.PartnerOrganization?.Name
                                        @if (!string.IsNullOrWhiteSpace(contract.ContractNumber))
                                        {
                                            <text> — @contract.ContractNumber</text>
                                        }
                                    </option>
                                }

                            </select>

                            @if (IsLoadingContracts)
                            {
                                <small class="form-hint">
                                    در حال دریافت قراردادهای این دوره...
                                </small>
                            }
                            else if (SelectedCourseId.HasValue && CoursePartnerOrganizations.Count == 0)
                            {
                                <small class="form-hint">
                                    برای این دوره قرارداد سازمانی فعالی ثبت نشده است.
                                </small>
                            }
                            else
                            {
                                <small class="form-hint">
                                    در صورت انتخاب قرارداد، قیمت توافقی اعمال می‌شود.
                                </small>
                            }

                        </div>


                        @if (SelectedCourse != null)
                        {
                            <div class="form-group">

                                <label>
                                    قیمت دوره
                                </label>

                                <div class="enrollment-price-box">

                                    <strong>
                                        @SelectedCourse.Price.ToString("N0")
                                    </strong>

                                    <span>
                                        تومان
                                    </span>

                                </div>

                            </div>
                        }


                        @if (SelectedContract != null)
                        {
                            <div class="form-group">

                                <label>
                                    قیمت توافقی سازمان
                                </label>

                                <div class="enrollment-price-box enrollment-agreed-price">

                                    @if (SelectedContract.AgreedPrice.HasValue)
                                    {
                                        <strong>
                                            @SelectedContract.AgreedPrice.Value.ToString("N0")
                                        </strong>

                                        <span>
                                            تومان
                                        </span>
                                    }
                                    else
                                    {
                                        <strong>
                                            قیمت توافقی تعیین نشده
                                        </strong>
                                    }

                                </div>

                            </div>
                        }


                        @if (SelectedCourse != null)
                        {
                            <div class="form-group">

                                <label>
                                    قیمت نهایی ثبت‌نام
                                </label>

                                <div class="enrollment-price-box enrollment-final-price">

                                    <strong>
                                        @FinalPrice.ToString("N0")
                                    </strong>

                                    <span>
                                        تومان
                                    </span>

                                </div>

                            </div>
                        }


                        <div class="form-group">

                            <label>
                                تاریخ شروع
                            </label>

                            <input
                                type="date"
                                @bind="FormStartDate" />

                        </div>


                        <div class="form-group">

                            <label>
                                وضعیت ثبت‌نام
                            </label>

                            <select @bind="FormStatus">

                                <option value="Active">
                                    فعال
                                </option>

                                <option value="Pending">
                                    در انتظار
                                </option>

                                <option value="Cancelled">
                                    لغوشده
                                </option>

                            </select>

                        </div>


                        <div class="form-group course-description-group">

                            <label>
                                توضیحات
                            </label>

                            <textarea
                                @bind="FormDescription"
                                placeholder="توضیحات مربوط به این ثبت‌نام...">
                            </textarea>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(FormError))
                    {
                        <div class="course-form-error">
                            @FormError
                        </div>
                    }


                    <div class="course-form-actions">

                        <button
                            class="admin-primary-btn"
                            @onclick="SaveEnrollment"
                            disabled="@IsSaving">

                            @(IsSaving
                                ? "در حال ذخیره..."
                                : "ثبت‌نام دانشجو")

                        </button>

                    </div>

                </div>

            </section>


            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>
                            مدیریت آموزشی
                        </span>

                        <h2>
                            فهرست ثبت‌نام‌ها
                        </h2>
                    </div>

                    <span class="users-count">
                        @Enrollments.Count ثبت‌نام
                    </span>

                </div>


                @if (Enrollments.Count == 0)
                {
                    <div class="admin-empty-state">

                        <div>
                            ✓
                        </div>

                        <h3>
                            هنوز ثبت‌نامی ثبت نشده است
                        </h3>

                        <p>
                            از فرم بالا اولین ثبت‌نام را ایجاد کنید.
                        </p>

                    </div>
                }
                else
                {
                    <div class="courses-table-wrapper">

                        <table class="courses-table">

                            <thead>

                                <tr>

                                    <th>
                                        دانشجو
                                    </th>

                                    <th>
                                        دوره
                                    </th>

                                    <th>
                                        سازمان طرف قرارداد
                                    </th>

                                    <th>
                                        قیمت
                                    </th>

                                    <th>
                                        تاریخ شروع
                                    </th>

                                    <th>
                                        وضعیت
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var enrollment in Enrollments)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @enrollment.StudentName
                                            </strong>
                                        </td>

                                        <td>
                                            @enrollment.CourseTitle
                                        </td>

                                        <td>
                                            @(enrollment.CoursePartnerOrganization?.PartnerOrganization?.Name
                                                ?? "بدون قرارداد سازمانی")
                                        </td>

                                        <td>
                                            <strong>
                                                @enrollment.CoursePrice.ToString("N0")
                                            </strong>

                                            <span class="price-unit">
                                                تومان
                                            </span>
                                        </td>

                                        <td>
                                            @enrollment.StartDate.ToString("yyyy/MM/dd")
                                        </td>

                                        <td>

                                            @if (enrollment.Status == "Active")
                                            {
                                                <span class="course-status active">
                                                    فعال
                                                </span>
                                            }
                                            else if (enrollment.Status == "Cancelled")
                                            {
                                                <span class="course-status inactive">
                                                    لغوشده
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="course-status">
                                                    @enrollment.Status
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>
        }

    </main>

</div>


@code {

    private List<StudentDto> Students { get; set; } = new();

    private List<CourseDto> Courses { get; set; } = new();

    private List<CoursePartnerOrganizationDto> CoursePartnerOrganizations { get; set; } = new();

    private List<EnrollmentDto> Enrollments { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private bool IsLoadingContracts { get; set; }

    private bool IsSaving { get; set; }

    private string? ErrorMessage { get; set; }

    private string? FormError { get; set; }

    private string FormStudentId { get; set; } = string.Empty;

    private string FormCourseId { get; set; } = string.Empty;

    private string FormCoursePartnerOrganizationId { get; set; } = string.Empty;

    private DateTime FormStartDate { get; set; } = DateTime.Today;

    private string FormStatus { get; set; } = "Active";

    private string FormDescription { get; set; } = string.Empty;


    private int? SelectedCourseId =>
        int.TryParse(FormCourseId, out var id)
            ? id
            : null;


    private CourseDto? SelectedCourse =>
        SelectedCourseId.HasValue
            ? Courses.FirstOrDefault(x => x.Id == SelectedCourseId.Value)
            : null;


    private int? SelectedContractId =>
        int.TryParse(FormCoursePartnerOrganizationId, out var id)
            ? id
            : null;


    private CoursePartnerOrganizationDto? SelectedContract =>
        SelectedContractId.HasValue
            ? CoursePartnerOrganizations.FirstOrDefault(x => x.Id == SelectedContractId.Value)
            : null;


    private decimal FinalPrice =>
        SelectedContract?.AgreedPrice
        ?? SelectedCourse?.Price
        ?? 0;


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var studentsTask =
                client.GetFromJsonAsync<List<StudentDto>>(
                    "api/Students");

            var coursesTask =
                client.GetFromJsonAsync<List<CourseDto>>(
                    "api/Courses");

            var enrollmentsTask =
                client.GetFromJsonAsync<List<EnrollmentDto>>(
                    "api/Enrollments");

            await Task.WhenAll(
                studentsTask,
                coursesTask,
                enrollmentsTask);

            Students =
                studentsTask.Result ?? new List<StudentDto>();

            Courses =
                coursesTask.Result ?? new List<CourseDto>();

            Enrollments =
                enrollmentsTask.Result ?? new List<EnrollmentDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً مطمئن شوید Backend در حال اجرا است.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task OnCourseChanged(ChangeEventArgs e)
    {
        FormCourseId = e.Value?.ToString() ?? string.Empty;

        FormCoursePartnerOrganizationId = string.Empty;
        CoursePartnerOrganizations.Clear();

        if (!SelectedCourseId.HasValue)
        {
            return;
        }

        await LoadCoursePartnerOrganizations();
    }


    private async Task LoadCoursePartnerOrganizations()
    {
        if (!SelectedCourseId.HasValue)
        {
            return;
        }

        IsLoadingContracts = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var result =
                await client.GetFromJsonAsync<List<CoursePartnerOrganizationDto>>(
                    $"api/CoursePartnerOrganizations/course/{SelectedCourseId.Value}");

            CoursePartnerOrganizations =
                result ?? new List<CoursePartnerOrganizationDto>();
        }
        catch
        {
            CoursePartnerOrganizations =
                new List<CoursePartnerOrganizationDto>();

            FormError =
                "دریافت قراردادهای سازمانی این دوره با خطا مواجه شد.";
        }
        finally
        {
            IsLoadingContracts = false;
        }
    }


    private async Task SaveEnrollment()
    {
        FormError = null;

        if (!int.TryParse(FormStudentId, out var studentId))
        {
            FormError = "لطفاً دانشجو را انتخاب کنید.";
            return;
        }

        if (!int.TryParse(FormCourseId, out var courseId))
        {
            FormError = "لطفاً دوره را انتخاب کنید.";
            return;
        }

        if (SelectedContract != null &&
            !SelectedContract.AgreedPrice.HasValue)
        {
            FormError =
                "برای قرارداد انتخاب‌شده قیمت توافقی تعیین نشده است.";
            return;
        }

        IsSaving = true;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            int? coursePartnerOrganizationId = null;

            if (int.TryParse(
                FormCoursePartnerOrganizationId,
                out var parsedContractId))
            {
                coursePartnerOrganizationId = parsedContractId;
            }

            var request = new CreateEnrollmentDto
            {
                StudentId = studentId,
                CourseId = courseId,
                CoursePartnerOrganizationId =
                    coursePartnerOrganizationId,
                StartDate = FormStartDate,
                Status = FormStatus,
                Description =
                    string.IsNullOrWhiteSpace(FormDescription)
                        ? null
                        : FormDescription.Trim()
            };

            var response =
                await client.PostAsJsonAsync(
                    "api/Enrollments",
                    request);

            if (!response.IsSuccessStatusCode)
            {
                FormError =
                    await GetErrorMessage(response);

                return;
            }

            ResetForm();

            await LoadData();
        }
        catch
        {
            FormError =
                "ارتباط با سرور برقرار نشد.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private void ResetForm()
    {
        FormStudentId = string.Empty;
        FormCourseId = string.Empty;
        FormCoursePartnerOrganizationId = string.Empty;
        FormStartDate = DateTime.Today;
        FormStatus = "Active";
        FormDescription = string.Empty;
        CoursePartnerOrganizations.Clear();
        FormError = null;
    }


    private async Task<string> GetErrorMessage(
        HttpResponseMessage response)
    {
        try
        {
            var error =
                await response.Content
                    .ReadFromJsonAsync<ApiError>();

            return error?.Message
                ?? "عملیات با خطا مواجه شد.";
        }
        catch
        {
            return "عملیات با خطا مواجه شد.";
        }
    }


    public class StudentDto
    {
        public int Id { get; set; }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        public string Mobile { get; set; } = string.Empty;
    }


    public class CourseDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public decimal Price { get; set; }

        public bool IsActive { get; set; }
    }


    public class PartnerOrganizationDto
    {
        public int Id { get; set; }

        public string Name { get; set; } = string.Empty;
    }


    public class CoursePartnerOrganizationDto
    {
        public int Id { get; set; }

        public int CourseId { get; set; }

        public int PartnerOrganizationId { get; set; }

        public string? ContractNumber { get; set; }

        public decimal? AgreedPrice { get; set; }

        public DateTime? StartDate { get; set; }

        public DateTime? EndDate { get; set; }

        public bool IsActive { get; set; }

        public string? Description { get; set; }

        public PartnerOrganizationDto? PartnerOrganization { get; set; }
    }


    public class EnrollmentDto
    {
        public int Id { get; set; }

        public int StudentId { get; set; }

        public string StudentName { get; set; } = string.Empty;

        public int CourseId { get; set; }

        public string CourseTitle { get; set; } = string.Empty;

        public decimal CoursePrice { get; set; }

        public DateTime StartDate { get; set; }

        public string Status { get; set; } = string.Empty;

        public string? Description { get; set; }

        public CoursePartnerOrganizationDto? CoursePartnerOrganization { get; set; }
    }


    public class CreateEnrollmentDto
    {
        public int StudentId { get; set; }

        public int CourseId { get; set; }

        public int? CoursePartnerOrganizationId { get; set; }

        public int? SupportUserId { get; set; }

        public int? InstructorId { get; set; }

        public DateTime StartDate { get; set; }

        public string Status { get; set; } = "Active";

        public string? Description { get; set; }
    }


    public class ApiError
    {
        public string? Message { get; set; }
    }

}

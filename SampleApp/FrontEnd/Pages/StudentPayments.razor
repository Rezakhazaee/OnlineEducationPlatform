@page "/student/payments"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout StudentLayout

@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>پرداخت‌های من | آموزش‌یار</PageTitle>

<div class="student-page">

    <div class="student-topbar">
        <div>
            <span class="student-eyebrow">مالی</span>
            <h1>پرداخت‌های من</h1>
            <p>وضعیت مالی ثبت‌نام‌ها و جزئیات پرداخت دوره‌های شما.</p>
        </div>

        <a href="/student/courses" class="student-outline-btn">
            ← دوره‌های من
        </a>
    </div>

    @if (IsLoading)
    {
        <section class="student-content-card">
            <div class="student-loading">
                <div class="student-loading-icon">₿</div>
                <h3>در حال دریافت اطلاعات مالی</h3>
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <section class="student-content-card">
            <div class="student-error">
                <strong>خطا</strong>
                <p>@ErrorMessage</p>
            </div>
        </section>
    }
    else if (Items.Count == 0)
    {
        <section class="student-content-card">
            <div class="student-empty-state">
                <div class="student-empty-icon">₿</div>
                <h3>هنوز اطلاعات پرداختی ندارید.</h3>
                <p>پس از ثبت‌نام و ثبت پرداخت، اطلاعات مالی اینجا نمایش داده می‌شود.</p>
                <a href="/courses" class="student-primary-link">
                    مشاهده دوره‌ها
                </a>
            </div>
        </section>
    }
    else
    {
        @foreach (var item in Items)
        {
            <section class="student-content-card">

                <div class="student-section-header">
                    <div>
                        <h2>@item.CourseTitle</h2>
                        <span>ثبت‌نام #@item.EnrollmentId</span>
                    </div>

                    <strong class="@GetStatusClass(item.PaymentStatus)">
                        @GetStatusText(item.PaymentStatus)
                    </strong>
                </div>

                <div class="student-profile-grid">

                    <div class="student-profile-field">
                        <small>شهریه دوره</small>
                        <strong>@Money(item.CoursePrice)</strong>
                    </div>

                    <div class="student-profile-field">
                        <small>پرداخت‌شده</small>
                        <strong>@Money(item.TotalPaid)</strong>
                    </div>

                    <div class="student-profile-field">
                        <small>مانده</small>
                        <strong>@Money(item.RemainingAmount)</strong>
                    </div>

                    <div class="student-profile-field">
                        <small>تعداد پرداخت‌ها</small>
                        <strong>@item.Payments.Count</strong>
                    </div>

                </div>

                @if (item.Payments.Count > 0)
                {
                    <div class="student-payment-list">

                        @foreach (var payment in item.Payments.OrderByDescending(x => x.PaymentDate))
                        {
                            <div class="student-payment-row">

                                <div>
                                    <strong>@Money(payment.Amount)</strong>
                                    <small>
                                        @payment.PaymentDate.ToString("yyyy/MM/dd")
                                    </small>
                                </div>

                                <div class="student-payment-type">
                                    @(payment.PaymentType ?? "نامشخص")
                                </div>

                                <div class="student-payment-amount">
                                    @GetPaymentText(payment.Status)
                                </div>

                            </div>
                        }

                    </div>
                }

                <div class="student-form-actions">
                    <a href="@($"/student/course-content/{item.CourseId}")"
                       class="student-primary-link">
                        مشاهده دوره
                    </a>
                </div>

            </section>
        }
    }

</div>

@code {

    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    private List<FinancialItem> Items { get; set; } = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || !Auth.IsStudent)
        {
            Navigation.NavigateTo(
                "/login?returnUrl=/student/payments",
                false);
            return;
        }

        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var enrollments =
                await client.GetFromJsonAsync<List<EnrollmentItem>>(
                    "api/Enrollments/my")
                ?? new();

            foreach (var enrollment in enrollments.Where(x => x.Status != "Cancelled"))
            {
                var detail =
                    await client.GetFromJsonAsync<FinancialApi>(
                        $"api/Enrollments/my/{enrollment.Id}/financial-details");

                if (detail != null)
                {
                    Items.Add(new FinancialItem
                    {
                        EnrollmentId = detail.EnrollmentId,
                        CourseId = enrollment.CourseId,
                        CourseTitle = detail.CourseTitle,
                        CoursePrice = detail.CoursePrice,
                        TotalPaid = detail.TotalPaid,
                        RemainingAmount = detail.RemainingAmount,
                        PaymentStatus = detail.PaymentStatus,
                        Payments = detail.Payments
                    });
                }
            }
        }
        catch
        {
            ErrorMessage = "دریافت اطلاعات مالی با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string Money(decimal value)
        => $"{value:N0} تومان";

    private string GetStatusText(string? value) => value switch
    {
        "Paid" => "تسویه‌شده",
        "PartiallyPaid" => "پرداخت ناقص",
        "Unpaid" => "پرداخت‌نشده",
        "Overpaid" => "بیش‌پرداخت",
        _ => value ?? "نامشخص"
    };

    private string GetStatusClass(string? value) => value switch
    {
        "Paid" => "student-enrollment-active",
        "PartiallyPaid" => "student-enrollment-inactive",
        "Unpaid" => "student-enrollment-cancelled",
        _ => "student-enrollment-neutral"
    };

    private string GetPaymentText(string? value) => value switch
    {
        "Paid" => "پرداخت‌شده",
        "Pending" => "در انتظار",
        "Cancelled" => "لغوشده",
        _ => value ?? "نامشخص"
    };

    private class EnrollmentItem
    {
        public int Id { get; set; }
        public int CourseId { get; set; }
        public string Status { get; set; } = "";
    }

    private class FinancialApi
    {
        public int EnrollmentId { get; set; }
        public string CourseTitle { get; set; } = "";
        public decimal CoursePrice { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal RemainingAmount { get; set; }
        public string PaymentStatus { get; set; } = "";
        public List<PaymentItem> Payments { get; set; } = new();
    }

    private class PaymentItem
    {
        public decimal Amount { get; set; }
        public DateTime PaymentDate { get; set; }
        public string? PaymentType { get; set; }
        public string? Status { get; set; }
    }

    private class FinancialItem
    {
        public int EnrollmentId { get; set; }
        public int CourseId { get; set; }
        public string CourseTitle { get; set; } = "";
        public decimal CoursePrice { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal RemainingAmount { get; set; }
        public string PaymentStatus { get; set; } = "";
        public List<PaymentItem> Payments { get; set; } = new();
    }
}

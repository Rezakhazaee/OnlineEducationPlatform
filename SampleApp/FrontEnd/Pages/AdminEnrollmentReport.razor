@page "/admin/enrollment-report"

@using System.Net.Http.Json
@using FrontEnd.Services
@using Microsoft.JSInterop

@inject AuthService Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>گزارش ثبت‌نام‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <AdminSidebar ActivePage="reports" />

    <main class="admin-main">

        <header class="admin-topbar">
            <div>
                <span class="admin-label">گزارش‌ها</span>
                <h1>گزارش ثبت‌نام‌ها</h1>
            </div>
            <AdminLogout />
        </header>

        @if (IsLoading)
        {
            <div class="admin-loading">
                <div class="admin-loading-icon">↻</div>
                <h3>در حال دریافت گزارش...</h3>
                <p>اطلاعات ثبت‌نام‌ها از سرور دریافت می‌شود.</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">
                <strong>خطا در دریافت گزارش</strong>
                <p>@ErrorMessage</p>

                <button type="button"
                        class="admin-outline-btn"
                        @onclick="LoadReport">
                    تلاش مجدد
                </button>
            </div>
        }
        else
        {
            <section class="admin-content-card">

                <div class="admin-card-header">
                    <div>
                        <span>فیلتر و جستجو</span>
                        <h2>گزارش ثبت‌نام‌ها</h2>
                    </div>
                </div>

                <div class="admin-form-grid">

                    <div class="admin-form-group">
                        <label>جستجو</label>
                        <input class="admin-input"
                               @bind="Search"
                               placeholder="نام دانشجو یا عنوان دوره..." />
                    </div>

                    <div class="admin-form-group">
                        <label>پشتیبان</label>
                        <select class="admin-input" @bind="SupportUserId">
                            <option value="">همه</option>

                            @foreach (var user in SupportUsers)
                            {
                                <option value="@user.Id">@user.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>بازاریاب</label>
                        <select class="admin-input" @bind="MarketingUserId">
                            <option value="">همه</option>

                            @foreach (var user in MarketingUsers)
                            {
                                <option value="@user.Id">@user.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>مدرس</label>
                        <select class="admin-input" @bind="InstructorId">
                            <option value="">همه</option>

                            @foreach (var instructor in Instructors)
                            {
                                <option value="@instructor.Id">@instructor.FullName</option>
                            }
                        </select>
                    </div>

                    @if (PartnerOrganizations.Count > 0)
                    {
                        <div class="admin-form-group">
                            <label>سازمان طرف قرارداد</label>
                            <select class="admin-input" @bind="PartnerOrganizationId">
                                <option value="">همه</option>

                                @foreach (var organization in PartnerOrganizations)
                                {
                                    <option value="@organization.Id">
                                        @organization.Name
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <div class="admin-form-group">
                        <label>وضعیت ثبت‌نام</label>
                        <select class="admin-input" @bind="Status">
                            <option value="">همه</option>
                            <option value="Active">فعال</option>
                            <option value="Completed">تکمیل‌شده</option>
                            <option value="Cancelled">لغوشده</option>
                            <option value="Pending">در انتظار</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>وضعیت پرداخت</label>
                        <select class="admin-input" @bind="PaymentStatus">
                            <option value="">همه</option>
                            <option value="Unpaid">پرداخت‌نشده</option>
                            <option value="PartiallyPaid">پرداخت ناقص</option>
                            <option value="Paid">تسویه‌شده</option>
                            <option value="Overpaid">بیش‌پرداخت</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>از تاریخ شروع</label>
                        <input class="admin-input"
                               type="date"
                               @bind="StartFrom" />
                    </div>

                    <div class="admin-form-group">
                        <label>تا تاریخ شروع</label>
                        <input class="admin-input"
                               type="date"
                               @bind="StartTo" />
                    </div>

                    <div class="admin-form-group">
                        <label>حداقل مبلغ</label>
                        <input class="admin-input"
                               type="number"
                               @bind="MinPrice" />
                    </div>

                    <div class="admin-form-group">
                        <label>حداکثر مبلغ</label>
                        <input class="admin-input"
                               type="number"
                               @bind="MaxPrice" />
                    </div>

                    <div class="admin-form-group">
                        <label>مرتب‌سازی</label>
                        <select class="admin-input" @bind="SortBy">
                            <option value="startDate">تاریخ شروع</option>
                            <option value="student">دانشجو</option>
                            <option value="course">دوره</option>
                            <option value="price">قیمت</option>
                            <option value="paid">پرداخت‌شده</option>
                            <option value="remaining">مانده</option>
                            <option value="paymentStatus">وضعیت پرداخت</option>
                            <option value="status">وضعیت ثبت‌نام</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>جهت مرتب‌سازی</label>
                        <select class="admin-input" @bind="SortDescending">
                            <option value="true">نزولی</option>
                            <option value="false">صعودی</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>تعداد در صفحه</label>
                        <select class="admin-input" @bind="PageSize">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>

                </div>

                <div class="student-form-actions">

                    <button type="button"
                            class="admin-primary-btn"
                            @onclick="ApplyFilters">
                        اعمال فیلتر
                    </button>

                    <button type="button"
                            class="admin-outline-btn"
                            @onclick="ResetFilters">
                        پاک کردن فیلترها
                    </button>

                    <button type="button"
                            class="admin-primary-btn"
                            disabled="@IsExporting"
                            @onclick='() => DownloadExport("excel")'>
                        @(IsExporting ? "در حال آماده‌سازی..." : "خروجی Excel")
                    </button>

                    <button type="button"
                            class="admin-outline-btn"
                            disabled="@IsExporting"
                            @onclick='() => DownloadExport("pdf")'>
                        @(IsExporting ? "در حال آماده‌سازی..." : "خروجی PDF")
                    </button>

                </div>

            </section>

            <section class="admin-content-card">

                <div class="admin-card-header">
                    <div>
                        <span>نتایج</span>

                        <h2>
                            @(TotalCount == 0
                                ? "نتیجه‌ای وجود ندارد"
                                : $"نمایش {(CurrentPage - 1) * PageSize + 1} تا {Math.Min(CurrentPage * PageSize, TotalCount)} از {TotalCount}")
                        </h2>
                    </div>
                </div>

                @if (Items.Count == 0)
                {
                    <div class="admin-empty-state">
                        ثبت‌نامی مطابق فیلترهای انتخاب‌شده پیدا نشد.
                    </div>
                }
                else
                {
                    <div class="students-table-wrap">

                        <table class="students-table">

                            <thead>
                                <tr>
                                    <th>دانشجو</th>
                                    <th>دوره</th>
                                    <th>مدرس</th>
                                    <th>پشتیبان</th>
                                    <th>تاریخ شروع</th>
                                    <th>قیمت</th>
                                    <th>پرداخت</th>
                                    <th>مانده</th>
                                    <th>وضعیت پرداخت</th>
                                    <th>وضعیت ثبت‌نام</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Items)
                                {
                                    <tr>

                                        <td>
                                            <strong>@item.StudentName</strong>
                                            <small>ثبت‌نام: @item.Id</small>
                                        </td>

                                        <td>@item.CourseTitle</td>

                                        <td>
                                            @(item.InstructorName ?? "بدون مدرس")
                                        </td>

                                        <td>
                                            @(item.SupportUserName ?? "بدون پشتیبان")
                                        </td>

                                        <td>
                                            @item.StartDate.ToString("yyyy/MM/dd")
                                        </td>

                                        <td>
                                            @item.CoursePrice.ToString("N0")
                                        </td>

                                        <td>
                                            @item.TotalPaid.ToString("N0")
                                        </td>

                                        <td>
                                            @item.RemainingAmount.ToString("N0")
                                        </td>

                                        <td>
                                            @GetPaymentStatusName(item.PaymentStatus)
                                        </td>

                                        <td>
                                            @GetEnrollmentStatusName(item.Status)
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <div class="student-form-actions">

                        <button type="button"
                                class="admin-outline-btn"
                                disabled="@(CurrentPage <= 1)"
                                @onclick="PreviousPage">
                            صفحه قبل
                        </button>

                        <span>
                            صفحه @CurrentPage از @TotalPages
                        </span>

                        <button type="button"
                                class="admin-outline-btn"
                                disabled="@(CurrentPage >= TotalPages)"
                                @onclick="NextPage">
                            صفحه بعد
                        </button>

                    </div>
                }

            </section>
        }

    </main>

</div>

@code {

    private bool IsLoading { get; set; } = true;
    private bool IsExporting { get; set; }

    private string? ErrorMessage { get; set; }

    private string Search { get; set; } = string.Empty;
    private string SupportUserId { get; set; } = string.Empty;
    private string MarketingUserId { get; set; } = string.Empty;
    private string InstructorId { get; set; } = string.Empty;
    private string PartnerOrganizationId { get; set; } = string.Empty;

    private string Status { get; set; } = string.Empty;
    private string PaymentStatus { get; set; } = string.Empty;

    private DateTime? StartFrom { get; set; }
    private DateTime? StartTo { get; set; }

    private decimal? MinPrice { get; set; }
    private decimal? MaxPrice { get; set; }

    private string SortBy { get; set; } = "startDate";
    private bool SortDescending { get; set; } = true;

    private int PageSize { get; set; } = 20;
    private int CurrentPage { get; set; } = 1;

    private int TotalCount { get; set; }
    private int TotalPages { get; set; }

    private List<EnrollmentReportItemDto> Items { get; set; } = new();

    private List<ManagementOptionDto> ManagementOptions { get; set; } = new();
    private List<InstructorDto> Instructors { get; set; } = new();
    private List<PartnerOrganizationDto> PartnerOrganizations { get; set; } = new();

    private IEnumerable<ManagementOptionDto> SupportUsers =>
        ManagementOptions.Where(x => x.Role == "Support");

    private IEnumerable<ManagementOptionDto> MarketingUsers =>
        ManagementOptions.Where(x => x.Role == "Marketer");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || !Auth.IsManagementPanelUser)
        {
            Navigation.NavigateTo(
                Auth.IsLoggedIn ? "/admin" : "/login",
                true);

            return;
        }

        await LoadData();

        StateHasChanged();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            ManagementOptions =
                await client.GetFromJsonAsync<List<ManagementOptionDto>>(
                    "api/Students/management-options")
                ?? new List<ManagementOptionDto>();

            Instructors =
                await client.GetFromJsonAsync<List<InstructorDto>>(
                    "api/Courses/instructors")
                ?? new List<InstructorDto>();

            try
            {
                PartnerOrganizations =
                    await client.GetFromJsonAsync<List<PartnerOrganizationDto>>(
                        "api/PartnerOrganizations")
                    ?? new List<PartnerOrganizationDto>();
            }
            catch
            {
                PartnerOrganizations = new List<PartnerOrganizationDto>();
            }

            await LoadReport();
        }
        catch
        {
            ErrorMessage = "دریافت اطلاعات گزارش با خطا مواجه شد.";
            IsLoading = false;
        }
    }

    private async Task LoadReport()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();
            var parameters = new List<string>();

            if (!string.IsNullOrWhiteSpace(Search))
                parameters.Add($"Search={Uri.EscapeDataString(Search.Trim())}");

            if (int.TryParse(SupportUserId, out var supportId))
                parameters.Add($"SupportUserId={supportId}");

            if (int.TryParse(MarketingUserId, out var marketingId))
                parameters.Add($"MarketingUserId={marketingId}");

            if (int.TryParse(InstructorId, out var instructorId))
                parameters.Add($"InstructorId={instructorId}");

            if (int.TryParse(PartnerOrganizationId, out var partnerId))
                parameters.Add($"PartnerOrganizationId={partnerId}");

            if (!string.IsNullOrWhiteSpace(Status))
                parameters.Add($"Status={Uri.EscapeDataString(Status)}");

            if (!string.IsNullOrWhiteSpace(PaymentStatus))
                parameters.Add($"PaymentStatus={Uri.EscapeDataString(PaymentStatus)}");

            if (StartFrom.HasValue)
                parameters.Add($"StartFrom={StartFrom.Value:yyyy-MM-dd}");

            if (StartTo.HasValue)
                parameters.Add($"StartTo={StartTo.Value:yyyy-MM-dd}");

            if (MinPrice.HasValue)
                parameters.Add($"MinPrice={MinPrice.Value}");

            if (MaxPrice.HasValue)
                parameters.Add($"MaxPrice={MaxPrice.Value}");

            parameters.Add($"SortBy={Uri.EscapeDataString(SortBy)}");
            parameters.Add($"SortDescending={SortDescending.ToString().ToLowerInvariant()}");
            parameters.Add($"Page={CurrentPage}");
            parameters.Add($"PageSize={PageSize}");

            var result =
                await client.GetFromJsonAsync<EnrollmentReportResultDto>(
                    "api/EnrollmentReports?" +
                    string.Join("&", parameters));

            Items =
                result?.Items ?? new List<EnrollmentReportItemDto>();

            TotalCount = result?.TotalCount ?? 0;
            CurrentPage = result?.Page ?? 1;
            PageSize = result?.PageSize ?? PageSize;
            TotalPages = result?.TotalPages ?? 0;
        }
        catch
        {
            ErrorMessage = "دریافت گزارش ثبت‌نام‌ها با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        CurrentPage = 1;
        await LoadReport();
    }

    private async Task ResetFilters()
    {
        Search = string.Empty;
        SupportUserId = string.Empty;
        MarketingUserId = string.Empty;
        InstructorId = string.Empty;
        PartnerOrganizationId = string.Empty;

        Status = string.Empty;
        PaymentStatus = string.Empty;

        StartFrom = null;
        StartTo = null;

        MinPrice = null;
        MaxPrice = null;

        SortBy = "startDate";
        SortDescending = true;

        PageSize = 20;
        CurrentPage = 1;

        await LoadReport();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage <= 1)
            return;

        CurrentPage--;
        await LoadReport();
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages)
            return;

        CurrentPage++;
        await LoadReport();
    }

    private async Task DownloadExport(string format)
    {
        IsExporting = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();
            var parameters = new List<string>();

            if (!string.IsNullOrWhiteSpace(Search))
                parameters.Add($"Search={Uri.EscapeDataString(Search.Trim())}");

            if (int.TryParse(SupportUserId, out var supportId))
                parameters.Add($"SupportUserId={supportId}");

            if (int.TryParse(MarketingUserId, out var marketingId))
                parameters.Add($"MarketingUserId={marketingId}");

            if (int.TryParse(InstructorId, out var instructorId))
                parameters.Add($"InstructorId={instructorId}");

            if (int.TryParse(PartnerOrganizationId, out var partnerId))
                parameters.Add($"PartnerOrganizationId={partnerId}");

            if (!string.IsNullOrWhiteSpace(Status))
                parameters.Add($"Status={Uri.EscapeDataString(Status)}");

            if (!string.IsNullOrWhiteSpace(PaymentStatus))
                parameters.Add($"PaymentStatus={Uri.EscapeDataString(PaymentStatus)}");

            if (StartFrom.HasValue)
                parameters.Add($"StartFrom={StartFrom.Value:yyyy-MM-dd}");

            if (StartTo.HasValue)
                parameters.Add($"StartTo={StartTo.Value:yyyy-MM-dd}");

            if (MinPrice.HasValue)
                parameters.Add($"MinPrice={MinPrice.Value}");

            if (MaxPrice.HasValue)
                parameters.Add($"MaxPrice={MaxPrice.Value}");

            parameters.Add($"SortBy={Uri.EscapeDataString(SortBy)}");
            parameters.Add($"SortDescending={SortDescending.ToString().ToLowerInvariant()}");

            var query = string.Join("&", parameters);

            var response =
                await client.GetAsync(
                    $"api/EnrollmentReportExports/{format}?{query}");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "تهیه فایل خروجی با خطا مواجه شد.";
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();

            var contentType =
                response.Content.Headers.ContentType?.ToString()
                ?? "application/octet-stream";

            var fileName =
                format == "pdf"
                    ? "enrollment-report.pdf"
                    : "enrollment-report.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName,
                contentType,
                Convert.ToBase64String(bytes));
        }
        catch
        {
            ErrorMessage = "دانلود فایل خروجی با خطا مواجه شد.";
        }
        finally
        {
            IsExporting = false;
        }
    }

    private static string GetPaymentStatusName(string value) =>
        value switch
        {
            "Unpaid" => "پرداخت‌نشده",
            "PartiallyPaid" => "پرداخت ناقص",
            "Paid" => "تسویه‌شده",
            "Overpaid" => "بیش‌پرداخت",
            _ => value
        };

    private static string GetEnrollmentStatusName(string value) =>
        value switch
        {
            "Active" => "فعال",
            "Completed" => "تکمیل‌شده",
            "Cancelled" => "لغوشده",
            "Pending" => "در انتظار",
            _ => value
        };

    private sealed class ManagementOptionDto
    {
        public int Id { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }

    private sealed class InstructorDto
    {
        public int Id { get; set; }
        public string FullName { get; set; } = string.Empty;
    }

    private sealed class PartnerOrganizationDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class EnrollmentReportItemDto
    {
        public int Id { get; set; }
        public int StudentId { get; set; }
        public string StudentName { get; set; } = string.Empty;
        public int CourseId { get; set; }
        public string CourseTitle { get; set; } = string.Empty;
        public decimal CoursePrice { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal RemainingAmount { get; set; }
        public string PaymentStatus { get; set; } = string.Empty;
        public string? SupportUserName { get; set; }
        public string? InstructorName { get; set; }
        public string? MarketingUserName { get; set; }
        public string? PartnerOrganizationName { get; set; }
        public DateTime StartDate { get; set; }
        public string Status { get; set; } = string.Empty;
    }

    private sealed class EnrollmentReportResultDto
    {
        public List<EnrollmentReportItemDto> Items { get; set; } = new();
        public int TotalCount { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalPages { get; set; }
    }
}

@page "/instructor"

@using System.Net.Http.Json
@using FrontEnd.Services

@layout InstructorLayout

@inject AuthService Auth

<PageTitle>پنل مدرس | آموزش‌یار</PageTitle>

<div class="support-content">

@if (IsLoading)
{
    <div class="support-loading">
        <div class="support-loading-icon">↻</div>

        <h3>
            در حال دریافت اطلاعات...
        </h3>

        <p>
            اطلاعات دوره‌ها و دانشجویان شما در حال بارگذاری است.
        </p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="support-error">

        <strong>
            @ErrorMessage
        </strong>

        <br />

        <button
            type="button"
            class="support-outline-btn"
            @onclick="LoadDashboard">

            تلاش مجدد

        </button>

    </div>
}
else
{
    <section class="support-welcome-card">

        <span>
            آموزش
        </span>

        <h2>
            دوره‌ها و دانشجویان من
        </h2>

        <p>
            در این پنل فقط دوره‌ها، دانشجویان، ثبت‌نام‌ها و پرداخت‌های مرتبط با دوره‌های شما نمایش داده می‌شود.
        </p>

    </section>


    <section class="support-stats">

        <div class="support-stat-card">

            <span class="support-stat-icon">
                ▣
            </span>

            <div>
                <small>
                    دوره‌های من
                </small>

                <strong>
                    @Courses.Count
                </strong>
            </div>

        </div>


        <div class="support-stat-card">

            <span class="support-stat-icon">
                ♙
            </span>

            <div>
                <small>
                    دانشجویان من
                </small>

                <strong>
                    @Students.Count
                </strong>
            </div>

        </div>


        <div class="support-stat-card">

            <span class="support-stat-icon">
                ✓
            </span>

            <div>
                <small>
                    ثبت‌نام‌ها
                </small>

                <strong>
                    @Enrollments.Count
                </strong>
            </div>

        </div>


        <div class="support-stat-card">

            <span class="support-stat-icon">
                ₿
            </span>

            <div>
                <small>
                    پرداخت‌شده
                </small>

                <strong>
                    @TotalPaid.ToString("N0")
                </strong>

                <span>
                    تومان
                </span>
            </div>

        </div>

    </section>


    <section class="support-content-card">

        <div class="support-card-header">

            <div>
                <span>
                    آموزش
                </span>

                <h2>
                    دوره‌های من
                </h2>
            </div>

            <a
                href="/instructor/courses"
                class="support-outline-btn">

                مشاهده همه

            </a>

        </div>


        @if (Courses.Count == 0)
        {
            <div class="support-empty-state">

                <h3>
                    هنوز دوره‌ای به شما اختصاص داده نشده است.
                </h3>

            </div>
        }
        else
        {
            <div class="support-enrollments-list">

                @foreach (var course in Courses.Take(5))
                {
                    <div class="support-enrollment-row">

                        <div class="support-enrollment-main">

                            <strong>
                                @course.Title
                            </strong>

                            <span>
                                قیمت دوره:
                                @course.Price.ToString("N0")
                                تومان
                            </span>

                        </div>


                        <div>

                            <small>
                                وضعیت
                            </small>

                            <span class="@(course.IsActive ? "status-active" : "status-cancelled")">
                                @(course.IsActive ? "فعال" : "غیرفعال")
                            </span>

                        </div>


                        <div>

                            <small>
                                دانشجویان
                            </small>

                            <strong>
                                @Enrollments.Count(x => x.CourseId == course.Id)
                            </strong>

                        </div>

                    </div>
                }

            </div>
        }

    </section>


    <section class="support-content-card">

        <div class="support-card-header">

            <div>
                <span>
                    ثبت‌نام
                </span>

                <h2>
                    آخرین ثبت‌نام‌ها
                </h2>
            </div>

            <a
                href="/instructor/students"
                class="support-outline-btn">

                دانشجویان من

            </a>

        </div>


        @if (Enrollments.Count == 0)
        {
            <div class="support-empty-state">

                <h3>
                    هنوز ثبت‌نامی وجود ندارد.
                </h3>

            </div>
        }
        else
        {
            <div class="support-enrollments-list">

                @foreach (var enrollment in Enrollments
                    .OrderByDescending(x => x.StartDate)
                    .Take(5))
                {
                    <div class="support-enrollment-row">

                        <div class="support-enrollment-main">

                            <strong>
                                @enrollment.StudentName
                            </strong>

                            <span>
                                @enrollment.CourseTitle
                            </span>

                        </div>


                        <div>

                            <small>
                                وضعیت
                            </small>

                            <span class="@GetEnrollmentStatusClass(enrollment.Status)">
                                @GetEnrollmentStatusText(enrollment.Status)
                            </span>

                        </div>


                        <div class="support-enrollment-money">

                            <small>
                                باقی‌مانده
                            </small>

                            <strong>
                                @enrollment.RemainingAmount.ToString("N0")
                                تومان
                            </strong>

                        </div>

                    </div>
                }

            </div>
        }

    </section>


    <section class="support-content-card">

        <div class="support-card-header">

            <div>
                <span>
                    امور مالی
                </span>

                <h2>
                    آخرین پرداخت‌ها
                </h2>
            </div>

            <a
                href="/instructor/payments"
                class="support-outline-btn">

                مشاهده همه

            </a>

        </div>


        @if (Payments.Count == 0)
        {
            <div class="support-empty-state">

                <h3>
                    هنوز پرداختی ثبت نشده است.
                </h3>

            </div>
        }
        else
        {
            <div class="support-payments-list">

                @foreach (var payment in Payments
                    .OrderByDescending(x => x.PaymentDate)
                    .Take(5))
                {
                    <div class="support-payment-row">

                        <div class="support-payment-item">
                            <small>دوره:</small>
                            <strong>@payment.CourseTitle</strong>
                        </div>

                        <div class="support-payment-item">
                            <small>تاریخ پرداخت:</small>
                            <strong>@payment.PaymentDate.ToString("yyyy/MM/dd")</strong>
                        </div>

                        <div class="support-payment-item">
                            <small>نوع پرداخت:</small>
                            <strong>@GetPaymentTypeText(payment.PaymentType)</strong>
                        </div>

                        <div class="support-payment-item">
                            <small>وضعیت:</small>

                            <span class="@GetPaymentStatusClass(payment.Status)">
                                @GetPaymentStatusText(payment.Status)
                            </span>
                        </div>

                        <div class="support-payment-item support-payment-amount">
                            <small>مبلغ:</small>
                            <strong>
                                @payment.Amount.ToString("N0") تومان
                            </strong>
                        </div>

                    </div>
                }

            </div>
        }

    </section>

}

</div>


@code {

    private List<CourseDto> Courses { get; set; } = new();

    private List<StudentDto> Students { get; set; } = new();

    private List<EnrollmentDto> Enrollments { get; set; } = new();

    private List<PaymentDto> Payments { get; set; } = new();

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }


    private decimal TotalPaid =>
        Enrollments.Sum(x => x.TotalPaid);


    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.IsInstructor)
        {
            return;
        }

        await LoadDashboard();
    }


    private async Task LoadDashboard()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            Courses =
                await client.GetFromJsonAsync<List<CourseDto>>(
                    "api/Courses")
                ?? new List<CourseDto>();

            Students =
                await client.GetFromJsonAsync<List<StudentDto>>(
                    "api/Students")
                ?? new List<StudentDto>();

            Enrollments =
                await client.GetFromJsonAsync<List<EnrollmentDto>>(
                    "api/Enrollments")
                ?? new List<EnrollmentDto>();

            Payments =
                await client.GetFromJsonAsync<List<PaymentDto>>(
                    "api/Payments")
                ?? new List<PaymentDto>();
        }
        catch
        {
            ErrorMessage =
                "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private string GetEnrollmentStatusText(string status)
    {
        return status switch
        {
            "Active" => "فعال",
            "Completed" => "تکمیل‌شده",
            "Suspended" => "معلق",
            "Cancelled" => "لغوشده",
            _ => status
        };
    }


    private string GetEnrollmentStatusClass(string status)
    {
        return status switch
        {
            "Active" => "status-active",
            "Completed" => "status-completed",
            "Suspended" => "status-suspended",
            "Cancelled" => "status-cancelled",
            _ => "status-default"
        };
    }


    private string GetPaymentTypeText(string type)
    {
        return type switch
        {
            "FullPayment" => "پرداخت کامل",
            "FirstInstallment" => "قسط اول",
            "SecondInstallment" => "قسط دوم",
            "ThirdInstallment" => "قسط سوم",
            _ => type
        };
    }


    private string GetPaymentStatusText(string status)
    {
        return status switch
        {
            "Paid" => "پرداخت‌شده",
            "Pending" => "در انتظار پرداخت",
            "Cancelled" => "لغوشده",
            "Unpaid" => "پرداخت‌نشده",
            _ => status
        };
    }


    private string GetPaymentStatusClass(string status)
    {
        return status switch
        {
            "Paid" => "payment-paid",
            "Pending" => "payment-pending",
            "Cancelled" => "payment-cancelled",
            _ => "payment-default"
        };
    }


    public class CourseDto
    {
        public int Id { get; set; }

        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public decimal Price { get; set; }

        public int? InstructorId { get; set; }

        public bool IsActive { get; set; }
    }


    public class StudentDto
    {
        public int Id { get; set; }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        public string NationalCode { get; set; } = string.Empty;

        public string Mobile { get; set; } = string.Empty;

        public DateTime CreatedDate { get; set; }
    }


    public class EnrollmentDto
    {
        public int Id { get; set; }

        public int StudentId { get; set; }

        public string StudentName { get; set; } = string.Empty;

        public int CourseId { get; set; }

        public string CourseTitle { get; set; } = string.Empty;

        public decimal TotalPaid { get; set; }

        public decimal RemainingAmount { get; set; }

        public DateTime StartDate { get; set; }

        public string Status { get; set; } = string.Empty;
    }


    public class PaymentDto
    {
        public int Id { get; set; }

        public string CourseTitle { get; set; } = string.Empty;

        public decimal Amount { get; set; }

        public DateTime PaymentDate { get; set; }

        public string PaymentType { get; set; } = string.Empty;

        public string Status { get; set; } = string.Empty;

        public int EnrollmentId { get; set; }
    }

}

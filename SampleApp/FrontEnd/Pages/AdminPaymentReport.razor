@page "/admin/payment-report"

@using System.Net.Http.Json
@using FrontEnd.Services
@using Microsoft.JSInterop

@inject AuthService Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>گزارش پرداخت‌ها | آموزش‌یار</PageTitle>

<div class="admin-page">

    <AdminSidebar ActivePage="reports" />

    <main class="admin-main">

        <header class="admin-topbar">
            <div>
                <span class="admin-label">گزارش‌ها</span>
                <h1>گزارش پرداخت‌ها</h1>
            </div>

            <AdminLogout />
        </header>

        @if (IsLoading)
        {
            <div class="admin-loading">
                <div class="admin-loading-icon">↻</div>
                <h3>در حال دریافت گزارش...</h3>
                <p>اطلاعات پرداخت‌ها از سرور دریافت می‌شود.</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="admin-error">
                <strong>خطا در دریافت گزارش</strong>
                <p>@ErrorMessage</p>

                <button type="button"
                        class="admin-outline-btn"
                        @onclick="LoadReport">
                    تلاش مجدد
                </button>
            </div>
        }
        else
        {
            <section class="admin-content-card">

                <div class="admin-card-header">
                    <div>
                        <span>فیلتر و جستجو</span>
                        <h2>گزارش پرداخت‌ها</h2>
                    </div>
                </div>

                <div class="admin-form-grid">

                    <div class="admin-form-group">
                        <label>جستجو</label>
                        <input class="admin-input"
                               @bind="Search"
                               placeholder="نام دانشجو یا عنوان دوره..." />
                    </div>

                    <div class="admin-form-group">
                        <label>پشتیبان</label>
                        <select class="admin-input" @bind="SupportUserId">
                            <option value="">همه</option>

                            @foreach (var user in SupportUsers)
                            {
                                <option value="@user.Id">@user.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>بازاریاب</label>
                        <select class="admin-input" @bind="MarketingUserId">
                            <option value="">همه</option>

                            @foreach (var user in MarketingUsers)
                            {
                                <option value="@user.Id">@user.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>مدرس</label>
                        <select class="admin-input" @bind="InstructorId">
                            <option value="">همه</option>

                            @foreach (var instructor in Instructors)
                            {
                                <option value="@instructor.Id">@instructor.FullName</option>
                            }
                        </select>
                    </div>

                    @if (PartnerOrganizations.Count > 0)
                    {
                        <div class="admin-form-group">
                            <label>سازمان طرف قرارداد</label>
                            <select class="admin-input"
                                    @bind="PartnerOrganizationId">
                                <option value="">همه</option>

                                @foreach (var organization in PartnerOrganizations)
                                {
                                    <option value="@organization.Id">
                                        @organization.Name
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <div class="admin-form-group">
                        <label>وضعیت پرداخت</label>
                        <select class="admin-input" @bind="Status">
                            <option value="">همه</option>
                            <option value="Paid">پرداخت‌شده</option>
                            <option value="Pending">در انتظار</option>
                            <option value="Cancelled">لغوشده</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>نوع پرداخت</label>
                        <select class="admin-input" @bind="PaymentType">
                            <option value="">همه</option>
                            <option value="FirstInstallment">قسط اول</option>
                            <option value="SecondInstallment">قسط دوم</option>
                            <option value="ThirdInstallment">قسط سوم</option>
                            <option value="FullPayment">پرداخت کامل</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>روش پرداخت</label>
                        <input class="admin-input"
                               @bind="PaymentMethod"
                               placeholder="مثلاً ZarinPal" />
                    </div>

                    <div class="admin-form-group">
                        <label>وضعیت ثبت‌نام</label>
                        <select class="admin-input"
                                @bind="EnrollmentStatus">
                            <option value="">همه</option>
                            <option value="Active">فعال</option>
                            <option value="Completed">تکمیل‌شده</option>
                            <option value="Cancelled">لغوشده</option>
                            <option value="Pending">در انتظار</option>
                            <option value="Suspended">معلق</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>از تاریخ پرداخت</label>
                        <input class="admin-input"
                               type="date"
                               @bind="PaymentFrom" />
                    </div>

                    <div class="admin-form-group">
                        <label>تا تاریخ پرداخت</label>
                        <input class="admin-input"
                               type="date"
                               @bind="PaymentTo" />
                    </div>

                    <div class="admin-form-group">
                        <label>حداقل مبلغ</label>
                        <input class="admin-input"
                               type="number"
                               @bind="MinAmount" />
                    </div>

                    <div class="admin-form-group">
                        <label>حداکثر مبلغ</label>
                        <input class="admin-input"
                               type="number"
                               @bind="MaxAmount" />
                    </div>

                    <div class="admin-form-group">
                        <label>مرتب‌سازی</label>
                        <select class="admin-input" @bind="SortBy">
                            <option value="paymentDate">تاریخ پرداخت</option>
                            <option value="student">دانشجو</option>
                            <option value="course">دوره</option>
                            <option value="amount">مبلغ</option>
                            <option value="status">وضعیت</option>
                            <option value="paymentType">نوع پرداخت</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>جهت مرتب‌سازی</label>
                        <select class="admin-input"
                                @bind="SortDescending">
                            <option value="true">نزولی</option>
                            <option value="false">صعودی</option>
                        </select>
                    </div>

                    <div class="admin-form-group">
                        <label>تعداد در صفحه</label>
                        <select class="admin-input" @bind="PageSize">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>

                </div>

                <div class="student-form-actions">

                    <button type="button"
                            class="admin-primary-btn"
                            @onclick="ApplyFilters">
                        اعمال فیلتر
                    </button>

                    <button type="button"
                            class="admin-outline-btn"
                            @onclick="ResetFilters">
                        پاک کردن فیلترها
                    </button>

                    <button type="button"
                            class="admin-primary-btn"
                            disabled="@IsExporting"
                            @onclick='() => DownloadExport("excel")'>
                        @(IsExporting
                            ? "در حال آماده‌سازی..."
                            : "خروجی Excel")
                    </button>

                    <button type="button"
                            class="admin-outline-btn"
                            disabled="@IsExporting"
                            @onclick='() => DownloadExport("pdf")'>
                        @(IsExporting
                            ? "در حال آماده‌سازی..."
                            : "خروجی PDF")
                    </button>

                </div>

            </section>

            <section class="admin-content-card">

                <div class="admin-card-header">

                    <div>
                        <span>نتایج</span>

                        <h2>
                            @(TotalCount == 0
                                ? "نتیجه‌ای وجود ندارد"
                                : $"نمایش {(CurrentPage - 1) * PageSize + 1} تا {Math.Min(CurrentPage * PageSize, TotalCount)} از {TotalCount}")
                        </h2>
                    </div>

                    <div>
                        <span>مجموع مبالغ</span>

                        <strong>
                            @TotalAmount.ToString("N0") تومان
                        </strong>
                    </div>

                </div>

                @if (Items.Count == 0)
                {
                    <div class="admin-empty-state">
                        پرداختی مطابق فیلترهای انتخاب‌شده پیدا نشد.
                    </div>
                }
                else
                {
                    <div class="students-table-wrap">

                        <table class="students-table">

                            <thead>
                                <tr>
                                    <th>دانشجو</th>
                                    <th>دوره</th>
                                    <th>مبلغ</th>
                                    <th>تاریخ پرداخت</th>
                                    <th>نوع پرداخت</th>
                                    <th>روش پرداخت</th>
                                    <th>وضعیت</th>
                                    <th>ثبت‌نام</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Items)
                                {
                                    <tr>

                                        <td>
                                            <strong>@item.StudentName</strong>
                                            <small>پرداخت: @item.Id</small>
                                        </td>

                                        <td>@item.CourseTitle</td>

                                        <td>
                                            @item.Amount.ToString("N0")
                                        </td>

                                        <td>
                                            @item.PaymentDate.ToString("yyyy/MM/dd HH:mm")
                                        </td>

                                        <td>
                                            @GetPaymentTypeName(item.PaymentType)
                                        </td>

                                        <td>
                                            @(item.PaymentMethod ?? "نامشخص")
                                        </td>

                                        <td>
                                            @GetPaymentStatusName(item.Status)
                                        </td>

                                        <td>
                                            @GetEnrollmentStatusName(item.EnrollmentStatus)
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <div class="student-form-actions">

                        <button type="button"
                                class="admin-outline-btn"
                                disabled="@(CurrentPage <= 1)"
                                @onclick="PreviousPage">
                            صفحه قبل
                        </button>

                        <span>
                            صفحه @CurrentPage از @TotalPages
                        </span>

                        <button type="button"
                                class="admin-outline-btn"
                                disabled="@(CurrentPage >= TotalPages)"
                                @onclick="NextPage">
                            صفحه بعد
                        </button>

                    </div>
                }

            </section>
        }

    </main>

</div>

@code {

    private bool IsLoading { get; set; } = true;
    private bool IsExporting { get; set; }

    private string? ErrorMessage { get; set; }

    private string Search { get; set; } = string.Empty;
    private string SupportUserId { get; set; } = string.Empty;
    private string MarketingUserId { get; set; } = string.Empty;
    private string InstructorId { get; set; } = string.Empty;
    private string PartnerOrganizationId { get; set; } = string.Empty;

    private string Status { get; set; } = string.Empty;
    private string PaymentType { get; set; } = string.Empty;
    private string PaymentMethod { get; set; } = string.Empty;
    private string EnrollmentStatus { get; set; } = string.Empty;

    private DateTime? PaymentFrom { get; set; }
    private DateTime? PaymentTo { get; set; }

    private decimal? MinAmount { get; set; }
    private decimal? MaxAmount { get; set; }

    private string SortBy { get; set; } = "paymentDate";
    private bool SortDescending { get; set; } = true;

    private int PageSize { get; set; } = 20;
    private int CurrentPage { get; set; } = 1;

    private int TotalCount { get; set; }
    private int TotalPages { get; set; }
    private decimal TotalAmount { get; set; }

    private List<PaymentReportItemDto> Items { get; set; } = new();

    private List<ManagementOptionDto> ManagementOptions { get; set; } = new();
    private List<InstructorDto> Instructors { get; set; } = new();
    private List<PartnerOrganizationDto> PartnerOrganizations { get; set; } = new();

    private IEnumerable<ManagementOptionDto> SupportUsers =>
        ManagementOptions.Where(x => x.Role == "Support");

    private IEnumerable<ManagementOptionDto> MarketingUsers =>
        ManagementOptions.Where(x => x.Role == "Marketer");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Auth.RestoreAsync();

        if (!Auth.IsLoggedIn || !Auth.IsManagementPanelUser)
        {
            Navigation.NavigateTo(
                Auth.IsLoggedIn ? "/admin" : "/login",
                true);

            return;
        }

        await LoadData();

        StateHasChanged();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            ManagementOptions =
                await client.GetFromJsonAsync<
                    List<ManagementOptionDto>>(
                    "api/Students/management-options")
                ?? new List<ManagementOptionDto>();

            Instructors =
                await client.GetFromJsonAsync<
                    List<InstructorDto>>(
                    "api/Courses/instructors")
                ?? new List<InstructorDto>();

            try
            {
                PartnerOrganizations =
                    await client.GetFromJsonAsync<
                        List<PartnerOrganizationDto>>(
                        "api/PartnerOrganizations")
                    ?? new List<PartnerOrganizationDto>();
            }
            catch
            {
                PartnerOrganizations =
                    new List<PartnerOrganizationDto>();
            }

            await LoadReport();
        }
        catch
        {
            ErrorMessage =
                "دریافت اطلاعات گزارش با خطا مواجه شد.";

            IsLoading = false;
        }
    }

    private async Task LoadReport()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();
            var parameters = BuildQueryParameters();

            var result =
                await client.GetFromJsonAsync<
                    PaymentReportResultDto>(
                    "api/PaymentReports?" +
                    string.Join("&", parameters));

            Items =
                result?.Items
                ?? new List<PaymentReportItemDto>();

            TotalCount = result?.TotalCount ?? 0;
            CurrentPage = result?.Page ?? 1;
            PageSize = result?.PageSize ?? PageSize;
            TotalPages = result?.TotalPages ?? 0;
            TotalAmount = result?.TotalAmount ?? 0;
        }
        catch
        {
            ErrorMessage =
                "دریافت گزارش پرداخت‌ها با خطا مواجه شد.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<string> BuildQueryParameters()
    {
        var parameters = new List<string>();

        if (!string.IsNullOrWhiteSpace(Search))
            parameters.Add(
                $"Search={Uri.EscapeDataString(Search.Trim())}");

        if (int.TryParse(SupportUserId, out var supportId))
            parameters.Add($"SupportUserId={supportId}");

        if (int.TryParse(MarketingUserId, out var marketingId))
            parameters.Add($"MarketingUserId={marketingId}");

        if (int.TryParse(InstructorId, out var instructorId))
            parameters.Add($"InstructorId={instructorId}");

        if (int.TryParse(
            PartnerOrganizationId,
            out var partnerId))
        {
            parameters.Add(
                $"PartnerOrganizationId={partnerId}");
        }

        if (!string.IsNullOrWhiteSpace(Status))
            parameters.Add(
                $"Status={Uri.EscapeDataString(Status)}");

        if (!string.IsNullOrWhiteSpace(PaymentType))
            parameters.Add(
                $"PaymentType={Uri.EscapeDataString(PaymentType)}");

        if (!string.IsNullOrWhiteSpace(PaymentMethod))
            parameters.Add(
                $"PaymentMethod={Uri.EscapeDataString(PaymentMethod.Trim())}");

        if (!string.IsNullOrWhiteSpace(EnrollmentStatus))
            parameters.Add(
                $"EnrollmentStatus={Uri.EscapeDataString(EnrollmentStatus)}");

        if (PaymentFrom.HasValue)
            parameters.Add(
                $"PaymentFrom={PaymentFrom.Value:yyyy-MM-dd}");

        if (PaymentTo.HasValue)
            parameters.Add(
                $"PaymentTo={PaymentTo.Value:yyyy-MM-dd}");

        if (MinAmount.HasValue)
            parameters.Add($"MinAmount={MinAmount.Value}");

        if (MaxAmount.HasValue)
            parameters.Add($"MaxAmount={MaxAmount.Value}");

        parameters.Add(
            $"SortBy={Uri.EscapeDataString(SortBy)}");

        parameters.Add(
            $"SortDescending={SortDescending.ToString().ToLowerInvariant()}");

        parameters.Add($"Page={CurrentPage}");
        parameters.Add($"PageSize={PageSize}");

        return parameters;
    }

    private async Task ApplyFilters()
    {
        CurrentPage = 1;
        await LoadReport();
    }

    private async Task ResetFilters()
    {
        Search = string.Empty;
        SupportUserId = string.Empty;
        MarketingUserId = string.Empty;
        InstructorId = string.Empty;
        PartnerOrganizationId = string.Empty;

        Status = string.Empty;
        PaymentType = string.Empty;
        PaymentMethod = string.Empty;
        EnrollmentStatus = string.Empty;

        PaymentFrom = null;
        PaymentTo = null;

        MinAmount = null;
        MaxAmount = null;

        SortBy = "paymentDate";
        SortDescending = true;

        PageSize = 20;
        CurrentPage = 1;

        await LoadReport();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage <= 1)
            return;

        CurrentPage--;
        await LoadReport();
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages)
            return;

        CurrentPage++;
        await LoadReport();
    }

    private async Task DownloadExport(string format)
    {
        IsExporting = true;
        ErrorMessage = null;

        try
        {
            var client = Auth.CreateAuthenticatedClient();

            var parameters = BuildQueryParameters();

            parameters.RemoveAll(
                x => x.StartsWith("Page=") ||
                     x.StartsWith("PageSize="));

            var query = string.Join("&", parameters);

            var response =
                await client.GetAsync(
                    $"api/PaymentReportExports/{format}?{query}");

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage =
                    "تهیه فایل خروجی با خطا مواجه شد.";

                return;
            }

            var bytes =
                await response.Content.ReadAsByteArrayAsync();

            var contentType =
                response.Content.Headers.ContentType?.ToString()
                ?? "application/octet-stream";

            var fileName =
                format == "pdf"
                    ? "payment-report.pdf"
                    : "payment-report.xlsx";

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                fileName,
                contentType,
                Convert.ToBase64String(bytes));
        }
        catch
        {
            ErrorMessage =
                "دانلود فایل خروجی با خطا مواجه شد.";
        }
        finally
        {
            IsExporting = false;
        }
    }

    private static string GetPaymentStatusName(string value) =>
        value switch
        {
            "Paid" => "پرداخت‌شده",
            "Pending" => "در انتظار",
            "Cancelled" => "لغوشده",
            _ => value
        };

    private static string GetPaymentTypeName(string value) =>
        value switch
        {
            "FirstInstallment" => "قسط اول",
            "SecondInstallment" => "قسط دوم",
            "ThirdInstallment" => "قسط سوم",
            "FullPayment" => "پرداخت کامل",
            _ => value
        };

    private static string GetEnrollmentStatusName(string value) =>
        value switch
        {
            "Active" => "فعال",
            "Completed" => "تکمیل‌شده",
            "Cancelled" => "لغوشده",
            "Pending" => "در انتظار",
            "Suspended" => "معلق",
            _ => value
        };

    private sealed class ManagementOptionDto
    {
        public int Id { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }

    private sealed class InstructorDto
    {
        public int Id { get; set; }
        public string FullName { get; set; } = string.Empty;
    }

    private sealed class PartnerOrganizationDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class PaymentReportItemDto
    {
        public int Id { get; set; }
        public int EnrollmentId { get; set; }
        public string StudentName { get; set; } = string.Empty;
        public string CourseTitle { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public DateTime PaymentDate { get; set; }
        public string PaymentType { get; set; } = string.Empty;
        public string? PaymentMethod { get; set; }
        public string Status { get; set; } = string.Empty;
        public string EnrollmentStatus { get; set; } = string.Empty;
    }

    private sealed class PaymentReportResultDto
    {
        public List<PaymentReportItemDto> Items { get; set; } = new();
        public int TotalCount { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalPages { get; set; }
        public decimal TotalAmount { get; set; }
    }
}

@using System.Net.Http.Json
@using FrontEnd.Services

@inject AuthService Auth

<button class="education-btn primary"
        @onclick="Toggle"
        disabled="@Loading">
    @(Expanded ? "بستن مالی" : "مالی")
</button>

@if (Expanded)
{
    <div class="education-card" style="margin-top:12px;">

        @if (Loading)
        {
            <div class="education-empty">
                در حال دریافت اطلاعات مالی...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="education-error">
                @ErrorMessage
            </div>
        }
        else if (Financial != null)
        {
            <div class="education-form-grid">

                <div class="education-card">
                    <strong>شهریه</strong>
                    <div style="margin-top:8px;">
                        @Financial.CoursePrice.ToString("N0") تومان
                    </div>
                </div>

                <div class="education-card">
                    <strong>پرداخت‌شده</strong>
                    <div style="margin-top:8px;">
                        @Financial.TotalPaid.ToString("N0") تومان
                    </div>
                </div>

                <div class="education-card">
                    <strong>مانده</strong>
                    <div style="margin-top:8px;">
                        @Financial.RemainingAmount.ToString("N0") تومان
                    </div>
                </div>

                <div class="education-card">
                    <strong>وضعیت پرداخت</strong>
                    <div style="margin-top:8px;">
                        @GetPaymentStatusText(Financial.PaymentStatus)
                    </div>
                </div>

            </div>

            @if (Financial.Payments.Count > 0)
            {
                <div class="education-table-wrapper" style="margin-top:20px;">
                    <table class="education-table">
                        <thead>
                            <tr>
                                <th>مبلغ</th>
                                <th>تاریخ</th>
                                <th>نوع پرداخت</th>
                                <th>وضعیت</th>
                                <th>توضیحات</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var payment in Financial.Payments)
                            {
                                <tr>
                                    <td>@payment.Amount.ToString("N0") تومان</td>
                                    <td>@payment.PaymentDate.ToString("yyyy/MM/dd")</td>
                                    <td>@payment.PaymentType</td>
                                    <td>@payment.Status</td>
                                    <td>@payment.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

    </div>
}

@code {
    [Parameter]
    public int EnrollmentId { get; set; }

    private bool Expanded { get; set; }
    private bool Loading { get; set; }
    private string? ErrorMessage { get; set; }

    private FinancialDto? Financial { get; set; }

    private async Task Toggle()
    {
        if (Expanded)
        {
            Expanded = false;
            return;
        }

        Expanded = true;
        Loading = true;
        ErrorMessage = null;
        Financial = null;

        try
        {
            await Auth.RestoreAsync();

            if (!Auth.IsLoggedIn || Auth.Role != "Marketer")
            {
                ErrorMessage = "دسترسی غیرمجاز.";
                return;
            }

            var client = Auth.CreateAuthenticatedClient();

            Financial =
                await client.GetFromJsonAsync<FinancialDto>(
                    $"api/Enrollments/{EnrollmentId}/financial-details");
        }
        catch
        {
            ErrorMessage = "دریافت اطلاعات مالی با خطا مواجه شد.";
        }
        finally
        {
            Loading = false;
        }
    }

    private string GetPaymentStatusText(string? status)
    {
        return status switch
        {
            "Paid" => "تسویه‌شده",
            "PartiallyPaid" => "پرداخت ناقص",
            "Unpaid" => "پرداخت‌نشده",
            "Overpaid" => "بیش‌پرداخت",
            _ => status ?? "نامشخص"
        };
    }

    private class FinancialDto
    {
        public int EnrollmentId { get; set; }
        public string StudentName { get; set; } = "";
        public string CourseTitle { get; set; } = "";
        public decimal CoursePrice { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal RemainingAmount { get; set; }
        public string PaymentStatus { get; set; } = "";
        public List<PaymentDto> Payments { get; set; } = new();
    }

    private class PaymentDto
    {
        public int Id { get; set; }
        public decimal Amount { get; set; }
        public DateTime PaymentDate { get; set; }
        public string? PaymentType { get; set; }
        public string? Description { get; set; }
        public string? Status { get; set; }
    }
}
